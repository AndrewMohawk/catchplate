COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-consume-dynamic.service.in /runtime/app/ops/systemd/serverware-oidc-session-activation-consume-dynamic.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-token-release.socket /runtime/app/ops/systemd/serverware-oidc-session-activation-token-release.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-token-release.service.in /runtime/app/ops/systemd/serverware-oidc-session-activation-token-release.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-token-release-bootstrap.socket /runtime/app/ops/systemd/serverware-oidc-session-activation-token-release-bootstrap.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-token-release-dynamic.socket /runtime/app/ops/systemd/serverware-oidc-session-activation-token-release-dynamic.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-token-release-dynamic.service.in /runtime/app/ops/systemd/serverware-oidc-session-activation-token-release-dynamic.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-release-recovery-bootstrap.socket /runtime/app/ops/systemd/serverware-oidc-session-activation-release-recovery-bootstrap.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-release-recovery-dynamic.socket /runtime/app/ops/systemd/serverware-oidc-session-activation-release-recovery-dynamic.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-oidc-session-activation-release-recovery-dynamic.service.in /runtime/app/ops/systemd/serverware-oidc-session-activation-release-recovery-dynamic.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@.socket /runtime/app/ops/systemd/serverware-policy-custody@.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@.service.in /runtime/app/ops/systemd/serverware-policy-custody@.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@durable-recovery-store.service.d /runtime/app/ops/systemd/serverware-policy-custody@durable-recovery-store.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@cleanup-authorization-consumer.service.d /runtime/app/ops/systemd/serverware-policy-custody@cleanup-authorization-consumer.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@recovery-target-provider.service.d /runtime/app/ops/systemd/serverware-policy-custody@recovery-target-provider.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@current-signature-authority.service.d /runtime/app/ops/systemd/serverware-policy-custody@current-signature-authority.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@bounded-cleanup-helper.service.d /runtime/app/ops/systemd/serverware-policy-custody@bounded-cleanup-helper.service.d
COPY --from=verified-production-source /source/docker-compose.apparmor.yml /runtime/app/docker-compose.apparmor.yml
RUN --network=none printf 'serverware.productionImage/v1\n' > /runtime/app/.serverware-production-image \
    && mkdir -p /runtime/custody-trust /runtime/gate-materials \
    && chmod 0555 /runtime/authority-bootstrap \
    && chmod 0444 /runtime/authority-bootstrap/authority_fd_entrypoint.py \
        /runtime/authority-bootstrap/authority_launcher.py \
        /runtime/authority-bootstrap/registration_evidence_signer_launcher.py \
        /runtime/authority-bootstrap/current_root_state_launcher.py \
        /runtime/authority-bootstrap/registration_execution_authorizer_launcher.py \
        /runtime/authority-bootstrap/registration_finalization_authorizer_launcher.py \
        /runtime/authority-bootstrap/registration_execution_reserver_launcher.py \
        /runtime/authority-bootstrap/registration_finalization_reserver_launcher.py \
        /runtime/authority-bootstrap/registration_execution_sql_launcher.py \
        /runtime/authority-bootstrap/registration_finalization_sql_launcher.py \
        /runtime/authority-bootstrap/registration_execution_completion_launcher.py \
        /runtime/authority-bootstrap/registration_finalization_completion_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_planner_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_delivery_planner_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_execution_authorizer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_authorizer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_execution_reserver_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_reserver_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_execution_sql_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_sql_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_completion_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_delivery_completion_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_proof_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_proof_dynamic_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_proof_input_issuer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_grant_issuer_launcher.py \
        /runtime/authority-bootstrap/workload_identity_issuer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_recovery_issuer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_grant_issuer_dynamic_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_consume_input_issuer_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_consume_dynamic_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_dynamic_launcher.py \
        /runtime/authority-bootstrap/oidc_session_activation_release_recovery_dynamic_launcher.py \
    && chmod 0755 /runtime/custody-trust \
    && chmod 0750 /runtime/gate-materials \
    && find /runtime/app/ops/policy-custody /runtime/app/ops/systemd -type d -exec chmod 0555 {} + \
    && find /runtime/app/ops/policy-custody /runtime/app/ops/systemd -type f -exec chmod 0444 {} + \
    && chmod 0444 /runtime/app/ops/production-readiness.env.example \
    && chmod 0444 /runtime/app/.serverware-production-image \
    && find /runtime -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

# Separate unsigned conductor filesystem, not the control-plane image or a
# configured service. Source verification and the offline Python dependency
# owners above remain prerequisites; no live owner is invoked during assembly.
FROM verified-production-source AS native-pilot-conductor-files

ARG SOURCE_DATE_EPOCH="0"
RUN --network=none set -eu; \
    install -d -m 0555 /conductor/app/scripts /conductor/usr/share/serverware; \
    install -d -m 0755 /conductor-base/var/local /conductor-base/etc; \
    ln -s /usr/share/zoneinfo/Etc/UTC /conductor-base/etc/localtime; \
    cp -R /source/serverware /conductor/app/serverware; \
    install -m 0444 /source/scripts/run_native_pilot.py /conductor/app/scripts/run_native_pilot.py; \
    install -m 0444 /source/scripts/native_pilot_runtime_entrypoint.py /conductor/app/scripts/native_pilot_runtime_entrypoint.py; \
    install -m 0444 /source-contract/source-manifest.json /conductor/usr/share/serverware/source-manifest.json; \
    test -z "$(find /conductor -type l -print -quit)"; \
    find /conductor -type d -exec chmod 0555 {} +; \
    find /conductor -type f -exec chmod 0444 {} +; \
    find /conductor -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" /conductor-base /conductor-base/var /conductor-base/var/local /conductor-base/etc /conductor-base/etc/localtime

FROM gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5 AS native-pilot-conductor-rootfs

# Keep the pinned base's genuine ELF interpreter and system DSOs alongside the
# existing relocated CPython/libpython/stdlib/vendor artifact. Native service
# executables, protected configurations, resources and authority are external.
COPY --from=production-python-runtime-artifact --chown=0:0 /runtime /runtime
COPY --from=production-python-runtime-artifact --chown=0:0 /vendor /vendor
COPY --from=native-pilot-conductor-files --chown=0:0 /conductor/app /app
COPY --from=native-pilot-conductor-files --chown=0:0 /conductor/usr/share/serverware /usr/share/serverware
# The pilot has no use for the base's setgid /var/local. Preserve the strict
# no-set-id inventory by replacing that exact empty directory with root0755.
# Resolve the base's zoneinfo/localtime link through its genuine pinned UTC
# file, never through host timezone data or an empty placeholder.
COPY --from=native-pilot-conductor-files --chown=0:0 /conductor-base/ /

FROM scratch AS native-pilot-conductor-artifact
COPY --from=native-pilot-conductor-rootfs / /

# Separate authority-coordinator package. Keep the conductor's admitted /app
# population unchanged; neither target supplies approvals, keys or live owners.
FROM verified-production-source AS native-pilot-authority-files

ARG SOURCE_DATE_EPOCH="0"
RUN --network=none set -eu; \
    install -d -m 0555 /authority-runtime-root/authority/app/scripts/authority; \
    install -m 0444 /source/scripts/native_pilot_authority_runtime_entrypoint.py /authority-runtime-root/authority/app/scripts/native_pilot_authority_runtime_entrypoint.py; \
    install -m 0444 /source/scripts/run_native_pilot_authority_coordinator.py /authority-runtime-root/authority/app/scripts/run_native_pilot_authority_coordinator.py; \
    install -m 0444 /source/scripts/native_pilot_runtime_artifacts.py /authority-runtime-root/authority/app/scripts/native_pilot_runtime_artifacts.py; \
    install -m 0444 /source/scripts/verify_nitro_tee.py /authority-runtime-root/authority/app/scripts/verify_nitro_tee.py; \
    install -m 0444 /source/scripts/authority/native_pilot_authority_io.py /authority-runtime-root/authority/app/scripts/authority/native_pilot_authority_io.py; \
    install -m 0444 /source/scripts/authority/prepare_native_pilot_closure_set.py /authority-runtime-root/authority/app/scripts/authority/prepare_native_pilot_closure_set.py; \
    test -z "$(find /authority-runtime-root -type l -print -quit)"; \
    find /authority-runtime-root -type d -exec chmod 0555 {} +; \
    find /authority-runtime-root -type f -exec chmod 0444 {} +; \
    find /authority-runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM native-pilot-conductor-rootfs AS native-pilot-authority-rootfs
# Copy /authority as an explicit child, not a destination synthesized as 0755.
COPY --from=native-pilot-authority-files --chown=0:0 /authority-runtime-root/ /

FROM scratch AS native-pilot-authority-artifact
COPY --from=native-pilot-authority-rootfs / /

# Separate commissioning supervisor. Child runtime source populations stay
# unchanged; all three inventories and independent authority remain required.
FROM verified-production-source AS native-pilot-supervisor-files

ARG SOURCE_DATE_EPOCH="0"
RUN --network=none set -eu; \
    install -d -m 0555 /supervisor-runtime-root/supervisor/app/scripts; \
    install -m 0444 /source/scripts/native_pilot_supervisor_runtime_entrypoint.py /supervisor-runtime-root/supervisor/app/scripts/native_pilot_supervisor_runtime_entrypoint.py; \
    install -m 0444 /source/scripts/run_native_pilot_supervisor.py /supervisor-runtime-root/supervisor/app/scripts/run_native_pilot_supervisor.py; \
    install -m 0444 /source/scripts/native_pilot_publication_runtime_entrypoint.py /supervisor-runtime-root/supervisor/app/scripts/native_pilot_publication_runtime_entrypoint.py; \
    install -m 0444 /source/scripts/native_pilot_genesis_install_runtime_entrypoint.py /supervisor-runtime-root/supervisor/app/scripts/native_pilot_genesis_install_runtime_entrypoint.py; \
    install -m 0444 /source/scripts/install_native_pilot_genesis_rendezvous.py /supervisor-runtime-root/supervisor/app/scripts/install_native_pilot_genesis_rendezvous.py; \
    install -m 0444 /source/scripts/install_native_pilot_genesis_job.py /supervisor-runtime-root/supervisor/app/scripts/install_native_pilot_genesis_job.py; \
    install -m 0444 /source/scripts/run_native_pilot_lifecycle.py /supervisor-runtime-root/supervisor/app/scripts/run_native_pilot_lifecycle.py; \
    install -m 0444 /source/scripts/run_native_pilot_approval_provider.py /supervisor-runtime-root/supervisor/app/scripts/run_native_pilot_approval_provider.py; \
    install -m 0444 /source/scripts/run_native_pilot_current_head_decisions.py /supervisor-runtime-root/supervisor/app/scripts/run_native_pilot_current_head_decisions.py; \
    test -z "$(find /supervisor-runtime-root -type l -print -quit)"; \
    find /supervisor-runtime-root -type d -exec chmod 0555 {} +; \
    find /supervisor-runtime-root -type f -exec chmod 0444 {} +; \
    find /supervisor-runtime-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM native-pilot-authority-rootfs AS native-pilot-supervisor-rootfs
COPY --from=native-pilot-supervisor-files --chown=0:0 /supervisor-runtime-root/ /

FROM scratch AS native-pilot-supervisor-artifact
COPY --from=native-pilot-supervisor-rootfs / /

FROM gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5

ARG SERVERWARE_IMAGE_SOURCE="https://github.com/example/private-deployment"
ARG SERVERWARE_IMAGE_TITLE="invalid source identity"
ARG SERVERWARE_IMAGE_REVISION="unknown"
ARG SERVERWARE_IMAGE_CREATED="unknown"
ARG SERVERWARE_SOURCE_TREE_DIGEST="unknown"
ARG SERVERWARE_SOURCE_ARCHIVE_SHA256="unknown"
ARG SERVERWARE_SOURCE_MANIFEST_SHA256="unknown"
ARG SERVERWARE_SOURCE_IDENTITY_MODE="invalid"
ARG SERVERWARE_PRODUCTION_RELEASE_ELIGIBLE="false"
ARG SOURCE_DATE_EPOCH="0"

LABEL org.opencontainers.image.title="${SERVERWARE_IMAGE_TITLE}" \
      org.opencontainers.image.source="${SERVERWARE_IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${SERVERWARE_IMAGE_REVISION}" \
      org.opencontainers.image.created="${SERVERWARE_IMAGE_CREATED}" \
      dev.serverware.source_tree_digest="${SERVERWARE_SOURCE_TREE_DIGEST}" \
      dev.serverware.source_archive_digest="${SERVERWARE_SOURCE_ARCHIVE_SHA256}" \
      dev.serverware.source_manifest_digest="${SERVERWARE_SOURCE_MANIFEST_SHA256}" \
      dev.serverware.source_identity_mode="${SERVERWARE_SOURCE_IDENTITY_MODE}" \
      dev.serverware.production_release_eligible="${SERVERWARE_PRODUCTION_RELEASE_ELIGIBLE}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/vendor:/app \
    SERVERWARE_DATA_DIR=/data

COPY --from=production-python-runtime-artifact --chown=0:0 /runtime /runtime
COPY --from=production-python-runtime-artifact --chown=0:0 /vendor /vendor
COPY --from=runtime-tree --chown=0:0 /runtime/authority-bootstrap /runtime/authority-bootstrap
COPY --from=runtime-tree --chown=0:0 /runtime/app /app
COPY --from=verified-production-source --chown=0:0 /source-contract/source-manifest.json /usr/share/serverware/source-manifest.json
COPY --from=runtime-tree --chown=65532:65532 --chmod=0755 /runtime/custody-trust /run/serverware/custody-trust
COPY --from=runtime-tree --chown=65532:65532 --chmod=0750 /runtime/gate-materials /run/serverware/gate
WORKDIR /app

EXPOSE 3000

USER nonroot:nonroot
ENTRYPOINT ["/runtime/python/bin/python3"]
CMD ["-m", "serverware.control_plane_runner"]
