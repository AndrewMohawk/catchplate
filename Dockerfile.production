FROM scratch AS python-production-dependency-cache
COPY requirements.lock /dependency-cache/requirements.lock
COPY production-dependencies/python-linux-amd64.sha256 /dependency-cache/python-linux-amd64.sha256
COPY production-dependencies/cache/python-wheelhouse-linux-amd64.tar.gz /dependency-cache/cache/python-wheelhouse-linux-amd64.tar.gz

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS python-deps

ARG SOURCE_DATE_EPOCH="0"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INDEX=1 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

WORKDIR /build
COPY --from=python-production-dependency-cache /dependency-cache /dependency-cache
RUN --network=none set -eu; \
    cd /dependency-cache; \
    test "$(grep -Ec '^[0-9a-f]{64}  ' python-linux-amd64.sha256)" -eq 2; \
    grep -E '^[0-9a-f]{64}  ' python-linux-amd64.sha256 | sha256sum -c -; \
    tar -xzf cache/python-wheelhouse-linux-amd64.tar.gz; \
    test -n "$(find wheelhouse -maxdepth 1 -type f -name '*.whl' -print -quit)"; \
    python -m pip install \
        --no-cache-dir \
        --no-compile \
        --no-index \
        --only-binary=:all: \
        --find-links=/dependency-cache/wheelhouse \
        --require-hashes \
        --target=/deps \
        -r /dependency-cache/requirements.lock; \
    find /deps -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS verified-production-source

ARG SERVERWARE_SOURCE_ARCHIVE
ARG SERVERWARE_SOURCE_ARCHIVE_SHA256
ARG SERVERWARE_SOURCE_MANIFEST
ARG SERVERWARE_SOURCE_MANIFEST_SHA256
ARG SERVERWARE_SOURCE_FILE_LIST
ARG SERVERWARE_SOURCE_FILE_LIST_SHA256
ARG SERVERWARE_SOURCE_FILE_HASHES
ARG SERVERWARE_SOURCE_FILE_HASHES_SHA256
ARG SERVERWARE_SOURCE_FILE_MODES
ARG SERVERWARE_SOURCE_FILE_MODES_SHA256

WORKDIR /build
COPY ${SERVERWARE_SOURCE_ARCHIVE} /source-contract/source.tar
COPY ${SERVERWARE_SOURCE_MANIFEST} /source-contract/source-manifest.json
COPY ${SERVERWARE_SOURCE_FILE_LIST} /source-contract/source.files
COPY ${SERVERWARE_SOURCE_FILE_HASHES} /source-contract/source.files.sha256
COPY ${SERVERWARE_SOURCE_FILE_MODES} /source-contract/source.files.mode
RUN --network=none set -eu; \
    test -n "${SERVERWARE_SOURCE_ARCHIVE_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_MANIFEST_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_LIST_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_HASHES_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_MODES_SHA256}"; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_ARCHIVE_SHA256#sha256:}" /source-contract/source.tar | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_MANIFEST_SHA256#sha256:}" /source-contract/source-manifest.json | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/source.files | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_HASHES_SHA256#sha256:}" /source-contract/source.files.sha256 | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_MODES_SHA256#sha256:}" /source-contract/source.files.mode | sha256sum -c -; \
    tar -tf /source-contract/source.tar > /source-contract/archive.files; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/archive.files | sha256sum -c -; \
    mkdir -p /source; \
    tar --no-same-owner -xf /source-contract/source.tar -C /source; \
    cd /source; \
    sha256sum -c /source-contract/source.files.sha256; \
    while read -r expected_mode relative; do \
        test -n "${expected_mode}"; \
        test -n "${relative}"; \
        test -f "/source/${relative}"; \
        test ! -L "/source/${relative}"; \
        test "$(stat -c '%a' "/source/${relative}")" = "${expected_mode}"; \
    done < /source-contract/source.files.mode

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS production-python-runtime-tree

ARG SOURCE_DATE_EPOCH="0"
# This artifact closes CPython, libpython, stdlib, extension modules, and vendor.
# The host PT_INTERP target and recursive system DSO graph remain external.
COPY --from=python-deps /deps /deps
RUN --network=none set -eu; \
    mkdir -p /runtime/python/bin /runtime/python/lib/python3.11 /vendor; \
    cp -L /usr/local/bin/python3 /runtime/python/bin/python3; \
    cp -RL /usr/local/lib/python3.11/. /runtime/python/lib/python3.11/; \
    rm -rf \
        /runtime/python/lib/python3.11/site-packages \
        /runtime/python/lib/python3.11/ensurepip \
        /runtime/python/lib/python3.11/idlelib \
        /runtime/python/lib/python3.11/tkinter \
        /runtime/python/lib/python3.11/__pycache__; \
    cp -L /usr/local/lib/libpython3.11.so.1.0 /runtime/python/lib/libpython3.11.so.1.0; \
    cp -RL /deps/. /vendor/; \
    test -x /runtime/python/bin/python3; \
    test -f /runtime/python/lib/libpython3.11.so.1.0; \
    test -n "$(find /runtime/python/lib/python3.11/lib-dynload -maxdepth 1 -type f -name '*.so' -print -quit)"; \
    test -z "$(find /runtime /vendor -type l -print -quit)"; \
    find /runtime /vendor -type d -exec chmod 0755 {} +; \
    find /runtime /vendor -type f -exec chmod 0444 {} +; \
    chmod 0555 /runtime/python/bin/python3; \
    find /runtime /vendor -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    /runtime/python/bin/python3 -I -c 'import _ssl, sys; assert sys.version_info[:2] == (3, 11); assert sys.prefix == "/runtime/python"'

FROM scratch AS production-python-runtime-artifact
COPY --from=production-python-runtime-tree /runtime /runtime
COPY --from=production-python-runtime-tree /vendor /vendor

