FROM scratch AS python-production-dependency-cache
COPY requirements.lock /dependency-cache/requirements.lock
COPY production-dependencies/python-linux-amd64.sha256 /dependency-cache/python-linux-amd64.sha256
COPY production-dependencies/cache/python-wheelhouse-linux-amd64.tar.gz /dependency-cache/cache/python-wheelhouse-linux-amd64.tar.gz

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS python-deps

ARG SOURCE_DATE_EPOCH="0"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INDEX=1 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

WORKDIR /build
COPY --from=python-production-dependency-cache /dependency-cache /dependency-cache
RUN --network=none set -eu; \
    cd /dependency-cache; \
    test "$(grep -Ec '^[0-9a-f]{64}  ' python-linux-amd64.sha256)" -eq 2; \
    grep -E '^[0-9a-f]{64}  ' python-linux-amd64.sha256 | sha256sum -c -; \
    tar -xzf cache/python-wheelhouse-linux-amd64.tar.gz; \
    test -n "$(find wheelhouse -maxdepth 1 -type f -name '*.whl' -print -quit)"; \
    python -m pip install \
        --no-cache-dir \
        --no-compile \
        --no-index \
        --only-binary=:all: \
        --find-links=/dependency-cache/wheelhouse \
        --require-hashes \
        --target=/deps \
        -r /dependency-cache/requirements.lock; \
    find /deps -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS verified-production-source

ARG SERVERWARE_SOURCE_ARCHIVE
ARG SERVERWARE_SOURCE_ARCHIVE_SHA256
ARG SERVERWARE_SOURCE_MANIFEST
ARG SERVERWARE_SOURCE_MANIFEST_SHA256
ARG SERVERWARE_SOURCE_FILE_LIST
ARG SERVERWARE_SOURCE_FILE_LIST_SHA256
ARG SERVERWARE_SOURCE_FILE_HASHES
ARG SERVERWARE_SOURCE_FILE_HASHES_SHA256
ARG SERVERWARE_SOURCE_FILE_MODES
ARG SERVERWARE_SOURCE_FILE_MODES_SHA256

WORKDIR /build
COPY ${SERVERWARE_SOURCE_ARCHIVE} /source-contract/source.tar
COPY ${SERVERWARE_SOURCE_MANIFEST} /source-contract/source-manifest.json
COPY ${SERVERWARE_SOURCE_FILE_LIST} /source-contract/source.files
COPY ${SERVERWARE_SOURCE_FILE_HASHES} /source-contract/source.files.sha256
COPY ${SERVERWARE_SOURCE_FILE_MODES} /source-contract/source.files.mode
RUN --network=none set -eu; \
    test -n "${SERVERWARE_SOURCE_ARCHIVE_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_MANIFEST_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_LIST_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_HASHES_SHA256}"; \
    test -n "${SERVERWARE_SOURCE_FILE_MODES_SHA256}"; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_ARCHIVE_SHA256#sha256:}" /source-contract/source.tar | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_MANIFEST_SHA256#sha256:}" /source-contract/source-manifest.json | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/source.files | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_HASHES_SHA256#sha256:}" /source-contract/source.files.sha256 | sha256sum -c -; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_MODES_SHA256#sha256:}" /source-contract/source.files.mode | sha256sum -c -; \
    tar -tf /source-contract/source.tar > /source-contract/archive.files; \
    printf '%s  %s\n' "${SERVERWARE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/archive.files | sha256sum -c -; \
    mkdir -p /source; \
    tar --no-same-owner -xf /source-contract/source.tar -C /source; \
    cd /source; \
    sha256sum -c /source-contract/source.files.sha256; \
    while read -r expected_mode relative; do \
        test -n "${expected_mode}"; \
        test -n "${relative}"; \
        test -f "/source/${relative}"; \
        test ! -L "/source/${relative}"; \
        test "$(stat -c '%a' "/source/${relative}")" = "${expected_mode}"; \
    done < /source-contract/source.files.mode

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS production-python-runtime-tree

ARG SOURCE_DATE_EPOCH="0"
# This artifact closes CPython, libpython, stdlib, extension modules, and vendor.
# The host PT_INTERP target and recursive system DSO graph remain external.
COPY --from=python-deps /deps /deps
RUN --network=none set -eu; \
    mkdir -p /runtime/python/bin /runtime/python/lib/python3.11 /vendor; \
    cp -L /usr/local/bin/python3 /runtime/python/bin/python3; \
    cp -RL /usr/local/lib/python3.11/. /runtime/python/lib/python3.11/; \
    rm -rf \
        /runtime/python/lib/python3.11/site-packages \
        /runtime/python/lib/python3.11/ensurepip \
        /runtime/python/lib/python3.11/idlelib \
        /runtime/python/lib/python3.11/tkinter \
        /runtime/python/lib/python3.11/__pycache__; \
    cp -L /usr/local/lib/libpython3.11.so.1.0 /runtime/python/lib/libpython3.11.so.1.0; \
    cp -RL /deps/. /vendor/; \
    test -x /runtime/python/bin/python3; \
    test -f /runtime/python/lib/libpython3.11.so.1.0; \
    test -n "$(find /runtime/python/lib/python3.11/lib-dynload -maxdepth 1 -type f -name '*.so' -print -quit)"; \
    test -z "$(find /runtime /vendor -type l -print -quit)"; \
    find /runtime /vendor -type d -exec chmod 0755 {} +; \
    find /runtime /vendor -type f -exec chmod 0444 {} +; \
    chmod 0555 /runtime/python/bin/python3; \
    find /runtime /vendor -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    /runtime/python/bin/python3 -I -c 'import _ssl, sys; assert sys.version_info[:2] == (3, 11); assert sys.prefix == "/runtime/python"'

FROM scratch AS production-python-runtime-artifact
COPY --from=production-python-runtime-tree /runtime /runtime
COPY --from=production-python-runtime-tree /vendor /vendor

FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS runtime-tree

ARG SOURCE_DATE_EPOCH="0"
COPY --from=python-deps /deps /runtime/deps
COPY --from=verified-production-source /source/serverware/authority_fd_entrypoint.py /runtime/authority-bootstrap/authority_fd_entrypoint.py
COPY --from=verified-production-source /source/serverware/authority_launcher.py /runtime/authority-bootstrap/authority_launcher.py
COPY --from=verified-production-source /source/serverware/registration_evidence_signer_launcher.py /runtime/authority-bootstrap/registration_evidence_signer_launcher.py
COPY --from=verified-production-source /source/serverware/current_root_state_launcher.py /runtime/authority-bootstrap/current_root_state_launcher.py
COPY --from=verified-production-source /source/serverware/registration_execution_authorizer_launcher.py /runtime/authority-bootstrap/registration_execution_authorizer_launcher.py
COPY --from=verified-production-source /source/serverware/registration_execution_reserver_launcher.py /runtime/authority-bootstrap/registration_execution_reserver_launcher.py
COPY --from=verified-production-source /source/serverware/registration_execution_sql_launcher.py /runtime/authority-bootstrap/registration_execution_sql_launcher.py
COPY --from=verified-production-source /source/serverware /runtime/app/serverware
COPY --from=verified-production-source /source/scripts /runtime/app/scripts
COPY --from=verified-production-source /source/schemas /runtime/app/schemas
COPY --from=verified-production-source /source/policies /runtime/app/policies
COPY --from=verified-production-source /source/security /runtime/app/security
COPY --from=verified-production-source /source/ops/policy-custody /runtime/app/ops/policy-custody
COPY --from=verified-production-source /source/ops/production-readiness.env.example /runtime/app/ops/production-readiness.env.example
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody-sockets.target /runtime/app/ops/systemd/serverware-policy-custody-sockets.target
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody.target /runtime/app/ops/systemd/serverware-policy-custody.target
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-evidence.socket /runtime/app/ops/systemd/serverware-registration-evidence.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-evidence.service.in /runtime/app/ops/systemd/serverware-registration-evidence.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-current-root-state.socket /runtime/app/ops/systemd/serverware-current-root-state.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-current-root-state.service.in /runtime/app/ops/systemd/serverware-current-root-state.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-authorizer.socket /runtime/app/ops/systemd/serverware-registration-execution-authorizer.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-authorizer.service.in /runtime/app/ops/systemd/serverware-registration-execution-authorizer.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-reserver.socket /runtime/app/ops/systemd/serverware-registration-execution-reserver.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-reserver.service.in /runtime/app/ops/systemd/serverware-registration-execution-reserver.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-sql.socket /runtime/app/ops/systemd/serverware-registration-execution-sql.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-registration-execution-sql.service.in /runtime/app/ops/systemd/serverware-registration-execution-sql.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@.socket /runtime/app/ops/systemd/serverware-policy-custody@.socket
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@.service.in /runtime/app/ops/systemd/serverware-policy-custody@.service.in
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@durable-recovery-store.service.d /runtime/app/ops/systemd/serverware-policy-custody@durable-recovery-store.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@cleanup-authorization-consumer.service.d /runtime/app/ops/systemd/serverware-policy-custody@cleanup-authorization-consumer.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@recovery-target-provider.service.d /runtime/app/ops/systemd/serverware-policy-custody@recovery-target-provider.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@current-signature-authority.service.d /runtime/app/ops/systemd/serverware-policy-custody@current-signature-authority.service.d
COPY --from=verified-production-source /source/ops/systemd/serverware-policy-custody@bounded-cleanup-helper.service.d /runtime/app/ops/systemd/serverware-policy-custody@bounded-cleanup-helper.service.d
COPY --from=verified-production-source /source/docker-compose.apparmor.yml /runtime/app/docker-compose.apparmor.yml
RUN --network=none printf 'serverware.productionImage/v1\n' > /runtime/app/.serverware-production-image \
    && mkdir -p /runtime/custody-trust /runtime/gate-materials \
    && chmod 0555 /runtime/authority-bootstrap \
    && chmod 0444 /runtime/authority-bootstrap/authority_fd_entrypoint.py \
        /runtime/authority-bootstrap/authority_launcher.py \
        /runtime/authority-bootstrap/registration_evidence_signer_launcher.py \
        /runtime/authority-bootstrap/current_root_state_launcher.py \
        /runtime/authority-bootstrap/registration_execution_authorizer_launcher.py \
        /runtime/authority-bootstrap/registration_execution_reserver_launcher.py \
        /runtime/authority-bootstrap/registration_execution_sql_launcher.py \
    && chmod 0755 /runtime/custody-trust \
    && chmod 0750 /runtime/gate-materials \
    && find /runtime/app/ops/policy-custody /runtime/app/ops/systemd -type d -exec chmod 0555 {} + \
    && find /runtime/app/ops/policy-custody /runtime/app/ops/systemd -type f -exec chmod 0444 {} + \
    && chmod 0444 /runtime/app/ops/production-readiness.env.example \
    && chmod 0444 /runtime/app/.serverware-production-image \
    && find /runtime -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM gcr.io/distroless/python3-debian12:nonroot@sha256:7d1042ce588ab97019fe95c24ffca7bc5a82ccdac572511d5e09bda4435c89c5

ARG SERVERWARE_IMAGE_SOURCE="https://github.com/example/private-deployment"
ARG SERVERWARE_IMAGE_TITLE="invalid source identity"
ARG SERVERWARE_IMAGE_REVISION="unknown"
ARG SERVERWARE_IMAGE_CREATED="unknown"
ARG SERVERWARE_SOURCE_TREE_DIGEST="unknown"
ARG SERVERWARE_SOURCE_ARCHIVE_SHA256="unknown"
ARG SERVERWARE_SOURCE_MANIFEST_SHA256="unknown"
ARG SERVERWARE_SOURCE_IDENTITY_MODE="invalid"
ARG SERVERWARE_PRODUCTION_RELEASE_ELIGIBLE="false"
ARG SOURCE_DATE_EPOCH="0"

LABEL org.opencontainers.image.title="${SERVERWARE_IMAGE_TITLE}" \
      org.opencontainers.image.source="${SERVERWARE_IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${SERVERWARE_IMAGE_REVISION}" \
      org.opencontainers.image.created="${SERVERWARE_IMAGE_CREATED}" \
      dev.serverware.source_tree_digest="${SERVERWARE_SOURCE_TREE_DIGEST}" \
      dev.serverware.source_archive_digest="${SERVERWARE_SOURCE_ARCHIVE_SHA256}" \
      dev.serverware.source_manifest_digest="${SERVERWARE_SOURCE_MANIFEST_SHA256}" \
      dev.serverware.source_identity_mode="${SERVERWARE_SOURCE_IDENTITY_MODE}" \
      dev.serverware.production_release_eligible="${SERVERWARE_PRODUCTION_RELEASE_ELIGIBLE}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/vendor:/app \
    SERVERWARE_DATA_DIR=/data

COPY --from=production-python-runtime-artifact --chown=0:0 /runtime /runtime
COPY --from=production-python-runtime-artifact --chown=0:0 /vendor /vendor
COPY --from=runtime-tree --chown=0:0 /runtime/authority-bootstrap /runtime/authority-bootstrap
COPY --from=runtime-tree --chown=0:0 /runtime/app /app
COPY --from=verified-production-source --chown=0:0 /source-contract/source-manifest.json /usr/share/serverware/source-manifest.json
COPY --from=runtime-tree --chown=65532:65532 --chmod=0755 /runtime/custody-trust /run/serverware/custody-trust
COPY --from=runtime-tree --chown=65532:65532 --chmod=0750 /runtime/gate-materials /run/serverware/gate
WORKDIR /app

EXPOSE 3000

USER nonroot:nonroot
ENTRYPOINT ["/runtime/python/bin/python3"]
CMD ["-m", "serverware.control_plane_runner"]
