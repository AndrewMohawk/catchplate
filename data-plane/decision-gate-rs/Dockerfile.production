FROM scratch AS rust-production-dependency-cache
COPY production-dependencies/cache/cargo-vendor.tar.gz /dependency-cache/cache/cargo-vendor.tar.gz
COPY production-dependencies/cache/musl-1.2.5-r12.apk /dependency-cache/cache/musl-1.2.5-r12.apk
COPY production-dependencies/cache/musl-dev-1.2.5-r12.apk /dependency-cache/cache/musl-dev-1.2.5-r12.apk
COPY production-dependencies/cache/python-wheelhouse-linux-amd64.tar.gz /dependency-cache/cache/python-wheelhouse-linux-amd64.tar.gz
COPY production-dependencies/cache/squashfs-tools_4.5.1-1_amd64.deb /dependency-cache/cache/squashfs-tools_4.5.1-1_amd64.deb
COPY production-dependencies/cache/liblzo2-2_2.10-2_amd64.deb /dependency-cache/cache/liblzo2-2_2.10-2_amd64.deb

FROM rust:1.88-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89 AS source-preparation

ARG SOURCE_DATE_EPOCH="0"
ARG CATCHPLATE_SOURCE_ARCHIVE
ARG CATCHPLATE_SOURCE_ARCHIVE_SHA256
ARG CATCHPLATE_SOURCE_MANIFEST
ARG CATCHPLATE_SOURCE_MANIFEST_SHA256
ARG CATCHPLATE_SOURCE_FILE_LIST
ARG CATCHPLATE_SOURCE_FILE_LIST_SHA256
ARG CATCHPLATE_SOURCE_FILE_HASHES
ARG CATCHPLATE_SOURCE_FILE_HASHES_SHA256
ARG CATCHPLATE_SOURCE_FILE_MODES
ARG CATCHPLATE_SOURCE_FILE_MODES_SHA256
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_NET_OFFLINE=true \
    RUSTFLAGS="-C link-arg=-Wl,--build-id=none"

WORKDIR /src
COPY ${CATCHPLATE_SOURCE_ARCHIVE} /source-contract/source.tar
COPY ${CATCHPLATE_SOURCE_MANIFEST} /source-contract/source-manifest.json
COPY ${CATCHPLATE_SOURCE_FILE_LIST} /source-contract/source.files
COPY ${CATCHPLATE_SOURCE_FILE_HASHES} /source-contract/source.files.sha256
COPY ${CATCHPLATE_SOURCE_FILE_MODES} /source-contract/source.files.mode
COPY --from=rust-production-dependency-cache /dependency-cache /dependency-cache
RUN --network=none set -eu; \
    test -n "${CATCHPLATE_SOURCE_ARCHIVE_SHA256}"; \
    test -n "${CATCHPLATE_SOURCE_MANIFEST_SHA256}"; \
    test -n "${CATCHPLATE_SOURCE_FILE_LIST_SHA256}"; \
    test -n "${CATCHPLATE_SOURCE_FILE_HASHES_SHA256}"; \
    test -n "${CATCHPLATE_SOURCE_FILE_MODES_SHA256}"; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_ARCHIVE_SHA256#sha256:}" /source-contract/source.tar | sha256sum -c -; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_MANIFEST_SHA256#sha256:}" /source-contract/source-manifest.json | sha256sum -c -; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/source.files | sha256sum -c -; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_FILE_HASHES_SHA256#sha256:}" /source-contract/source.files.sha256 | sha256sum -c -; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_FILE_MODES_SHA256#sha256:}" /source-contract/source.files.mode | sha256sum -c -; \
    tar -tf /source-contract/source.tar > /source-contract/archive.files; \
    printf '%s  %s\n' "${CATCHPLATE_SOURCE_FILE_LIST_SHA256#sha256:}" /source-contract/archive.files | sha256sum -c -; \
    mkdir -p /source; \
    tar --no-same-owner -xf /source-contract/source.tar -C /source; \
    cd /source; \
    sha256sum -c /source-contract/source.files.sha256; \
    while read -r expected_mode relative; do \
        test -n "${expected_mode}"; \
        test -n "${relative}"; \
        test -f "/source/${relative}"; \
        test ! -L "/source/${relative}"; \
        test "$(stat -c '%a' "/source/${relative}")" = "${expected_mode}"; \
    done < /source-contract/source.files.mode; \
    mkdir -p /dependency-cache/data-plane/decision-gate-rs; \
    cp /source/data-plane/decision-gate-rs/Cargo.toml /dependency-cache/data-plane/decision-gate-rs/Cargo.toml; \
    cp /source/data-plane/decision-gate-rs/Cargo.lock /dependency-cache/data-plane/decision-gate-rs/Cargo.lock; \
    cp /source/production-dependencies/rust-linux-amd64.sha256 /dependency-cache/rust-linux-amd64.sha256; \
    cd /dependency-cache; \
    sha256sum -c rust-linux-amd64.sha256; \
    tar -xzf cache/cargo-vendor.tar.gz -C /src; \
    mkdir -p /src/.cargo; \
    printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "vendored-sources"' \
        '' \
        '[source.vendored-sources]' \
        'directory = "/src/vendor"' \
        > /src/.cargo/config.toml; \
    cp /source/data-plane/decision-gate-rs/Cargo.toml /src/Cargo.toml; \
    cp /source/data-plane/decision-gate-rs/Cargo.lock /src/Cargo.lock; \
    cp -R /source/data-plane/decision-gate-rs/src /src/src; \
    cp -R /source/data-plane/decision-gate-rs/trust /src/trust; \
    cp -R /source/schemas /schemas; \
    mkdir -p /policy-custody-assets/systemd; \
    cp -R /source/ops/policy-custody/. /policy-custody-assets/; \
    cp /source/ops/systemd/catchplate-policy-custody-sockets.target /policy-custody-assets/systemd/catchplate-policy-custody-sockets.target; \
    cp /source/ops/systemd/catchplate-policy-custody.target /policy-custody-assets/systemd/catchplate-policy-custody.target; \
    cp /source/ops/systemd/catchplate-policy-custody@.socket /policy-custody-assets/systemd/catchplate-policy-custody@.socket; \
    cp /source/ops/systemd/catchplate-policy-custody@.service.in /policy-custody-assets/systemd/catchplate-policy-custody@.service.in; \
    cp -R /source/ops/systemd/catchplate-policy-custody@durable-recovery-store.service.d /policy-custody-assets/systemd/catchplate-policy-custody@durable-recovery-store.service.d; \
    cp -R /source/ops/systemd/catchplate-policy-custody@cleanup-authorization-consumer.service.d /policy-custody-assets/systemd/catchplate-policy-custody@cleanup-authorization-consumer.service.d; \
    cp -R /source/ops/systemd/catchplate-policy-custody@recovery-target-provider.service.d /policy-custody-assets/systemd/catchplate-policy-custody@recovery-target-provider.service.d; \
    cp -R /source/ops/systemd/catchplate-policy-custody@current-signature-authority.service.d /policy-custody-assets/systemd/catchplate-policy-custody@current-signature-authority.service.d; \
    cp -R /source/ops/systemd/catchplate-policy-custody@bounded-cleanup-helper.service.d /policy-custody-assets/systemd/catchplate-policy-custody@bounded-cleanup-helper.service.d

# A fresh pinned compiler filesystem imports only the verified Rust closure.
# The full source/provenance owner still runs first, but unrelated source bytes
# do not enter this stage's filesystem or compiler COPY checksums.
FROM rust:1.88-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89 AS build

ARG SOURCE_DATE_EPOCH="0"
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_NET_OFFLINE=true \
    RUSTFLAGS="-C link-arg=-Wl,--build-id=none"

WORKDIR /src
COPY --from=source-preparation /src /src
COPY --from=source-preparation /schemas /schemas
COPY --from=source-preparation /source/scripts/cargo_build_diagnostics.rs /source/scripts/cargo_build_diagnostics.rs
COPY --from=source-preparation /policy-custody-assets /policy-custody-assets
RUN --network=none rustc --edition=2021 /source/scripts/cargo_build_diagnostics.rs -o /usr/local/bin/catchplate-cargo-build
RUN --network=none /usr/local/bin/catchplate-cargo-build --release --frozen \
    && install -d -m 0710 /runtime-layout/catchplate-custody \
    && install -d -m 0700 /runtime-layout/catchplate-custody-state \
    && install -d -m 0755 /runtime-layout/catchplate-custody-trust \
    && CATCHPLATE_CUSTODY_ATTEMPT_LEDGER_DIRECTORY=/runtime-layout/catchplate-custody-state \
        /src/target/release/catchplate-custody-runtime --initialize-attempt-ledger \
    && find /policy-custody-assets -type d -exec chmod 0555 {} + \
    && find /policy-custody-assets -type f -exec chmod 0444 {} + \
    && find /policy-custody-assets -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

# Offline operator tool only, built by the existing glibc owner. This explicit
# export is not copied into any claimant/default runtime or guest closure.
FROM scratch AS native-pilot-operator-artifact
COPY --from=build --chown=0:0 --chmod=0555 /src/target/release/catchplate-export-custody-seccomp /usr/local/bin/catchplate-export-custody-seccomp

FROM rust:1.88-alpine3.22@sha256:64eba3726734dcfe89e0a62a0485007a3ab7c7372ce5b38c621d8812f70215f0 AS launcher-build

ARG SOURCE_DATE_EPOCH="0"
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_NET_OFFLINE=true \
    RUSTFLAGS="-C link-arg=-Wl,--build-id=none"

WORKDIR /src
COPY --from=source-preparation /src/Cargo.toml /src/Cargo.lock /src/
COPY --from=source-preparation /src/src /src/src
COPY --from=source-preparation /src/trust /src/trust
COPY --from=source-preparation /src/.cargo /src/.cargo
COPY --from=source-preparation /schemas /schemas
COPY --from=source-preparation /source/scripts/cargo_build_diagnostics.rs /source/scripts/cargo_build_diagnostics.rs
COPY --from=source-preparation /dependency-cache/data-plane/decision-gate-rs /dependency-cache/data-plane/decision-gate-rs
COPY --from=source-preparation /dependency-cache/rust-linux-amd64.sha256 /dependency-cache/rust-linux-amd64.sha256
COPY --from=source-preparation /dependency-cache/cache/cargo-vendor.tar.gz /dependency-cache/cache/cargo-vendor.tar.gz
COPY --from=source-preparation /dependency-cache/cache/musl-1.2.5-r12.apk /dependency-cache/cache/musl-1.2.5-r12.apk
COPY --from=source-preparation /dependency-cache/cache/musl-dev-1.2.5-r12.apk /dependency-cache/cache/musl-dev-1.2.5-r12.apk
RUN --network=none set -eu; \
    cd /dependency-cache; \
    test "$(grep -Ec '^[0-9a-f]{64}  ' rust-linux-amd64.sha256)" -eq 5; \
    grep -E '^[0-9a-f]{64}  ' rust-linux-amd64.sha256 | sha256sum -c -; \
    apk \
        --no-network \
        --repositories-file /dev/null \
        add \
        cache/musl-1.2.5-r12.apk \
        cache/musl-dev-1.2.5-r12.apk; \
    tar -xzf cache/cargo-vendor.tar.gz -C /src
RUN --network=none rustc --edition=2021 /source/scripts/cargo_build_diagnostics.rs -o /usr/local/bin/catchplate-cargo-build
RUN --network=none /usr/local/bin/catchplate-cargo-build --release --frozen \
        --bin catchplate-production-launcher --bin catchplate-native-response-verifier \
        --bin catchplate-native-ingress-verifier --bin catchplate-native-ingress-client \
        --bin catchplate-native-bootstrap-client --bin catchplate-workload-sidecar \
        --bin catchplate-response-v2-guest-inspector \
        --bin catchplate-response-v2-guest-role \
        --bin catchplate-native-shadow-worker \
        --bin catchplate-native-runtime-attestation-verifier \
        --bin catchplate-native-publication-handoff \
        --bin catchplate-policy-shadow-custody-guest \
        --bin catchplate-native-shadow-guest-supervisor \
        --bin catchplate-native-enclave-entrypoint \
        --bin catchplate-native-shadow-proof-cohort \
        --bin catchplate-native-publication-genesis-controller \
        --bin catchplate-native-publication-adoption-validator \
        --bin catchplate-native-shadow-verifier \
        --bin catchplate-native-shadow-verifier-transport \
        --bin catchplate-native-shadow-time-issuer \
        --bin catchplate-native-generation-origin-issuer \
        --bin catchplate-native-setup-hardware --bin catchplate-native-setup-proxy --bin catchplate-native-setup-final \
        --bin catchplate-setup-native-hardware --bin catchplate-setup-native-proxy --bin catchplate-setup-native-final \
        --bin catchplate-native-parent-relay --bin catchplate-native-parent-ingress \
        --bin catchplate-native-activation-relay \
    && test "$(readelf -l /src/target/release/catchplate-native-activation-relay | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-activation-relay | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-activation-relay)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-production-launcher | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-production-launcher | grep -c NEEDED)" -eq 0 \
    && test "$(readelf -l /src/target/release/catchplate-native-response-verifier | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-response-verifier | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-response-verifier)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-ingress-verifier | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-ingress-verifier | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-ingress-verifier)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-ingress-client | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-ingress-client | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-ingress-client)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-bootstrap-client | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-bootstrap-client | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-bootstrap-client)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-workload-sidecar | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-workload-sidecar | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-workload-sidecar)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-parent-relay | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-parent-relay | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-parent-relay)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-parent-ingress | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-parent-ingress | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-parent-ingress)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-response-v2-guest-inspector | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-response-v2-guest-inspector | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-response-v2-guest-inspector)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-response-v2-guest-role | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-response-v2-guest-role | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-response-v2-guest-role)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-worker | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-worker | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-worker)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-runtime-attestation-verifier | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-runtime-attestation-verifier | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-runtime-attestation-verifier)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-publication-handoff | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-publication-handoff | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-publication-handoff)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-verifier | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-verifier | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-verifier)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-verifier-transport | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-verifier-transport | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-verifier-transport)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-policy-shadow-custody-guest | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-policy-shadow-custody-guest | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-policy-shadow-custody-guest)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-guest-supervisor | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-guest-supervisor | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-guest-supervisor)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-proof-cohort | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-proof-cohort | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-proof-cohort)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-publication-genesis-controller | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-publication-genesis-controller | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-publication-genesis-controller)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-publication-adoption-validator | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-publication-adoption-validator | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-publication-adoption-validator)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-shadow-time-issuer | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-shadow-time-issuer | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-shadow-time-issuer)" -le 67108864 \
    && test "$(readelf -l /src/target/release/catchplate-native-generation-origin-issuer | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/catchplate-native-generation-origin-issuer | grep -c NEEDED)" -eq 0 \
    && test "$(stat -c %s /src/target/release/catchplate-native-generation-origin-issuer)" -le 67108864 \
    && for binary in catchplate-native-setup-hardware catchplate-native-setup-proxy catchplate-native-setup-final \
        catchplate-setup-native-hardware catchplate-setup-native-proxy catchplate-setup-native-final; do \
        test "$(readelf -l /src/target/release/$binary | grep -c INTERP)" -eq 0 || exit 1; \
        test "$(readelf -d /src/target/release/$binary | grep -c NEEDED)" -eq 0 || exit 1; \
        test "$(stat -c %s /src/target/release/$binary)" -le 67108864 || exit 1; \
    done

FROM scratch AS production-launcher-artifact
COPY --from=launcher-build /src/target/release/catchplate-production-launcher /catchplate-production-launcher

FROM scratch AS native-response-verifier-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-response-verifier /catchplate-native-response-verifier

FROM scratch AS native-ingress-verifier-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-ingress-verifier /catchplate-native-ingress-verifier

FROM scratch AS native-ingress-client-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-ingress-client /catchplate-native-ingress-client

FROM scratch AS native-bootstrap-client-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-bootstrap-client /catchplate-native-bootstrap-client

# Workload-side installation, separate from the measured claimant closure.
FROM source-preparation AS native-workload-sidecar-runtime
COPY --from=launcher-build /src/target/release/catchplate-workload-sidecar /sidecar-build/catchplate-workload-sidecar
RUN --network=none set -eu; \
    install -d -o 0 -g 0 -m 0755 /sidecar-runtime/usr/local/libexec /sidecar-runtime/usr/share/catchplate; \
    install -o 0 -g 0 -m 0555 /sidecar-build/catchplate-workload-sidecar /sidecar-runtime/usr/local/libexec/catchplate-workload-sidecar; \
    install -o 0 -g 0 -m 0444 /source/scripts/install_workload_sidecar_unit.py /sidecar-runtime/usr/share/catchplate/install_workload_sidecar_unit.py; \
    install -o 0 -g 0 -m 0444 /source/schemas/native-workload-sidecar.v1.schema.json /sidecar-runtime/usr/share/catchplate/native-workload-sidecar.v1.schema.json; \
    chmod 0555 /sidecar-runtime /sidecar-runtime/usr /sidecar-runtime/usr/local \
        /sidecar-runtime/usr/local/libexec /sidecar-runtime/usr/share /sidecar-runtime/usr/share/catchplate; \
    touch -d "@${SOURCE_DATE_EPOCH}" /sidecar-runtime /sidecar-runtime/usr /sidecar-runtime/usr/local \
        /sidecar-runtime/usr/local/libexec /sidecar-runtime/usr/share /sidecar-runtime/usr/share/catchplate \
        /sidecar-runtime/usr/local/libexec/catchplate-workload-sidecar \
        /sidecar-runtime/usr/share/catchplate/install_workload_sidecar_unit.py \
        /sidecar-runtime/usr/share/catchplate/native-workload-sidecar.v1.schema.json

FROM scratch AS native-workload-sidecar-artifact
# Copy the explicit child directory so its 0555 mode and nested modes survive;
# --chmod=0444 on individual files would also make implicit parents unsearchable.
COPY --from=native-workload-sidecar-runtime --chown=0:0 /sidecar-runtime/ /

FROM scratch AS native-parent-relay-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-parent-relay /catchplate-native-parent-relay

FROM scratch AS native-parent-ingress-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-parent-ingress /catchplate-native-parent-ingress

FROM scratch AS guest-inspector-artifact
COPY --from=launcher-build /src/target/release/catchplate-response-v2-guest-inspector /catchplate-response-v2-guest-inspector

FROM scratch AS guest-role-artifact
COPY --from=launcher-build /src/target/release/catchplate-response-v2-guest-role /catchplate-response-v2-guest-role

FROM scratch AS native-shadow-worker-artifact
COPY --from=launcher-build /src/target/release/catchplate-native-shadow-worker /catchplate-native-shadow-worker

FROM scratch AS native-publication-handoff-artifact
COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-publication-handoff /catchplate-native-publication-handoff

FROM scratch AS native-runtime-attestation-verifier-artifact
COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-runtime-attestation-verifier /catchplate-native-runtime-attestation-verifier

FROM scratch AS native-shadow-verifier-supervisor-artifact
