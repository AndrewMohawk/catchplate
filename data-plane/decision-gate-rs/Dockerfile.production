FROM scratch AS rust-production-dependency-cache
COPY data-plane/decision-gate-rs/Cargo.toml /dependency-cache/data-plane/decision-gate-rs/Cargo.toml
COPY data-plane/decision-gate-rs/Cargo.lock /dependency-cache/data-plane/decision-gate-rs/Cargo.lock
COPY production-dependencies/rust-linux-amd64.sha256 /dependency-cache/rust-linux-amd64.sha256
COPY production-dependencies/cache/cargo-vendor.tar.gz /dependency-cache/cache/cargo-vendor.tar.gz
COPY production-dependencies/cache/musl-1.2.5-r12.apk /dependency-cache/cache/musl-1.2.5-r12.apk
COPY production-dependencies/cache/musl-dev-1.2.5-r12.apk /dependency-cache/cache/musl-dev-1.2.5-r12.apk

FROM rust:1.88-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89 AS build

ARG SOURCE_DATE_EPOCH="0"
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_NET_OFFLINE=true \
    RUSTFLAGS="-C link-arg=-Wl,--build-id=none"

WORKDIR /src
COPY --from=rust-production-dependency-cache /dependency-cache /dependency-cache
RUN --network=none set -eu; \
    cd /dependency-cache; \
    sha256sum -c rust-linux-amd64.sha256; \
    tar -xzf cache/cargo-vendor.tar.gz -C /src; \
    mkdir -p /src/.cargo; \
    printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "vendored-sources"' \
        '' \
        '[source.vendored-sources]' \
        'directory = "/src/vendor"' \
        > /src/.cargo/config.toml; \
    cp data-plane/decision-gate-rs/Cargo.toml /src/Cargo.toml; \
    cp data-plane/decision-gate-rs/Cargo.lock /src/Cargo.lock
COPY data-plane/decision-gate-rs/src ./src
COPY data-plane/decision-gate-rs/trust ./trust
COPY schemas /schemas
RUN --network=none cargo build --release --frozen \
    && install -d -m 0710 /runtime-layout/serverware-custody \
    && install -d -m 0700 /runtime-layout/serverware-custody-state \
    && install -d -m 0755 /runtime-layout/serverware-custody-trust \
    && SERVERWARE_CUSTODY_ATTEMPT_LEDGER_DIRECTORY=/runtime-layout/serverware-custody-state \
        /src/target/release/serverware-custody-runtime --initialize-attempt-ledger

FROM rust:1.88-alpine3.22@sha256:64eba3726734dcfe89e0a62a0485007a3ab7c7372ce5b38c621d8812f70215f0 AS launcher-build

ARG SOURCE_DATE_EPOCH="0"
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    CARGO_NET_OFFLINE=true \
    RUSTFLAGS="-C link-arg=-Wl,--build-id=none"

WORKDIR /src
COPY --from=rust-production-dependency-cache /dependency-cache /dependency-cache
RUN --network=none set -eu; \
    cd /dependency-cache; \
    sha256sum -c rust-linux-amd64.sha256; \
    apk \
        --no-network \
        --repositories-file /dev/null \
        add \
        cache/musl-1.2.5-r12.apk \
        cache/musl-dev-1.2.5-r12.apk; \
    tar -xzf cache/cargo-vendor.tar.gz -C /src; \
    mkdir -p /src/.cargo; \
    printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "vendored-sources"' \
        '' \
        '[source.vendored-sources]' \
        'directory = "/src/vendor"' \
        > /src/.cargo/config.toml; \
    cp data-plane/decision-gate-rs/Cargo.toml /src/Cargo.toml; \
    cp data-plane/decision-gate-rs/Cargo.lock /src/Cargo.lock
COPY data-plane/decision-gate-rs/src ./src
COPY data-plane/decision-gate-rs/trust ./trust
COPY schemas /schemas
RUN --network=none cargo build --release --frozen --bin serverware-production-launcher \
    && test "$(readelf -l /src/target/release/serverware-production-launcher | grep -c INTERP)" -eq 0 \
    && test "$(readelf -d /src/target/release/serverware-production-launcher | grep -c NEEDED)" -eq 0

FROM scratch AS production-launcher-artifact
COPY --from=launcher-build /src/target/release/serverware-production-launcher /serverware-production-launcher

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:ce0d66bc0f64aae46e6a03add867b07f42cc7b8799c949c2e898057b7f75a151

ARG SERVERWARE_IMAGE_SOURCE="https://github.com/example/private-deployment"
ARG SERVERWARE_IMAGE_REVISION="unknown"
ARG SERVERWARE_IMAGE_CREATED="unknown"
ARG SERVERWARE_SOURCE_TREE_DIGEST="unknown"
ARG SOURCE_DATE_EPOCH="0"

LABEL org.opencontainers.image.title="Serverware decision gate" \
      org.opencontainers.image.source="${SERVERWARE_IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${SERVERWARE_IMAGE_REVISION}" \
      org.opencontainers.image.created="${SERVERWARE_IMAGE_CREATED}" \
      dev.serverware.source_tree_digest="${SERVERWARE_SOURCE_TREE_DIGEST}"

COPY --from=build /src/target/release/serverware-decision-gate /usr/local/bin/serverware-decision-gate
COPY --from=build /src/target/release/serverware-proof-client /usr/local/bin/serverware-proof-client
COPY --from=build /src/target/release/serverware-custody-runtime /usr/local/bin/serverware-custody-runtime
COPY --from=launcher-build /src/target/release/serverware-production-launcher /usr/local/libexec/serverware-production-launcher
COPY --from=build --chown=65531:65530 --chmod=0710 /runtime-layout/serverware-custody /run/serverware-custody
COPY --from=build --chown=65531:65530 --chmod=0700 /runtime-layout/serverware-custody-state /var/lib/serverware-custody
COPY --from=build --chown=65531:65530 --chmod=0600 /runtime-layout/serverware-custody-state/manifest.json /var/lib/serverware-custody/manifest.json
COPY --from=build --chown=65531:65530 --chmod=0600 /runtime-layout/serverware-custody-state/ledger.lock /var/lib/serverware-custody/ledger.lock
COPY --from=build --chown=65532:65532 --chmod=0755 /runtime-layout/serverware-custody-trust /run/serverware/custody-trust
USER nonroot:nonroot
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/serverware-decision-gate"]
