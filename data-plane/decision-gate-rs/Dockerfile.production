COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-response-v2-guest-role /usr/local/bin/catchplate-response-v2-guest-role
COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-shadow-worker /usr/local/bin/catchplate-native-shadow-worker
