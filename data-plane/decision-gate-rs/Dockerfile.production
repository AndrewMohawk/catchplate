COPY --from=native-shadow-custody-runtime --chown=0:0 --chmod=0444 /shadow-custody-output/native-shadow-custody-runtime.json /native-install/usr/share/catchplate/native-shadow-custody-runtime.json

FROM production-decision-gate AS native-enclave-base
COPY --from=native-broker-runtime --chown=0:0 --chmod=0444 /broker-output/native-broker-runtime.squashfs /opt/catchplate/native-broker-runtime.squashfs
