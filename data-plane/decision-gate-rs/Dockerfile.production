FROM python:3.11-slim-bookworm@sha256:0030323c9ce4d6dfab5f0812577cb0abd13c806f86b3a1f5b5d8f200ebb1421c AS native-python-runtime-build
ARG SOURCE_DATE_EPOCH="0"
ENV SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_INDEX=1
COPY --from=source-preparation /source /source
COPY --from=source-preparation /source-contract /source-contract
COPY --from=rust-production-dependency-cache /dependency-cache /dependency-cache
# Keep liblzo2's real archive /lib directory away from this merged-/usr base's
# /lib symlink and ELF interpreter links. Stage both verified packages separately
# and install only the fixed build-tool files.
RUN --network=none set -eu; \
    cp /source/requirements.lock /dependency-cache/requirements.lock; \
    cp /source/production-dependencies/python-linux-amd64.sha256 /dependency-cache/python-linux-amd64.sha256; \
    cp /source/production-dependencies/native-broker-linux-amd64.sha256 /dependency-cache/native-broker-linux-amd64.sha256; \
    cd /dependency-cache; \
    test "$(grep -Ec '^[0-9a-f]{64}  ' python-linux-amd64.sha256)" -eq 2; \
    test "$(grep -Ec '^[0-9a-f]{64}  ' native-broker-linux-amd64.sha256)" -eq 2; \
    grep -E '^[0-9a-f]{64}  ' python-linux-amd64.sha256 | sha256sum -c -; \
    grep -E '^[0-9a-f]{64}  ' native-broker-linux-amd64.sha256 | sha256sum -c -; \
    test "$(readlink /lib)" = usr/lib; \
    test "$(readlink /lib64)" = usr/lib64; \
    mkdir -m 0755 /native-build-packages /native-build-packages/squashfs /native-build-packages/lzo; \
    dpkg-deb --extract cache/squashfs-tools_4.5.1-1_amd64.deb /native-build-packages/squashfs; \
    dpkg-deb --extract cache/liblzo2-2_2.10-2_amd64.deb /native-build-packages/lzo; \
    test -f /native-build-packages/squashfs/usr/bin/mksquashfs; \
    test ! -L /native-build-packages/squashfs/usr/bin/mksquashfs; \
    test -f /native-build-packages/lzo/lib/x86_64-linux-gnu/liblzo2.so.2.0.0; \
    test ! -L /native-build-packages/lzo/lib/x86_64-linux-gnu/liblzo2.so.2.0.0; \
    test "$(readlink /native-build-packages/lzo/lib/x86_64-linux-gnu/liblzo2.so.2)" = liblzo2.so.2.0.0; \
    test ! -e /usr/bin/mksquashfs; test ! -L /usr/bin/mksquashfs; \
    test ! -e /usr/lib/x86_64-linux-gnu/liblzo2.so.2.0.0; test ! -L /usr/lib/x86_64-linux-gnu/liblzo2.so.2.0.0; \
    test ! -e /usr/lib/x86_64-linux-gnu/liblzo2.so.2; test ! -L /usr/lib/x86_64-linux-gnu/liblzo2.so.2; \
    install -o 0 -g 0 -m 0755 /native-build-packages/squashfs/usr/bin/mksquashfs /usr/bin/mksquashfs; \
    install -o 0 -g 0 -m 0644 /native-build-packages/lzo/lib/x86_64-linux-gnu/liblzo2.so.2.0.0 /usr/lib/x86_64-linux-gnu/liblzo2.so.2.0.0; \
    ln -s liblzo2.so.2.0.0 /usr/lib/x86_64-linux-gnu/liblzo2.so.2; \
    tar -xzf cache/python-wheelhouse-linux-amd64.tar.gz; \
    python -m pip install --no-cache-dir --no-compile --no-index --only-binary=:all: \
        --find-links=/dependency-cache/wheelhouse --require-hashes --target=/deps \
        -r /dependency-cache/requirements.lock

FROM native-python-runtime-build AS native-broker-runtime
