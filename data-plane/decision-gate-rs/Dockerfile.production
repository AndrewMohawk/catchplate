COPY --from=native-role-key-runtime --chown=0:0 --chmod=0444 /role-key-output/native-role-key-provisioner-runtime.json /usr/share/catchplate/native-role-key-provisioner-runtime.json
COPY --from=native-shadow-key-runtime --chown=0:0 --chmod=0444 /shadow-key-output/native-shadow-key-delivery-runtime.squashfs /opt/catchplate/native-shadow-key-delivery-runtime.squashfs
COPY --from=native-shadow-key-runtime --chown=0:0 --chmod=0444 /shadow-key-output/native-shadow-key-delivery-runtime.json /usr/share/catchplate/native-shadow-key-delivery-runtime.json
COPY --from=build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-enclave-entrypoint /usr/local/libexec/catchplate-native-enclave-entrypoint
# Native startup constructs the private broker mount and drops the helper's
# privileges. No root key, credential, provider token or host socket is baked in.
USER 0:0
ENTRYPOINT ["/usr/local/libexec/catchplate-native-enclave-entrypoint"]
CMD []

# Separately approved public delivery trust, packaged before EIF measurement.
# This is not a source-archive input or a runtime N/launch/seed original.
FROM source-preparation AS native-delivery-authority-input
ARG NATIVE_DELIVERY_AUTHORITY_SHA256
COPY production-native-delivery/authority.pem /native-delivery/authority.pem
RUN --network=none set -eu; \
    test "${#NATIVE_DELIVERY_AUTHORITY_SHA256}" -eq 71; \
    case "${NATIVE_DELIVERY_AUTHORITY_SHA256}" in sha256:*) ;; *) exit 1 ;; esac; \
    printf '%s  %s\n' "${NATIVE_DELIVERY_AUTHORITY_SHA256#sha256:}" /native-delivery/authority.pem | sha256sum -c -

FROM native-enclave-base AS native-enclave-delivery
ARG NATIVE_DELIVERY_AUTHORITY_SHA256
ARG NATIVE_DELIVERY_AUTHORITY_SPKI_SHA256
LABEL dev.catchplate.native_delivery_authority_pem_sha256="${NATIVE_DELIVERY_AUTHORITY_SHA256}" \
      dev.catchplate.native_delivery_authority_spki_sha256="${NATIVE_DELIVERY_AUTHORITY_SPKI_SHA256}"
COPY --from=native-delivery-authority-input --chown=0:0 --chmod=0444 /native-delivery/authority.pem /usr/share/catchplate/native-delivery-authority.pem
CMD ["--receive-configuration-v1"]

# Explicit signed v2 rotation delivery. The legacy v1/v24 image stays fixed;
# both inherit the same independently selected public delivery-authority pin.
FROM native-enclave-delivery AS native-enclave-rotation-delivery
CMD ["--receive-rotation-configuration-v2"]

# Explicit outer receiver DATA packaging. No C9 delivery, service assignment,
# key, launch original or journal state is accepted as an image input.
FROM native-python-runtime-build AS native-activation-receiver-configuration
ARG ACTIVATION_RECEIVER_INPUTS_SHA256
ENV ACTIVATION_RECEIVER_INPUTS_SHA256=$ACTIVATION_RECEIVER_INPUTS_SHA256
COPY production-activation-receiver/ /activation-receiver-inputs/
RUN --network=none python -I -B /source/scripts/package_native_activation_receiver.py

# Export includes the fixed guest bootstrap; it does not provision a journal,
# credentials or NSM. The bootstrap creates only the receiver's local pipes.
FROM scratch AS native-activation-receiver-artifact
COPY --from=native-activation-receiver-configuration --chown=0:0 /activation-receiver-root/ /
COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-enclave-entrypoint /usr/local/libexec/catchplate-native-enclave-entrypoint
COPY --from=launcher-build --chown=0:0 --chmod=0555 /src/target/release/catchplate-native-shadow-guest-supervisor /opt/catchplate/catchplate-native-shadow-guest-supervisor
COPY --from=native-shadow-custody-runtime --chown=0:0 --chmod=0444 /shadow-custody-output/native-shadow-custody-runtime.squashfs /opt/catchplate/native-shadow-custody-runtime.squashfs
COPY --from=native-shadow-custody-runtime --chown=0:0 --chmod=0444 /shadow-custody-output/native-shadow-custody-runtime.json /usr/share/catchplate/native-shadow-custody-runtime.json
COPY --from=native-shadow-key-runtime --chown=0:0 --chmod=0444 /shadow-key-output/native-shadow-key-delivery-runtime.squashfs /opt/catchplate/native-shadow-key-delivery-runtime.squashfs
COPY --from=native-shadow-key-runtime --chown=0:0 --chmod=0444 /shadow-key-output/native-shadow-key-delivery-runtime.json /usr/share/catchplate/native-shadow-key-delivery-runtime.json

# Explicit service-enclave image, separate from the decision-gate default.
# Existing NSM, role-owned durable journal and encrypted credential resources
# must be provisioned inside the guest; no placeholder storage is created here.
FROM native-enclave-base AS native-activation-receiver-enclave
COPY --from=native-activation-receiver-artifact --chown=0:0 / /
CMD ["--activation-receiver-v1"]

# Preserve both the named legacy target and the Dockerfile's default target.
FROM native-enclave-base AS native-enclave
