# Rendered only by the installer from validated, distinct DNS hostnames.
# TLS8443 is published as443 only when the operator explicitly selects an address.
# Do not run envsubst: nginx variables below are not environment placeholders.
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null;

events { worker_connections 128; }

stream {
    access_log off;
    error_log /dev/null;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_handshake_timeout 10s;
    ssl_alpn http/1.1;
    proxy_connect_timeout 3s;
    proxy_timeout 10m;
    proxy_half_close on;
    proxy_next_upstream off;
    proxy_protocol off;
    proxy_ssl off;

    # Unknown or absent SNI never reaches either the console or the proxy.
    server {
        listen 8443 ssl default_server;
        ssl_reject_handshake on;
        return "";
    }

    server {
        listen 8443 ssl;
        server_name ${CONSOLE_HOST};
        ssl_certificate /run/serverware/tls.crt;
        ssl_certificate_key /run/serverware/tls.key;
        proxy_pass 127.0.0.1:8080;
    }

    server {
        listen 8443 ssl;
        server_name ${PROXY_HOST};
        ssl_certificate /run/serverware/tls.crt;
        ssl_certificate_key /run/serverware/tls.key;
        # This stream never receives console Basic-auth processing or an admin
        # header. The gate owns CONNECT authentication and its own authorization.
        proxy_pass decision-gate-rs:9090;
    }
}

http {
    access_log off;
    error_log /dev/null;
    server_tokens off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    send_timeout 30s;
    keepalive_timeout 10s;

    # Case-sensitive regexes are intentional: map's literal keys are otherwise
    # case-insensitive. The renderer escapes periods in the validated hostname.
    map $http_origin $console_origin {
        default foreign;
        "" absent;
        ~^https://${CONSOLE_HOST_REGEX}$ same;
    }
    map "$request_method:$console_origin" $console_origin_allowed {
        default 0;
        ~^(GET|HEAD|OPTIONS):(same|absent)$ 1;
        ~^[A-Z]+:same$ 1;
    }
    map $http_host $console_host_allowed {
        default 0;
        ~^${CONSOLE_HOST_REGEX}(:443)?$ 1;
    }

    server {
        listen 127.0.0.1:8080 default_server;
        server_name _;
        return 403;
    }

    server {
        listen 127.0.0.1:8080;
        server_name ${CONSOLE_HOST};
        if ($console_host_allowed = 0) { return 403; }
        if ($console_origin_allowed = 0) { return 403; }
        auth_basic "Serverware console";
        auth_basic_user_file /run/serverware/htpasswd;

        add_header Cache-Control no-store always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;

        location / {
            proxy_http_version 1.1;
            # Allowlist browser headers instead of trusting arbitrary caller
            # identity, forwarded, administrative or data-plane token headers.
            proxy_pass_request_headers off;
            proxy_set_header Host ${CONSOLE_HOST};
            proxy_set_header Connection "";
            proxy_set_header Accept $http_accept;
            proxy_set_header Content-Type $http_content_type;
            proxy_set_header Content-Encoding $http_content_encoding;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Origin $http_origin;
            proxy_set_header X-Serverware-CSRF-Token $http_x_serverware_csrf_token;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host ${CONSOLE_HOST};
            proxy_set_header X-Forwarded-Port 443;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header Forwarded "";
            proxy_set_header Authorization "";
            proxy_set_header Proxy-Authorization "";
            proxy_set_header X-Serverware-Bootstrap-Token "";
            # Only the authenticated content handler can use this private token.
            include /run/serverware/operator-admin-header.conf;
            proxy_request_buffering on;
            proxy_buffering off;
            proxy_cache off;
            proxy_next_upstream off;
            proxy_connect_timeout 3s;
            proxy_send_timeout 30s;
            proxy_read_timeout 60s;
            proxy_pass http://serverware:3000;
        }
    }

    # Container liveness only; not public, and not application/proxy readiness.
    server {
        listen 127.0.0.1:8081;
        server_name localhost;
        location = /edge-healthz {
            limit_except GET { deny all; }
            default_type text/plain;
            return 200 "standalone edge alive; application readiness not asserted\n";
        }
        location / { return 404; }
    }
}
