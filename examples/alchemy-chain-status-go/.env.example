# Public configuration only. Supply the issued Serverware application token
# separately through your environment or CI secret store; never use an Alchemy key.
SERVERWARE_PROXY_URL=https://proxy.example.test:443
SERVERWARE_APP_ID=11111111-1111-4111-8111-111111111111
SERVERWARE_PROXY_TOKEN=
SERVERWARE_CA_FILE=/path/to/serverware-ca.pem
# Optional: additional CA for the outer HTTPS proxy, not the interception CA.
SERVERWARE_PROXY_CA_FILE=
# Exactly eth-mainnet or eth-sepolia, matching the saved permission.
SERVERWARE_ALCHEMY_CHAIN=eth-sepolia
