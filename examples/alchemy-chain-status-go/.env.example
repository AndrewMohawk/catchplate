# Public configuration only. Supply the issued Catchplate application token
# separately through your environment or CI secret store; never use an Alchemy key.
CATCHPLATE_PROXY_URL=https://proxy.example.test:443
CATCHPLATE_APP_ID=11111111-1111-4111-8111-111111111111
CATCHPLATE_PROXY_TOKEN=
CATCHPLATE_CA_FILE=/path/to/catchplate-ca.pem
# Optional: additional CA for the outer HTTPS proxy, not the interception CA.
CATCHPLATE_PROXY_CA_FILE=
# Exactly eth-mainnet or eth-sepolia, matching the saved permission.
CATCHPLATE_ALCHEMY_CHAIN=eth-sepolia
