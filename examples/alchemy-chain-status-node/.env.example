# Documentation only; the launcher does not automatically load dotenv files.
# Never put a real Alchemy key in this example or repository.
CATCHPLATE_PROXY_URL=https://your-proxy.example:443
CATCHPLATE_APP_ID=
# Supply the limited Catchplate application token from your secret store.
CATCHPLATE_PROXY_TOKEN=
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
# Optional additional outer-proxy CA; never the interception CA by default.
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/proxy-edge-ca.pem
# Select the same one-chain permission saved by the operator.
CATCHPLATE_ALCHEMY_CHAIN=eth-mainnet
