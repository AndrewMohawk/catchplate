# Documentation only; the launcher does not automatically load dotenv files.
# Never put a real Alchemy key in this example or repository.
SERVERWARE_PROXY_URL=https://your-proxy.example:443
SERVERWARE_APP_ID=
# Supply the limited Serverware application token from your secret store.
SERVERWARE_PROXY_TOKEN=
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
# Optional additional outer-proxy CA; never the interception CA by default.
# SERVERWARE_PROXY_CA_FILE=/absolute/path/proxy-edge-ca.pem
# Select the same one-chain permission saved by the operator.
SERVERWARE_ALCHEMY_CHAIN=eth-mainnet
