# Public configuration; select the exact chain saved in the permission.
SERVERWARE_ALCHEMY_CHAIN=eth-mainnet
SERVERWARE_PROXY_URL=https://proxy.example.test
SERVERWARE_APP_ID=00000000-0000-4000-8000-000000000000
# Scoped Serverware application token, NOT an Alchemy key. Set privately.
SERVERWARE_PROXY_TOKEN=
# Downloaded public interception CA; absolute path required.
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
# Optional public CA for an HTTPS proxy not trusted by certifi.
# SERVERWARE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
