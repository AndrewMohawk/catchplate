# Public configuration; select the exact chain saved in the permission.
CATCHPLATE_ALCHEMY_CHAIN=eth-mainnet
CATCHPLATE_PROXY_URL=https://proxy.example.test
CATCHPLATE_APP_ID=00000000-0000-4000-8000-000000000000
# Scoped Catchplate application token, NOT an Alchemy key. Set privately.
CATCHPLATE_PROXY_TOKEN=
# Downloaded public interception CA; absolute path required.
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
# Optional public CA for an HTTPS proxy not trusted by certifi.
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
