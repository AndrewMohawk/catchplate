# Public configuration template. Not loaded automatically.
# The application must permit Basic CONNECT authentication.
CATCHPLATE_PROXY_URL=https://catchplate-proxy.example.com:443
CATCHPLATE_APP_ID=REPLACE_WITH_APPLICATION_UUID
CATCHPLATE_PROXY_TOKEN=REPLACE_WITH_APPLICATION_TOKEN_NOT_PROVIDER_TOKEN
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
CATCHPLATE_GITHUB_OWNER=your-owner
CATCHPLATE_GITHUB_REPO=your-repository
# Optional additional CA for the outer HTTPS proxy:
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/outer-proxy-ca.pem
