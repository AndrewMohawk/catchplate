# Public configuration template. Not loaded automatically.
# The application must permit Basic CONNECT authentication.
SERVERWARE_PROXY_URL=https://serverware-proxy.example.com:443
SERVERWARE_APP_ID=REPLACE_WITH_APPLICATION_UUID
SERVERWARE_PROXY_TOKEN=REPLACE_WITH_APPLICATION_TOKEN_NOT_PROVIDER_TOKEN
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
SERVERWARE_GITHUB_OWNER=your-owner
SERVERWARE_GITHUB_REPO=your-repository
# Optional additional CA for the outer HTTPS proxy:
# SERVERWARE_PROXY_CA_FILE=/absolute/path/outer-proxy-ca.pem
