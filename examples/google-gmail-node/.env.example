# Reference only: this program does not load .env files.
# Export the application token privately; never save it in this file.
CATCHPLATE_PROXY_URL=https://your-proxy.example:443
CATCHPLATE_APP_ID=replace-with-your-saved-application-uuid
CATCHPLATE_PROXY_TOKEN=
CATCHPLATE_CA_FILE=/absolute/path/to/catchplate-ca.pem
# Optional CA for a privately signed OUTER proxy certificate:
CATCHPLATE_PROXY_CA_FILE=
# No Google access/refresh token, OAuth client secret, or credentials JSON.
