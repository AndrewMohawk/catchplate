# Reference only: the program does not load this file.
# Export the application token privately; never save it here.
CATCHPLATE_PROXY_URL=https://your-proxy.example:443
CATCHPLATE_APP_ID=replace-with-your-saved-application-uuid
CATCHPLATE_PROXY_TOKEN=
CATCHPLATE_CA_FILE=/absolute/path/to/catchplate-ca.pem
# Optional additional CA for the OUTER proxy certificate; omit if unused.
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/to/proxy-ca.pem
# No Google access token, refresh token, client secret or credentials JSON.
