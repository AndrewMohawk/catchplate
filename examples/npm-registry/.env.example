# Public placeholders only. Never put the real npm provider token in this client.
SERVERWARE_PROXY_URL=https://proxy.example.invalid:443
SERVERWARE_APP_ID=00000000-0000-4000-8000-000000000000
SERVERWARE_PROXY_TOKEN=replace_with_your_serverware_application_token
SERVERWARE_CA_FILE=/absolute/trusted/serverware-interception-ca.pem
# Optional when the outer HTTPS proxy has a private rather than public CA:
# SERVERWARE_PROXY_CA_FILE=/absolute/trusted/proxy-outer-ca.pem
SERVERWARE_NPM_PACKAGE=@your-scope/your-package
# Required by manifest and publish; deliberately one ordinary release version:
SERVERWARE_NPM_VERSION=1.0.0
# Explicit public publish only. Leave these unset for metadata reads:
# SERVERWARE_NPM_TAG=latest
# SERVERWARE_NPM_TARBALL=/absolute/reviewed/package.tgz
# SERVERWARE_NPM_TARBALL_SHA256=replace_with_reviewed_64_character_lowercase_sha256
# SERVERWARE_NPM_PUBLISH_CONFIRM=publish-publicly
