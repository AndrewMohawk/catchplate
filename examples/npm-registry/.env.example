# Public placeholders only. Never put the real npm provider token in this client.
CATCHPLATE_PROXY_URL=https://proxy.example.invalid:443
CATCHPLATE_APP_ID=00000000-0000-4000-8000-000000000000
CATCHPLATE_PROXY_TOKEN=replace_with_your_catchplate_application_token
CATCHPLATE_CA_FILE=/absolute/trusted/catchplate-interception-ca.pem
# Optional when the outer HTTPS proxy has a private rather than public CA:
# CATCHPLATE_PROXY_CA_FILE=/absolute/trusted/proxy-outer-ca.pem
CATCHPLATE_NPM_PACKAGE=@your-scope/your-package
# Required by manifest, publish, install and ci; one ordinary release version:
CATCHPLATE_NPM_VERSION=1.0.0
# Install/ci only. Source is reviewed package.json (+ v3 package-lock.json for ci).
# Output MUST NOT exist and must not be inside the input project; it is retained.
# CATCHPLATE_NPM_PROJECT=/absolute/reviewed/consumer-project
# CATCHPLATE_NPM_OUTPUT=/absolute/new-installed-project
# Explicit public publish only. Leave these unset for metadata reads:
# CATCHPLATE_NPM_TAG=latest
# CATCHPLATE_NPM_TARBALL=/absolute/reviewed/package.tgz
# CATCHPLATE_NPM_TARBALL_SHA256=replace_with_reviewed_64_character_lowercase_sha256
# CATCHPLATE_NPM_PUBLISH_CONFIRM=publish-publicly
