# Reference only; not loaded automatically. Posting integration is not available.
CATCHPLATE_PROXY_URL=https://your-proxy-host:443
CATCHPLATE_APP_ID=replace-with-your-application-uuid
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
CATCHPLATE_X_POST_TEXT=An explicitly reviewed text-only post
# Set only for one intentional invocation; unset afterward:
# CATCHPLATE_X_POST_CONFIRM=post-once
# Optional separate OUTER proxy CA:
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
# Supply CATCHPLATE_PROXY_TOKEN privately. Never supply an X provider token.
