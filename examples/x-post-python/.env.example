# Reference only; not loaded automatically. Posting integration is not available.
SERVERWARE_PROXY_URL=https://your-proxy-host:443
SERVERWARE_APP_ID=replace-with-your-application-uuid
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
SERVERWARE_X_POST_TEXT=An explicitly reviewed text-only post
# Set only for one intentional invocation; unset afterward:
# SERVERWARE_X_POST_CONFIRM=post-once
# Optional separate OUTER proxy CA:
# SERVERWARE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
# Supply SERVERWARE_PROXY_TOKEN privately. Never supply an X provider token.
