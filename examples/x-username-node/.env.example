# Export explicitly; this file is not loaded by the client.
CATCHPLATE_PROXY_URL=https://catchplate-proxy.example.com:443
CATCHPLATE_APP_ID=REPLACE_WITH_APPLICATION_UUID
CATCHPLATE_PROXY_TOKEN=REPLACE_WITH_APPLICATION_TOKEN_NOT_X_TOKEN
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
CATCHPLATE_X_USERNAME=selected_username
# Optional private CA for the outer HTTPS proxy, not the interception CA:
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/outer-proxy-ca.pem
