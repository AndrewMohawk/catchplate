# Export explicitly; this file is not loaded by the client.
SERVERWARE_PROXY_URL=https://serverware-proxy.example.com:443
SERVERWARE_APP_ID=REPLACE_WITH_APPLICATION_UUID
SERVERWARE_PROXY_TOKEN=REPLACE_WITH_APPLICATION_TOKEN_NOT_X_TOKEN
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
SERVERWARE_X_USERNAME=selected_username
# Optional private CA for the outer HTTPS proxy, not the interception CA:
# SERVERWARE_PROXY_CA_FILE=/absolute/path/outer-proxy-ca.pem
