# Public configuration examples only; this file is not loaded automatically.
SERVERWARE_PROXY_URL=https://your-proxy-host:443
SERVERWARE_APP_ID=replace-with-your-application-uuid
SERVERWARE_CA_FILE=/absolute/path/serverware-ca.pem
SERVERWARE_X_USERNAME=example
# Optional private CA for the OUTER proxy TLS connection, not the X connection:
# SERVERWARE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
# Supply SERVERWARE_PROXY_TOKEN from a secret manager or interactive prompt.
# Never provide an X token: the SDK uses serverware-x-placeholder-v1.
