# Public configuration examples only; this file is not loaded automatically.
CATCHPLATE_PROXY_URL=https://your-proxy-host:443
CATCHPLATE_APP_ID=replace-with-your-application-uuid
CATCHPLATE_CA_FILE=/absolute/path/catchplate-ca.pem
CATCHPLATE_X_USERNAME=example
# Optional private CA for the OUTER proxy TLS connection, not the X connection:
# CATCHPLATE_PROXY_CA_FILE=/absolute/path/proxy-ca.pem
# Supply CATCHPLATE_PROXY_TOKEN from a secret manager or interactive prompt.
# Never provide an X token: the SDK uses catchplate-x-placeholder-v1.
