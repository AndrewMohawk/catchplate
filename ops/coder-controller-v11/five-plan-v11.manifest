manifest_version=11
workflow_id=catchplate-coder-five-plan-v11
source_mode=snapshot-read-only
artifact_mode=controller-cas
docker_authority=controller-disposable-dind-only
build_egress=allowlisted
no_build_egress=controller-proxy-and-service-networks-only
stage.0.operation=build
stage.0.plan=catchplate-build-v1
stage.0.make_target=coder-controller-build-execute
stage.0.build_allowed=true
stage.1.operation=runNoBuild
stage.1.plan=catchplate-unit-no-build-v1
stage.1.make_target=coder-controller-unit-execute
stage.1.build_allowed=false
stage.2.operation=runNoBuild
stage.2.plan=catchplate-integration-no-build-v1
stage.2.make_target=coder-controller-integration-execute
stage.2.build_allowed=false
stage.3.operation=runNoBuild
stage.3.plan=catchplate-e2e-no-build-v1
stage.3.make_target=coder-controller-e2e-execute
stage.3.build_allowed=false
stage.4.operation=runNoBuild
stage.4.plan=catchplate-attestation-no-build-v1
stage.4.make_target=coder-controller-attestation-execute
stage.4.build_allowed=false
post_seal.denied_operation.0=build
post_seal.denied_operation.1=pull
post_seal.denied_operation.2=import
post_seal.denied_operation.3=tag
post_seal.denied_operation.4=privileged
post_seal.denied_operation.5=host_mount
mutation_identity_check=after-every-mutation
