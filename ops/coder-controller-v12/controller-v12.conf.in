contract_version=12
request_contract_version=11
receipt_contract_version=12
trust_profile=trusted-host-userspace-digest-no-ima
workflow_id=catchplate-coder-five-lane-v12
deadline_profile_id=catchplate-coder-five-lane-v12
socket_path=/run/catchplate/coder/v12/controller/control.sock
socket_group=@CLIENT_GROUP@
socket_mode=0660
state_root=/var/lib/catchplate/coder-controller-v12/controller
ledger_socket=/run/catchplate/coder/v12/receipt-authority/control.sock
final_verdict_socket=/run/catchplate/coder/v12/final-verdict-authority/control.sock
executor_socket=/run/catchplate/coder/v12/plan-executor/control.sock
lane_proxy_socket=/run/catchplate/coder/v12/docker-proxy/control.sock
lifecycle_socket=/run/catchplate/coder/v12/lifecycle/control.sock
trust_generation_socket=/run/catchplate/coder/v12/trust-generation/control.sock
external_witness_socket=/run/catchplate/coder/v12/external-witness/control.sock
final_settlement_socket=/run/catchplate/coder/v12/final-settlement/control.sock
source_cas_root=/var/lib/catchplate/coder-controller-v12/cas/source
artifact_cas_root=/var/lib/catchplate/coder-controller-v12/cas/artifact
oci_cas_root=/var/lib/catchplate/coder-controller-v12/cas/oci
source_ingress_descriptor=@RELEASE_ROOT@/source/source-ingress-v12.manifest
source_ingress_signature=@RELEASE_ROOT@/source/source-ingress-v12.manifest.sig
canonical_source_bundle=@RELEASE_ROOT@/source/canonical-source.bundle
native_snapshot_publication=@RELEASE_ROOT@/source/native-snapshot-publication-v12.manifest
native_snapshot_publication_signature=@RELEASE_ROOT@/source/native-snapshot-publication-v12.manifest.sig
native_point_snapshot=@RELEASE_ROOT@/source/native-point-snapshot.tar
executor_invocation_inputs=@RELEASE_ROOT@/config/executor-invocation-inputs-v12.json
source_input_root=@RELEASE_ROOT@/source/input
request_schema=@RELEASE_ROOT@/schemas/coder-test-controller-request.v1.schema.json
receipt_schema=@RELEASE_ROOT@/schemas/coder-test-controller-receipt.v12.schema.json
workflow_manifest=@RELEASE_ROOT@/config/five-lane-v12.manifest
deadline_profile=@RELEASE_ROOT@/policy/lane-deadlines-v12.manifest
deadline_profile_signature=@RELEASE_ROOT@/policy/lane-deadlines-v12.manifest.sig
release_manifest=@RELEASE_ROOT@/manifest/installed-release-v12.manifest
release_manifest_signature=@RELEASE_ROOT@/manifest/installed-release-v12.manifest.sig
release_manifest_public_key=@RELEASE_ROOT@/trust/release-bundle-signer-public-key.pem
configuration_authority_public_key=@RELEASE_ROOT@/trust/configuration-authority-public-key.pem
source_ingress_authority_public_key=@RELEASE_ROOT@/trust/source-ingress-authority-public-key.pem
configuration_generation=@RELEASE_ROOT@/authorization/config-generation-v12.manifest
configuration_generation_signature=@RELEASE_ROOT@/authorization/config-generation-v12.manifest.sig
key_authorization=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest
key_authorization_signature=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest.sig
revocation_checkpoint=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest
revocation_checkpoint_signature=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest.sig
requester_public_key=@RELEASE_ROOT@/trust/requester-public-key.ed25519
receipt_authority_public_key=@RELEASE_ROOT@/trust/receipt-authority-public-key.pem
final_verdict_public_key=@RELEASE_ROOT@/trust/final-verdict-authority-public-key.pem
external_witness_public_key=@RELEASE_ROOT@/trust/external-witness-public-key.ed25519
readiness_fixture_public_key=@RELEASE_ROOT@/trust/readiness-fixture-public-key.pem
controller_identity_public_key=@RELEASE_ROOT@/trust/controller-identity-public-key.pem
private_key_credential=controller-identity-key
max_connections=32
first_frame_timeout_ms=5000
ledger_operation_timeout_ms=5000
cleanup_reserve_ms=@CLEANUP_RESERVE_MS@
receipt_replay=exact_canonical_bytes
receipt_state_machine=PREPARED,AUTHENTICATED,LOGGED,FINALIZED
receipt_sequence_highwater_required=true
receipt_checkpoint_consistency_required=true
external_witness_checkpoint_required=true
allow_ima_claim=false
allow_tee_claim=false
hardware_proof=false
