document_version=12
binding_id=catchplate-coder-docker-artifacts-v12
docker_api_request_schema_version=12
docker_lane_capability_schema_version=12
docker_network_membership_schema_version=12
docker_service_instance_schema_version=12
docker_runner_execution_schema_version=12
docker_api_request_schema_sha256=@DOCKER_API_REQUEST_SCHEMA_SHA256@
docker_lane_capability_schema_sha256=@DOCKER_LANE_CAPABILITY_SCHEMA_SHA256@
docker_network_membership_schema_sha256=@DOCKER_NETWORK_MEMBERSHIP_SCHEMA_SHA256@
docker_service_instance_schema_sha256=@DOCKER_SERVICE_INSTANCE_SCHEMA_SHA256@
docker_runner_execution_schema_sha256=@DOCKER_RUNNER_EXECUTION_SCHEMA_SHA256@
pinned_pull_set_sha256=@PINNED_PULL_SET_SHA256@
exact_build_tuple_set_sha256=@EXACT_BUILD_TUPLE_SET_SHA256@
docker_api_rule_set_sha256=@DOCKER_API_RULE_SET_SHA256@
runner_oci_archive_sha256=@RUNNER_OCI_ARCHIVE_SHA256@
runner_oci_digest_file_sha256=@RUNNER_OCI_DIGEST_FILE_SHA256@
browser_oci_archive_sha256=@BROWSER_OCI_ARCHIVE_SHA256@
browser_oci_digest_file_sha256=@BROWSER_OCI_DIGEST_FILE_SHA256@
buildkit_oci_archive_sha256=@BUILDKIT_OCI_ARCHIVE_SHA256@
buildkit_oci_digest_file_sha256=@BUILDKIT_OCI_DIGEST_FILE_SHA256@
integrity_mode=UserspaceDigestOnly
fs_verity_adapter=optional-unclaimed
private_dind_lifecycle_contract=catchplate/private-dind-lifecycle/v12
lane_proxy_contract=catchplate/controller-lane-proxy/v12
host_docker_socket_exposed=false
global_docker_daemon_allowed=false
legacy_v11_lease_allowed=false
docker_archive_format=catchplate/docker-image-archive-set/v12
docker_archive_outer_container=canonical-ustar-v12
docker_archive_member_order=utf8-path-byte-order
docker_archive_member_metadata=uid-0,gid-0,mtime-0,file-0644,directory-0755
docker_archive_canonical_json=manifest.json,repositories
docker_archive_preserved_content=image-config-json,layer-tar-bytes
docker_archive_unsupported_members=deny
docker_archive_import_verification=recanonicalize-and-require-byte-identity
docker_archive_producer=data-plane/decision-gate-rs/src/dind_lifecycle.rs:canonicalize_docker_image_archive_v12
build_oci_handoff=canonical-owner-labelled-export-to-controller-cas
no_build_oci_handoff=fresh-private-daemon-exact-canonical-cas-import
