contract=catchplate/controller-lane-capability/v12
request_contract=catchplate/controller-lane-proxy/v12
default=deny
enforcement=compiled-rust-source-digest-bound-v12
bind_fields=laneId,daemonGeneration,sourceSeal,artifactSeal,ociSeal,operationProfile,ownerNamespace,sequence,deadlineBoottimeNs,method,normalizedPath,normalizedQuery,bodySha256,targetId,expectedState,streamMode,maxRequestBytes,maxResponseBytes,maxDurationMs
ruleset_path=@RELEASE_ROOT@/policy/docker-api-rules.v12.json
ruleset_sha256=@DOCKER_API_RULE_SET_SHA256@
pinned_pull_set_path=@RELEASE_ROOT@/policy/pinned-pulls.v12.json
pinned_pull_set_sha256=@PINNED_PULL_SET_SHA256@
exact_build_tuple_set_path=@RELEASE_ROOT@/policy/exact-build-tuples.v12.json
exact_build_tuple_set_sha256=@EXACT_BUILD_TUPLE_SET_SHA256@
capability_issuer=catchplate-coder-plan-executor-v12
executor_authority=exact-signed-capability
body_authority=none
body_socket_projection=none
repository_body_host_socket_projection=none
host_docker_socket=forbidden
global_docker_daemon=forbidden
legacy_v11_lease=forbidden
daemon_scope=one-fresh-private-dind-per-lane
daemon_owner=catchplate-coder-lifecycle-privileged-v12
daemon_listener_delivery=scm-rights-capability-fd-only
proxy_transport=full-duplex-half-close-preserving
ownership_authority=root-ledger-and-exact-labels
ownership_label.namespace=com.catchplate.coder.v12.owner
ownership_label.generation=com.catchplate.coder.v12.generation
ownership_label.lane=com.catchplate.coder.v12.lane
ownership_label.resource=com.catchplate.coder.v12.resource
uncertain_response=query-ledger-then-reconcile-or-destroy
terminal_destruction_receipt=required-signed-v12

profile.build.allow_pinned_pull=true
profile.build.allow_exact_build_tuple=true
profile.build.allow_owner_resource_create=true
profile.build.allow_owner_resource_start=true
profile.build.allow_owner_resource_inspect=true
profile.build.allow_owner_resource_logs=true
profile.build.allow_owner_resource_stop=true
profile.build.allow_owner_resource_remove=true
profile.build.allow_expected_oci_export=true
profile.build.allow_push=false
profile.build.allow_tag=false
profile.build.allow_commit=false
profile.build.allow_prune=false
profile.build.allow_privileged=false
profile.build.allow_host_bind=false
profile.build.allow_host_namespace=false
profile.build.allow_device=false
profile.build.allow_cap_add=false
profile.build.pull_reference=@PINNED_PULL_SET_SHA256@
profile.build.build_tuple=@EXACT_BUILD_TUPLE_SET_SHA256@
profile.build.allowed_operations=pinned-pull,exact-build,owner-create,owner-start,owner-inspect,owner-logs,owner-stop,owner-remove,expected-oci-export
profile.build.oci_export=exact-owner-labelled-images-to-controller-oci-cas
profile.build.daemon_reuse=false

profile.no-build.allow_private_oci_import=true
profile.no-build.allow_owner_resource_create=true
profile.no-build.allow_owner_resource_start=true
profile.no-build.allow_owner_resource_inspect=true
profile.no-build.allow_owner_resource_logs=true
profile.no-build.allow_owner_resource_stop=true
profile.no-build.allow_owner_resource_remove=true
profile.no-build.allow_build=false
profile.no-build.allow_pull=false
profile.no-build.allow_load=false
profile.no-build.allow_external_import=false
profile.no-build.allow_tag=false
profile.no-build.allow_push=false
profile.no-build.allow_commit=false
profile.no-build.allow_prune=false
profile.no-build.allow_arbitrary_exec=false
profile.no-build.allow_archive_write=false
profile.no-build.allow_unowned_read=false
profile.no-build.body_service_endpoint_access=true
profile.no-build.body_docker_api_access=false
profile.no-build.allowed_operations=verified-cas-import,owner-create,owner-start,owner-inspect,owner-logs,owner-stop,owner-remove
profile.no-build.import_source=controller-oci-cas-exact-digest-only
profile.no-build.daemon_fresh=true
profile.no-build.daemon_reuse=false

transition.create=Declared,Creating,Created
transition.start=Created,Running
transition.wait=Running,Exited
transition.remove=Created|Exited,Removing,Removed
transition.unknown=*,OutcomeUnknown
transition.failure=*,Destroying
transition.reconcile=OutcomeUnknown,Querying,Reconciled|Destroying
transition.terminal=Destroying,Destroyed,SignedDestructionReceipt
