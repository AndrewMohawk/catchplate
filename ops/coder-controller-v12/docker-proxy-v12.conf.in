contract_version=12
socket_activation=systemd-listen-fds
socket_path=/run/catchplate/coder/v12/docker-proxy/control.sock
socket_group=@EXECUTOR_GROUP@
socket_mode=0660
socket_gid=@DOCKER_API_GID@
authorized_controller_uid=@CONTROLLER_UID@
authorized_executor_uid=@EXECUTOR_UID@
executor_uid=@EXECUTOR_UID@
state_root=/var/lib/catchplate/coder-controller-v12/docker-proxy
lifecycle_socket=/run/catchplate/coder/v12/lifecycle/control.sock
release_manifest=@RELEASE_ROOT@/manifest/installed-release-v12.manifest
release_manifest_signature=@RELEASE_ROOT@/manifest/installed-release-v12.manifest.sig
release_manifest_public_key=@RELEASE_ROOT@/trust/release-bundle-signer-public-key.pem
docker_policy=@RELEASE_ROOT@/config/docker-lane-policy-v12.conf
configuration_authority_public_key=@RELEASE_ROOT@/trust/configuration-authority-public-key.pem
configuration_generation=@RELEASE_ROOT@/authorization/config-generation-v12.manifest
configuration_generation_signature=@RELEASE_ROOT@/authorization/config-generation-v12.manifest.sig
key_authorization=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest
key_authorization_signature=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest.sig
revocation_checkpoint=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest
revocation_checkpoint_signature=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest.sig
request_contract=catchplate/controller-lane-proxy/v12
response_contract=catchplate/controller-lane-proxy/v12
capability_transport=controller-connected-scm-rights-fd
authority_transport=lifecycle-delegated-scm-rights-fds
root_lifecycle_ownership=exclusive
proxy_privilege=unprivileged
body_subject_authority=none
unknown_route=deny
unknown_method=deny
unknown_query=deny
unknown_body_field=deny
unknown_target=deny
unknown_transition=deny
uncertain_outcome=query-privileged-ledger-or-destroy
stream_transport=seqpacket-scm-rights
ownership_labels_are_advisory=false
privileged_ledger_is_authority=true
destroy_on_any_failure=true
host_docker_socket_exposed=false
global_docker_daemon_allowed=false
legacy_v11_lease_allowed=false
lane_daemon_scope=fresh-private-per-lane
daemon_transport=delegated-connected-fd-only
listener_transport=delegated-capability-scoped-fd-only
full_duplex_transport=true
preserve_half_close=true
ownership_label.namespace=com.catchplate.coder.v12.owner
ownership_label.generation=com.catchplate.coder.v12.generation
ownership_label.lane=com.catchplate.coder.v12.lane
ownership_label.resource=com.catchplate.coder.v12.resource
build_operation_profile=exact-build-only
no_build_import_profile=fresh-daemon-exact-controller-cas-digest-only
terminal_destruction_receipt=required-signed-v12
