manifest_version=12
workflow_id=serverware-coder-five-lane-v12
request_contract_version=12
receipt_contract_version=12
source_mode=controller-cas-point-snapshot
source_ingress_descriptor=@RELEASE_ROOT@/source/source-ingress-v12.manifest
source_publication_modes=canonical-bundle,native-point-snapshot
artifact_mode=controller-cas
oci_mode=controller-cas
host_docker_socket_exposed=false
failure_transition=Destroying
lane_count=5
deadline_profile_id=serverware-coder-five-lane-v12
deadline_profile=@RELEASE_ROOT@/policy/lane-deadlines-v12.manifest
cleanup_reserve_ms=@CLEANUP_RESERVE_MS@

lane.0.id=build
lane.0.sequence=0
lane.0.deadline_ms=@BUILD_DEADLINE_MS@
lane.0.operation=build
lane.0.phase_target=coder-controller-v12-build-phase
lane.0.build_allowed=true
lane.0.private_dind=true
lane.0.executor_docker_authority=private-build-dind
lane.0.body_docker_authority=sealed-capability-only
lane.0.body_docker_socket_projection=none
lane.0.source_access=immutable-cas-read-only
lane.0.artifact_access=controller-staging-write
lane.0.network_profile=pinned-pulls-only

lane.1.id=unit
lane.1.sequence=1
lane.1.deadline_ms=@UNIT_DEADLINE_MS@
lane.1.operation=runNoBuild
lane.1.phase_target=coder-controller-v12-unit-phase
lane.1.build_allowed=false
lane.1.private_dind=false
lane.1.executor_docker_authority=none
lane.1.body_docker_authority=none
lane.1.body_docker_socket_projection=none
lane.1.source_access=immutable-cas-read-only
lane.1.artifact_access=sealed-read-only
lane.1.network_profile=none

lane.2.id=integration
lane.2.sequence=2
lane.2.deadline_ms=@INTEGRATION_DEADLINE_MS@
lane.2.operation=runNoBuild
lane.2.phase_target=coder-controller-v12-integration-phase
lane.2.build_allowed=false
lane.2.private_dind=true
lane.2.executor_docker_authority=private-no-build-dind
lane.2.body_docker_authority=none
lane.2.body_docker_socket_projection=none
lane.2.body_access=service-endpoints-only
lane.2.source_access=immutable-cas-read-only
lane.2.artifact_access=sealed-read-only
lane.2.network_profile=private-services

lane.3.id=e2e
lane.3.sequence=3
lane.3.deadline_ms=@E2E_DEADLINE_MS@
lane.3.operation=runNoBuild
lane.3.phase_target=coder-controller-v12-e2e-phase
lane.3.build_allowed=false
lane.3.private_dind=true
lane.3.executor_docker_authority=private-no-build-dind
lane.3.body_docker_authority=none
lane.3.body_docker_socket_projection=none
lane.3.body_access=service-endpoints-only
lane.3.source_access=immutable-cas-read-only
lane.3.artifact_access=sealed-read-only
lane.3.network_profile=private-services-and-browser

lane.4.id=attestation
lane.4.sequence=4
lane.4.deadline_ms=@ATTESTATION_DEADLINE_MS@
lane.4.operation=runNoBuild
lane.4.phase_target=coder-controller-v12-attestation-phase
lane.4.build_allowed=false
lane.4.private_dind=false
lane.4.executor_docker_authority=none
lane.4.body_docker_authority=none
lane.4.body_docker_socket_projection=none
lane.4.source_access=immutable-cas-read-only
lane.4.artifact_access=sealed-read-only
lane.4.network_profile=external-witness-only

post_build.export=owner-labelled-images-to-oci-cas
post_build.destroy=build-dind
post_build.verify=source-artifact-oci-manifest
post_build.no_build_dind=fresh-private-import-only
post_build.import_source=controller-oci-cas-exact-digest-only
private_dind.lifecycle_contract=serverware/private-dind-lifecycle/v12
private_dind.root_owned_resources=dockerd,netns,nftables,mounts,cgroups,ownership-ledger
private_dind.startup_destroy_nonterminal=true
private_dind.terminal_destruction_receipt=required-signed-v12
readiness_fixture_manifest=@RELEASE_ROOT@/fixtures/readiness-fixtures-v12.manifest
docker_proxy_contract=serverware/controller-lane-proxy/v12
