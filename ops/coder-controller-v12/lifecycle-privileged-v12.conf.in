contract_version=12
mode=privileged-helper-v12
socket_activation=systemd-listen-fds
socket_path=/run/serverware/coder/v12/lifecycle-privileged/control.sock
authorized_peer_uid=@LIFECYCLE_UID@
authorized_peer_gid=@LIFECYCLE_GID@
executor_uid=@EXECUTOR_UID@
docker_proxy_uid=@DOCKER_PROXY_UID@
request_contract=ServerwarePrivilegedLifecycleRequestV12
response_contract=ServerwarePrivilegedLifecycleResponseV12
accepted_operations=admin-create-private-dind-v12,admin-destroy-private-dind-v12,admin-reconcile-private-dind-v12
operation_capability_public_key=@RELEASE_ROOT@/trust/lifecycle-authority-public-key.pem
release_manifest=@RELEASE_ROOT@/manifest/installed-release-v12.manifest
release_manifest_signature=@RELEASE_ROOT@/manifest/installed-release-v12.manifest.sig
release_manifest_public_key=@RELEASE_ROOT@/trust/release-bundle-signer-public-key.pem
docker_policy=@RELEASE_ROOT@/config/docker-lane-policy-v12.conf
configuration_authority_public_key=@RELEASE_ROOT@/trust/configuration-authority-public-key.pem
configuration_generation=@RELEASE_ROOT@/authorization/config-generation-v12.manifest
configuration_generation_signature=@RELEASE_ROOT@/authorization/config-generation-v12.manifest.sig
key_authorization=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest
key_authorization_signature=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest.sig
revocation_checkpoint=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest
revocation_checkpoint_signature=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest.sig
state_root=/var/lib/serverware/coder-controller-v12/lifecycle-privileged
ownership_ledger=/var/lib/serverware/coder-controller-v12/lifecycle-privileged/ownership-ledger
terminal_destruction_receipt_root=/var/lib/serverware/coder-controller-v12/lifecycle-privileged/terminal-destruction-receipts
ownership_label.namespace=com.serverware.coder.v12.owner
ownership_label.generation=com.serverware.coder.v12.generation
ownership_label.lane=com.serverware.coder.v12.lane
ownership_label.resource=com.serverware.coder.v12.resource
ownership_label.required=true
dind_root=/var/lib/serverware/coder-controller-v12/dind
cgroup_root=/sys/fs/cgroup/system.slice/serverware-coder-lifecycle-privileged-v12.service
private_socket_root=/run/serverware/coder/v12/dind
private_mount_root=/var/lib/serverware/coder-controller-v12/dind
lane_state_pattern=/var/lib/serverware/coder-controller-v12/dind/{owner-namespace}/{generation}
daemon_data_root_pattern=/var/lib/serverware/coder-controller-v12/dind/{owner-namespace}/{generation}/data
containerd_root_pattern=/var/lib/serverware/coder-controller-v12/dind/{owner-namespace}/{generation}/exec
daemon_socket_pattern=/run/serverware/coder/v12/dind/{generation}.sock
netns_root=/run/netns
netns_prefix=serverware-coder-v12-
host_veth_prefix=swv12h
network_identity_allocator=root-locked-generation-allocation-v12
network_subnet_cidr=10.64.0.0/10
network_subnet_prefix_length=30
network_subnet_probe_bound=4096
network_hook=@RELEASE_ROOT@/hooks/network-lifecycle-v12.sh
dind_hook=@RELEASE_ROOT@/hooks/dind-lifecycle-v12.sh
dockerd_binary=@RELEASE_ROOT@/bin/dockerd-v12
containerd_binary=@RELEASE_ROOT@/bin/containerd-v12
containerd_shim_binary=@RELEASE_ROOT@/bin/containerd-shim-runc-v2-v12
runc_binary=@RELEASE_ROOT@/bin/runc-v12
readiness_trust_config=@RELEASE_ROOT@/config/plan-executor-v12.conf
readiness_fixture_public_key=@RELEASE_ROOT@/trust/readiness-fixture-public-key.pem
readiness_fixture_manifest=@RELEASE_ROOT@/fixtures/readiness-fixtures-v12.manifest
readiness_fixture_manifest_signature=@RELEASE_ROOT@/fixtures/readiness-fixtures-v12.manifest.sig
readiness_fixture_root=@RELEASE_ROOT@/fixtures
readiness_docker_client_stream=@RELEASE_ROOT@/fixtures/docker-101.fixture
readiness_docker_server_stream=@RELEASE_ROOT@/fixtures/docker-half-close.fixture
readiness_service_image_archive=@RELEASE_ROOT@/runner/runner.oci.tar
readiness_service_probe=@RELEASE_ROOT@/fixtures/service-health.fixture
readiness_browser_image_archive=@RELEASE_ROOT@/runner/browser.oci.tar
readiness_chromium_page=@RELEASE_ROOT@/fixtures/chromium-page.html
readiness_chromium_script=@RELEASE_ROOT@/fixtures/chromium-script.js
readiness_chromium_probe=@RELEASE_ROOT@/fixtures/chromium-probe.fixture
readiness_chromium_expected_cdp=@RELEASE_ROOT@/fixtures/chromium-expected-cdp.json
readiness_chromium_expected_dom=@RELEASE_ROOT@/fixtures/chromium-expected-dom.txt
readiness_chromium_expected_js=@RELEASE_ROOT@/fixtures/chromium-expected-js.txt
readiness_chromium_expected_fetch=@RELEASE_ROOT@/fixtures/chromium-expected-fetch.txt
readiness_teardown_fixture=@RELEASE_ROOT@/fixtures/teardown.fixture
readiness_probe_order=docker-upgrade,service-health,chromium,teardown
readiness_before_repository_work_every_invocation=true
docker_top_level_object_count_scope=private-daemon-top-level-api:containers,images,nondefault-networks,volumes
docker_internal_storage_absence_proof=generation-state-root-absent;internal-layers-snapshots-build-cache-not-individually-counted
network_contract=@RELEASE_ROOT@/network/network-contract-v12.manifest
network_contract_signature=@RELEASE_ROOT@/network/network-contract-v12.manifest.sig
host_ruleset=@RELEASE_ROOT@/network/host.nft
host_cleanup_ruleset=@RELEASE_ROOT@/network/host-cleanup.nft
build_lane_ruleset=@RELEASE_ROOT@/network/build-lane.nft
no_build_lane_ruleset=@RELEASE_ROOT@/network/no-build-lane.nft
lane_cleanup_ruleset=@RELEASE_ROOT@/network/lane-cleanup.nft
command.admin_create_private_dind=admin-create-private-dind-v12
command.admin_destroy_private_dind=admin-destroy-private-dind-v12
command.admin_reconcile_private_dind=admin-reconcile-private-dind-v12
root_owned_resources=dockerd,containerd,netns,nftables,mounts,cgroups,private-sockets,ownership-ledger
capability_fd_delivery=scm-rights-only
daemon_listener_fd_delivery=scm-rights-only
unprivileged_path_access=capability-scoped-proxy-and-listener-fds-only
host_docker_socket=forbidden
global_docker_daemon=forbidden
legacy_v11_lease=forbidden
exact_lane_slots=0,1,2,3,4
build_lane_slot=0
build_egress=pinned-pulls-only
no_build_egress=none
build_allowed_operations=pinned-pull,exact-build,owner-create,owner-start,owner-inspect,owner-logs,owner-stop,owner-remove,expected-oci-export
build_oci_export=exact-owner-labelled-images-to-controller-oci-cas
no_build_allowed_operations=verified-cas-import,owner-create,owner-start,owner-inspect,owner-logs,owner-stop,owner-remove
no_build_oci_import=fresh-private-daemon-exact-controller-cas-digest-only
daemon_reuse=false
startup_operation=setup-host
startup_reconcile_owned_resources=true
startup_reconcile_operation=admin-reconcile-private-dind-v12
startup_reconcile_scope=destroy-all-nonterminal-lanes
shutdown_operation=cleanup-host
shutdown_destroy_all_owned_resources=true
shutdown_reconcile_operation=admin-reconcile-private-dind-v12
shutdown_reconcile_scope=destroy-all-owned-lanes
destroy_on_any_failure=true
uncertain_response=query-authoritative-ledger-then-reconcile-or-destroy
uncertain_response_query_keys=generation,lane,request-digest,operation,target-id
terminal_destruction_receipt=required-signed-v12
cleanup_deadline_ms=@CLEANUP_RESERVE_MS@
private_key_credential=lifecycle-privileged-authority-key
