contract_version=12
mode=unprivileged-coordinator-v12
socket_activation=systemd-listen-fds
socket_path=/run/catchplate/coder/v12/lifecycle/control.sock
socket_group=@LIFECYCLE_GROUP@
socket_mode=0660
executor_uid=@EXECUTOR_UID@
docker_proxy_uid=@DOCKER_PROXY_UID@
state_root=/var/lib/catchplate/coder-controller-v12/lifecycle
ownership_ledger=/var/lib/catchplate/coder-controller-v12/lifecycle/ownership-ledger
privileged_lifecycle_socket=/run/catchplate/coder/v12/lifecycle-privileged/control.sock
privileged_request_contract=CatchplatePrivilegedLifecycleRequestV12
privileged_response_contract=CatchplatePrivilegedLifecycleResponseV12
release_manifest=@RELEASE_ROOT@/manifest/installed-release-v12.manifest
release_manifest_signature=@RELEASE_ROOT@/manifest/installed-release-v12.manifest.sig
release_manifest_public_key=@RELEASE_ROOT@/trust/release-bundle-signer-public-key.pem
configuration_authority_public_key=@RELEASE_ROOT@/trust/configuration-authority-public-key.pem
configuration_generation=@RELEASE_ROOT@/authorization/config-generation-v12.manifest
configuration_generation_signature=@RELEASE_ROOT@/authorization/config-generation-v12.manifest.sig
key_authorization=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest
key_authorization_signature=@RELEASE_ROOT@/authorization/key-authorization-v12.manifest.sig
revocation_checkpoint=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest
revocation_checkpoint_signature=@RELEASE_ROOT@/authorization/revocation-checkpoint-v12.manifest.sig
cleanup_deadline_ms=@CLEANUP_RESERVE_MS@
helper_kill_after_ms=5000
startup_reconcile=true
destroy_nonterminal_lanes=true
failure_transition=Destroying
cgroup_kill_required=true
pidfd_reap_required=true
remove_owned_netns=true
remove_owned_nftables=true
remove_owned_mounts=true
remove_owned_sockets=true
root_owned_resources=dockerd,netns,nftables,mounts,cgroups,ownership-ledger
capability_fd_delivery=scm-rights-only
terminal_destruction_receipt=required-signed-v12
private_key_credential=lifecycle-authority-key
