[Unit]
Description=Independent Catchplate native Setup hardware-verifier one-shot
ConditionPathExists=/etc/catchplate/setup-native-hardware-verifier-launch.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/catchplate-setup-native-hardware
Restart=no
TimeoutStartSec=35s
KillMode=control-group
KillSignal=SIGKILL
SendSIGKILL=yes
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=null

# No Install section: every attempt is independently authorized and manually
# started after its ORIGINAL <=30s boot-bound configuration is provisioned.
# Never enable/restart this unit on failure or treat inactive as issuance proof.
