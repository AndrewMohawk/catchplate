# Copy to ops/production-readiness.env on the production Linux host and replace
# every placeholder. scripts/run_production_readiness.py rejects placeholder
# values and does not print env values in dry-run output.
#
# Native launch and host preflight are trusted-host readiness only. A root-owned
# launcher supplies these two inputs plus a sealed bootstrap-receipt memfd
# separately to the runner and preflight:
#   CATCHPLATE_LAUNCHER_TRUSTED_PRODUCTION_ENV_PATH=/etc/catchplate/production-readiness.env
#   CATCHPLATE_LAUNCHER_TRUSTED_PRODUCTION_ENV_SHA256=sha256:<independently-approved-env-digest>
# Do not add those assignments to this env: readiness rejects self-authorizing
# launcher inputs. Install the exact env at the absolute trusted path as a
# root/current-owned regular non-symlink file with mode 0400 or 0600, beneath
# non-symlink ancestors that are not writable by group/other. The static launcher
# opens measured host inputs and passes catchplate.bootstrapReceipt/v3 on exact
# descriptor 198. That receipt carries catchplate.launchAuthorization/v2 plus the
# nonce and launch-witness rollback bindings into completionProof/v6 readiness.
# It is non-authoritative host context under trusted-host-wall-clock, not final
# TEE authority. Independent final verification is outside this env and emits
# catchplate.releaseCompletionVerification/v1. Its result core must carry a
# catchplate.releaseCompletionResultSignature/v1 from the dedicated
# releaseCompletionResult role. The final caller pins that provider, key ID,
# SPKI digest, and role-registry digest outside this readiness env. Production
# custody for the authorship key belongs in an independently operated HSM/KMS
# or measured TEE; this example does not establish that custody.
# Production launcher state is not configurable here. The v3 contract fixes it
# at /var/lib/catchplate/production-proof, with the exact attempt journal and
# lock at launch-authorization-attempt.v1.json and
# launch-authorization-attempt.v1.lock. The launch-authority ledger is schema
# v7. Migrate v5/v6 state offline or reinitialize/reprovision it, regenerate the
# v3 manifest and global-role registry pins, and drain or migrate nonterminal
# old-contract operations before enabling v7.
# The launch manifest fixes sys.path to the measured release root, CPython
# stdlib, its direct lib-dynload extension-module directory, and vendor root in
# that order. All four directories and every contained byte must be deployed in
# the immutable release before manifest generation; omissions fail closed.
# The launcher validates the selected interpreter as Linux x86-64 ELF64 with a
# Py_BytesMain dynamic symbol and matching libpython3.11 dependency. This does
# not yet close PT_INTERP or the recursive system-DSO loader graph; those host
# dependencies remain part of the explicit production-host boundary.
# Root, the kernel, systemd, the installed launcher, and the immutable release
# mount remain explicit trust roots. Starting Make/Python from an ambient shell
# does not satisfy this contract.
CATCHPLATE_FINAL_LAUNCHER_CONTRACT=descriptor-sealed-bootstrap-v3

CATCHPLATE_RELEASE_CHANNEL=prod
# This value is fixed. Host preflight and the readiness runner reject final mode.
CATCHPLATE_COMPLETION_VERIFICATION_MODE=readiness
CATCHPLATE_PUBLIC_URL=https://catchplate.example
# Keep the agent-facing proxy on loopback unless external firewall/source
# allowlist evidence is part of deployment acceptance.
CATCHPLATE_PROXY_BIND_ADDRESS=127.0.0.1
CATCHPLATE_CONTROL_PLANE_TLS_DIR=/etc/catchplate/control-plane-tls
CATCHPLATE_AUDIT_ANCHOR_TLS_DIR=/etc/catchplate/audit-anchor-tls
CATCHPLATE_PRODUCTION_CONTROL_PLANE_BASE=https://catchplate:3000
CATCHPLATE_ATTESTATION_HELPER_DIR=/opt/catchplate/attestation-helpers
# Absolute, non-symlink release interpreter selected by the hashed release env.
# Native readiness use must match this path, and its exact bytes are pinned in
# CATCHPLATE_ATTESTATION_EXECUTABLE_SHA256_MANIFEST below.
CATCHPLATE_PRODUCTION_PYTHON_EXECUTABLE=/opt/catchplate/releases/<source-digest>/runtime/python/bin/python3
# Absolute Docker CLI selected by the hashed env. Native readiness opens,
# measures, and executes these exact bytes through the retained descriptor.
CATCHPLATE_DOCKER_EXECUTABLE=/usr/bin/docker
# Compose is executed directly through this independently byte-pinned plugin;
# Docker CLI plugin discovery and ambient Docker/Compose settings are forbidden.
CATCHPLATE_DOCKER_COMPOSE_PLUGIN_EXECUTABLE=/usr/libexec/docker/cli-plugins/docker-compose
CATCHPLATE_DOCKER_COMPOSE_PLUGIN_SHA256=sha256:<64-lowercase-hex>
# Native readiness accepts only this root-owned, non-symlink local Unix socket and
# requires `docker info --format '{{.ID}}'` to match this daemon identity.
CATCHPLATE_DOCKER_UNIX_SOCKET=/run/docker.sock
CATCHPLATE_DOCKER_DAEMON_ID=<independently-approved-local-daemon-id>
# Stable Compose namespace pinned by the authenticated env and supplied with
# --project-name for rendering and every live service-ID lookup.
CATCHPLATE_DOCKER_COMPOSE_PROJECT_NAME=catchplate-production
# Python runs with -I and executes all three exact one-open script byte sets
# through retained /proc/self/fd descriptors. These script pins are separate
# from the fixed nine-entry host executable manifest below.
CATCHPLATE_PRODUCTION_HOST_PREFLIGHT_SCRIPT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_VERIFY_PRODUCTION_READINESS_SCRIPT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_VERIFY_RELEASE_COMPLETION_SCRIPT_SHA256=sha256:<64-lowercase-hex>
# Host preflight is short-lived and Ed25519-authenticated. The private key
# remains root-owned mode 0600 on the production host; completion snapshots only
# the independently pinned public key and requires exact key-ID and age policy.
CATCHPLATE_PRODUCTION_HOST_PREFLIGHT_SIGNING_PRIVATE_KEY=/etc/catchplate/release-trust/preflight-signing.key.pem
CATCHPLATE_PRODUCTION_HOST_PREFLIGHT_SIGNING_PUBLIC_KEY=/etc/catchplate/release-trust/preflight-signing.pub.pem
CATCHPLATE_PRODUCTION_HOST_PREFLIGHT_SIGNING_KEY_ID=sha256:<64-hex-preflight-signing-spki-digest>
CATCHPLATE_PRODUCTION_HOST_PREFLIGHT_MAX_AGE_SECONDS=300
CATCHPLATE_RELEASE_PROVENANCE_FILE=/opt/catchplate/release/release-provenance.json
CATCHPLATE_IMAGE_SIGNATURES_FILE=/opt/catchplate/release/image-signatures.json
# Existing owner-only Ed25519 private key used by the release builder. The
# generator never creates this key in production and verifies it against the
# independently provisioned public trust root below before signing.
CATCHPLATE_RELEASE_PROVENANCE_SIGNING_KEY=/etc/catchplate/release-signing/release-provenance.pem
# Independent release-verifier trust roots must be absolute paths to bounded,
# regular, non-symlink public-key files (maximum 65536 bytes). The Sigstore,
# Rekor, and external checkpoint key IDs below are SHA-256 digests of SPKI DER.
CATCHPLATE_RELEASE_PROVENANCE_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/release-provenance.pub.pem
CATCHPLATE_SIGSTORE_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/sigstore.pub.pem
CATCHPLATE_REKOR_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/rekor.pub.pem
CATCHPLATE_EXTERNAL_CHECKPOINT_PROVIDER=managed-prod-log
CATCHPLATE_EXTERNAL_CHECKPOINT_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/external-checkpoint.pub.pem
# Readiness also binds the three CLI-selected policy/reproducibility verifier
# roots to these exact paths and independently computed SPKI DER digests. The
# policy identity, activation, and reproducibility roles must use three distinct
# public keys; the existing response/release role separation remains enforced.
CATCHPLATE_POLICY_IDENTITY_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/policy-identity.pub.pem
CATCHPLATE_POLICY_IDENTITY_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-policy-identity-spki-digest>
CATCHPLATE_POLICY_ACTIVATION_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/policy-activation.pub.pem
CATCHPLATE_POLICY_ACTIVATION_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-policy-activation-spki-digest>
CATCHPLATE_REPRODUCIBLE_BUILD_TRUSTED_PUBLIC_KEY=/etc/catchplate/release-trust/reproducible-build.pub.pem
CATCHPLATE_REPRODUCIBLE_BUILD_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-reproducible-build-spki-digest>
# Do not add final-verifier evidence or challenge inputs here. The independent
# Manifest-v6 public Nitro verifier has its own pinned input surface and emits
# releaseCompletionVerification/v1 with actionAuthorization=null and
# okForAction=false. A separate stateful action gate checks the live final head.
# Service-token files must be absolute, regular, non-symlink files containing
# exactly one UTF-8 token with no leading/trailing whitespace or newline.
# Keep the admin and bootstrap files owned by 65532:65532 with mode 0400 or
# 0600. Keep shared data-plane and audit-anchor files owned by root:65530 with
# mode 0440 so both production runtimes can read only their mounted copies.
# Every token value must be independently generated and distinct.
CATCHPLATE_ADMIN_TOKEN_FILE=/etc/catchplate/service-credentials/admin-token
CATCHPLATE_ADMIN_ROLES=admin,approver,auditor,policy_author,policy_publisher,credential_owner,attestation_operator,attestation_reviewer

# OAuth client secrets stay in host files owned by UID 65532 with mode 0400 or
# 0600. Host preflight verifies that the non-root control-plane container can
# read the bind mounts without exposing their values.
CATCHPLATE_OAUTH_STATE_TTL_SECONDS=600
CATCHPLATE_OAUTH_PENDING_CREDENTIAL_TTL_SECONDS=900
CATCHPLATE_OAUTH_PENDING_CREDENTIAL_MAX_COUNT=1000
CATCHPLATE_SETUP_SESSION_TTL_SECONDS=86400
CATCHPLATE_SETUP_SESSION_MAX_ACTIVE=1000
CATCHPLATE_SETUP_SESSION_MAX_RETAINED=10000
CATCHPLATE_SETUP_SESSION_RETENTION_SECONDS=604800
CATCHPLATE_SETUP_SESSION_EVIDENCE_MAX_BYTES=1048576
CATCHPLATE_SETUP_SESSION_EVIDENCE_MAX_COUNT=64
CATCHPLATE_SETUP_SESSION_EVENT_MAX_BYTES=16384
CATCHPLATE_SETUP_SESSION_EVENT_MAX_COUNT=128
CATCHPLATE_SETUP_SESSION_AUDIT_OUTBOX_MAX_PENDING=10000
CATCHPLATE_SETUP_SESSION_AUDIT_CLAIM_TTL_SECONDS=60
CATCHPLATE_SETUP_ENROLLMENT_VERIFIER_PUBLIC_KEY=/etc/catchplate/setup-trust/enrollment-verifier.pub.pem
CATCHPLATE_SETUP_ENROLLMENT_VERIFIER_KEY_ID=sha256:<64-hex-enrollment-verifier-spki-digest>
CATCHPLATE_SETUP_ENROLLMENT_VERIFIER_PROVIDER=production-enrollment-verifier
CATCHPLATE_SETUP_HARDWARE_VERIFIER_PUBLIC_KEY=/etc/catchplate/setup-trust/hardware-verifier.pub.pem
CATCHPLATE_SETUP_HARDWARE_VERIFIER_KEY_ID=sha256:<64-hex-hardware-verifier-spki-digest>
CATCHPLATE_SETUP_HARDWARE_VERIFIER_PROVIDER=production-hardware-verifier
CATCHPLATE_SETUP_FINAL_AUTHORITY_PUBLIC_KEY=/etc/catchplate/setup-trust/final-authority.pub.pem
CATCHPLATE_SETUP_FINAL_AUTHORITY_KEY_ID=sha256:<64-hex-final-authority-spki-digest>
CATCHPLATE_SETUP_FINAL_AUTHORITY_PROVIDER=production-setup-final-authority
CATCHPLATE_SETUP_ATTESTATION_CHALLENGE_TTL_SECONDS=300
CATCHPLATE_CREDENTIAL_LEASE_REPLAY_MAX_ENTRIES=1000000
CATCHPLATE_GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
CATCHPLATE_GOOGLE_OAUTH_CLIENT_SECRET_FILE=/etc/catchplate/oauth/google-client-secret
CATCHPLATE_GOOGLE_OAUTH_REDIRECT_URI=https://catchplate.example/api/oauth/callback/google
CATCHPLATE_X_OAUTH_CLIENT_ID=<x-oauth-client-id>
CATCHPLATE_X_OAUTH_CLIENT_SECRET_FILE=/etc/catchplate/oauth/x-client-secret
CATCHPLATE_X_OAUTH_REDIRECT_URI=https://catchplate.example/api/oauth/callback/x

CATCHPLATE_OIDC_ENABLED=1
CATCHPLATE_OIDC_ISSUER=https://idp.example
CATCHPLATE_OIDC_AUDIENCE=catchplate-control-plane
CATCHPLATE_OIDC_JWKS_JSON='<pinned-jwks-json>'
CATCHPLATE_OIDC_ROLE_CLAIM=catchplate_roles
CATCHPLATE_OIDC_BROWSER_LOGIN_ENABLED=1
CATCHPLATE_OIDC_AUTHORIZATION_ENDPOINT=https://idp.example/authorize
CATCHPLATE_OIDC_TOKEN_ENDPOINT=https://idp.example/token
CATCHPLATE_OIDC_CLIENT_ID=catchplate-control-plane
CATCHPLATE_OIDC_CLIENT_SECRET_FILE=/etc/catchplate/oauth/oidc-client-secret
CATCHPLATE_OIDC_REDIRECT_URI=https://catchplate.example/api/auth/oidc/callback
CATCHPLATE_OIDC_BROWSER_SCOPES=openid,profile,email
CATCHPLATE_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
CATCHPLATE_OIDC_LOGIN_STATE_TTL_SECONDS=300
CATCHPLATE_OIDC_SESSION_TTL_SECONDS=3600
CATCHPLATE_OIDC_SESSION_WEBAUTHN_REQUIRED=1
CATCHPLATE_OIDC_SESSION_WEBAUTHN_CHALLENGE_TTL_SECONDS=120
CATCHPLATE_OIDC_SESSION_WEBAUTHN_PENDING_TTL_SECONDS=300
CATCHPLATE_OIDC_SESSION_ACTIVATION_RETRY_TTL_SECONDS=20
CATCHPLATE_WEBAUTHN_RECOVERY_ENABLED=1
# Public half only. Keep the offline Ed25519 private key outside every
# Catchplate host, container, agent environment, and copied handoff command.
CATCHPLATE_WEBAUTHN_RECOVERY_ROOT_PUBLIC_KEY=/etc/catchplate/webauthn-recovery/offline-root.pub.pem
CATCHPLATE_WEBAUTHN_RECOVERY_ROOT_KEY_ID=sha256:<64-hex-offline-recovery-root-spki-digest>
CATCHPLATE_WEBAUTHN_RECOVERY_ROOT_PROVIDER=offline-recovery-authority
CATCHPLATE_WEBAUTHN_RECOVERY_AUDIENCE=https://catchplate.example
# Public identities for startup/readiness collision checks. Private keys remain online.
CATCHPLATE_POLICY_SIGNING_PUBLIC_KEY=/etc/catchplate/gate/policy-signing-ed25519.pub.pem
# Pre-provision this Ed25519 PKCS#8 key with mode 0400 or 0600 and ownership
# readable by the production control-plane UID. Compose mounts it read-only.
CATCHPLATE_RESPONSE_SIGNING_PRIVATE_KEY_FILE=/etc/catchplate/runtime/response-signing-ed25519.pem
CATCHPLATE_RESPONSE_SIGNING_PUBLIC_KEY=/etc/catchplate/runtime/response-signing-ed25519.pub.pem
# Independent verifier pin for dispatch receipts embedded in proxy response proofs.
# It must resolve to the same public key bytes as CATCHPLATE_RESPONSE_SIGNING_PUBLIC_KEY.
CATCHPLATE_CONTROL_PLANE_RESPONSE_SIGNING_PUBLIC_KEY=/etc/catchplate/runtime/response-signing-ed25519.pub.pem
CATCHPLATE_CONTROL_PLANE_RESPONSE_SIGNING_PUBLIC_KEY_ID=sha256:<64-hex-response-signing-spki-digest>
CATCHPLATE_WEBAUTHN_TRUST_SIGNING_PUBLIC_KEY=/etc/catchplate/runtime/webauthn-trust-signing-ed25519.pub.pem
CATCHPLATE_WEBAUTHN_RECOVERY_TTL_SECONDS=180
CATCHPLATE_WEBAUTHN_RECOVERY_MAX_LIVE=100
CATCHPLATE_WEBAUTHN_RECOVERY_TERMINAL_RETENTION_SECONDS=7776000
CATCHPLATE_WEBAUTHN_RECOVERY_MAX_RETAINED=100000
CATCHPLATE_WEBAUTHN_RECOVERY_CREDENTIAL_HISTORY_MAX_COUNT=1000
CATCHPLATE_WEBAUTHN_RECOVERY_CREDENTIAL_HISTORY_MAX_BYTES=4194304
CATCHPLATE_WEBAUTHN_RECOVERY_EXCLUDE_CREDENTIALS_MAX_COUNT=1000
CATCHPLATE_WEBAUTHN_RECOVERY_EXCLUDE_CREDENTIALS_MAX_BYTES=1048576
CATCHPLATE_WEBAUTHN_RECOVERY_WITNESS_BACKEND=postgres
# This must resolve to a different PostgreSQL cluster and fault domain from metadata.
# Both database roles must be allowed to execute pg_control_system().
CATCHPLATE_WEBAUTHN_RECOVERY_WITNESS_POSTGRES_DSN=postgresql://catchplate-witness:<password>@witness-db.example:5432/catchplate_witness
CATCHPLATE_WEBAUTHN_RECOVERY_WITNESS_FAULT_DOMAIN_ID=aws:recovery-account:us-east-1b
CATCHPLATE_WEBAUTHN_RECOVERY_WITNESS_CONNECT_TIMEOUT_SECONDS=5
CATCHPLATE_WEBAUTHN_CHALLENGE_GLOBAL_LIVE_MAX=50000
CATCHPLATE_WEBAUTHN_CHALLENGE_USER_LIVE_MAX=64
CATCHPLATE_WEBAUTHN_CHALLENGE_GLOBAL_RATE_MAX=10000
CATCHPLATE_WEBAUTHN_CHALLENGE_USER_RATE_MAX=120
CATCHPLATE_WEBAUTHN_CHALLENGE_RATE_WINDOW_SECONDS=60
CATCHPLATE_WEBAUTHN_CHALLENGE_TERMINAL_RETENTION_SECONDS=900
CATCHPLATE_WEBAUTHN_CHALLENGE_MAX_RETAINED=100000
CATCHPLATE_WEBAUTHN_ORIGIN=https://catchplate.example
CATCHPLATE_CONTROL_PLANE_MUTATION_WEBAUTHN_REQUIRED=1
CATCHPLATE_CONTROL_PLANE_MUTATION_REQUIRE_HARDWARE_ATTESTATION=1
CATCHPLATE_CONTROL_PLANE_MUTATION_ALLOWED_AUTHENTICATOR_CLASSES=yubikey,hardware
CATCHPLATE_DIRECT_CA_DOWNLOAD_ENABLED=0
CATCHPLATE_CA_INSTALL_SESSION_TTL_SECONDS=300
CATCHPLATE_CONTROL_PLANE_TWO_PERSON_REQUIRED=1
CATCHPLATE_CONTROL_PLANE_TWO_PERSON_ACTIONS=credential.create,credential.oauth.activate,credential.oauth.uncertain.resolve,credential.update,credential.delete,route.create,route.update,route.delete,policy.publish,webauthn.credential.register,webauthn.credential.revoke,webauthn.trust.publish,rbac.role.change,rbac.deprovision,control_plane.token.rotate,break_glass.grant,setup.attestation.finalize
CATCHPLATE_WEBAUTHN_BOOTSTRAP_TOKEN_FILE=/etc/catchplate/service-credentials/webauthn-bootstrap-token
CATCHPLATE_POLICY_PUBLISH_DRY_RUN_REQUIRED=1
CATCHPLATE_POLICY_CANARY_REQUIRED=1
CATCHPLATE_POLICY_CANARY_MIN_OBSERVATION_SECONDS=60
CATCHPLATE_POLICY_CANARY_MIN_AUDIT_EVENTS=10
CATCHPLATE_POLICY_CANARY_MAX_DENIALS=0

CATCHPLATE_TEE_QUOTE_PROVIDER=aws-nitro-enclaves
CATCHPLATE_TEE_PLATFORM=aws-nitro
CATCHPLATE_TEE_QUOTE_COMMAND='python3 scripts/aws_nitro_tee_provider.py quote'
CATCHPLATE_TEE_QUOTE_VERIFY_COMMAND='python3 scripts/aws_nitro_tee_provider.py verify'
CATCHPLATE_KEY_RELEASE_REQUIRED=1
CATCHPLATE_KEY_RELEASE_COMMAND='python3 scripts/aws_nitro_tee_provider.py release'
CATCHPLATE_MASTER_KEY_UNSEAL_COMMAND='/usr/bin/python3 /app/scripts/aws_nitro_kms_unseal.py unseal'
CATCHPLATE_NITRO_NSM_UNSEAL_COMMAND_TEMPLATE='/opt/catchplate/bin/nsm-unseal --ciphertext {recipient_ciphertext_path}'
CATCHPLATE_NITRO_NSM_UNSEAL_OUTPUT_FORMAT=json
CATCHPLATE_KEY_RELEASE_ALLOW_DEBUG=0
CATCHPLATE_KEY_RELEASE_MIN_ROLLBACK_EPOCH=1
CATCHPLATE_KEY_RELEASE_REQUIRE_DATA_PLANE_DIGEST=1
CATCHPLATE_NITRO_ATTESTATION_COMMAND='python3 scripts/nitro_nsm_attest.py attest'
CATCHPLATE_NITRO_NSM_ATTEST_COMMAND_TEMPLATE='/opt/catchplate/bin/nsm-attest --user-data {user_data_path} --out {output_path}'
CATCHPLATE_NITRO_ROOT_CERT=/etc/catchplate/nitro-root.pem
CATCHPLATE_NITRO_EXPECTED_PCRS='<json-object-of-pcr-number-to-sha384-hex>'
CATCHPLATE_NITRO_REQUIRE_KMS_COMMAND=1
CATCHPLATE_NITRO_KMS_RELEASE_COMMAND='python3 scripts/aws_kms_recipient_release.py release --materials-file /run/catchplate/nitro/kms-materials.json'
CATCHPLATE_NITRO_KMS_MATERIALS_FILE=/etc/catchplate/kms-materials.json
CATCHPLATE_NITRO_ALLOWED_MATERIALS=broker-kek,decision-gate-ca
CATCHPLATE_DATA_PLANE_RECIPIENT_ATTESTATION_COMMAND='/opt/catchplate/bin/lease-recipient-attest'
CATCHPLATE_DATA_PLANE_RESPONSE_PROOF_ATTESTATION_COMMAND='/opt/catchplate/bin/response-proof-attest'
CATCHPLATE_DATA_PLANE_INSTANCE_ID=spiffe://prod.catchplate.internal/decision-gate/instance-01

# Response-observation v2 is one local TEE node and one fault domain. This is
# explicitly 1-of-1 availability, not an independent quorum or external witness.
CATCHPLATE_RESPONSE_OBSERVATION_V2_TEE_TOPOLOGY_PROFILE=local-single-node-1-of-1
# This must be a statically linked x86-64 ELF with no arguments, PT_INTERP, or
# DT_NEEDED entries. The exact executable digest is also present in the closed
# CATCHPLATE_ATTESTATION_EXECUTABLE_SHA256_MANIFEST below.
CATCHPLATE_RESPONSE_OBSERVATION_V2_TEE_VERIFY_COMMAND='/opt/catchplate/bin/response-v2-tee-verify'
CATCHPLATE_RESPONSE_V2_TEE_EXPECTATIONS_FILE=/etc/catchplate/response-v2/tee-expectations.json
CATCHPLATE_RESPONSE_V2_TEE_EXPECTATIONS_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_V2_NITRO_TRUST_ROOTS_FILE=/etc/catchplate/response-v2/nitro-trust-roots.json
CATCHPLATE_RESPONSE_V2_NITRO_TRUST_ROOTS_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_GENERATION_ID=<signed-response-v2-generation-id>
CATCHPLATE_RESPONSE_OBSERVATION_V2_SOURCE_COMMIT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_SOURCE_TREE_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_SIGNER_KEY_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_ROLE_IDENTITY_ROOT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_PROOF_PINS_ROOT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_ROLE_KEYS_JSON='<canonical-public-response-v2-role-key-manifest-json>'
# Canonical public JSON only. The private release-attestor, log, and runtime
# attestation keys remain in their separate custody systems and key directories.
CATCHPLATE_RESPONSE_OBSERVATION_V2_TRANSPARENCY_TRUST_PIN_JSON='<canonical-response-v2-release-transparency-trust-pin-json>'
CATCHPLATE_RESPONSE_OBSERVATION_V2_PUBLIC_CONFIG_DIR=/etc/catchplate/response-v2/generation
CATCHPLATE_RESPONSE_OBSERVATION_V2_CUSTODY_CONFIG_FILE=/etc/catchplate/response-v2/generation/custody.json
CATCHPLATE_RESPONSE_OBSERVATION_V2_CUSTODY_CONFIG_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_TRANSPARENCY_TRUST_PIN_FILE=/etc/catchplate/response-v2/generation/release-transparency-trust-pin.json
CATCHPLATE_RESPONSE_OBSERVATION_V2_TRANSPARENCY_TRUST_PIN_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_OBSERVATION_V2_RELEASE_TRANSPARENCY_ARTIFACT_FILE=/etc/catchplate/response-v2/generation/release-transparency-artifact.json
CATCHPLATE_RESPONSE_OBSERVATION_V2_RELEASE_TRANSPARENCY_ARTIFACT_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_V2_PROVIDER_GENERATION_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_RESPONSE_V2_GENERATION_ACTIVATION_TIMEOUT_MS=300000
CATCHPLATE_RESPONSE_OBSERVATION_V2_SECCOMP_PROFILE=./security/seccomp/catchplate-deny-dangerous.json
CATCHPLATE_RESPONSE_OBSERVATION_V2_APPARMOR_PROFILE=catchplate-response-v2
CATCHPLATE_RESPONSE_OBSERVATION_V2_CGROUP_ROOT=/sys/fs/cgroup/catchplate-response-v2
CATCHPLATE_RESPONSE_OBSERVATION_V2_POSTGRES_SOCKET_DIR=/run/postgresql
CATCHPLATE_RESPONSE_OBSERVATION_V2_STATE_SOCKET_DIR=/run/catchplate-response-v2/state
CATCHPLATE_RESPONSE_OBSERVATION_V2_CREDENTIAL_SOCKET_DIR=/run/catchplate-response-v2/credential-transport
CATCHPLATE_RESPONSE_OBSERVATION_V2_POLICY_SOCKET_DIR=/run/catchplate-response-v2/policy-proof-verifier
CATCHPLATE_RESPONSE_OBSERVATION_V2_LEDGER_SOCKET_DIR=/run/catchplate-response-v2/immutable-artifact-ledger
CATCHPLATE_RESPONSE_OBSERVATION_V2_RELEASE_SOCKET_DIR=/run/catchplate-response-v2/release-attestor-publisher
CATCHPLATE_RESPONSE_OBSERVATION_V2_WATCHDOG_SOCKET_DIR=/run/catchplate-response-v2/cleanup-watchdog
CATCHPLATE_RESPONSE_OBSERVATION_V2_ROUTER_SOCKET_DIR=/run/catchplate-response-v2/router
CATCHPLATE_RESPONSE_OBSERVATION_V2_STATE_DATA_DIR=/var/lib/catchplate-response-v2/state-authority
CATCHPLATE_RESPONSE_OBSERVATION_V2_CREDENTIAL_DATA_DIR=/var/lib/catchplate-response-v2/credential-transport
CATCHPLATE_RESPONSE_OBSERVATION_V2_POLICY_DATA_DIR=/var/lib/catchplate-response-v2/policy-proof-verifier
CATCHPLATE_RESPONSE_OBSERVATION_V2_LEDGER_DATA_DIR=/var/lib/catchplate-response-v2/immutable-artifact-ledger
CATCHPLATE_RESPONSE_OBSERVATION_V2_RELEASE_DATA_DIR=/var/lib/catchplate-response-v2/release-attestor-publisher
CATCHPLATE_RESPONSE_OBSERVATION_V2_WATCHDOG_DATA_DIR=/var/lib/catchplate-response-v2/cleanup-watchdog
CATCHPLATE_RESPONSE_OBSERVATION_V2_ROUTER_DATA_DIR=/var/lib/catchplate-response-v2/custody-router
CATCHPLATE_RESPONSE_OBSERVATION_V2_BOOTSTRAP_KEY_DIR=/etc/catchplate/response-v2/credentials/generation-bootstrap
CATCHPLATE_RESPONSE_OBSERVATION_V2_GENERATION_PUBLIC_CREDENTIAL_DIR=/etc/catchplate/response-v2/credentials/generation-public
CATCHPLATE_RESPONSE_OBSERVATION_V2_STATE_KEY_DIR=/etc/catchplate/response-v2/credentials/state-authority
CATCHPLATE_RESPONSE_OBSERVATION_V2_CREDENTIAL_KEY_DIR=/etc/catchplate/response-v2/credentials/credential-transport
CATCHPLATE_RESPONSE_OBSERVATION_V2_POLICY_KEY_DIR=/etc/catchplate/response-v2/credentials/policy-proof-verifier
CATCHPLATE_RESPONSE_OBSERVATION_V2_LEDGER_KEY_DIR=/etc/catchplate/response-v2/credentials/immutable-artifact-ledger
CATCHPLATE_RESPONSE_OBSERVATION_V2_RELEASE_KEY_DIR=/etc/catchplate/response-v2/credentials/release-attestor-publisher
CATCHPLATE_RESPONSE_OBSERVATION_V2_WATCHDOG_KEY_DIR=/etc/catchplate/response-v2/credentials/cleanup-watchdog
CATCHPLATE_RESPONSE_OBSERVATION_V2_ROUTER_KEY_DIR=/etc/catchplate/response-v2/credentials/custody-router
CATCHPLATE_POLICY_MIN_SEQUENCE=1
CATCHPLATE_POLICY_MIN_ROLLBACK_EPOCH=1
CATCHPLATE_DATA_PLANE_LEASE_RECIPIENT_ATTESTATION_REQUIRED=1
CATCHPLATE_DATA_PLANE_LEASE_RECIPIENT_VERIFY_COMMAND='/opt/catchplate/bin/lease-recipient-verify'
CATCHPLATE_CONTROL_PLANE_ATTESTATION_VERIFY_COMMAND='/opt/catchplate/bin/control-plane-attestation-verify'
# Closed byte-pin manifest for every host-mounted attestation executable and
# the response-proof collector, production Python, and Docker. Keys must match
# this exact nine-entry set;
# compute each digest from the independently approved executable bytes.
CATCHPLATE_ATTESTATION_EXECUTABLE_SHA256_MANIFEST='{"CATCHPLATE_CONTROL_PLANE_ATTESTATION_VERIFY_COMMAND":"sha256:<64-lowercase-hex>","CATCHPLATE_DATA_PLANE_LEASE_RECIPIENT_VERIFY_COMMAND":"sha256:<64-lowercase-hex>","CATCHPLATE_DATA_PLANE_RECIPIENT_ATTESTATION_COMMAND":"sha256:<64-lowercase-hex>","CATCHPLATE_DATA_PLANE_RESPONSE_PROOF_ATTESTATION_COMMAND":"sha256:<64-lowercase-hex>","CATCHPLATE_DOCKER_EXECUTABLE":"sha256:<64-lowercase-hex>","CATCHPLATE_NITRO_NSM_ATTEST_COMMAND_TEMPLATE":"sha256:<64-lowercase-hex>","CATCHPLATE_NITRO_NSM_UNSEAL_COMMAND_TEMPLATE":"sha256:<64-lowercase-hex>","CATCHPLATE_PRODUCTION_PYTHON_EXECUTABLE":"sha256:<64-lowercase-hex>","CATCHPLATE_PROXY_PROOF_COLLECTOR_COMMAND":"sha256:<64-lowercase-hex>","CATCHPLATE_RESPONSE_OBSERVATION_V2_TEE_VERIFY_COMMAND":"sha256:<64-lowercase-hex>"}'
CATCHPLATE_EXPECTED_DATA_PLANE_BINARY_DIGEST=sha256:<64-hex-measured-decision-gate-digest>

# Policy-shadow generation has two deliberately different trust statements.
# The decision-gate runtime attestation is production hardware evidence and its
# verifier must validate a fresh Nitro claim against independently approved
# measurements. The five host policy-custody services remain co-located
# TrustedHostNoTee authorities: every service report must say hardwareProof=false
# and must never be promoted to hardware evidence by the handoff helper.
# Production proxy ingress is TLS 1.3 mutual TLS. These source files are
# mounted read-only at the fixed CATCHPLATE_PROXY_TLS_* runtime paths in
# docker-compose.production.yml. Before Compose starts, run:
#   sudo make verify-production-proxy-ingress-materials \
#     CATCHPLATE_PROXY_INGRESS_MODE=mtls \
#     CATCHPLATE_PROXY_TLS_CERT_FILE="$CATCHPLATE_PROXY_TLS_CERT_FILE" \
#     CATCHPLATE_PROXY_TLS_KEY_FILE="$CATCHPLATE_PROXY_TLS_KEY_FILE" \
#     CATCHPLATE_PROXY_CLIENT_CA_BUNDLE_FILE="$CATCHPLATE_PROXY_CLIENT_CA_BUNDLE_FILE"
# Certificate and CA: root:root 0444. Private key: root:GID-65532 0440.
CATCHPLATE_PROXY_INGRESS_MODE=mtls
CATCHPLATE_PROXY_TLS_CERT_FILE=/etc/catchplate/proxy-ingress/server-cert.pem
CATCHPLATE_PROXY_TLS_KEY_FILE=/etc/catchplate/proxy-ingress/server-key.pem
CATCHPLATE_PROXY_CLIENT_CA_BUNDLE_FILE=/etc/catchplate/proxy-ingress/client-ca.pem

# Required by standard production Rust ingress. These are public originals,
# deployed explicitly as root:root 0444 and mounted read-only by Compose.
# Publication alone does not install them or restart a service. The existing
# proxy-ingress-materials preflight is not verification of this authorization:
# Rust independently admits it against the actual binary, server key, signed
# policy and loaded single-issuer CA bytes before serving requests.
# The authorizer pin is the independently selected exact canonical PEM file
# digest, NOT the CA digest or the author's SPKI digest from its signed record.
CATCHPLATE_WORKLOAD_IDENTITY_TRUST_AUTHORIZATION_FILE=/etc/catchplate/workload-identity-trust/authorization.json
CATCHPLATE_WORKLOAD_IDENTITY_TRUST_AUTHORIZER_PUBLIC_KEY_FILE=/etc/catchplate/workload-identity-trust/authorizer-public-key.pem
CATCHPLATE_WORKLOAD_IDENTITY_TRUST_AUTHORIZER_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_WORKLOAD_IDENTITY_TRUST_DEPLOYMENT_ID=<independently-approved-deployment-id>
# The initial profile has an original lifetime of at most 24 hours. A changed
# bound policy or renewed trust authorization requires explicit deployment and
# restart. Reload cannot extend that lifetime or rotate the loaded TLS trust.
# This software-host profile is not the separate native framed-DER profile,
# enclave custody, independent rollback witnessing or production acceptance.

CATCHPLATE_POLICY_SHADOW_RUNTIME_ATTESTATION_MODE=tee-hardware
CATCHPLATE_POLICY_SHADOW_RUNTIME_HARDWARE_PROOF_REQUIRED=1
CATCHPLATE_POLICY_CUSTODY_SERVICE_ATTESTATION_MODE=trusted-host-no-tee
CATCHPLATE_POLICY_CUSTODY_SERVICE_HARDWARE_PROOF=0
# Numeric GID of the host swpc-driver account. It must be distinct from all five
# service primary GIDs and is the only supplemental group granted to the
# decision-gate container for the root:swpc-driver mode-0660 seqpacket sockets.
CATCHPLATE_POLICY_CUSTODY_DRIVER_GID=<numeric-host-swpc-driver-gid>
CATCHPLATE_POLICY_CUSTODY_SOCKET_DIR=/run/catchplate/policy-custody
CATCHPLATE_POLICY_CUSTODY_SOCKET_TARGET=catchplate-policy-custody-sockets.target
CATCHPLATE_POLICY_CUSTODY_READY_TARGET=catchplate-policy-custody.target
# The root launcher renders this canonical v5 manifest only after measuring the
# live driver and role-owned state directories. It atomically installs the
# resulting root-owned generation and independently pins both emitted receipts.
CATCHPLATE_POLICY_CUSTODY_RUNTIME_CONFIG_MODE=trusted-launcher-after-live-measurement-v1
CATCHPLATE_POLICY_CUSTODY_RUNTIME_CONFIG_ROOT=/run/catchplate/policy-custody/runtime/current
CATCHPLATE_POLICY_CUSTODY_ASSET_RENDER_MANIFEST_FILE=/etc/catchplate/policy-custody/asset-render-manifest.v5.json
CATCHPLATE_POLICY_CUSTODY_ASSET_RENDER_MANIFEST_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_POLICY_CUSTODY_RENDERED_ASSETS_FILE=/etc/catchplate/policy-custody/rendered-assets.v5.json
CATCHPLATE_POLICY_CUSTODY_RENDERED_ASSETS_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_POLICY_CUSTODY_HOST_INSTALLATION_MANIFEST_FILE=/etc/catchplate/policy-custody/policy-custody-host-installation.v1.json
CATCHPLATE_POLICY_CUSTODY_HOST_INSTALLATION_MANIFEST_SHA256=sha256:<64-lowercase-hex>
# Trust and custody inputs must be absolute, root:root regular non-symlink files
# beneath non-writable ancestry with mode 0400 or 0600.
CATCHPLATE_POLICY_SHADOW_TRUST_MANIFEST_FILE=/etc/catchplate/policy-shadow/trust-manifest.json
CATCHPLATE_POLICY_SHADOW_TRUST_MANIFEST_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_POLICY_SHADOW_CUSTODY_CONFIG_FILE=/etc/catchplate/policy-shadow/custody-config.json
# Startup-generation is optional and all-or-none. The normal production path
# omits all three values: start generation control without an automatic request,
# measure the live driver, install the five matching configs, start the READY
# target, and only then request candidate activation. Set this paired override
# only when the root launcher has independently approved a signed automatic
# startup request and Compose mounts its host file at the exact in-container
# path.
# CATCHPLATE_POLICY_SHADOW_STARTUP_GENERATION=/run/catchplate/policy-shadow/generation/startup-generation.json
# CATCHPLATE_POLICY_SHADOW_STARTUP_GENERATION_FILE=/etc/catchplate/policy-shadow/startup-generation.json
# CATCHPLATE_POLICY_SHADOW_STARTUP_GENERATION_SHA256=sha256:<64-lowercase-hex>
# Compose mounts CATCHPLATE_ATTESTATION_HELPER_DIR read-only at
# /opt/catchplate/bin. These digests bind the exact fixed host files
# policy-shadow-runtime-attestation-verify and
# policy-shadow-publication-handoff in that directory.
CATCHPLATE_POLICY_SHADOW_RUNTIME_ATTESTATION_VERIFIER_SHA256=sha256:<64-lowercase-hex>
CATCHPLATE_POLICY_SHADOW_PUBLICATION_HANDOFF_SHA256=sha256:<64-lowercase-hex>

# External response-proof collector. The readiness runner generates a fresh
# nonce and collects after live readiness. The release pipeline/operator must
# compute the three expected digests below independently from the intended
# canonical client request, canonical dispatched request, and policy operation
# preimages. The collector is checked against these pins and supplies only the
# fresh response proof and TLS channel binding; it is not trusted to select the
# expected request or operation digests.
CATCHPLATE_PROXY_RESPONSE_PROOF_FILE=/opt/catchplate/release/proxy-response-proof.json
CATCHPLATE_PROXY_PROOF_CONTRACT=buffered-v3
# For a fully buffered, all-method response-observation proof, set the contract
# above to observation-v1. It uses the same independently pinned expected
# client-request, dispatched-request, operation, nonce, TLS, and trust inputs
# and requires the separately published body snapshot settings below. The
# completion verifier reopens this regular non-symlink file, enforces the bound,
# and matches its exact digest and byte count to the collector and signed runtime
# statement.
# CATCHPLATE_PROXY_OBSERVATION_BODY_FILE=/opt/catchplate/release/proxy-response-observation-body.bin
# CATCHPLATE_PROXY_PROOF_MAX_OBSERVATION_BODY_BYTES=16777216
# These observation settings are forbidden for buffered-v3 and streaming-v1.
# For a streaming-v1 production proof, set the contract above to streaming-v1
# and pin all three settings below in this same hashed environment file.
# CATCHPLATE_PROXY_STREAM_BODY_FILE=/opt/catchplate/release/proxy-response-body.bin
# CATCHPLATE_PROXY_PROOF_MAX_STREAM_BYTES=67108864
# CATCHPLATE_PROXY_EXPECTED_OPERATION_CONTEXT_DIGEST=sha256:<64-lowercase-hex>
CATCHPLATE_PROXY_PROOF_COLLECTOR_COMMAND='/opt/catchplate/bin/catchplate-proof-client'
CATCHPLATE_PROXY_PROOF_ADDRESS=proxy.prod.internal:8080
CATCHPLATE_PROXY_PROOF_URL=https://proof-target.prod.internal/health
CATCHPLATE_PROXY_PROOF_CA_BUNDLE=/etc/catchplate/proxy-ca.pem
# Both values must select one principal in the exact active signed policy, and
# that principal must be authorized for the GET URL above.
CATCHPLATE_PROXY_PROOF_AGENT_ID=<active-policy-agent-header>
CATCHPLATE_PROXY_PROOF_PRINCIPAL_ID=<active-policy-principal-id>
CATCHPLATE_PROXY_PROOF_COLLECTOR_PRIVATE_KEY=/etc/catchplate/proof-collector.key.pem
CATCHPLATE_PROXY_PROOF_COLLECTOR_PUBLIC_KEY=/etc/catchplate/proof-collector.pub.pem
CATCHPLATE_PROXY_PROOF_COLLECTOR_KEY_ID=sha256:<64-hex-collector-spki-digest>
CATCHPLATE_PROXY_PROOF_VERIFIER_PUBLIC_KEY=/etc/catchplate/proxy-proof-verifier.pub.pem
CATCHPLATE_PROXY_PROOF_VERIFIER_KEY_ID=sha256:<64-hex-verifier-spki-digest>
CATCHPLATE_PROXY_EXPECTED_CLIENT_REQUEST_DIGEST=sha256:<64-lowercase-hex>
CATCHPLATE_PROXY_EXPECTED_REQUEST_DIGEST=sha256:<64-lowercase-hex>
CATCHPLATE_PROXY_EXPECTED_OPERATION_DIGEST=sha256:<64-lowercase-hex>
CATCHPLATE_PROXY_PROOF_MAX_AGE_SECONDS=300
# Readiness uses this exact hashed benchmark policy; CLI overrides must
# match rather than selecting a weaker threshold.
CATCHPLATE_COMPLETION_P99_LIMIT_MS=20.0

CATCHPLATE_IMAGE_SIGNATURE_PROVIDER=sigstore-command
CATCHPLATE_IMAGE_SIGN_COMMAND='python3 scripts/cosign_sigstore.py sign'
CATCHPLATE_IMAGE_VERIFY_COMMAND='python3 scripts/cosign_sigstore.py verify'
CATCHPLATE_COSIGN_BINARY=cosign
CATCHPLATE_COSIGN_KEY=awskms://arn:aws:kms:us-east-1:111122223333:key/catchplate-signing
CATCHPLATE_COSIGN_KEY_ID=sha256:<64-hex-key-provider-id>
CATCHPLATE_COSIGN_EXPECTED_REKOR_LOG_ID=sha256:<64-hex-rekor-log-id>
CATCHPLATE_REQUIRE_SIGSTORE_TRANSPARENCY=1

# Independently operated append-only release evidence anchor. Both release
# provenance and image-signature records are published here before deployment.
CATCHPLATE_RELEASE_ANCHOR_BASE=https://release-anchor.example.net
# Set this only when the anchor uses a private CA.
# CATCHPLATE_RELEASE_ANCHOR_CA_BUNDLE=/etc/catchplate/release-anchor-ca.pem

CATCHPLATE_TRANSPARENCY_CHECKPOINT_REQUIRED=1
CATCHPLATE_TRANSPARENCY_CHECKPOINT_COMMAND='python3 scripts/transparency_checkpoint.py checkpoint'
CATCHPLATE_TRANSPARENCY_CHECKPOINT_MODE=http
CATCHPLATE_TRANSPARENCY_LOG_URL=https://transparency.example/checkpoints
CATCHPLATE_TRANSPARENCY_EXPECTED_PROVIDER=managed-prod-log
CATCHPLATE_TRANSPARENCY_EXPECTED_LOG_ID=sha256:<64-hex-managed-log-id>

CATCHPLATE_APPARMOR_EXPECTED_PROFILE=catchplate-docker

CATCHPLATE_METADATA_STORE_BACKEND=postgres
CATCHPLATE_METADATA_STORE_POSTGRES_DSN=postgresql://catchplate:<password>@metadata-store/catchplate
CATCHPLATE_METADATA_STORE_FAULT_DOMAIN_ID=aws:control-plane-account:us-east-1a
CATCHPLATE_GRANT_STORE_BACKEND=postgres
# Atomic release authorization requires the exact same writer DSN and schema.
CATCHPLATE_GRANT_STORE_POSTGRES_DSN=postgresql://catchplate:<password>@metadata-store/catchplate
CATCHPLATE_AUDIT_STORE_BACKEND=postgres
CATCHPLATE_AUDIT_STORE_POSTGRES_DSN=postgresql://catchplate:<password>@audit-store/catchplate
CATCHPLATE_CONTROL_PLANE_GRANT_CONSUME_URL=https://catchplate.internal/api/data-plane/grants/consume
CATCHPLATE_CONTROL_PLANE_RATE_LIMIT_CONSUME_URL=https://catchplate.internal/api/data-plane/rate-limits/consume
CATCHPLATE_CONTROL_PLANE_RELEASE_AUTHORIZATION_BASE_URL=https://catchplate.internal/api/data-plane/release-authorizations
CATCHPLATE_ATOMIC_RELEASE_AUTHORIZATION_ENABLED=1
CATCHPLATE_RELEASE_AUTHORIZATION_RESERVATION_TTL_SECONDS=15
CATCHPLATE_RELEASE_AUTHORIZATION_DISPATCH_TTL_SECONDS=30
CATCHPLATE_RELEASE_AUTHORIZATION_RECONCILE_LIMIT=100
CATCHPLATE_DATA_PLANE_CREDENTIAL_LEASE_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-credential-lease-token
CATCHPLATE_DATA_PLANE_AUDIT_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-audit-token
CATCHPLATE_DATA_PLANE_GRANT_CONSUME_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-grant-consume-token
CATCHPLATE_DATA_PLANE_RATE_LIMIT_CONSUME_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-rate-limit-consume-token
CATCHPLATE_DATA_PLANE_RELEASE_AUTHORIZATION_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-release-authorization-token
CATCHPLATE_DATA_PLANE_MANAGEMENT_TOKEN_FILE=/etc/catchplate/service-credentials/data-plane-management-token
CATCHPLATE_AUDIT_ANCHOR_TOKEN_FILE=/etc/catchplate/service-credentials/audit-anchor-token
CATCHPLATE_AUDIT_ANCHOR_INTERVAL_SECONDS=2
CATCHPLATE_AUDIT_ANCHOR_TIMEOUT_SECONDS=10

CATCHPLATE_AGENT_EGRESS_POLICY_REQUIRED=1
CATCHPLATE_AGENT_EGRESS_POLICY_MODE=kubernetes-network-policy
CATCHPLATE_AGENT_EGRESS_PROXY_CIDRS=10.42.0.10/32,10.42.0.11/32
CATCHPLATE_AGENT_EGRESS_PROXY_PORT=8080
CATCHPLATE_AGENT_ENROLLMENT_PACKET_REQUIRED=1

CATCHPLATE_PRODUCTION_IMAGE_NO_SHELL_REQUIRED=1
CATCHPLATE_PRODUCTION_IMAGE_PULL=1
CATCHPLATE_PRODUCTION_IMAGES=registry.prod.catchplate.dev/catchplate/control@sha256:<64-hex-digest>,registry.prod.catchplate.dev/catchplate/decision-gate@sha256:<64-hex-digest>
CATCHPLATE_CONTROL_PLANE_IMAGE=registry.prod.catchplate.dev/catchplate/control@sha256:<64-hex-digest>
CATCHPLATE_DECISION_GATE_IMAGE=registry.prod.catchplate.dev/catchplate/decision-gate@sha256:<64-hex-digest>
