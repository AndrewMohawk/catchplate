# Copy to ops/production-readiness.env on the production Linux host and replace
# every placeholder. scripts/run_production_readiness.py rejects placeholder
# values and does not print env values in dry-run output.
#
# Final mode has an explicit launcher trust root outside this file. A root-owned
# native launcher supplies these two inputs plus a sealed bootstrap-receipt memfd
# separately to the runner, preflight, and direct verifier:
#   SERVERWARE_LAUNCHER_TRUSTED_PRODUCTION_ENV_PATH=/etc/serverware/production-readiness.env
#   SERVERWARE_LAUNCHER_TRUSTED_PRODUCTION_ENV_SHA256=sha256:<independently-approved-env-digest>
# Do not add those assignments to this env: final mode rejects self-authorizing
# launcher inputs. Install the exact env at the absolute trusted path as a
# root/current-owned regular non-symlink file with mode 0400 or 0600, beneath
# non-symlink ancestors that are not writable by group/other. The launcher is
# necessarily the trust root for selecting that path and digest. Final mode uses
# the root-owned static serverware-production-launcher systemd service. It opens
# and hashes every executable input once, clears the ambient environment, executes
# Python and both scripts from verified descriptors, and passes an immutable
# serverware.bootstrapReceipt/v2 memfd, including the signed off-host launch
# authorization, through the signed preflight to completion.
# The launch manifest fixes sys.path to the measured release root, CPython
# stdlib, its direct lib-dynload extension-module directory, and vendor root in
# that order. All four directories and every contained byte must be deployed in
# the immutable release before manifest generation; omissions fail closed.
# The launcher validates the selected interpreter as Linux x86-64 ELF64 with a
# Py_BytesMain dynamic symbol and matching libpython3.11 dependency. This does
# not yet close PT_INTERP or the recursive system-DSO loader graph; those host
# dependencies remain part of the explicit production-host boundary.
# Root, the kernel, systemd, the installed launcher, and the immutable release
# mount remain explicit trust roots. Starting Make/Python from an ambient shell
# does not satisfy this contract.
SERVERWARE_FINAL_LAUNCHER_CONTRACT=descriptor-sealed-bootstrap-v2

SERVERWARE_RELEASE_CHANNEL=prod
# Change both this value and the runner's --verification-mode to final only
# when all final hardware and off-host challenge settings below are present.
SERVERWARE_COMPLETION_VERIFICATION_MODE=readiness
SERVERWARE_PUBLIC_URL=https://serverware.example
# Keep the agent-facing proxy on loopback unless external firewall/source
# allowlist evidence is part of deployment acceptance.
SERVERWARE_PROXY_BIND_ADDRESS=127.0.0.1
SERVERWARE_CONTROL_PLANE_TLS_DIR=/etc/serverware/control-plane-tls
SERVERWARE_AUDIT_ANCHOR_TLS_DIR=/etc/serverware/audit-anchor-tls
SERVERWARE_PRODUCTION_CONTROL_PLANE_BASE=https://serverware:3000
SERVERWARE_ATTESTATION_HELPER_DIR=/opt/serverware/attestation-helpers
# Absolute, non-symlink release interpreter selected by the hashed release env.
# Final-mode CLI use must match this path, and its exact bytes are pinned in
# SERVERWARE_ATTESTATION_EXECUTABLE_SHA256_MANIFEST below.
SERVERWARE_PRODUCTION_PYTHON_EXECUTABLE=/opt/serverware/releases/<source-digest>/runtime/python/bin/python3
# Absolute Docker CLI selected by the hashed env. Final Linux execution opens,
# measures, and executes these exact bytes through the retained descriptor.
SERVERWARE_DOCKER_EXECUTABLE=/usr/bin/docker
# Compose is executed directly through this independently byte-pinned plugin;
# Docker CLI plugin discovery and ambient Docker/Compose settings are forbidden.
SERVERWARE_DOCKER_COMPOSE_PLUGIN_EXECUTABLE=/usr/libexec/docker/cli-plugins/docker-compose
SERVERWARE_DOCKER_COMPOSE_PLUGIN_SHA256=sha256:<64-lowercase-hex>
# Final mode accepts only this root-owned, non-symlink local Unix socket and
# requires `docker info --format '{{.ID}}'` to match this daemon identity.
SERVERWARE_DOCKER_UNIX_SOCKET=/run/docker.sock
SERVERWARE_DOCKER_DAEMON_ID=<independently-approved-local-daemon-id>
# Stable Compose namespace pinned by the authenticated env and supplied with
# --project-name for rendering and every live service-ID lookup.
SERVERWARE_DOCKER_COMPOSE_PROJECT_NAME=serverware-production
# Python runs with -I and executes all three exact one-open script byte sets
# through retained /proc/self/fd descriptors. These script pins are separate
# from the fixed nine-entry host executable manifest below.
SERVERWARE_PRODUCTION_HOST_PREFLIGHT_SCRIPT_SHA256=sha256:<64-lowercase-hex>
SERVERWARE_VERIFY_PRODUCTION_READINESS_SCRIPT_SHA256=sha256:<64-lowercase-hex>
SERVERWARE_VERIFY_RELEASE_COMPLETION_SCRIPT_SHA256=sha256:<64-lowercase-hex>
# Final host preflight is short-lived and Ed25519-authenticated. The private key
# remains root-owned mode 0600 on the production host; completion snapshots only
# the independently pinned public key and requires exact key-ID and age policy.
SERVERWARE_PRODUCTION_HOST_PREFLIGHT_SIGNING_PRIVATE_KEY=/etc/serverware/release-trust/preflight-signing.key.pem
SERVERWARE_PRODUCTION_HOST_PREFLIGHT_SIGNING_PUBLIC_KEY=/etc/serverware/release-trust/preflight-signing.pub.pem
SERVERWARE_PRODUCTION_HOST_PREFLIGHT_SIGNING_KEY_ID=sha256:<64-hex-preflight-signing-spki-digest>
SERVERWARE_PRODUCTION_HOST_PREFLIGHT_MAX_AGE_SECONDS=300
SERVERWARE_RELEASE_PROVENANCE_FILE=/opt/serverware/release/release-provenance.json
SERVERWARE_IMAGE_SIGNATURES_FILE=/opt/serverware/release/image-signatures.json
# Existing owner-only Ed25519 private key used by the release builder. The
# generator never creates this key in production and verifies it against the
# independently provisioned public trust root below before signing.
SERVERWARE_RELEASE_PROVENANCE_SIGNING_KEY=/etc/serverware/release-signing/release-provenance.pem
# Independent release-verifier trust roots must be absolute paths to bounded,
# regular, non-symlink public-key files (maximum 65536 bytes). The Sigstore,
# Rekor, and external checkpoint key IDs below are SHA-256 digests of SPKI DER.
SERVERWARE_RELEASE_PROVENANCE_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/release-provenance.pub.pem
SERVERWARE_SIGSTORE_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/sigstore.pub.pem
SERVERWARE_REKOR_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/rekor.pub.pem
SERVERWARE_EXTERNAL_CHECKPOINT_PROVIDER=managed-prod-log
SERVERWARE_EXTERNAL_CHECKPOINT_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/external-checkpoint.pub.pem
# Final mode also binds the three CLI-selected policy/reproducibility verifier
# roots to these exact paths and independently computed SPKI DER digests. The
# policy identity, activation, and reproducibility roles must use three distinct
# public keys; the existing response/release role separation remains enforced.
SERVERWARE_POLICY_IDENTITY_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/policy-identity.pub.pem
SERVERWARE_POLICY_IDENTITY_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-policy-identity-spki-digest>
SERVERWARE_POLICY_ACTIVATION_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/policy-activation.pub.pem
SERVERWARE_POLICY_ACTIVATION_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-policy-activation-spki-digest>
SERVERWARE_REPRODUCIBLE_BUILD_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/reproducible-build.pub.pem
SERVERWARE_REPRODUCIBLE_BUILD_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-reproducible-build-spki-digest>
# Final verification only. Readiness mode rejects these settings when
# uncommented. The receipt is issued after atomic off-host challenge
# consumption and its authority key must be a pinned Ed25519 public key. The
# independently configured SPKI IDs must match the loaded key bytes exactly,
# and the hardware-verifier and challenge-authority IDs must differ. The v1
# receipt commits serverware.finalCompletionIdentity/v1.
# SERVERWARE_HARDWARE_ASSURANCE=/var/lib/serverware/hardware-assurance.json
# SERVERWARE_HARDWARE_ASSURANCE_TRUSTED_PUBLIC_KEY=/etc/serverware/release-trust/hardware-verifier.pub.pem
# SERVERWARE_HARDWARE_ASSURANCE_TRUSTED_PUBLIC_KEY_ID=sha256:<64-hex-hardware-verifier-spki-digest>
# Set exactly one expected challenge form.
# SERVERWARE_HARDWARE_ASSURANCE_EXPECTED_CHALLENGE_NONCE=<unpadded-base64url-32-plus-byte-nonce>
# SERVERWARE_HARDWARE_ASSURANCE_EXPECTED_CHALLENGE_NONCE_SHA256=sha256:<64-lowercase-hex>
# SERVERWARE_FINAL_CHALLENGE_RECEIPT=/var/lib/serverware/final-challenge-receipt.json
# SERVERWARE_FINAL_CHALLENGE_AUTHORITY_PUBLIC_KEY=/etc/serverware/release-trust/final-challenge-authority.pub.pem
# SERVERWARE_FINAL_CHALLENGE_AUTHORITY_PUBLIC_KEY_ID=sha256:<64-hex-final-authority-spki-digest>
# SERVERWARE_FINAL_CHALLENGE_AUTHORITY_PROVIDER=production-final-challenge-authority
# Service-token files must be absolute, regular, non-symlink files containing
# exactly one UTF-8 token with no leading/trailing whitespace or newline.
# Keep the admin and bootstrap files owned by 65532:65532 with mode 0400 or
# 0600. Keep shared data-plane and audit-anchor files owned by root:65530 with
# mode 0440 so both production runtimes can read only their mounted copies.
# Every token value must be independently generated and distinct.
SERVERWARE_ADMIN_TOKEN_FILE=/etc/serverware/service-credentials/admin-token
SERVERWARE_ADMIN_ROLES=admin,approver,auditor,policy_author,policy_publisher,credential_owner,attestation_operator,attestation_reviewer

# OAuth client secrets stay in host files owned by UID 65532 with mode 0400 or
# 0600. Host preflight verifies that the non-root control-plane container can
# read the bind mounts without exposing their values.
SERVERWARE_OAUTH_STATE_TTL_SECONDS=600
SERVERWARE_OAUTH_PENDING_CREDENTIAL_TTL_SECONDS=900
SERVERWARE_OAUTH_PENDING_CREDENTIAL_MAX_COUNT=1000
SERVERWARE_SETUP_SESSION_TTL_SECONDS=86400
SERVERWARE_SETUP_SESSION_MAX_ACTIVE=1000
SERVERWARE_SETUP_SESSION_MAX_RETAINED=10000
SERVERWARE_SETUP_SESSION_RETENTION_SECONDS=604800
SERVERWARE_SETUP_SESSION_EVIDENCE_MAX_BYTES=1048576
SERVERWARE_SETUP_SESSION_EVIDENCE_MAX_COUNT=64
SERVERWARE_SETUP_SESSION_EVENT_MAX_BYTES=16384
SERVERWARE_SETUP_SESSION_EVENT_MAX_COUNT=128
SERVERWARE_SETUP_SESSION_AUDIT_OUTBOX_MAX_PENDING=10000
SERVERWARE_SETUP_SESSION_AUDIT_CLAIM_TTL_SECONDS=60
SERVERWARE_SETUP_ENROLLMENT_VERIFIER_PUBLIC_KEY=/etc/serverware/setup-trust/enrollment-verifier.pub.pem
SERVERWARE_SETUP_ENROLLMENT_VERIFIER_KEY_ID=sha256:<64-hex-enrollment-verifier-spki-digest>
SERVERWARE_SETUP_ENROLLMENT_VERIFIER_PROVIDER=production-enrollment-verifier
SERVERWARE_SETUP_HARDWARE_VERIFIER_PUBLIC_KEY=/etc/serverware/setup-trust/hardware-verifier.pub.pem
SERVERWARE_SETUP_HARDWARE_VERIFIER_KEY_ID=sha256:<64-hex-hardware-verifier-spki-digest>
SERVERWARE_SETUP_HARDWARE_VERIFIER_PROVIDER=production-hardware-verifier
SERVERWARE_SETUP_FINAL_AUTHORITY_PUBLIC_KEY=/etc/serverware/setup-trust/final-authority.pub.pem
SERVERWARE_SETUP_FINAL_AUTHORITY_KEY_ID=sha256:<64-hex-final-authority-spki-digest>
SERVERWARE_SETUP_FINAL_AUTHORITY_PROVIDER=production-setup-final-authority
SERVERWARE_SETUP_ATTESTATION_CHALLENGE_TTL_SECONDS=300
SERVERWARE_CREDENTIAL_LEASE_REPLAY_MAX_ENTRIES=1000000
SERVERWARE_GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
SERVERWARE_GOOGLE_OAUTH_CLIENT_SECRET_FILE=/etc/serverware/oauth/google-client-secret
SERVERWARE_GOOGLE_OAUTH_REDIRECT_URI=https://serverware.example/api/oauth/callback/google
SERVERWARE_X_OAUTH_CLIENT_ID=<x-oauth-client-id>
SERVERWARE_X_OAUTH_CLIENT_SECRET_FILE=/etc/serverware/oauth/x-client-secret
SERVERWARE_X_OAUTH_REDIRECT_URI=https://serverware.example/api/oauth/callback/x

SERVERWARE_OIDC_ENABLED=1
SERVERWARE_OIDC_ISSUER=https://idp.example
SERVERWARE_OIDC_AUDIENCE=serverware-control-plane
SERVERWARE_OIDC_JWKS_JSON='<pinned-jwks-json>'
SERVERWARE_OIDC_ROLE_CLAIM=serverware_roles
SERVERWARE_OIDC_BROWSER_LOGIN_ENABLED=1
SERVERWARE_OIDC_AUTHORIZATION_ENDPOINT=https://idp.example/authorize
SERVERWARE_OIDC_TOKEN_ENDPOINT=https://idp.example/token
SERVERWARE_OIDC_CLIENT_ID=serverware-control-plane
SERVERWARE_OIDC_CLIENT_SECRET_FILE=/etc/serverware/oauth/oidc-client-secret
SERVERWARE_OIDC_REDIRECT_URI=https://serverware.example/api/auth/oidc/callback
SERVERWARE_OIDC_BROWSER_SCOPES=openid,profile,email
SERVERWARE_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
SERVERWARE_OIDC_LOGIN_STATE_TTL_SECONDS=300
SERVERWARE_OIDC_SESSION_TTL_SECONDS=3600
SERVERWARE_OIDC_SESSION_WEBAUTHN_REQUIRED=1
SERVERWARE_OIDC_SESSION_WEBAUTHN_CHALLENGE_TTL_SECONDS=120
SERVERWARE_OIDC_SESSION_WEBAUTHN_PENDING_TTL_SECONDS=300
SERVERWARE_OIDC_SESSION_ACTIVATION_RETRY_TTL_SECONDS=20
SERVERWARE_WEBAUTHN_RECOVERY_ENABLED=1
# Public half only. Keep the offline Ed25519 private key outside every
# Serverware host, container, agent environment, and copied handoff command.
SERVERWARE_WEBAUTHN_RECOVERY_ROOT_PUBLIC_KEY=/etc/serverware/webauthn-recovery/offline-root.pub.pem
SERVERWARE_WEBAUTHN_RECOVERY_ROOT_KEY_ID=sha256:<64-hex-offline-recovery-root-spki-digest>
SERVERWARE_WEBAUTHN_RECOVERY_ROOT_PROVIDER=offline-recovery-authority
SERVERWARE_WEBAUTHN_RECOVERY_AUDIENCE=https://serverware.example
# Public identities for startup/readiness collision checks. Private keys remain online.
SERVERWARE_POLICY_SIGNING_PUBLIC_KEY=/etc/serverware/gate/policy-signing-ed25519.pub.pem
# Pre-provision this Ed25519 PKCS#8 key with mode 0400 or 0600 and ownership
# readable by the production control-plane UID. Compose mounts it read-only.
SERVERWARE_RESPONSE_SIGNING_PRIVATE_KEY_FILE=/etc/serverware/runtime/response-signing-ed25519.pem
SERVERWARE_RESPONSE_SIGNING_PUBLIC_KEY=/etc/serverware/runtime/response-signing-ed25519.pub.pem
# Independent verifier pin for dispatch receipts embedded in proxy response proofs.
# It must resolve to the same public key bytes as SERVERWARE_RESPONSE_SIGNING_PUBLIC_KEY.
SERVERWARE_CONTROL_PLANE_RESPONSE_SIGNING_PUBLIC_KEY=/etc/serverware/runtime/response-signing-ed25519.pub.pem
SERVERWARE_CONTROL_PLANE_RESPONSE_SIGNING_PUBLIC_KEY_ID=sha256:<64-hex-response-signing-spki-digest>
SERVERWARE_WEBAUTHN_TRUST_SIGNING_PUBLIC_KEY=/etc/serverware/runtime/webauthn-trust-signing-ed25519.pub.pem
SERVERWARE_WEBAUTHN_RECOVERY_TTL_SECONDS=180
SERVERWARE_WEBAUTHN_RECOVERY_MAX_LIVE=100
SERVERWARE_WEBAUTHN_RECOVERY_TERMINAL_RETENTION_SECONDS=7776000
SERVERWARE_WEBAUTHN_RECOVERY_MAX_RETAINED=100000
SERVERWARE_WEBAUTHN_RECOVERY_CREDENTIAL_HISTORY_MAX_COUNT=1000
SERVERWARE_WEBAUTHN_RECOVERY_CREDENTIAL_HISTORY_MAX_BYTES=4194304
SERVERWARE_WEBAUTHN_RECOVERY_EXCLUDE_CREDENTIALS_MAX_COUNT=1000
SERVERWARE_WEBAUTHN_RECOVERY_EXCLUDE_CREDENTIALS_MAX_BYTES=1048576
SERVERWARE_WEBAUTHN_RECOVERY_WITNESS_BACKEND=postgres
# This must resolve to a different PostgreSQL cluster and fault domain from metadata.
# Both database roles must be allowed to execute pg_control_system().
SERVERWARE_WEBAUTHN_RECOVERY_WITNESS_POSTGRES_DSN=postgresql://serverware-witness:<password>@witness-db.example:5432/serverware_witness
SERVERWARE_WEBAUTHN_RECOVERY_WITNESS_FAULT_DOMAIN_ID=aws:recovery-account:us-east-1b
SERVERWARE_WEBAUTHN_RECOVERY_WITNESS_CONNECT_TIMEOUT_SECONDS=5
SERVERWARE_WEBAUTHN_CHALLENGE_GLOBAL_LIVE_MAX=50000
SERVERWARE_WEBAUTHN_CHALLENGE_USER_LIVE_MAX=64
SERVERWARE_WEBAUTHN_CHALLENGE_GLOBAL_RATE_MAX=10000
SERVERWARE_WEBAUTHN_CHALLENGE_USER_RATE_MAX=120
SERVERWARE_WEBAUTHN_CHALLENGE_RATE_WINDOW_SECONDS=60
SERVERWARE_WEBAUTHN_CHALLENGE_TERMINAL_RETENTION_SECONDS=900
SERVERWARE_WEBAUTHN_CHALLENGE_MAX_RETAINED=100000
SERVERWARE_WEBAUTHN_ORIGIN=https://serverware.example
SERVERWARE_CONTROL_PLANE_MUTATION_WEBAUTHN_REQUIRED=1
SERVERWARE_CONTROL_PLANE_MUTATION_REQUIRE_HARDWARE_ATTESTATION=1
SERVERWARE_CONTROL_PLANE_MUTATION_ALLOWED_AUTHENTICATOR_CLASSES=yubikey,hardware
SERVERWARE_DIRECT_CA_DOWNLOAD_ENABLED=0
SERVERWARE_CA_INSTALL_SESSION_TTL_SECONDS=300
SERVERWARE_CONTROL_PLANE_TWO_PERSON_REQUIRED=1
SERVERWARE_CONTROL_PLANE_TWO_PERSON_ACTIONS=credential.create,credential.oauth.activate,credential.oauth.uncertain.resolve,credential.update,credential.delete,route.create,route.update,route.delete,policy.publish,webauthn.credential.register,webauthn.credential.revoke,webauthn.trust.publish,rbac.role.change,rbac.deprovision,control_plane.token.rotate,break_glass.grant,setup.attestation.finalize
SERVERWARE_WEBAUTHN_BOOTSTRAP_TOKEN_FILE=/etc/serverware/service-credentials/webauthn-bootstrap-token
SERVERWARE_POLICY_PUBLISH_DRY_RUN_REQUIRED=1
SERVERWARE_POLICY_CANARY_REQUIRED=1
SERVERWARE_POLICY_CANARY_MIN_OBSERVATION_SECONDS=60
SERVERWARE_POLICY_CANARY_MIN_AUDIT_EVENTS=10
SERVERWARE_POLICY_CANARY_MAX_DENIALS=0

SERVERWARE_TEE_QUOTE_PROVIDER=aws-nitro-enclaves
SERVERWARE_TEE_PLATFORM=aws-nitro
SERVERWARE_TEE_QUOTE_COMMAND='python3 scripts/aws_nitro_tee_provider.py quote'
SERVERWARE_TEE_QUOTE_VERIFY_COMMAND='python3 scripts/aws_nitro_tee_provider.py verify'
SERVERWARE_KEY_RELEASE_REQUIRED=1
SERVERWARE_KEY_RELEASE_COMMAND='python3 scripts/aws_nitro_tee_provider.py release'
SERVERWARE_MASTER_KEY_UNSEAL_COMMAND='/usr/bin/python3 /app/scripts/aws_nitro_kms_unseal.py unseal'
SERVERWARE_NITRO_NSM_UNSEAL_COMMAND_TEMPLATE='/opt/serverware/bin/nsm-unseal --ciphertext {recipient_ciphertext_path}'
SERVERWARE_NITRO_NSM_UNSEAL_OUTPUT_FORMAT=json
SERVERWARE_KEY_RELEASE_ALLOW_DEBUG=0
SERVERWARE_KEY_RELEASE_MIN_ROLLBACK_EPOCH=1
SERVERWARE_KEY_RELEASE_REQUIRE_DATA_PLANE_DIGEST=1
SERVERWARE_NITRO_ATTESTATION_COMMAND='python3 scripts/nitro_nsm_attest.py attest'
SERVERWARE_NITRO_NSM_ATTEST_COMMAND_TEMPLATE='/opt/serverware/bin/nsm-attest --user-data {user_data_path} --out {output_path}'
SERVERWARE_NITRO_ROOT_CERT=/etc/serverware/nitro-root.pem
SERVERWARE_NITRO_EXPECTED_PCRS='<json-object-of-pcr-number-to-sha384-hex>'
SERVERWARE_NITRO_REQUIRE_KMS_COMMAND=1
SERVERWARE_NITRO_KMS_RELEASE_COMMAND='python3 scripts/aws_kms_recipient_release.py release --materials-file /run/serverware/nitro/kms-materials.json'
SERVERWARE_NITRO_KMS_MATERIALS_FILE=/etc/serverware/kms-materials.json
SERVERWARE_NITRO_ALLOWED_MATERIALS=broker-kek,decision-gate-ca
SERVERWARE_DATA_PLANE_RECIPIENT_ATTESTATION_COMMAND='/opt/serverware/bin/lease-recipient-attest'
SERVERWARE_DATA_PLANE_RESPONSE_PROOF_ATTESTATION_COMMAND='/opt/serverware/bin/response-proof-attest'
SERVERWARE_DATA_PLANE_INSTANCE_ID=spiffe://prod.serverware.internal/decision-gate/instance-01
SERVERWARE_POLICY_MIN_SEQUENCE=1
SERVERWARE_POLICY_MIN_ROLLBACK_EPOCH=1
SERVERWARE_DATA_PLANE_LEASE_RECIPIENT_ATTESTATION_REQUIRED=1
SERVERWARE_DATA_PLANE_LEASE_RECIPIENT_VERIFY_COMMAND='/opt/serverware/bin/lease-recipient-verify'
SERVERWARE_CONTROL_PLANE_ATTESTATION_VERIFY_COMMAND='/opt/serverware/bin/control-plane-attestation-verify'
# Closed byte-pin manifest for every host-mounted attestation executable and
# the response-proof collector, production Python, and Docker. Keys must match
# this exact nine-entry set;
# compute each digest from the independently approved executable bytes.
SERVERWARE_ATTESTATION_EXECUTABLE_SHA256_MANIFEST='{"SERVERWARE_CONTROL_PLANE_ATTESTATION_VERIFY_COMMAND":"sha256:<64-lowercase-hex>","SERVERWARE_DATA_PLANE_LEASE_RECIPIENT_VERIFY_COMMAND":"sha256:<64-lowercase-hex>","SERVERWARE_DATA_PLANE_RECIPIENT_ATTESTATION_COMMAND":"sha256:<64-lowercase-hex>","SERVERWARE_DATA_PLANE_RESPONSE_PROOF_ATTESTATION_COMMAND":"sha256:<64-lowercase-hex>","SERVERWARE_DOCKER_EXECUTABLE":"sha256:<64-lowercase-hex>","SERVERWARE_NITRO_NSM_ATTEST_COMMAND_TEMPLATE":"sha256:<64-lowercase-hex>","SERVERWARE_NITRO_NSM_UNSEAL_COMMAND_TEMPLATE":"sha256:<64-lowercase-hex>","SERVERWARE_PRODUCTION_PYTHON_EXECUTABLE":"sha256:<64-lowercase-hex>","SERVERWARE_PROXY_PROOF_COLLECTOR_COMMAND":"sha256:<64-lowercase-hex>"}'
SERVERWARE_EXPECTED_DATA_PLANE_BINARY_DIGEST=sha256:<64-hex-measured-decision-gate-digest>

# External response-proof collector. The readiness runner generates a fresh
# nonce and collects after live readiness. The release pipeline/operator must
# compute the three expected digests below independently from the intended
# canonical client request, canonical dispatched request, and policy operation
# preimages. The collector is checked against these pins and supplies only the
# fresh response proof and TLS channel binding; it is not trusted to select the
# expected request or operation digests.
SERVERWARE_PROXY_RESPONSE_PROOF_FILE=/opt/serverware/release/proxy-response-proof.json
SERVERWARE_PROXY_PROOF_CONTRACT=buffered-v3
# For a fully buffered, all-method response-observation proof, set the contract
# above to observation-v1. It uses the same independently pinned expected
# client-request, dispatched-request, operation, nonce, TLS, and trust inputs
# and requires the separately published body snapshot settings below. The
# completion verifier reopens this regular non-symlink file, enforces the bound,
# and matches its exact digest and byte count to the collector and signed runtime
# statement.
# SERVERWARE_PROXY_OBSERVATION_BODY_FILE=/opt/serverware/release/proxy-response-observation-body.bin
# SERVERWARE_PROXY_PROOF_MAX_OBSERVATION_BODY_BYTES=16777216
# These observation settings are forbidden for buffered-v3 and streaming-v1.
# For a streaming-v1 production proof, set the contract above to streaming-v1
# and pin all three settings below in this same hashed environment file.
# SERVERWARE_PROXY_STREAM_BODY_FILE=/opt/serverware/release/proxy-response-body.bin
# SERVERWARE_PROXY_PROOF_MAX_STREAM_BYTES=67108864
# SERVERWARE_PROXY_EXPECTED_OPERATION_CONTEXT_DIGEST=sha256:<64-lowercase-hex>
SERVERWARE_PROXY_PROOF_COLLECTOR_COMMAND='/opt/serverware/bin/serverware-proof-client'
SERVERWARE_PROXY_PROOF_ADDRESS=proxy.prod.internal:8080
SERVERWARE_PROXY_PROOF_URL=https://proof-target.prod.internal/health
SERVERWARE_PROXY_PROOF_CA_BUNDLE=/etc/serverware/proxy-ca.pem
# Both values must select one principal in the exact active signed policy, and
# that principal must be authorized for the GET URL above.
SERVERWARE_PROXY_PROOF_AGENT_ID=<active-policy-agent-header>
SERVERWARE_PROXY_PROOF_PRINCIPAL_ID=<active-policy-principal-id>
SERVERWARE_PROXY_PROOF_COLLECTOR_PRIVATE_KEY=/etc/serverware/proof-collector.key.pem
SERVERWARE_PROXY_PROOF_COLLECTOR_PUBLIC_KEY=/etc/serverware/proof-collector.pub.pem
SERVERWARE_PROXY_PROOF_COLLECTOR_KEY_ID=sha256:<64-hex-collector-spki-digest>
SERVERWARE_PROXY_PROOF_VERIFIER_PUBLIC_KEY=/etc/serverware/proxy-proof-verifier.pub.pem
SERVERWARE_PROXY_PROOF_VERIFIER_KEY_ID=sha256:<64-hex-verifier-spki-digest>
SERVERWARE_PROXY_EXPECTED_CLIENT_REQUEST_DIGEST=sha256:<64-lowercase-hex>
SERVERWARE_PROXY_EXPECTED_REQUEST_DIGEST=sha256:<64-lowercase-hex>
SERVERWARE_PROXY_EXPECTED_OPERATION_DIGEST=sha256:<64-lowercase-hex>
SERVERWARE_PROXY_PROOF_MAX_AGE_SECONDS=300
# Final completion uses this exact hashed benchmark policy; CLI overrides must
# match rather than selecting a weaker threshold.
SERVERWARE_COMPLETION_P99_LIMIT_MS=20.0

SERVERWARE_IMAGE_SIGNATURE_PROVIDER=sigstore-command
SERVERWARE_IMAGE_SIGN_COMMAND='python3 scripts/cosign_sigstore.py sign'
SERVERWARE_IMAGE_VERIFY_COMMAND='python3 scripts/cosign_sigstore.py verify'
SERVERWARE_COSIGN_BINARY=cosign
SERVERWARE_COSIGN_KEY=awskms://arn:aws:kms:us-east-1:111122223333:key/serverware-signing
SERVERWARE_COSIGN_KEY_ID=sha256:<64-hex-key-provider-id>
SERVERWARE_COSIGN_EXPECTED_REKOR_LOG_ID=sha256:<64-hex-rekor-log-id>
SERVERWARE_REQUIRE_SIGSTORE_TRANSPARENCY=1

# Independently operated append-only release evidence anchor. Both release
# provenance and image-signature records are published here before deployment.
SERVERWARE_RELEASE_ANCHOR_BASE=https://release-anchor.example.net
# Set this only when the anchor uses a private CA.
# SERVERWARE_RELEASE_ANCHOR_CA_BUNDLE=/etc/serverware/release-anchor-ca.pem

SERVERWARE_TRANSPARENCY_CHECKPOINT_REQUIRED=1
SERVERWARE_TRANSPARENCY_CHECKPOINT_COMMAND='python3 scripts/transparency_checkpoint.py checkpoint'
SERVERWARE_TRANSPARENCY_CHECKPOINT_MODE=http
SERVERWARE_TRANSPARENCY_LOG_URL=https://transparency.example/checkpoints
SERVERWARE_TRANSPARENCY_EXPECTED_PROVIDER=managed-prod-log
SERVERWARE_TRANSPARENCY_EXPECTED_LOG_ID=sha256:<64-hex-managed-log-id>

SERVERWARE_APPARMOR_EXPECTED_PROFILE=serverware-docker

SERVERWARE_METADATA_STORE_BACKEND=postgres
SERVERWARE_METADATA_STORE_POSTGRES_DSN=postgresql://serverware:<password>@metadata-store/serverware
SERVERWARE_METADATA_STORE_FAULT_DOMAIN_ID=aws:control-plane-account:us-east-1a
SERVERWARE_GRANT_STORE_BACKEND=postgres
# Atomic release authorization requires the exact same writer DSN and schema.
SERVERWARE_GRANT_STORE_POSTGRES_DSN=postgresql://serverware:<password>@metadata-store/serverware
SERVERWARE_AUDIT_STORE_BACKEND=postgres
SERVERWARE_AUDIT_STORE_POSTGRES_DSN=postgresql://serverware:<password>@audit-store/serverware
SERVERWARE_CONTROL_PLANE_GRANT_CONSUME_URL=https://serverware.internal/api/data-plane/grants/consume
SERVERWARE_CONTROL_PLANE_RATE_LIMIT_CONSUME_URL=https://serverware.internal/api/data-plane/rate-limits/consume
SERVERWARE_CONTROL_PLANE_RELEASE_AUTHORIZATION_BASE_URL=https://serverware.internal/api/data-plane/release-authorizations
SERVERWARE_ATOMIC_RELEASE_AUTHORIZATION_ENABLED=1
SERVERWARE_RELEASE_AUTHORIZATION_RESERVATION_TTL_SECONDS=15
SERVERWARE_RELEASE_AUTHORIZATION_DISPATCH_TTL_SECONDS=30
SERVERWARE_RELEASE_AUTHORIZATION_RECONCILE_LIMIT=100
SERVERWARE_DATA_PLANE_CREDENTIAL_LEASE_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-credential-lease-token
SERVERWARE_DATA_PLANE_AUDIT_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-audit-token
SERVERWARE_DATA_PLANE_GRANT_CONSUME_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-grant-consume-token
SERVERWARE_DATA_PLANE_RATE_LIMIT_CONSUME_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-rate-limit-consume-token
SERVERWARE_DATA_PLANE_RELEASE_AUTHORIZATION_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-release-authorization-token
SERVERWARE_DATA_PLANE_MANAGEMENT_TOKEN_FILE=/etc/serverware/service-credentials/data-plane-management-token
SERVERWARE_AUDIT_ANCHOR_TOKEN_FILE=/etc/serverware/service-credentials/audit-anchor-token
SERVERWARE_AUDIT_ANCHOR_INTERVAL_SECONDS=2
SERVERWARE_AUDIT_ANCHOR_TIMEOUT_SECONDS=10

SERVERWARE_AGENT_EGRESS_POLICY_REQUIRED=1
SERVERWARE_AGENT_EGRESS_POLICY_MODE=kubernetes-network-policy
SERVERWARE_AGENT_EGRESS_PROXY_CIDRS=10.42.0.10/32,10.42.0.11/32
SERVERWARE_AGENT_EGRESS_PROXY_PORT=8080
SERVERWARE_AGENT_ENROLLMENT_PACKET_REQUIRED=1

SERVERWARE_PRODUCTION_IMAGE_NO_SHELL_REQUIRED=1
SERVERWARE_PRODUCTION_IMAGE_PULL=1
SERVERWARE_PRODUCTION_IMAGES=registry.prod.serverware.dev/serverware/control@sha256:<64-hex-digest>,registry.prod.serverware.dev/serverware/decision-gate@sha256:<64-hex-digest>
SERVERWARE_CONTROL_PLANE_IMAGE=registry.prod.serverware.dev/serverware/control@sha256:<64-hex-digest>
SERVERWARE_DECISION_GATE_IMAGE=registry.prod.serverware.dev/serverware/decision-gate@sha256:<64-hex-digest>
