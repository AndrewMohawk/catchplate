{
  "apiVersion": "catchplate.productionReadinessLaunch/v3",
  "authorization": {
    "authorizationScope": "trusted-host-readiness",
    "deploymentAudience": "production.us-east-1:primary",
    "deploymentIdentitySha256": "sha256:<64-lowercase-hex>",
    "freshnessAuthority": "trusted-host-wall-clock",
    "monotonicWitness": {
      "administrativeDomainSha256": "sha256:<independent-launch-witness-administrative-domain-64-lowercase-hex>",
      "identitySha256": "sha256:<independent-launch-witness-identity-64-lowercase-hex>",
      "signingKeyId": "sha256:<launch-witness-ed25519-spki-64-lowercase-hex>",
      "signingPublicKeySpkiDerBase64url": "<canonical-base64url-launch-witness-Ed25519-SPKI-DER>",
      "storeAssurance": {
        "apiVersion": "catchplate.launchAuthorityWitnessStoreAssurance/v1",
        "kind": "LaunchAuthorityWitnessStoreAssurance",
        "statement": {
          "assuranceIssuerKeyId": "sha256:<witness-store-assurance-issuer-spki-64-lowercase-hex>",
          "independentAdministration": true,
          "rollbackResistance": "externally-witnessed-monotonic",
          "storeAdministrativeDomainSha256": "sha256:<independent-witness-store-administrative-domain-64-lowercase-hex>",
          "storeClass": "independentlyAdministeredLinearizableCas",
          "storeIdentitySha256": "sha256:<independent-witness-store-identity-64-lowercase-hex>",
          "witnessAdministrativeDomainSha256": "sha256:<independent-launch-witness-administrative-domain-64-lowercase-hex>",
          "witnessIdentitySha256": "sha256:<independent-launch-witness-identity-64-lowercase-hex>",
          "witnessKeyId": "sha256:<launch-witness-ed25519-spki-64-lowercase-hex>"
        },
        "signature": "<canonical-base64url-64-byte-Ed25519-signature>"
      },
      "storeAssuranceIssuerKeyId": "sha256:<witness-store-assurance-issuer-spki-64-lowercase-hex>",
      "storeAssuranceIssuerPublicKeySpkiDerBase64url": "<canonical-base64url-witness-store-assurance-issuer-Ed25519-SPKI-DER>",
      "storeAssuranceSha256": "sha256:<canonical-witness-store-assurance-64-lowercase-hex>"
    },
    "releaseSequence": 1,
    "rollbackEpoch": 0
  },
  "composeFile": {
    "path": "/opt/catchplate/releases/<source-digest>/docker-compose.production.yml",
    "sha256": "sha256:<64-lowercase-hex>"
  },
  "globalRoleRegistry": {
    "apiVersion": "catchplate.productionLaunchGlobalRoleRegistryBinding/v1",
    "canonicalProfile": "catchplate.canonicalJson/integer-string-bool-null-array-object-nfc-v1",
    "claimScope": "roles-present-in-native-launch-contract",
    "pinsFile": {
      "path": "/etc/catchplate/production-launch-global-role-registry.json",
      "sha256": "sha256:<exact-canonical-registry-file-including-final-lf-64-lowercase-hex>"
    },
    "registry": {
      "apiVersion": "catchplate.productionLaunchGlobalRoleRegistry/v1",
      "claimScope": "roles-present-in-native-launch-contract",
      "roles": {
        "launchAuthority": "sha256:<launch-authority-spki-64-lowercase-hex>",
        "launchAuthorityWitness": "sha256:<launch-authority-witness-spki-64-lowercase-hex>",
        "launchAuthorityWitnessStoreAssurance": "sha256:<launch-authority-witness-store-assurance-spki-64-lowercase-hex>",
        "launchAuthorityWitnessTls": "sha256:<launch-authority-witness-tls-spki-64-lowercase-hex>",
        "nonceAuthorityAssuranceEvidence": "sha256:<nonce-authority-assurance-evidence-spki-64-lowercase-hex>",
        "nonceAuthorityVerifierState": "sha256:<nonce-authority-verifier-state-spki-64-lowercase-hex>",
        "nonceAuthorityVerifierStateStoreAttestation": "sha256:<nonce-authority-verifier-state-store-attestation-spki-64-lowercase-hex>",
        "policyActivation": "sha256:<policy-activation-spki-64-lowercase-hex>",
        "policyIdentity": "sha256:<policy-identity-spki-64-lowercase-hex>",
        "reproducibleBuild": "sha256:<reproducible-build-spki-64-lowercase-hex>"
      },
      "rolesOutsideClaim": [
        "actionGate",
        "publicAttestationNonceStore",
        "publicAttestationProducer",
        "publicAttestationWitnessStore",
        "finalVerifier",
        "nonceAuthorityVerifierStateStoreAssurance",
        "release",
        "response",
        "verifierStateTlsClient",
        "verifierStateTlsServer"
      ]
    },
    "registrySha256": "sha256:<canonical-registry-without-final-lf-64-lowercase-hex>"
  },
  "inputs": {
    "bench": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/decision-gate-rs-bench.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "imageSignatures": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/image-signatures.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "imageSignaturesSummary": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/image-signatures-summary.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "kmsMaterials": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/kms-materials.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyActivationSignature": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/policy-activation-verification.sig.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyActivationTrustedPublicKey": {
      "path": "/opt/catchplate/releases/<source-digest>/trust/policy-activation.pub.pem",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyActivationVerification": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/policy-activation-verification.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyBundle": {
      "path": "/opt/catchplate/releases/<source-digest>/policy/production-policy-bundle.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyIdentityVerification": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/production-policy-identity.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "policyTrustedPublicKey": {
      "path": "/opt/catchplate/releases/<source-digest>/trust/policy-identity.pub.pem",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "productionImagesBuild": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/production-images-build.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "productionImagesEnv": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/production-images.env",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "productionImagesPublished": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/production-images-published.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "releaseProvenance": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/release-provenance.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "releaseProvenanceSummary": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/release-provenance-summary.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "reproducibleBuildSignature": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/reproducible-build-verification.sig.json",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "reproducibleBuildTrustedPublicKey": {
      "path": "/opt/catchplate/releases/<source-digest>/trust/reproducible-build.pub.pem",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "reproducibleBuildVerification": {
      "path": "/opt/catchplate/releases/<source-digest>/evidence/reproducible-build-verification.json",
      "sha256": "sha256:<64-lowercase-hex>"
    }
  },
  "kind": "ProductionReadinessLaunch",
  "launchAttemptJournal": {
    "apiVersion": "catchplate.launchAuthorizationAttemptJournal/v1",
    "consistencyScope": "trusted-host-readiness-availability-and-consistency-only",
    "domain": "catchplate.launchAuthorizationAttemptJournal/v1",
    "lockPath": "/var/lib/catchplate/production-proof/launch-authorization-attempt.v1.lock",
    "maxBytes": 65536,
    "path": "/var/lib/catchplate/production-proof/launch-authorization-attempt.v1.json",
    "rollbackAuthority": "external-monotonic-witness"
  },
  "nonceRollbackAssurance": {
    "apiVersion": "catchplate.productionNonceRollbackAssuranceBinding/v1",
    "canonicalProfile": "catchplate.canonicalJson/integer-string-bool-null-array-object-nfc-v1",
    "contract": {
      "apiVersion": "catchplate.productionNonceRollbackAssurancePins/v1",
      "independentVerifierPins": {
        "expectedNonceAuthorityAssuranceIssuerSpkiSha256": "sha256:<independently-approved-assurance-issuer-spki-64-lowercase-hex>",
        "expectedNonceAuthorityAssuranceSha256": "sha256:<independently-approved-assurance-contract-64-lowercase-hex>"
      },
      "publicConfigPins": {
        "nonceAuthorityAssurance": {
          "administrativeDomainSha256": "sha256:<nonce-authority-administrative-domain-64-lowercase-hex>",
          "apiVersion": "catchplate.nonceAuthorityAssurance/v1",
          "assuranceEvidenceSha256": "sha256:<nonce-authority-assurance-evidence-64-lowercase-hex>",
          "assuranceEvidenceType": "linearizableCasOperatorAttestation",
          "assuranceLevel": "productionRollbackProtected",
          "authorityEpoch": 1,
          "authorityGeneration": 1,
          "authorityIdentitySha256": "sha256:<nonce-authority-identity-64-lowercase-hex>",
          "backendClass": "independentlyAdministeredLinearizableCas",
          "productionEligible": true,
          "rollbackProtection": {
            "administrativeRollbackResistance": true,
            "backendAttestationRequired": true,
            "exactSuccessorRequired": true,
            "freshVerifierChallengeRequired": true,
            "keyProtection": "nonExportableKmsHsm",
            "mechanism": "linearizableCasWithRollbackProtectedStorage",
            "stateCommitment": "hashChainedLinearizableCommitment",
            "verifierStateStoreClass": "independentlyAdministeredLinearizableCas"
          }
        },
        "nonceAuthorityAssuranceEvidenceSigningPublicKeySpkiDerBase64url": "<canonical-base64url-Ed25519-assurance-evidence-SPKI-DER>",
        "nonceAuthorityAssuranceSha256": "sha256:<independently-approved-assurance-contract-64-lowercase-hex>",
        "nonceAuthorityVerifierStateSigningPublicKeySpkiDerBase64url": "<canonical-base64url-Ed25519-verifier-state-SPKI-DER>",
        "nonceAuthorityVerifierStateStoreAdministrativeDomainSha256": "sha256:<independent-store-administrative-domain-64-lowercase-hex>",
        "nonceAuthorityVerifierStateStoreAssuranceEvidenceSha256": "sha256:<independent-store-assurance-evidence-64-lowercase-hex>",
        "nonceAuthorityVerifierStateStoreAttestationPublicKeySpkiDerBase64url": "<canonical-base64url-Ed25519-store-attestation-SPKI-DER>",
        "nonceAuthorityVerifierStateStoreIdentitySha256": "sha256:<independent-store-identity-64-lowercase-hex>"
      }
    },
    "contractSha256": "sha256:<canonical-contract-without-final-lf-64-lowercase-hex>",
    "enforcement": "native-launcher-measured",
    "pinsFile": {
      "path": "/etc/catchplate/nonce-rollback-assurance-pins.json",
      "sha256": "sha256:<canonical-pin-file-including-final-lf-64-lowercase-hex>"
    },
    "purpose": "readiness-only"
  },
  "outputs": {
    "claimsFile": "/var/lib/catchplate/production-proof/production-readiness-claims.json",
    "completionProofOut": "/var/lib/catchplate/production-proof/catchplate-completion-proof.json",
    "configOut": "/var/lib/catchplate/production-proof/production-readiness-config.json",
    "nitroEvidenceOut": "/var/lib/catchplate/production-proof/nitro-kms-evidence.json",
    "productionHostPreflight": "/var/lib/catchplate/production-proof/production-host-preflight.json",
    "proxyProofSummaryOut": "/var/lib/catchplate/production-proof/proxy-response-proof-summary.json",
    "readinessOut": "/var/lib/catchplate/production-proof/production-readiness.json"
  },
  "productionEnv": {
    "path": "/etc/catchplate/production-readiness.env",
    "sha256": "sha256:<64-lowercase-hex>"
  },
  "python": {
    "importRoots": [
      {
        "path": "/opt/catchplate/releases/<source-digest>",
        "sha256": "sha256:<catchplate-import-root-v1-tree-digest>"
      },
      {
        "path": "/opt/catchplate/releases/<source-digest>/runtime/python/lib/python3.11",
        "sha256": "sha256:<catchplate-import-root-v1-tree-digest>"
      },
      {
        "path": "/opt/catchplate/releases/<source-digest>/runtime/python/lib/python3.11/lib-dynload",
        "sha256": "sha256:<catchplate-import-root-v1-tree-digest>"
      },
      {
        "path": "/opt/catchplate/releases/<source-digest>/vendor",
        "sha256": "sha256:<catchplate-import-root-v1-tree-digest>"
      }
    ],
    "path": "/opt/catchplate/releases/<source-digest>/runtime/python/bin/python3",
    "sha256": "sha256:<64-lowercase-hex>"
  },
  "releaseRoot": "/opt/catchplate/releases/<source-digest>",
  "scripts": {
    "preflight": {
      "path": "/opt/catchplate/releases/<source-digest>/scripts/production_host_preflight.py",
      "sha256": "sha256:<64-lowercase-hex>"
    },
    "runner": {
      "path": "/opt/catchplate/releases/<source-digest>/scripts/run_production_readiness.py",
      "sha256": "sha256:<64-lowercase-hex>"
    }
  },
  "sourceTreeDigest": "sha256:<source-digest>",
  "stateDirectory": "/var/lib/catchplate/production-proof"
}
