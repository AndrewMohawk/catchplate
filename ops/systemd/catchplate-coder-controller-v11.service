[Unit]
Description=Catchplate Coder Controller v11 trusted-host execution broker
After=local-fs.target catchplate-coder-docker-proxy-v11.service catchplate-coder-receipt-authority-v11.service
Requires=catchplate-coder-docker-proxy-v11.service catchplate-coder-receipt-authority-v11.service
RequiresMountsFor=/sys/fs/cgroup /var/lib/catchplate/coder-controller-v11

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=catchplate
RuntimeDirectoryMode=0755
StateDirectory=catchplate/coder-controller-v11
StateDirectoryMode=0700
ExecStartPre=/usr/bin/mkdir -p /sys/fs/cgroup/catchplate-coder-controller-v11
ExecStartPre=/usr/bin/test -S /run/catchplate/controller-plan-executor-v11.sock
ExecStartPre=/usr/bin/test -S /run/catchplate/controller-docker-proxy.sock
ExecStartPre=/usr/bin/test -S /run/catchplate/controller-receipt-authority-v11.sock
ExecStartPre=/usr/bin/rm -f /run/catchplate/controller-plan-api.sock
ExecStart=/usr/local/libexec/catchplate-coder-controller --config /etc/catchplate/coder-controller-v11/controller.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=45s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
Delegate=yes
NoNewPrivileges=no
PrivateTmp=no
PrivateDevices=no
PrivateIPC=no
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
