[Unit]
Description=Catchplate Coder controller v12
PartOf=catchplate-coder-v12.target
After=local-fs.target catchplate-coder-runtime-v12.service catchplate-coder-controller-v12.socket catchplate-coder-plan-executor-v12.service catchplate-coder-docker-proxy-v12.service catchplate-coder-receipt-authority-v12.service catchplate-coder-log-custody-authority-v12.service catchplate-coder-trust-generation-v12.service catchplate-coder-external-witness-v12.service catchplate-coder-final-settlement-v12.service catchplate-coder-final-verdict-authority-v12.service
Requires=catchplate-coder-runtime-v12.service catchplate-coder-controller-v12.socket catchplate-coder-plan-executor-v12.service catchplate-coder-docker-proxy-v12.service catchplate-coder-receipt-authority-v12.service catchplate-coder-log-custody-authority-v12.service catchplate-coder-trust-generation-v12.service catchplate-coder-external-witness-v12.service catchplate-coder-final-settlement-v12.service catchplate-coder-final-verdict-authority-v12.service
Before=catchplate-coder-readiness-v12.service
RequiresMountsFor=/var/lib/catchplate/coder-controller-v12

[Service]
Type=notify
User=catchplate-coder-controller
Group=catchplate-coder-controller
SupplementaryGroups=catchplate-coder-executor-api catchplate-coder-docker-api catchplate-coder-receipt-api catchplate-coder-verdict-api catchplate-coder-lifecycle-api catchplate-coder-cas
UMask=0077
Sockets=catchplate-coder-controller-v12.socket
LoadCredentialEncrypted=controller-identity-key:@RELEASE_ROOT@/credentials/controller-identity-key.cred
ExecStart=@RELEASE_ROOT@/bin/catchplate-coder-controller-v12 --config @RELEASE_ROOT@/config/controller-v12.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=90s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/catchplate/coder/v12/controller /var/lib/catchplate/coder-controller-v12/controller /var/lib/catchplate/coder-controller-v12/cas

[Install]
WantedBy=catchplate-coder-v12.target
