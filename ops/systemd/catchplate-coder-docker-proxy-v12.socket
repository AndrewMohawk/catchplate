[Unit]
Description=Catchplate Coder v12 capability-scoped Docker proxy socket
PartOf=catchplate-coder-v12.target
After=catchplate-coder-runtime-v12.service
Requires=catchplate-coder-runtime-v12.service
Before=catchplate-coder-docker-proxy-v12.service

[Socket]
ListenSequentialPacket=/run/catchplate/coder/v12/docker-proxy/control.sock
SocketUser=root
SocketGroup=catchplate-coder-docker-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=catchplate-coder-docker-proxy-v12.service

[Install]
WantedBy=catchplate-coder-v12.target
