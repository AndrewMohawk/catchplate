[Unit]
Description=Catchplate Coder v12 co-located witness authority
PartOf=catchplate-coder-v12.target
After=local-fs.target catchplate-coder-runtime-v12.service catchplate-coder-external-witness-v12.socket
Requires=catchplate-coder-runtime-v12.service catchplate-coder-external-witness-v12.socket
Before=catchplate-coder-receipt-authority-v12.service catchplate-coder-controller-v12.service

[Service]
Type=notify
User=catchplate-coder-witness
Group=catchplate-coder-witness
UMask=0077
Sockets=catchplate-coder-external-witness-v12.socket
LoadCredentialEncrypted=external-witness-key:@RELEASE_ROOT@/credentials/external-witness-key.cred
ExecStart=@RELEASE_ROOT@/bin/catchplate-coder-local-trust-authority-v12 --config @RELEASE_ROOT@/config/local-external-witness-v12.json
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/catchplate/coder-controller-v12/external-witness

[Install]
WantedBy=catchplate-coder-v12.target
