[Unit]
Description=Catchplate Coder v12 local witness RPC
PartOf=catchplate-coder-v12.target
After=catchplate-coder-runtime-v12.service
Requires=catchplate-coder-runtime-v12.service
Before=catchplate-coder-external-witness-v12.service

[Socket]
ListenStream=/run/catchplate/coder/v12/external-witness/control.sock
SocketUser=root
SocketGroup=catchplate-coder-witness-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=catchplate-coder-external-witness-v12.service

[Install]
WantedBy=catchplate-coder-v12.target
