[Unit]
Description=Catchplate Coder v12 unprivileged lifecycle coordinator
PartOf=catchplate-coder-v12.target
After=local-fs.target catchplate-coder-runtime-v12.service catchplate-coder-private-dind-reconcile-v12.service catchplate-coder-lifecycle-v12.socket catchplate-coder-lifecycle-privileged-v12.socket
Requires=catchplate-coder-runtime-v12.service catchplate-coder-private-dind-reconcile-v12.service catchplate-coder-lifecycle-v12.socket catchplate-coder-lifecycle-privileged-v12.socket
Before=catchplate-coder-docker-proxy-v12.service catchplate-coder-plan-executor-v12.service catchplate-coder-controller-v12.service
RequiresMountsFor=/var/lib/catchplate/coder-controller-v12

[Service]
Type=notify
User=catchplate-coder-lifecycle
Group=catchplate-coder-lifecycle
SupplementaryGroups=catchplate-coder-lifecycle-api catchplate-coder-lifecycle-privileged-api
UMask=0077
LoadCredentialEncrypted=lifecycle-authority-key:@RELEASE_ROOT@/credentials/lifecycle-authority-key.cred
Sockets=catchplate-coder-lifecycle-v12.socket
ExecStart=@RELEASE_ROOT@/bin/catchplate-coder-lifecycle-v12 --config @RELEASE_ROOT@/config/lifecycle-v12.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=45s
TimeoutStopSec=120s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/catchplate/coder/v12/lifecycle /var/lib/catchplate/coder-controller-v12/lifecycle

[Install]
WantedBy=catchplate-coder-v12.target
