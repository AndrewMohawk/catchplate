[Unit]
Description=Catchplate Coder v12 root-owned log-custody RPC socket
PartOf=catchplate-coder-v12.target
After=catchplate-coder-runtime-v12.service
Requires=catchplate-coder-runtime-v12.service
Before=catchplate-coder-log-custody-authority-v12.service

[Socket]
ListenStream=/run/catchplate/coder/v12/log-custody/control.sock
SocketUser=root
SocketGroup=catchplate-coder-log-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=catchplate-coder-log-custody-authority-v12.service

[Install]
WantedBy=catchplate-coder-v12.target
