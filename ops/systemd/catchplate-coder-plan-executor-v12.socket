[Unit]
Description=Catchplate Coder v12 root-owned plan executor ingress
PartOf=catchplate-coder-v12.target
After=catchplate-coder-runtime-v12.service
Requires=catchplate-coder-runtime-v12.service
Before=catchplate-coder-plan-executor-v12.service

[Socket]
ListenSequentialPacket=/run/catchplate/coder/v12/plan-executor/control.sock
SocketUser=root
SocketGroup=catchplate-coder-executor-api
SocketMode=0660
DirectoryMode=0750
Backlog=128
RemoveOnStop=yes
Accept=no
Service=catchplate-coder-plan-executor-v12.service

[Install]
WantedBy=catchplate-coder-v12.target
