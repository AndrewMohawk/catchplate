[Unit]
Description=Catchplate Coder v12 static gate for mandatory per-invocation signed readiness
PartOf=catchplate-coder-v12.target
After=catchplate-coder-controller-v12.service catchplate-coder-plan-executor-v12.service catchplate-coder-private-dind-reconcile-v12.service catchplate-coder-lifecycle-privileged-v12.service
Requires=catchplate-coder-controller-v12.service catchplate-coder-plan-executor-v12.service catchplate-coder-private-dind-reconcile-v12.service catchplate-coder-lifecycle-privileged-v12.service
Before=catchplate-coder-v12.target

[Service]
Type=oneshot
User=catchplate-coder-executor
Group=catchplate-coder-executor
SupplementaryGroups=catchplate-coder-docker-api catchplate-coder-lifecycle-api catchplate-coder-cas
UMask=0077
Environment=CATCHPLATE_CODER_PLAN_EXECUTOR_CONFIG_SHA256=@PLAN_EXECUTOR_CONFIG_SHA256@
Environment=CATCHPLATE_CODER_REQUIRE_PER_INVOCATION_READINESS_V12=1
ExecStart=/usr/bin/timeout --signal=KILL 30s @RELEASE_ROOT@/bin/catchplate-coder-plan-executor-v12 --config @RELEASE_ROOT@/config/plan-executor-v12.conf health
RemainAfterExit=yes
TimeoutStartSec=45s
TimeoutStopSec=15s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/catchplate/coder/v12/plan-executor /var/lib/catchplate/coder-controller-v12/executor /var/lib/catchplate/coder-controller-v12/cas

[Install]
WantedBy=catchplate-coder-v12.target
