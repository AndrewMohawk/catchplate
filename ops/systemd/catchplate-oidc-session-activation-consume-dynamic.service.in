# Unrendered, uninstalled alternate to fixed consume-planner delivery.
# Independent provisioning must supply exact public trust, private keys, TLS,
# journal/export stores, resource identities and the current-root state owner.
# No root signing key enters this worker. Staged originals do not prove readiness.
# Provision UID 65501 state-socket ACL separately; do not grant the state group.
# Public TLS files: root-owned 0444; private TLS key: root:65501 mode 0440.
# PostgreSQL egress must independently match the admitted endpoint.
[Unit]
Description=Catchplate dynamically staged OIDC activation consume planner
BindsTo=catchplate-oidc-session-activation-consume-bootstrap.socket catchplate-oidc-session-activation-consume-dynamic.socket
Requires=catchplate-current-root-state.socket
After=local-fs.target catchplate-oidc-session-activation-consume-bootstrap.socket catchplate-oidc-session-activation-consume-dynamic.socket catchplate-current-root-state.socket
Conflicts=catchplate-oidc-session-activation-delivery-planner.socket catchplate-oidc-session-activation-delivery-planner.service
RequiresMountsFor=@ACTIVATION_DELIVERY_PLANNER_RELEASE_ROOT@ @ACTIVATION_CONSUME_DYNAMIC_TRUST_DIR@ @ACTIVATION_DELIVERY_PLANNER_TLS_DIR@ @ACTIVATION_DELIVERY_PLANNER_JOURNAL_DIR@ @ACTIVATION_DELIVERY_PLANNER_EXECUTION_STORE_DIR@
AssertPathIsDirectory=@ACTIVATION_DELIVERY_PLANNER_RELEASE_ROOT@
AssertPathIsDirectory=@ACTIVATION_CONSUME_DYNAMIC_TRUST_DIR@
AssertPathIsDirectory=@ACTIVATION_DELIVERY_PLANNER_TLS_DIR@
AssertPathIsDirectory=@ACTIVATION_DELIVERY_PLANNER_JOURNAL_DIR@
AssertPathIsDirectory=@ACTIVATION_DELIVERY_PLANNER_EXECUTION_STORE_DIR@
AssertPathExists=@ACTIVATION_DELIVERY_PLANNER_KEY@
AssertPathExists=@ACTIVATION_DELIVERY_PLANNER_JOURNAL_KEY@
AssertPathExists=@ACTIVATION_DELIVERY_PLANNER_BUNDLE_KEY@
AssertPathExists=@ACTIVATION_DELIVERY_PLANNER_DELIVERY_KEY@
AssertPathExists=@ACTIVATION_DELIVERY_PLANNER_EXECUTION_BUNDLE_KEY@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Exactly two named listeners arrive in either FD order. Root stages the exact
# originals/resources, closes staging, and permanently drops to 65501:65501.
# Eleven final FDs 198..208 retain the existing distinct keys and private stores.
# One bounded prepare followed by its exact export shares the original allowance;
# any failed phase is terminal. Type=exec is not cryptographic readiness proof.
User=root
Group=root
RootDirectory=@ACTIVATION_DELIVERY_PLANNER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@ACTIVATION_CONSUME_DYNAMIC_TRUST_DIR@:/run/catchplate/oidc-session-activation-consume-dynamic-trust
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_TLS_DIR@:/run/catchplate/oidc-session-activation-delivery-planner-tls
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-planner-key
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_JOURNAL_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-journal-key
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_BUNDLE_KEY@:/run/secrets/catchplate-oidc-session-activation-bundle-key
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_DELIVERY_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-key
BindReadOnlyPaths=@ACTIVATION_DELIVERY_PLANNER_EXECUTION_BUNDLE_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-execution-bundle-key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation:/run/catchplate/oidc-session-activation
BindReadOnlyPaths=/run/catchplate/current-root:/run/catchplate/current-root
BindPaths=@ACTIVATION_DELIVERY_PLANNER_JOURNAL_DIR@:/var/lib/catchplate/oidc-session-activation-delivery-planner
BindPaths=@ACTIVATION_DELIVERY_PLANNER_EXECUTION_STORE_DIR@:/var/lib/catchplate/oidc-session-activation-delivery-execution
ReadWritePaths=/var/lib/catchplate/oidc-session-activation-delivery-planner
ReadWritePaths=/var/lib/catchplate/oidc-session-activation-delivery-execution
Sockets=catchplate-oidc-session-activation-consume-bootstrap.socket catchplate-oidc-session-activation-consume-dynamic.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_consume_dynamic_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
