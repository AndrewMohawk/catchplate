# Unrendered and uninstalled. Independent admission must supply an immutable
# release, accounts, root/role/receiving/enrollment originals and exact keys.
# No database, state socket, TLS, journal or writable-store mount is needed.
[Unit]
Description=Catchplate dedicated consume grant authorizer (trusted-host-local)
BindsTo=catchplate-oidc-session-activation-delivery-execution-authorizer.socket
After=local-fs.target catchplate-oidc-session-activation-delivery-execution-authorizer.socket
RequiresMountsFor=@CONSUME_AUTHORIZER_RELEASE_ROOT@ @CONSUME_AUTHORIZER_TRUST_DIR@ @CONSUME_AUTHORIZER_SIGNING_KEY@ @CONSUME_AUTHORIZER_EXECUTION_BUNDLE_KEY@ @CONSUME_AUTHORIZER_HISTORICAL_BUNDLE_KEY@ @CONSUME_AUTHORIZER_DELIVERY_KEY@
AssertPathIsDirectory=@CONSUME_AUTHORIZER_RELEASE_ROOT@
AssertPathIsDirectory=@CONSUME_AUTHORIZER_TRUST_DIR@
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/root-public-key.pem
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/bootstrap.json
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/custody.json
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/planner-bootstrap.json
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/planner-history-custody.json
AssertPathExists=@CONSUME_AUTHORIZER_TRUST_DIR@/receiving-history-custody.json
AssertPathExists=@CONSUME_AUTHORIZER_SIGNING_KEY@
AssertPathExists=@CONSUME_AUTHORIZER_EXECUTION_BUNDLE_KEY@
AssertPathExists=@CONSUME_AUTHORIZER_HISTORICAL_BUNDLE_KEY@
AssertPathExists=@CONSUME_AUTHORIZER_DELIVERY_KEY@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root delivery permanently drops to 65500:65500, with empty supplementary groups.
# Exactly eleven inherited descriptors 198..208; one accepted request per launch.
# Type=exec is not cryptographic readiness or successful grant delivery.
User=root
Group=root
RootDirectory=@CONSUME_AUTHORIZER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@CONSUME_AUTHORIZER_TRUST_DIR@:/run/catchplate/oidc-session-activation-delivery-execution-authorizer-trust
BindReadOnlyPaths=@CONSUME_AUTHORIZER_SIGNING_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-execution-authorizer-signing-key
BindReadOnlyPaths=@CONSUME_AUTHORIZER_EXECUTION_BUNDLE_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-execution-authorizer-execution-bundle-key
BindReadOnlyPaths=@CONSUME_AUTHORIZER_HISTORICAL_BUNDLE_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-execution-authorizer-historical-bundle-key
BindReadOnlyPaths=@CONSUME_AUTHORIZER_DELIVERY_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-execution-authorizer-delivery-key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-delivery-execution:/run/catchplate/oidc-session-activation-delivery-execution
Sockets=catchplate-oidc-session-activation-delivery-execution-authorizer.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_authorizer_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cooperative TERM/cgroup escalation is not a hard kernel syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
