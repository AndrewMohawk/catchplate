# Uninstalled deployment input; no accounts, state ACL or authority provisioned.
# Recreating this socket invalidates independently signed resource identities.
[Unit]
Description=Catchplate dedicated OIDC activation delivery-consume planner ingress
Before=catchplate-oidc-session-activation-delivery-planner.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/oidc-session-activation/delivery-planner.sock
FileDescriptorName=catchplate-oidc-session-activation-delivery-planner
SocketUser=65501
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-delivery-planner.service

[Install]
WantedBy=sockets.target
