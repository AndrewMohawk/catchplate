# Uninstalled deployment input; no account, permission or execution authority
# is provisioned. Recreating the socket invalidates its signed resource pins.
[Unit]
Description=Catchplate dedicated OIDC activation execution grant ingress
Before=catchplate-oidc-session-activation-execution-authorizer.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/oidc-session-activation-execution/authorizer.sock
FileDescriptorName=catchplate-oidc-session-activation-execution-authorizer
SocketUser=65506
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-execution-authorizer.service

[Install]
WantedBy=sockets.target
