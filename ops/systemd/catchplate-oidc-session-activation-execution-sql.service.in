# Unrendered, uninstalled deployment input. Independent provisioning supplies
# accounts, exact release, signed role/custody, AES originals, TLS identities,
# catalog, attempt checkpoint and independent current pending authority.
# Public TLS: root 0444; private TLS: root:65504 0440; AES: root 0400/raw32.
# Restrict PostgreSQL egress independently to the exact admitted endpoint.
[Unit]
Description=Catchplate dedicated activation SQL owner (trusted-host-local)
BindsTo=catchplate-oidc-session-activation-execution-sql.socket
After=local-fs.target catchplate-oidc-session-activation-execution-sql.socket
RequiresMountsFor=@ACTIVATION_SQL_RELEASE_ROOT@ @ACTIVATION_SQL_TRUST_DIR@ @ACTIVATION_SQL_TLS_DIR@ @ACTIVATION_SQL_BUNDLE_KEY@ @ACTIVATION_SQL_DELIVERY_KEY@ @ACTIVATION_SQL_JOURNAL_DIR@
AssertPathIsDirectory=@ACTIVATION_SQL_RELEASE_ROOT@
AssertPathIsDirectory=@ACTIVATION_SQL_TRUST_DIR@
AssertPathIsDirectory=@ACTIVATION_SQL_TLS_DIR@
AssertPathIsDirectory=@ACTIVATION_SQL_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Permanent drop to 65504:65504 without supplementary groups. Seven FDs,
# no signing key. One accepted exchange, including rejected/uncertain work.
# Type=exec does not establish cryptographic or database readiness.
User=root
Group=root
RootDirectory=@ACTIVATION_SQL_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@ACTIVATION_SQL_TRUST_DIR@:/run/catchplate/oidc-session-activation-execution-sql-trust
BindReadOnlyPaths=@ACTIVATION_SQL_TLS_DIR@:/run/catchplate/oidc-session-activation-execution-sql-tls
BindReadOnlyPaths=@ACTIVATION_SQL_BUNDLE_KEY@:/run/secrets/catchplate-oidc-session-activation-bundle-key
BindReadOnlyPaths=@ACTIVATION_SQL_DELIVERY_KEY@:/run/secrets/catchplate-oidc-session-activation-delivery-key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-execution:/run/catchplate/oidc-session-activation-execution
BindPaths=@ACTIVATION_SQL_JOURNAL_DIR@:/var/lib/catchplate/oidc-session-activation-execution-sql-attempts
ReadWritePaths=/var/lib/catchplate/oidc-session-activation-execution-sql-attempts
Sockets=catchplate-oidc-session-activation-execution-sql.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_execution_sql_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# TERM plus cgroup escalation is not a hard syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
