# Uninstalled deployment input; no accounts or execution authority provisioned.
# Recreating this socket invalidates independently signed resource identities.
[Unit]
Description=Catchplate dedicated OIDC activation planner ingress
Before=catchplate-oidc-session-activation-planner.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/oidc-session-activation/planner.sock
FileDescriptorName=catchplate-oidc-session-activation-planner
SocketUser=65507
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-planner.service

[Install]
WantedBy=sockets.target
