# Unrendered, uninstalled alternate to static grant-issuer delivery.
# Independent dynamic authorization precedes signer access. No TLS/AES keys.
# Staged ACK is exact input admission, not grant issuance or token delivery.
[Unit]
Description=Catchplate dynamically staged release-grant issuer
BindsTo=catchplate-oidc-session-activation-release-grant-issuer-bootstrap.socket catchplate-oidc-session-activation-release-grant-issuer-dynamic.socket
Requires=catchplate-oidc-session-activation-token-release-bootstrap.socket catchplate-oidc-session-activation-token-release-dynamic.socket
Conflicts=catchplate-oidc-session-activation-release-grant-issuer.socket catchplate-oidc-session-activation-release-grant-issuer.service
After=local-fs.target catchplate-oidc-session-activation-release-grant-issuer-bootstrap.socket catchplate-oidc-session-activation-release-grant-issuer-dynamic.socket catchplate-oidc-session-activation-token-release-bootstrap.socket catchplate-oidc-session-activation-token-release-dynamic.socket
RequiresMountsFor=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@ @RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@ @RELEASE_GRANT_ISSUER_ROOT_SIGNING_KEY@
AssertPathIsDirectory=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@
AssertPathIsDirectory=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/root-public-key.pem
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/authorization.json
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/proof-input-policy.json
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/completion-bootstrap.json
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/proof-enrollment.json
AssertPathExists=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@/intent-enrollment.json
AssertPathExists=@RELEASE_GRANT_ISSUER_ROOT_SIGNING_KEY@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same PID and original work/window across permanent root -> 65496:65496 drop.
# Six sealed/CLOEXEC descriptors198..203; no post-drop exec, retry or renewal.
User=root
Group=root
RootDirectory=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RELEASE_GRANT_ISSUER_DYNAMIC_TRUST_DIR@:/run/catchplate/oidc-session-activation-release-grant-issuer-dynamic-trust
BindReadOnlyPaths=@RELEASE_GRANT_ISSUER_ROOT_SIGNING_KEY@:/run/secrets/catchplate-oidc-session-activation-release-grant-issuer-root-signing-key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-token-release:/run/catchplate/oidc-session-activation-token-release
Sockets=catchplate-oidc-session-activation-release-grant-issuer-bootstrap.socket catchplate-oidc-session-activation-release-grant-issuer-dynamic.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_grant_issuer_dynamic_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
