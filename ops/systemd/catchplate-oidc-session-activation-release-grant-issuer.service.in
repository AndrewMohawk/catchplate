# Unrendered, uninstalled source. No resource provisioner or production receipt.
# This private service alone receives the actual runtime-root signing key.
[Unit]
Description=Catchplate one-shot release-grant issuer (trusted-host-local)
BindsTo=catchplate-oidc-session-activation-release-grant-issuer.socket
After=local-fs.target catchplate-oidc-session-activation-release-grant-issuer.socket
RequiresMountsFor=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@ @RELEASE_GRANT_ISSUER_TRUST_DIR@ @RELEASE_GRANT_ISSUER_ROOT_SIGNING_KEY@
AssertPathIsDirectory=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@
AssertPathIsDirectory=@RELEASE_GRANT_ISSUER_TRUST_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same PID and original work/window across permanent root -> 65496:65496 drop.
# Six sealed/CLOEXEC descriptors198..203; no post-drop exec, retry or renewal.
User=root
Group=root
RootDirectory=@RELEASE_GRANT_ISSUER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RELEASE_GRANT_ISSUER_TRUST_DIR@:/run/catchplate/oidc-session-activation-release-grant-issuer-trust
BindReadOnlyPaths=@RELEASE_GRANT_ISSUER_ROOT_SIGNING_KEY@:/run/secrets/catchplate-oidc-session-activation-release-grant-issuer-root-signing-key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-token-release:/run/catchplate/oidc-session-activation-token-release
Sockets=catchplate-oidc-session-activation-release-grant-issuer.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_grant_issuer_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
