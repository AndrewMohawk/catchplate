# Uninstalled source. Provision exact policy/proof/launch originals first.
[Unit]
Description=Catchplate private release-grant issuer ingress
Before=catchplate-oidc-session-activation-release-grant-issuer.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/oidc-session-activation-token-release/grants.sock
FileDescriptorName=catchplate-oidc-session-activation-release-grant-issuer
SocketUser=65496
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-release-grant-issuer.service

[Install]
WantedBy=sockets.target
