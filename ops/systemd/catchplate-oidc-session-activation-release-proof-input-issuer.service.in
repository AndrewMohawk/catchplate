# Unrendered, uninstalled source; not a production readiness receipt.
# Only this issuer receives its root signing key. The proof worker never does.
# The issuer needs only the packet-reader TLS files: public root0444 and
# private root:65494 mode0440, in its OWN isolated namespace. Do not change
# the proof/completion workers' independent root:65497 TLS protections.
[Unit]
Description=Catchplate one-shot proof-input issuer (trusted-host-local)
BindsTo=catchplate-oidc-session-activation-release-proof-input-issuer.socket
Requires=catchplate-oidc-session-activation-release-proof-bootstrap.socket catchplate-oidc-session-activation-release-proof-dynamic.socket
After=local-fs.target catchplate-oidc-session-activation-release-proof-input-issuer.socket catchplate-oidc-session-activation-release-proof-bootstrap.socket catchplate-oidc-session-activation-release-proof-dynamic.socket
RequiresMountsFor=@PROOF_INPUT_ISSUER_RELEASE_ROOT@ @PROOF_INPUT_ISSUER_TRUST_DIR@ @PROOF_INPUT_ISSUER_ROOT_SIGNING_KEY@ @PROOF_INPUT_ISSUER_TLS_CA@ @PROOF_INPUT_ISSUER_TLS_CERTIFICATE@ @PROOF_INPUT_ISSUER_TLS_KEY@
AssertPathIsDirectory=@PROOF_INPUT_ISSUER_RELEASE_ROOT@
AssertPathIsDirectory=@PROOF_INPUT_ISSUER_TRUST_DIR@
AssertPathExists=@PROOF_INPUT_ISSUER_ROOT_SIGNING_KEY@
AssertPathExists=@PROOF_INPUT_ISSUER_TLS_CA@
AssertPathExists=@PROOF_INPUT_ISSUER_TLS_CERTIFICATE@
AssertPathExists=@PROOF_INPUT_ISSUER_TLS_KEY@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same PID and original work/window across permanent root -> 65494:65494 drop.
# Exactly eight final inherited descriptors198..205. No post-drop exec/retry.
User=root
Group=root
RootDirectory=@PROOF_INPUT_ISSUER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@PROOF_INPUT_ISSUER_TRUST_DIR@:/run/catchplate/oidc-session-activation-release-proof-input-issuer-trust
BindReadOnlyPaths=@PROOF_INPUT_ISSUER_ROOT_SIGNING_KEY@:/run/secrets/catchplate-oidc-session-activation-release-proof-input-issuer-root-signing-key
BindReadOnlyPaths=@PROOF_INPUT_ISSUER_TLS_CA@:/run/catchplate/oidc-session-activation-delivery-completion-tls/ca.pem
BindReadOnlyPaths=@PROOF_INPUT_ISSUER_TLS_CERTIFICATE@:/run/catchplate/oidc-session-activation-delivery-completion-tls/custody.crt
BindReadOnlyPaths=@PROOF_INPUT_ISSUER_TLS_KEY@:/run/catchplate/oidc-session-activation-delivery-completion-tls/custody.key
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-release-proof-inputs:/run/catchplate/oidc-session-activation-release-proof-inputs
BindReadOnlyPaths=/run/catchplate/oidc-session-activation-token-release:/run/catchplate/oidc-session-activation-token-release
Sockets=catchplate-oidc-session-activation-release-proof-input-issuer.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_proof_input_issuer_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# PostgreSQL egress must match the independently admitted endpoint; this
# template supplies no credentials, database grants, keys, users or certificates.
