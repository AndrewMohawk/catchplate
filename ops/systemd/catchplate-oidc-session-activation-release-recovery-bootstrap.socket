# Uninstalled opt-in source; exact active-actor staging is not token delivery.
[Unit]
Description=Catchplate recovery-only root bootstrap staging ingress
Before=catchplate-oidc-session-activation-release-recovery-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=catchplate-oidc-session-activation-token-release.socket catchplate-oidc-session-activation-token-release.service catchplate-oidc-session-activation-token-release-dynamic.socket catchplate-oidc-session-activation-token-release-dynamic.service catchplate-oidc-session-activation-token-release-bootstrap.socket

[Socket]
ListenStream=/run/catchplate/oidc-session-activation-token-release/recovery-bootstrap.sock
FileDescriptorName=catchplate-oidc-session-activation-release-recovery-bootstrap
SocketUser=0
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-release-recovery-dynamic.service

[Install]
WantedBy=sockets.target
