# Alternative to the fixed-bootstrap socket, never a second release listener.
[Unit]
Description=Catchplate dynamically staged private token-release ingress
Before=catchplate-oidc-session-activation-token-release-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=catchplate-oidc-session-activation-token-release.socket catchplate-oidc-session-activation-token-release.service

[Socket]
ListenStream=/run/catchplate/oidc-session-activation-token-release/release.sock
FileDescriptorName=catchplate-oidc-session-activation-token-release
SocketUser=65502
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-oidc-session-activation-token-release-dynamic.service

[Install]
WantedBy=sockets.target
