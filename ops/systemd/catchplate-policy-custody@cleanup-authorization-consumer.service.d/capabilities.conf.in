[Service]
User=swpc-consume
Group=swpc-consume
StateDirectory=catchplate/policy-custody/cleanup-authorization-consumer/state catchplate/policy-custody/cleanup-authorization-consumer/journal
StateDirectoryMode=0700
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
CPUAccounting=yes
CPUQuota=100%
TasksAccounting=yes
TasksMax=16
IOAccounting=yes
# O_RDONLY is required to open a directory FD; owner write permission still
# grants exact state mutation through openat/renameat/unlinkat.
OpenFile=%S/catchplate/policy-custody/cleanup-authorization-consumer/state:state:read-only
OpenFile=%S/catchplate/policy-custody/cleanup-authorization-consumer/journal:journal:read-only
InaccessiblePaths=%S/catchplate/policy-custody/cleanup-authorization-consumer/state
InaccessiblePaths=%S/catchplate/policy-custody/cleanup-authorization-consumer/journal
