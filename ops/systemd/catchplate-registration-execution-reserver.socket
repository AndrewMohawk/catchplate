# Uninstalled deployment input. Independently admitted account/group access,
# release and signed launch material are required. Listener recreation changes
# both the socket-FD and pathname identities admitted by the bootstrap.
[Unit]
Description=Catchplate dedicated registration execution reserver ingress
Before=catchplate-registration-execution-reserver.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/registration-execution/reserver.sock
FileDescriptorName=catchplate-registration-execution-reserver
SocketUser=65514
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=16
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-registration-execution-reserver.service

[Install]
WantedBy=sockets.target
