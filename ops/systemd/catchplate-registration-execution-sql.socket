# Uninstalled deployment input. Independently admitted accounts, release and
# signed cold launch are required; this unit supplies no execution permission.
# Recreating the listener invalidates its independently pinned identities.
[Unit]
Description=Catchplate dedicated registration SQL ingress
Before=catchplate-registration-execution-sql.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/registration-execution/sql.sock
FileDescriptorName=catchplate-registration-execution-sql
SocketUser=65512
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-registration-execution-sql.service

[Install]
WantedBy=sockets.target
