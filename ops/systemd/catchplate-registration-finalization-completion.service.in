# Unrendered, uninstalled deployment input. Independently supply admitted
# accounts, release/runtime, completion key, read-only DB roles/TLS, current
# pending/packet/history pins and completion journal/checkpoint.
# TLS publics: root-owned 0444; TLS keys: root:65508 0440. Completion signing
# key: 65508:65508 0400. Root-controlled parent directories remain mandatory.
# UID65508 needs separately provisioned state-socket DAC access and signed
# state v3 admission; it has no supplementary groups. Restrict DB egress.
[Unit]
Description=Catchplate dedicated finalization completion owner (trusted-host-local)
BindsTo=catchplate-registration-finalization-completion.socket
After=local-fs.target catchplate-registration-finalization-completion.socket
RequiresMountsFor=@FINALIZATION_COMPLETION_RELEASE_ROOT@ @FINALIZATION_COMPLETION_TRUST_DIR@ @FINALIZATION_COMPLETION_KEY_FILE@ @FINALIZATION_COMPLETION_TLS_DIR@ @FINALIZATION_COMPLETION_JOURNAL_DIR@
AssertPathIsDirectory=@FINALIZATION_COMPLETION_RELEASE_ROOT@
AssertPathIsDirectory=@FINALIZATION_COMPLETION_TRUST_DIR@
AssertPathIsDirectory=@FINALIZATION_COMPLETION_TLS_DIR@
AssertPathIsDirectory=@FINALIZATION_COMPLETION_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root delivery permanently drops to 65508:65508 with no supplementary groups.
# Five fixed inherited FDs 198..202. One accepted connection, including rejection,
# ends this cold launch. Type=exec is not successful cryptographic readiness.
User=root
Group=root
RootDirectory=@FINALIZATION_COMPLETION_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@FINALIZATION_COMPLETION_TRUST_DIR@:/run/catchplate/registration-finalization-completion-trust
BindReadOnlyPaths=@FINALIZATION_COMPLETION_KEY_FILE@:/run/catchplate/registration-finalization-completion-key/completion.pem
BindReadOnlyPaths=@FINALIZATION_COMPLETION_TLS_DIR@:/run/catchplate/registration-finalization-completion-tls
BindReadOnlyPaths=/run/catchplate/registration-finalization:/run/catchplate/registration-finalization
BindReadOnlyPaths=/run/catchplate/current-root:/run/catchplate/current-root
BindPaths=@FINALIZATION_COMPLETION_JOURNAL_DIR@:/var/lib/catchplate/registration-finalization-completions
ReadWritePaths=/var/lib/catchplate/registration-finalization-completions
Sockets=catchplate-registration-finalization-completion.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/registration_finalization_completion_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cgroup escalation is not a hard kernel/driver watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
