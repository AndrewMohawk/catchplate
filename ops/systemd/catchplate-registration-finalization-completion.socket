# Uninstalled deployment input. Independently admitted accounts, release and
# signed launch required. Recreating this socket invalidates its pinned identity.
[Unit]
Description=Catchplate dedicated finalization completion recovery ingress
Before=catchplate-registration-finalization-completion.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/registration-finalization/completion.sock
FileDescriptorName=catchplate-registration-finalization-completion
SocketUser=65508
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-registration-finalization-completion.service

[Install]
WantedBy=sockets.target
