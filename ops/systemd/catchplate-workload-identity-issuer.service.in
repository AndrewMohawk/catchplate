# Unrendered, uninstalled software-key profile; not TEE/HSM custody evidence.
[Unit]
Description=Catchplate one-shot independently authorized workload issuer
BindsTo=catchplate-workload-identity-issuer.socket
After=local-fs.target catchplate-workload-identity-issuer.socket
RequiresMountsFor=@WORKLOAD_ISSUER_RELEASE_ROOT@ @WORKLOAD_ISSUER_TRUST_DIR@ @WORKLOAD_ISSUER_CA_KEY@ @WORKLOAD_ISSUER_JOURNAL@
AssertPathIsDirectory=@WORKLOAD_ISSUER_RELEASE_ROOT@
AssertPathIsDirectory=@WORKLOAD_ISSUER_TRUST_DIR@
AssertPathIsDirectory=@WORKLOAD_ISSUER_JOURNAL@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root opens five original resources, then permanently drops in the same PID.
# The web app receives neither this key nor a generic signing capability.
User=root
Group=root
RootDirectory=@WORKLOAD_ISSUER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@WORKLOAD_ISSUER_TRUST_DIR@:/run/catchplate/workload-identity-issuer-trust
BindReadOnlyPaths=@WORKLOAD_ISSUER_CA_KEY@:/run/secrets/catchplate-workload-identity-issuer-ca-key
BindReadOnlyPaths=/run/catchplate/workload-identity-issuer:/run/catchplate/workload-identity-issuer
BindPaths=@WORKLOAD_ISSUER_JOURNAL@:/var/lib/catchplate/workload-identity-issuer
ReadWritePaths=/var/lib/catchplate/workload-identity-issuer
Sockets=catchplate-workload-identity-issuer.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/workload_identity_issuer_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=60s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
