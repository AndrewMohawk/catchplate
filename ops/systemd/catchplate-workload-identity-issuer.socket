# Uninstalled source. Provision signed issuer/resource authority before use.
[Unit]
Description=Catchplate private workload certificate issuer ingress
Before=catchplate-workload-identity-issuer.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/catchplate/workload-identity-issuer/issuer.sock
FileDescriptorName=catchplate-workload-identity-issuer
SocketUser=65492
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=catchplate-workload-identity-issuer.service

[Install]
WantedBy=sockets.target
