[Unit]
Description=Serverware Coder controller v12
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-controller-v12.socket serverware-coder-plan-executor-v12.service serverware-coder-docker-proxy-v12.service serverware-coder-receipt-authority-v12.service serverware-coder-log-custody-authority-v12.service serverware-coder-trust-generation-v12.service serverware-coder-external-witness-v12.service serverware-coder-final-settlement-v12.service serverware-coder-final-verdict-authority-v12.service
Requires=serverware-coder-runtime-v12.service serverware-coder-controller-v12.socket serverware-coder-plan-executor-v12.service serverware-coder-docker-proxy-v12.service serverware-coder-receipt-authority-v12.service serverware-coder-log-custody-authority-v12.service serverware-coder-trust-generation-v12.service serverware-coder-external-witness-v12.service serverware-coder-final-settlement-v12.service serverware-coder-final-verdict-authority-v12.service
Before=serverware-coder-readiness-v12.service
RequiresMountsFor=/var/lib/serverware/coder-controller-v12

[Service]
Type=notify
User=serverware-coder-controller
Group=serverware-coder-controller
SupplementaryGroups=serverware-coder-executor-api serverware-coder-docker-api serverware-coder-receipt-api serverware-coder-verdict-api serverware-coder-lifecycle-api serverware-coder-cas
UMask=0077
Sockets=serverware-coder-controller-v12.socket
LoadCredentialEncrypted=controller-identity-key:@RELEASE_ROOT@/credentials/controller-identity-key.cred
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-controller-v12 --config @RELEASE_ROOT@/config/controller-v12.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=90s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/serverware/coder/v12/controller /var/lib/serverware/coder-controller-v12/controller /var/lib/serverware/coder-controller-v12/cas

[Install]
WantedBy=serverware-coder-v12.target
