[Unit]
Description=Serverware Coder v12 root-owned controller ingress
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-controller-v12.service

[Socket]
ListenSequentialPacket=/run/serverware/coder/v12/controller/control.sock
SocketUser=root
SocketGroup=@CLIENT_GROUP@
SocketMode=0660
DirectoryMode=0750
Backlog=128
RemoveOnStop=yes
Accept=no
Service=serverware-coder-controller-v12.service

[Install]
WantedBy=serverware-coder-v12.target
