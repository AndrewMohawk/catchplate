[Unit]
Description=Serverware Coder v11 disposable DinD authority and policy proxy
After=local-fs.target network-online.target
Wants=network-online.target
Before=serverware-coder-controller-v11.service
RequiresMountsFor=/var/lib/serverware/coder-docker-proxy-v11 /run/netns/serverware-coder-controller-v11

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=serverware
RuntimeDirectoryMode=0755
StateDirectory=serverware/coder-docker-proxy-v11
StateDirectoryMode=0700
NetworkNamespacePath=/run/netns/serverware-coder-controller-v11
ExecStartPre=/usr/bin/rm -f /run/serverware/controller-plan-executor-v11.sock /run/serverware/controller-docker-proxy.sock /run/serverware/private-docker-v11.sock
ExecStart=/usr/local/libexec/serverware-coder-docker-proxy --config /etc/serverware/coder-controller-v11/docker-proxy.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=no
TimeoutStartSec=180s
TimeoutStopSec=75s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
Delegate=yes
NoNewPrivileges=no
PrivateTmp=no
PrivateDevices=no
PrivateIPC=no
ProtectSystem=full
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=no
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
