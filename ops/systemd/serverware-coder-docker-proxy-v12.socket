[Unit]
Description=Serverware Coder v12 capability-scoped Docker proxy socket
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-docker-proxy-v12.service

[Socket]
ListenSequentialPacket=/run/serverware/coder/v12/docker-proxy/control.sock
SocketUser=root
SocketGroup=serverware-coder-docker-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=serverware-coder-docker-proxy-v12.service

[Install]
WantedBy=serverware-coder-v12.target
