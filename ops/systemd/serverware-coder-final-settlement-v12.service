[Unit]
Description=Serverware Coder v12 co-located final-settlement authority
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-final-settlement-v12.socket serverware-coder-external-witness-v12.service
Requires=serverware-coder-runtime-v12.service serverware-coder-final-settlement-v12.socket serverware-coder-external-witness-v12.service
Before=serverware-coder-receipt-authority-v12.service serverware-coder-controller-v12.service

[Service]
Type=notify
User=serverware-coder-settlement
Group=serverware-coder-settlement
UMask=0077
Sockets=serverware-coder-final-settlement-v12.socket
LoadCredentialEncrypted=final-settlement-key:@RELEASE_ROOT@/credentials/final-settlement-key.cred
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-local-trust-authority-v12 --config @RELEASE_ROOT@/config/local-final-settlement-v12.json
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/serverware/coder-controller-v12/final-settlement

[Install]
WantedBy=serverware-coder-v12.target
