[Unit]
Description=Serverware Coder v12 local final-settlement RPC
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-final-settlement-v12.service

[Socket]
ListenStream=/run/serverware/coder/v12/final-settlement/control.sock
SocketUser=root
SocketGroup=serverware-coder-settlement-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=serverware-coder-final-settlement-v12.service

[Install]
WantedBy=serverware-coder-v12.target
