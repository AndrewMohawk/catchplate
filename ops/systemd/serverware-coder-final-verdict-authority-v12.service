[Unit]
Description=Serverware Coder v12 final-verdict authority
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-final-verdict-authority-v12.socket serverware-coder-receipt-authority-v12.service
Requires=serverware-coder-runtime-v12.service serverware-coder-final-verdict-authority-v12.socket serverware-coder-receipt-authority-v12.service
Before=serverware-coder-controller-v12.service
RequiresMountsFor=/var/lib/serverware/coder-controller-v12

[Service]
Type=notify
User=serverware-coder-verdict
Group=serverware-coder-verdict
SupplementaryGroups=serverware-coder-verdict-api serverware-coder-receipt-api
UMask=0077
LoadCredentialEncrypted=final-verdict-authority-key:@RELEASE_ROOT@/credentials/final-verdict-authority-key.cred
Sockets=serverware-coder-final-verdict-authority-v12.socket
Environment=SERVERWARE_FINAL_VERDICT_AUTHORITY_CONFIG=@RELEASE_ROOT@/config/final-verdict-authority-v12.conf
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-final-verdict-authority-v12
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/serverware/coder/v12/final-verdict-authority /var/lib/serverware/coder-controller-v12/final-verdict-authority

[Install]
WantedBy=serverware-coder-v12.target
