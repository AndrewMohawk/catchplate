[Unit]
Description=Serverware Coder v12 root-owned final-verdict RPC
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-final-verdict-authority-v12.service

[Socket]
ListenStream=/run/serverware/coder/v12/final-verdict-authority/control.sock
SocketUser=root
SocketGroup=serverware-coder-verdict-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=serverware-coder-final-verdict-authority-v12.service

[Install]
WantedBy=serverware-coder-v12.target
