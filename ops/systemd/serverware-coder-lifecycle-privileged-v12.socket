[Unit]
Description=Serverware Coder v12 privileged lifecycle RPC socket
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-lifecycle-v12.service

[Socket]
ListenStream=/run/serverware/coder/v12/lifecycle-privileged/control.sock
SocketUser=root
SocketGroup=serverware-coder-lifecycle-privileged-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=serverware-coder-lifecycle-privileged-v12.service

[Install]
WantedBy=serverware-coder-v12.target
