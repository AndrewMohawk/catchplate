[Unit]
Description=Serverware Coder v12 unprivileged lifecycle coordinator
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-private-dind-reconcile-v12.service serverware-coder-lifecycle-v12.socket serverware-coder-lifecycle-privileged-v12.socket
Requires=serverware-coder-runtime-v12.service serverware-coder-private-dind-reconcile-v12.service serverware-coder-lifecycle-v12.socket serverware-coder-lifecycle-privileged-v12.socket
Before=serverware-coder-docker-proxy-v12.service serverware-coder-plan-executor-v12.service serverware-coder-controller-v12.service
RequiresMountsFor=/var/lib/serverware/coder-controller-v12

[Service]
Type=notify
User=serverware-coder-lifecycle
Group=serverware-coder-lifecycle
SupplementaryGroups=serverware-coder-lifecycle-api serverware-coder-lifecycle-privileged-api
UMask=0077
LoadCredentialEncrypted=lifecycle-authority-key:@RELEASE_ROOT@/credentials/lifecycle-authority-key.cred
Sockets=serverware-coder-lifecycle-v12.socket
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-lifecycle-v12 --config @RELEASE_ROOT@/config/lifecycle-v12.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=45s
TimeoutStopSec=120s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/serverware/coder/v12/lifecycle /var/lib/serverware/coder-controller-v12/lifecycle

[Install]
WantedBy=serverware-coder-v12.target
