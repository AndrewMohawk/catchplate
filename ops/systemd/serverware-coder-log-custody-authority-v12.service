[Unit]
Description=Serverware Coder v12 independent log-custody authority
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-log-custody-authority-v12.socket
Requires=serverware-coder-runtime-v12.service serverware-coder-log-custody-authority-v12.socket
Before=serverware-coder-receipt-authority-v12.service
RequiresMountsFor=/var/lib/serverware/coder-controller-v12

[Service]
Type=notify
User=serverware-coder-log
Group=serverware-coder-log
SupplementaryGroups=serverware-coder-log-api
UMask=0077
Sockets=serverware-coder-log-custody-authority-v12.socket
LoadCredentialEncrypted=log-custody-authority-key:@RELEASE_ROOT@/credentials/log-custody-authority-key.cred
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-log-custody-authority-v12 --config @RELEASE_ROOT@/config/log-custody-authority-v12.json
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/serverware/coder-controller-v12/log-custody

[Install]
WantedBy=serverware-coder-v12.target
