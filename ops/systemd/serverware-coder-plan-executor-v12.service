[Unit]
Description=Serverware Coder v12 plan executor with mandatory per-invocation signed readiness
PartOf=serverware-coder-v12.target
After=local-fs.target serverware-coder-runtime-v12.service serverware-coder-plan-executor-v12.socket serverware-coder-lifecycle-v12.service serverware-coder-docker-proxy-v12.service serverware-coder-receipt-authority-v12.service serverware-coder-final-verdict-authority-v12.service
Requires=serverware-coder-runtime-v12.service serverware-coder-plan-executor-v12.socket serverware-coder-lifecycle-v12.service serverware-coder-docker-proxy-v12.service serverware-coder-receipt-authority-v12.service serverware-coder-final-verdict-authority-v12.service
Before=serverware-coder-controller-v12.service serverware-coder-readiness-v12.service
RequiresMountsFor=/var/lib/serverware/coder-controller-v12

[Service]
Type=notify
User=serverware-coder-executor
Group=serverware-coder-executor
SupplementaryGroups=serverware-coder-executor-api serverware-coder-docker-api serverware-coder-lifecycle-api serverware-coder-cas
UMask=0077
LoadCredentialEncrypted=plan-executor-capability-key:@RELEASE_ROOT@/credentials/plan-executor-capability-key.cred
Environment=SERVERWARE_CODER_PLAN_EXECUTOR_CONFIG_SHA256=@PLAN_EXECUTOR_CONFIG_SHA256@
Environment=SERVERWARE_CODER_REQUIRE_PER_INVOCATION_READINESS_V12=1
Sockets=serverware-coder-plan-executor-v12.socket
ExecStart=@RELEASE_ROOT@/bin/serverware-coder-plan-executor-v12 --config @RELEASE_ROOT@/config/plan-executor-v12.conf daemon
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=120s
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/serverware/coder/v12/plan-executor /var/lib/serverware/coder-controller-v12/executor /var/lib/serverware/coder-controller-v12/cas

[Install]
WantedBy=serverware-coder-v12.target
