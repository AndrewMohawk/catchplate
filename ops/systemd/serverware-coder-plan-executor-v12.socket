[Unit]
Description=Serverware Coder v12 root-owned plan executor ingress
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-plan-executor-v12.service

[Socket]
ListenSequentialPacket=/run/serverware/coder/v12/plan-executor/control.sock
SocketUser=root
SocketGroup=serverware-coder-executor-api
SocketMode=0660
DirectoryMode=0750
Backlog=128
RemoveOnStop=yes
Accept=no
Service=serverware-coder-plan-executor-v12.service

[Install]
WantedBy=serverware-coder-v12.target
