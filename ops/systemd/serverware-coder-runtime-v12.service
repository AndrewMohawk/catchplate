[Unit]
Description=Serverware Coder v12 exact runtime directory setup
PartOf=serverware-coder-v12.target
After=local-fs.target
Before=serverware-coder-controller-v12.socket serverware-coder-lifecycle-privileged-v12.socket serverware-coder-private-dind-reconcile-v12.service serverware-coder-lifecycle-v12.socket serverware-coder-lifecycle-v12.service serverware-coder-trust-generation-v12.socket serverware-coder-trust-generation-v12.service serverware-coder-external-witness-v12.socket serverware-coder-external-witness-v12.service serverware-coder-final-settlement-v12.socket serverware-coder-final-settlement-v12.service serverware-coder-receipt-authority-v12.socket serverware-coder-receipt-authority-v12.service serverware-coder-log-custody-authority-v12.socket serverware-coder-log-custody-authority-v12.service serverware-coder-final-verdict-authority-v12.socket serverware-coder-final-verdict-authority-v12.service serverware-coder-docker-proxy-v12.socket serverware-coder-docker-proxy-v12.service serverware-coder-plan-executor-v12.socket serverware-coder-plan-executor-v12.service serverware-coder-controller-v12.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=@RELEASE_ROOT@/hooks/runtime-directories-v12.sh setup @CLIENT_GROUP@
ExecStop=@RELEASE_ROOT@/hooks/runtime-directories-v12.sh cleanup @CLIENT_GROUP@
RemainAfterExit=yes
TimeoutStartSec=15s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/run/serverware

[Install]
WantedBy=serverware-coder-v12.target
