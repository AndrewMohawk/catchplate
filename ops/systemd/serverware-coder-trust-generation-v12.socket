[Unit]
Description=Serverware Coder v12 local trust-generation RPC
PartOf=serverware-coder-v12.target
After=serverware-coder-runtime-v12.service
Requires=serverware-coder-runtime-v12.service
Before=serverware-coder-trust-generation-v12.service

[Socket]
ListenStream=/run/serverware/coder/v12/trust-generation/control.sock
SocketUser=root
SocketGroup=serverware-coder-trust-api
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=yes
Accept=no
Service=serverware-coder-trust-generation-v12.service

[Install]
WantedBy=serverware-coder-v12.target
