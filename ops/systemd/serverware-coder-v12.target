[Unit]
Description=Serverware Coder controller v12 complete service set
Requires=serverware-coder-runtime-v12.service
Requires=serverware-coder-controller-v12.socket
Requires=serverware-coder-lifecycle-privileged-v12.socket
Requires=serverware-coder-private-dind-reconcile-v12.service
Requires=serverware-coder-lifecycle-v12.socket
Requires=serverware-coder-lifecycle-v12.service
Requires=serverware-coder-trust-generation-v12.socket
Requires=serverware-coder-trust-generation-v12.service
Requires=serverware-coder-external-witness-v12.socket
Requires=serverware-coder-external-witness-v12.service
Requires=serverware-coder-final-settlement-v12.socket
Requires=serverware-coder-final-settlement-v12.service
Requires=serverware-coder-receipt-authority-v12.socket
Requires=serverware-coder-receipt-authority-v12.service
Requires=serverware-coder-log-custody-authority-v12.socket
Requires=serverware-coder-log-custody-authority-v12.service
Requires=serverware-coder-final-verdict-authority-v12.socket
Requires=serverware-coder-final-verdict-authority-v12.service
Requires=serverware-coder-docker-proxy-v12.socket
Requires=serverware-coder-docker-proxy-v12.service
Requires=serverware-coder-plan-executor-v12.socket
Requires=serverware-coder-plan-executor-v12.service
Requires=serverware-coder-controller-v12.service
Requires=serverware-coder-readiness-v12.service
After=serverware-coder-readiness-v12.service

[Install]
WantedBy=multi-user.target
