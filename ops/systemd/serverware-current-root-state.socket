# Uninstalled template. Reserve/completion callers require independently
# provisioned socket-group access; SO_PEERCRED still checks their primary IDs.
# Recreating this socket invalidates the separately signed listener identities.
[Unit]
Description=Serverware independently enrolled current-root state ingress
Before=serverware-current-root-state.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/current-root/state.sock
FileDescriptorName=serverware-current-root-state
SocketUser=65516
SocketGroup=65516
SocketMode=0660
DirectoryMode=0755
Backlog=16
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-current-root-state.service

[Install]
WantedBy=sockets.target
