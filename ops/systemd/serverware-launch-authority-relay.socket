[Unit]
Description=Serverware production launch authority relay socket
Documentation=https://github.com/example/private-deployment

[Socket]
ListenSequentialPacket=/run/serverware/launch-authority.sock
SocketMode=0600
SocketUser=root
SocketGroup=root
# Search-only access lets the dedicated relay service validate the inherited path;
# the socket remains root:root 0600 and accepts only root SO_PEERCRED peers.
DirectoryMode=0711
RemoveOnStop=yes
Service=serverware-launch-authority-relay.service

[Install]
WantedBy=sockets.target
