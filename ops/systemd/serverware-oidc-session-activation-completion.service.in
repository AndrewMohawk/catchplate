# Unrendered, uninstalled input. Independent provisioning supplies accounts,
# exact release, role/history originals, keys, TLS/DB roles, current pending
# scope, packet/caller pins and separate completion journal/checkpoint.
# Signing/AES keys: root0400. TLS publics: root0444; keys: root:65503 0440.
# UID 65503 needs separately admitted state profile/socket DAC access; it has
# no supplementary groups. Independently restrict read-only PostgreSQL egress.
[Unit]
Description=Serverware dedicated activation completion owner (trusted-host-local)
BindsTo=serverware-oidc-session-activation-completion.socket
After=local-fs.target serverware-oidc-session-activation-completion.socket
RequiresMountsFor=@ACTIVATION_COMPLETION_RELEASE_ROOT@ @ACTIVATION_COMPLETION_TRUST_DIR@ @ACTIVATION_COMPLETION_KEY_FILE@ @ACTIVATION_COMPLETION_BUNDLE_KEY@ @ACTIVATION_COMPLETION_DELIVERY_KEY@ @ACTIVATION_COMPLETION_TLS_DIR@ @ACTIVATION_COMPLETION_JOURNAL_DIR@
AssertPathIsDirectory=@ACTIVATION_COMPLETION_RELEASE_ROOT@
AssertPathIsDirectory=@ACTIVATION_COMPLETION_TRUST_DIR@
AssertPathIsDirectory=@ACTIVATION_COMPLETION_TLS_DIR@
AssertPathIsDirectory=@ACTIVATION_COMPLETION_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root permanently drops to 65503:65503. Seven FDs 198..204. One accepted
# exchange, including rejection/uncertainty, ends this launch. No retry.
# Type=exec does not establish cryptographic or database readiness.
User=root
Group=root
RootDirectory=@ACTIVATION_COMPLETION_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@ACTIVATION_COMPLETION_TRUST_DIR@:/run/serverware/oidc-session-activation-completion-trust
BindReadOnlyPaths=@ACTIVATION_COMPLETION_KEY_FILE@:/run/serverware/oidc-session-activation-completion-key/completion.pem
BindReadOnlyPaths=@ACTIVATION_COMPLETION_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-bundle-key
BindReadOnlyPaths=@ACTIVATION_COMPLETION_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-key
BindReadOnlyPaths=@ACTIVATION_COMPLETION_TLS_DIR@:/run/serverware/oidc-session-activation-completion-tls
BindReadOnlyPaths=/run/serverware/oidc-session-activation:/run/serverware/oidc-session-activation
BindReadOnlyPaths=/run/serverware/current-root:/run/serverware/current-root
BindPaths=@ACTIVATION_COMPLETION_JOURNAL_DIR@:/var/lib/serverware/oidc-session-activation-completions
ReadWritePaths=/var/lib/serverware/oidc-session-activation-completions
Sockets=serverware-oidc-session-activation-completion.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_completion_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cooperative shutdown/cgroup escalation is not a hard syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
