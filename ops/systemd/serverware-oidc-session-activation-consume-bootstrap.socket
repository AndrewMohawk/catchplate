# Opt-in source template; installation and exact resource admission are separate.
# Staging acknowledges sealed originals, not worker readiness or token release.
[Unit]
Description=Serverware private consume planner bootstrap staging socket
Before=serverware-oidc-session-activation-consume-dynamic.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation/consume-bootstrap.sock
FileDescriptorName=serverware-oidc-session-activation-consume-bootstrap
SocketUser=0
SocketGroup=65495
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-consume-dynamic.service

[Install]
WantedBy=sockets.target
