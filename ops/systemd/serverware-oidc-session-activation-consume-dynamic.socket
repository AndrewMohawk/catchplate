# Alternate to the fixed planner socket, never installed alongside it.
# Recreating this path invalidates the independently admitted resource identity.
[Unit]
Description=Serverware dynamically staged consume planner socket
Before=serverware-oidc-session-activation-consume-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=serverware-oidc-session-activation-delivery-planner.socket serverware-oidc-session-activation-delivery-planner.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation/delivery-planner.sock
FileDescriptorName=serverware-oidc-session-activation-delivery-planner
SocketUser=65501
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-consume-dynamic.service

[Install]
WantedBy=sockets.target
