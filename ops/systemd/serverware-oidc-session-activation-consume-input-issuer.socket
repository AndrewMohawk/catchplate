# Uninstalled source. Provision exact policy/activation/launch originals first.
[Unit]
Description=Serverware private consume-input issuer ingress
Before=serverware-oidc-session-activation-consume-input-issuer.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-consume-inputs/grants.sock
FileDescriptorName=serverware-oidc-session-activation-consume-input-issuer
SocketUser=65495
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-consume-input-issuer.service

[Install]
WantedBy=sockets.target
