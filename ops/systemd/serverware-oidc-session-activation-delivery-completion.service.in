# Unrendered, uninstalled input. Independent provisioning supplies exact release,
# root/custody originals, keys, TLS reader roles, pending scope and journal/checkpoint.
# Signing/AES keys root0400; TLS public root0444, keys root:65497 0440.
# State v9 and independent socket DAC admit 65497; no supplementary groups.
[Unit]
Description=Serverware consume completion owner (trusted-host-local)
BindsTo=serverware-oidc-session-activation-delivery-completion.socket
Requires=serverware-current-root-state.socket
After=local-fs.target serverware-oidc-session-activation-delivery-completion.socket serverware-current-root-state.socket
RequiresMountsFor=@DELIVERY_COMPLETION_RELEASE_ROOT@ @DELIVERY_COMPLETION_TRUST_DIR@ @DELIVERY_COMPLETION_SIGNING_KEY@ @DELIVERY_COMPLETION_EXECUTION_BUNDLE_KEY@ @DELIVERY_COMPLETION_HISTORICAL_BUNDLE_KEY@ @DELIVERY_COMPLETION_DELIVERY_KEY@ @DELIVERY_COMPLETION_TLS_DIR@ @DELIVERY_COMPLETION_JOURNAL_DIR@
AssertPathIsDirectory=@DELIVERY_COMPLETION_RELEASE_ROOT@
AssertPathIsDirectory=@DELIVERY_COMPLETION_TRUST_DIR@
AssertPathIsDirectory=@DELIVERY_COMPLETION_TLS_DIR@
AssertPathIsDirectory=@DELIVERY_COMPLETION_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root drops permanently to 65497:65497 and continues in the SAME PID with the
# actual work/window/deadline. Eight CLOEXEC descriptors 198..205; no postdrop exec.
# One accepted exchange spends the launch. Type=exec is not semantic readiness.
User=root
Group=root
RootDirectory=@DELIVERY_COMPLETION_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@DELIVERY_COMPLETION_TRUST_DIR@:/run/serverware/oidc-session-activation-delivery-completion-trust
BindReadOnlyPaths=@DELIVERY_COMPLETION_SIGNING_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-completion-signing-key
BindReadOnlyPaths=@DELIVERY_COMPLETION_EXECUTION_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-completion-execution-bundle-key
BindReadOnlyPaths=@DELIVERY_COMPLETION_HISTORICAL_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-completion-historical-bundle-key
BindReadOnlyPaths=@DELIVERY_COMPLETION_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-completion-delivery-key
BindReadOnlyPaths=@DELIVERY_COMPLETION_TLS_DIR@:/run/serverware/oidc-session-activation-delivery-completion-tls
BindReadOnlyPaths=/run/serverware/oidc-session-activation-delivery-execution:/run/serverware/oidc-session-activation-delivery-execution
BindReadOnlyPaths=/run/serverware/current-root:/run/serverware/current-root
BindPaths=@DELIVERY_COMPLETION_JOURNAL_DIR@:/var/lib/serverware/oidc-session-activation-delivery-completions
ReadWritePaths=/var/lib/serverware/oidc-session-activation-delivery-completions
Sockets=serverware-oidc-session-activation-delivery-completion.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_delivery_completion_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
