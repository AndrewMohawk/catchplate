# Uninstalled source input. This endpoint admits independently root-authorized
# private completion-purpose receivers, not the public/control-plane UID.
[Unit]
Description=Serverware private consume completion ingress
Before=serverware-oidc-session-activation-delivery-completion.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-delivery-execution/completion.sock
FileDescriptorName=serverware-oidc-session-activation-delivery-completion
SocketUser=65497
SocketGroup=65497
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-delivery-completion.service

[Install]
WantedBy=sockets.target
