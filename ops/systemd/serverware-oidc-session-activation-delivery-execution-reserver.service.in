# Unrendered and uninstalled. Independently provision the admitted immutable
# release, six root trust originals, four private keys and checkpointed journal.
# State v8 and state-socket access for UID 65499 remain separate prerequisites;
# a read-only state socket mount does not grant an ACL or a new protocol purpose.
[Unit]
Description=Serverware dedicated consume execution reserver (trusted-host-local)
BindsTo=serverware-oidc-session-activation-delivery-execution-reserver.socket
After=local-fs.target serverware-oidc-session-activation-delivery-execution-reserver.socket
RequiresMountsFor=@CONSUME_RESERVER_RELEASE_ROOT@ @CONSUME_RESERVER_TRUST_DIR@ @CONSUME_RESERVER_COMPUTATION_KEY@ @CONSUME_RESERVER_EXECUTION_BUNDLE_KEY@ @CONSUME_RESERVER_HISTORICAL_BUNDLE_KEY@ @CONSUME_RESERVER_DELIVERY_KEY@ @CONSUME_RESERVER_JOURNAL_DIR@
AssertPathIsDirectory=@CONSUME_RESERVER_RELEASE_ROOT@
AssertPathIsDirectory=@CONSUME_RESERVER_TRUST_DIR@
AssertPathIsDirectory=@CONSUME_RESERVER_JOURNAL_DIR@
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/root-public-key.pem
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/bootstrap.json
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/custody.json
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/planner-bootstrap.json
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/planner-history-custody.json
AssertPathExists=@CONSUME_RESERVER_TRUST_DIR@/receiving-history-custody.json
AssertPathExists=@CONSUME_RESERVER_COMPUTATION_KEY@
AssertPathExists=@CONSUME_RESERVER_EXECUTION_BUNDLE_KEY@
AssertPathExists=@CONSUME_RESERVER_HISTORICAL_BUNDLE_KEY@
AssertPathExists=@CONSUME_RESERVER_DELIVERY_KEY@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same isolated process drops permanently to 65499:65499 and no extra groups.
# Twelve inherited descriptors 198..209; one accepted request per launch.
# Type=exec does not establish cryptographic readiness or reservation delivery.
User=root
Group=root
RootDirectory=@CONSUME_RESERVER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@CONSUME_RESERVER_TRUST_DIR@:/run/serverware/oidc-session-activation-delivery-execution-reserver-trust
BindReadOnlyPaths=@CONSUME_RESERVER_COMPUTATION_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-reserver-computation-key
BindReadOnlyPaths=@CONSUME_RESERVER_EXECUTION_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-reserver-execution-bundle-key
BindReadOnlyPaths=@CONSUME_RESERVER_HISTORICAL_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-reserver-historical-bundle-key
BindReadOnlyPaths=@CONSUME_RESERVER_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-reserver-delivery-key
BindReadOnlyPaths=/run/serverware/oidc-session-activation-delivery-execution:/run/serverware/oidc-session-activation-delivery-execution
BindReadOnlyPaths=/run/serverware/current-root:/run/serverware/current-root
BindPaths=@CONSUME_RESERVER_JOURNAL_DIR@:/var/lib/serverware/oidc-session-activation-delivery-execution-reservations
ReadWritePaths=/var/lib/serverware/oidc-session-activation-delivery-execution-reservations
Sockets=serverware-oidc-session-activation-delivery-execution-reserver.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_reserver_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cooperative TERM/cgroup escalation is not a hard kernel syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
