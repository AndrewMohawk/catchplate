# Uninstalled deployment input. Recreating the socket invalidates signed pins.
# This file provisions neither accounts, root assertions nor state-peer access.
[Unit]
Description=Serverware dedicated consume reservation ingress
Before=serverware-oidc-session-activation-delivery-execution-reserver.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-delivery-execution/reserver.sock
FileDescriptorName=serverware-oidc-session-activation-delivery-execution-reserver
SocketUser=65499
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-delivery-execution-reserver.service

[Install]
WantedBy=sockets.target
