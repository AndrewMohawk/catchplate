# Unrendered, uninstalled deployment input; no account, key or journal creation.
# Independent admission supplies six trust originals, three AES originals,
# five TLS files, immutable release, attempt checkpoint and current pending pins.
# TLS public files: root 0444; private files: root:65498 0440; AES: root 0400/raw32.
# Independently restrict database network egress to the exact admitted endpoint.
[Unit]
Description=Serverware dedicated consume SQL owner (trusted-host-local)
BindsTo=serverware-oidc-session-activation-delivery-execution-sql.socket
After=local-fs.target serverware-oidc-session-activation-delivery-execution-sql.socket
RequiresMountsFor=@CONSUME_SQL_RELEASE_ROOT@ @CONSUME_SQL_TRUST_DIR@ @CONSUME_SQL_TLS_DIR@ @CONSUME_SQL_EXECUTION_BUNDLE_KEY@ @CONSUME_SQL_HISTORICAL_BUNDLE_KEY@ @CONSUME_SQL_DELIVERY_KEY@ @CONSUME_SQL_JOURNAL_DIR@
AssertPathIsDirectory=@CONSUME_SQL_RELEASE_ROOT@
AssertPathIsDirectory=@CONSUME_SQL_TRUST_DIR@
AssertPathIsDirectory=@CONSUME_SQL_TLS_DIR@
AssertPathIsDirectory=@CONSUME_SQL_JOURNAL_DIR@
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/root-public-key.pem
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/bootstrap.json
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/custody.json
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/planner-bootstrap.json
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/planner-history-custody.json
AssertPathExists=@CONSUME_SQL_TRUST_DIR@/receiving-history-custody.json
AssertPathExists=@CONSUME_SQL_EXECUTION_BUNDLE_KEY@
AssertPathExists=@CONSUME_SQL_HISTORICAL_BUNDLE_KEY@
AssertPathExists=@CONSUME_SQL_DELIVERY_KEY@
AssertPathExists=@CONSUME_SQL_TLS_DIR@/ca.pem
AssertPathExists=@CONSUME_SQL_TLS_DIR@/issuer.crt
AssertPathExists=@CONSUME_SQL_TLS_DIR@/issuer.key
AssertPathExists=@CONSUME_SQL_TLS_DIR@/executor.crt
AssertPathExists=@CONSUME_SQL_TLS_DIR@/executor.key
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same isolated PID drops permanently to 65498:65498, no supplementary groups.
# Eleven fixed descriptors 198..208; no signer; one accepted exchange per launch.
# Type=exec is not cryptographic admission, DB readiness or observed commit.
User=root
Group=root
RootDirectory=@CONSUME_SQL_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@CONSUME_SQL_TRUST_DIR@:/run/serverware/oidc-session-activation-delivery-execution-sql-trust
BindReadOnlyPaths=@CONSUME_SQL_TLS_DIR@:/run/serverware/oidc-session-activation-delivery-execution-sql-tls
BindReadOnlyPaths=@CONSUME_SQL_EXECUTION_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-sql-execution-bundle-key
BindReadOnlyPaths=@CONSUME_SQL_HISTORICAL_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-sql-historical-bundle-key
BindReadOnlyPaths=@CONSUME_SQL_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-delivery-execution-sql-delivery-key
BindReadOnlyPaths=/run/serverware/oidc-session-activation-delivery-execution:/run/serverware/oidc-session-activation-delivery-execution
BindPaths=@CONSUME_SQL_JOURNAL_DIR@:/var/lib/serverware/oidc-session-activation-delivery-execution-sql-attempts
ReadWritePaths=/var/lib/serverware/oidc-session-activation-delivery-execution-sql-attempts
Sockets=serverware-oidc-session-activation-delivery-execution-sql.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_delivery_execution_sql_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cooperative TERM and cgroup escalation do not make a hard syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
