# Uninstalled deployment input. Recreating the listener invalidates signed pins.
[Unit]
Description=Serverware dedicated consume SQL ingress
Before=serverware-oidc-session-activation-delivery-execution-sql.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-delivery-execution/sql.sock
FileDescriptorName=serverware-oidc-session-activation-delivery-execution-sql
SocketUser=65498
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-delivery-execution-sql.service

[Install]
WantedBy=sockets.target
