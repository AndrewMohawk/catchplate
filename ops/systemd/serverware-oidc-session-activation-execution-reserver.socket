# Uninstalled deployment input. No account, permission or execution authority
# is provisioned; recreating the socket invalidates its signed resource pins.
[Unit]
Description=Serverware dedicated OIDC activation execution reservation ingress
Before=serverware-oidc-session-activation-execution-reserver.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-execution/reserver.sock
FileDescriptorName=serverware-oidc-session-activation-execution-reserver
SocketUser=65505
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-execution-reserver.service

[Install]
WantedBy=sockets.target
