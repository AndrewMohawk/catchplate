# Uninstalled input. Recreating the socket invalidates signed resource pins.
[Unit]
Description=Serverware dedicated OIDC activation one-use SQL ingress
Before=serverware-oidc-session-activation-execution-sql.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-execution/sql.sock
FileDescriptorName=serverware-oidc-session-activation-execution-sql
SocketUser=65504
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-execution-sql.service

[Install]
WantedBy=sockets.target
