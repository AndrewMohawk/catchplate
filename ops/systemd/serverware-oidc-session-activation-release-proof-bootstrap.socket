# Opt-in source template; independent resource provisioning is separate.
# A staged ACK is neither proof-worker readiness nor committed-release evidence.
[Unit]
Description=Serverware private release-proof bootstrap staging socket
Before=serverware-oidc-session-activation-release-proof-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=serverware-oidc-session-activation-release-proof.socket serverware-oidc-session-activation-release-proof.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/proof-bootstrap.sock
FileDescriptorName=serverware-oidc-session-activation-release-proof-bootstrap
SocketUser=0
SocketGroup=65494
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-release-proof-dynamic.service

[Install]
WantedBy=sockets.target
