# Alternate to the fixed proof socket, never installed alongside it.
# Recreating the path invalidates independently admitted resource identities.
[Unit]
Description=Serverware dynamically staged committed-release proof socket
Before=serverware-oidc-session-activation-release-proof-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=serverware-oidc-session-activation-release-proof.socket serverware-oidc-session-activation-release-proof.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/proof.sock
FileDescriptorName=serverware-oidc-session-activation-release-proof
SocketUser=65497
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-release-proof-dynamic.service

[Install]
WantedBy=sockets.target
