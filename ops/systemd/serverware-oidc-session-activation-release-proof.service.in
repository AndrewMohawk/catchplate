# Unrendered, uninstalled source. Independent provisioning supplies exact source,
# post-intent root custody/bootstrap, proof enrollment/signer and reader TLS.
# No completion signer, completion journal, state socket or SQL write role.
[Unit]
Description=Serverware committed-release proof worker (trusted-host-local)
BindsTo=serverware-oidc-session-activation-release-proof.socket
After=local-fs.target serverware-oidc-session-activation-release-proof.socket
RequiresMountsFor=@RELEASE_PROOF_RELEASE_ROOT@ @RELEASE_PROOF_TRUST_DIR@ @RELEASE_PROOF_SIGNING_KEY@ @RELEASE_PROOF_EXECUTION_BUNDLE_KEY@ @RELEASE_PROOF_HISTORICAL_BUNDLE_KEY@ @RELEASE_PROOF_DELIVERY_KEY@ @RELEASE_PROOF_TLS_DIR@
AssertPathIsDirectory=@RELEASE_PROOF_RELEASE_ROOT@
AssertPathIsDirectory=@RELEASE_PROOF_TRUST_DIR@
AssertPathIsDirectory=@RELEASE_PROOF_TLS_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root drops permanently to 65497:65497; same PID, work/window/deadline.
# Seven CLOEXEC FDs198..204; one request, no postdrop exec or retry.
User=root
Group=root
RootDirectory=@RELEASE_PROOF_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RELEASE_PROOF_TRUST_DIR@:/run/serverware/oidc-session-activation-release-proof-trust
BindReadOnlyPaths=@RELEASE_PROOF_SIGNING_KEY@:/run/secrets/serverware-oidc-session-activation-release-proof-signing-key
BindReadOnlyPaths=@RELEASE_PROOF_EXECUTION_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-release-proof-execution-bundle-key
BindReadOnlyPaths=@RELEASE_PROOF_HISTORICAL_BUNDLE_KEY@:/run/secrets/serverware-oidc-session-activation-release-proof-historical-bundle-key
BindReadOnlyPaths=@RELEASE_PROOF_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-release-proof-delivery-key
BindReadOnlyPaths=@RELEASE_PROOF_TLS_DIR@:/run/serverware/oidc-session-activation-delivery-completion-tls
BindReadOnlyPaths=/run/serverware/oidc-session-activation-token-release:/run/serverware/oidc-session-activation-token-release
Sockets=serverware-oidc-session-activation-release-proof.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_proof_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
