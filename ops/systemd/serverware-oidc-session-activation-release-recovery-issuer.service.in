# Unrendered, uninstalled source; no keys, resources or accepted release supplied.
[Unit]
Description=Serverware one-shot recovery-grant issuer (trusted-host-local)
BindsTo=serverware-oidc-session-activation-release-recovery-issuer.socket
After=local-fs.target serverware-oidc-session-activation-release-recovery-issuer.socket
RequiresMountsFor=@RECOVERY_ISSUER_RELEASE_ROOT@ @RECOVERY_ISSUER_TRUST_DIR@ @RECOVERY_ISSUER_ROOT_SIGNING_KEY@
AssertPathIsDirectory=@RECOVERY_ISSUER_RELEASE_ROOT@
AssertPathIsDirectory=@RECOVERY_ISSUER_TRUST_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Same PID and original allowance across permanent root -> 65493:65493 drop.
# Eight fixed descriptors198..205; no post-drop exec, retry, store or staging.
User=root
Group=root
RootDirectory=@RECOVERY_ISSUER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RECOVERY_ISSUER_TRUST_DIR@:/run/serverware/oidc-session-activation-release-recovery-issuer-trust
BindReadOnlyPaths=@RECOVERY_ISSUER_ROOT_SIGNING_KEY@:/run/secrets/serverware-oidc-session-activation-release-recovery-issuer-root-signing-key
BindReadOnlyPaths=/run/serverware/oidc-session-activation-token-release:/run/serverware/oidc-session-activation-token-release
Sockets=serverware-oidc-session-activation-release-recovery-issuer.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_recovery_issuer_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
