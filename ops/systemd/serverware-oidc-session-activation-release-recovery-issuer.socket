# Uninstalled source. Requires independently provisioned recovery originals.
[Unit]
Description=Serverware private recovery-grant issuer ingress
Before=serverware-oidc-session-activation-release-recovery-issuer.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/recovery-grants.sock
FileDescriptorName=serverware-oidc-session-activation-release-recovery-issuer
SocketUser=65493
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-release-recovery-issuer.service

[Install]
WantedBy=sockets.target
