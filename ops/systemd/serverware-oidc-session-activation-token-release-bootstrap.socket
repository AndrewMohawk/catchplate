# Uninstalled source. Root listener is accessible only to the private issuer.
[Unit]
Description=Serverware private release-bootstrap staging ingress
Before=serverware-oidc-session-activation-token-release-dynamic.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/bootstrap.sock
FileDescriptorName=serverware-oidc-session-activation-token-release-bootstrap
SocketUser=0
SocketGroup=65496
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-token-release-dynamic.service

[Install]
WantedBy=sockets.target
