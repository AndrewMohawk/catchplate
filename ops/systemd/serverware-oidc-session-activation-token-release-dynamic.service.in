# Uninstalled source; exact policy/proof, key, listener and slot provisioning
# remains independent. A staging ACK is not worker readiness or token delivery.
[Unit]
Description=Serverware original-bound dynamic release delivery (trusted-host-local)
BindsTo=serverware-oidc-session-activation-token-release-bootstrap.socket serverware-oidc-session-activation-token-release-dynamic.socket
After=local-fs.target serverware-oidc-session-activation-token-release-bootstrap.socket serverware-oidc-session-activation-token-release-dynamic.socket
Conflicts=serverware-oidc-session-activation-token-release.socket serverware-oidc-session-activation-token-release.service
RequiresMountsFor=@RELEASE_WORKER_ROOT@ @RELEASE_DYNAMIC_TRUST_DIR@ @RELEASE_DELIVERY_KEY@ @RELEASE_OUTCOME_BASE_DIR@
AssertPathIsDirectory=@RELEASE_WORKER_ROOT@
AssertPathIsDirectory=@RELEASE_DYNAMIC_TRUST_DIR@
AssertPathIsDirectory=@RELEASE_OUTCOME_BASE_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Exactly two initial named sockets; systemd does not order separate units.
# Map names to actual paths, then retain only final five CLOEXEC FDs198..202.
# Original work/window spans stage, sole permanent drop and release serving.
User=root
Group=root
RootDirectory=@RELEASE_WORKER_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RELEASE_DYNAMIC_TRUST_DIR@:/run/serverware/oidc-session-activation-token-release-dynamic-trust
BindReadOnlyPaths=@RELEASE_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-token-release-delivery-key
BindReadOnlyPaths=/run/serverware/oidc-session-activation-token-release:/run/serverware/oidc-session-activation-token-release
BindPaths=@RELEASE_OUTCOME_BASE_DIR@:/var/lib/serverware/oidc-session-activation-release-outcomes
ReadWritePaths=/var/lib/serverware/oidc-session-activation-release-outcomes
Sockets=serverware-oidc-session-activation-token-release-bootstrap.socket serverware-oidc-session-activation-token-release-dynamic.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_dynamic_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
