# Alternative to the fixed-bootstrap socket, never a second release listener.
[Unit]
Description=Serverware dynamically staged private token-release ingress
Before=serverware-oidc-session-activation-token-release-dynamic.service
After=systemd-tmpfiles-setup.service
Conflicts=serverware-oidc-session-activation-token-release.socket serverware-oidc-session-activation-token-release.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/release.sock
FileDescriptorName=serverware-oidc-session-activation-token-release
SocketUser=65502
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-token-release-dynamic.service

[Install]
WantedBy=sockets.target
