# Unrendered, uninstalled input. Provisioning independently supplies a protected
# release, signed originals, root0400 raw32 key, and already-existing slot.
# The root0700 base is not a shared outcome: only one digest-derived child is
# opened, matched to signed pins and retained through permanent privilege drop.
[Unit]
Description=Serverware private activation token-release worker (trusted-host-local)
BindsTo=serverware-oidc-session-activation-token-release.socket
After=local-fs.target serverware-oidc-session-activation-token-release.socket
RequiresMountsFor=@RELEASE_WORKER_ROOT@ @RELEASE_TRUST_DIR@ @RELEASE_DELIVERY_KEY@ @RELEASE_OUTCOME_BASE_DIR@
AssertPathIsDirectory=@RELEASE_WORKER_ROOT@
AssertPathIsDirectory=@RELEASE_TRUST_DIR@
AssertPathIsDirectory=@RELEASE_OUTCOME_BASE_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Sole permanent drop to 65502:65502, same PID/work/window/deadline. Five CLOEXEC
# descriptors 198..202. One accepted exchange is terminal, including uncertainty.
# Type=exec is not semantic readiness; no post-drop exec or standalone --run.
User=root
Group=root
RootDirectory=@RELEASE_WORKER_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RELEASE_TRUST_DIR@:/run/serverware/oidc-session-activation-token-release-trust
BindReadOnlyPaths=@RELEASE_DELIVERY_KEY@:/run/secrets/serverware-oidc-session-activation-token-release-delivery-key
BindReadOnlyPaths=/run/serverware/oidc-session-activation-token-release:/run/serverware/oidc-session-activation-token-release
BindPaths=@RELEASE_OUTCOME_BASE_DIR@:/var/lib/serverware/oidc-session-activation-release-outcomes
ReadWritePaths=/var/lib/serverware/oidc-session-activation-release-outcomes
Sockets=serverware-oidc-session-activation-token-release.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/oidc_session_activation_release_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
