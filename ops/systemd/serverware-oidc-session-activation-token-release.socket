# Uninstalled source input; peer credentials do not replace original admission.
[Unit]
Description=Serverware private activation token-release ingress
Before=serverware-oidc-session-activation-token-release.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/oidc-session-activation-token-release/release.sock
FileDescriptorName=serverware-oidc-session-activation-token-release
SocketUser=65502
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=1
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-oidc-session-activation-token-release.service

[Install]
WantedBy=sockets.target
