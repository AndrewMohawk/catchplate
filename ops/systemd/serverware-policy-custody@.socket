[Unit]
Description=Serverware policy-custody %i authenticated ingress
PartOf=serverware-policy-custody-sockets.target serverware-policy-custody.target
Before=serverware-policy-custody@%i.service
After=systemd-tmpfiles-setup.service
AssertPathIsDirectory=/run/serverware/policy-custody
StartLimitIntervalSec=60s
StartLimitBurst=3

[Socket]
ListenSequentialPacket=/run/serverware/policy-custody/%i.sock
FileDescriptorName=listener
SocketUser=root
SocketGroup=swpc-driver
SocketMode=0660
DirectoryMode=0750
Backlog=1
PassCredentials=yes
FlushPending=yes
RemoveOnStop=yes
Accept=no
Service=serverware-policy-custody@%i.service
TriggerLimitIntervalSec=60s
TriggerLimitBurst=3

[Install]
WantedBy=serverware-policy-custody-sockets.target
