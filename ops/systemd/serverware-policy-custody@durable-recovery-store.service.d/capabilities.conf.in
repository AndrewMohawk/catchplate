[Service]
User=swpc-store
Group=swpc-store
StateDirectory=serverware/policy-custody/durable-recovery-store/journal
StateDirectoryMode=0700
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
CPUAccounting=yes
CPUQuota=100%
TasksAccounting=yes
TasksMax=16
IOAccounting=yes
# O_RDONLY is the only valid open mode for a Linux directory descriptor; the
# owner-writable inode remains mutable through descriptor-relative syscalls.
OpenFile=%S/serverware/policy-custody/durable-recovery-store/journal:journal:read-only
InaccessiblePaths=%S/serverware/policy-custody/durable-recovery-store/journal
