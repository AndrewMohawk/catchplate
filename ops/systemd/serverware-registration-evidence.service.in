# Unrendered deployment input, not an installed or verified service. The release
# root is an independently approved complete runtime image export, not a checkout.
# No account, key, receipt, replay storage or trust root is provisioned here.
[Unit]
Description=Serverware independent registration evidence signer (trusted-host-local)
BindsTo=serverware-registration-evidence.socket
After=local-fs.target serverware-registration-evidence.socket
RequiresMountsFor=@SIGNER_RELEASE_ROOT@ @SIGNER_TRUST_DIR@ @SIGNER_KEY_FILE@ @SIGNER_REPLAY_DIR@
AssertPathIsDirectory=@SIGNER_RELEASE_ROOT@
AssertPathIsDirectory=@SIGNER_TRUST_DIR@
AssertPathIsDirectory=@SIGNER_REPLAY_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Exec is not an admission/readiness receipt. The root delivery drops all groups,
# capabilities and root IDs before the fixed nonroot runner admits its five FDs.
User=root
Group=root
RootDirectory=@SIGNER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@SIGNER_TRUST_DIR@:/run/serverware/registration-evidence-trust
BindReadOnlyPaths=@SIGNER_KEY_FILE@:/run/secrets/serverware-registration-evidence-signing-key
BindReadOnlyPaths=/run/serverware/registration-evidence:/run/serverware/registration-evidence
BindPaths=@SIGNER_REPLAY_DIR@:/var/lib/serverware/registration-evidence-replay
ReadWritePaths=/var/lib/serverware/registration-evidence-replay
Sockets=serverware-registration-evidence.socket
# O_NONBLOCK is a service option and is shared by activated socket duplicates.
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/registration_evidence_signer_launcher.py --root-delivery
Restart=no
TimeoutStartSec=35s
TimeoutStopSec=35s
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
