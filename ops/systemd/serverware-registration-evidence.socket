[Unit]
Description=Serverware independent registration evidence signer ingress
Before=serverware-registration-evidence.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/registration-evidence/signer.sock
FileDescriptorName=serverware-registration-evidence
SocketUser=65517
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=16
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-registration-evidence.service

[Install]
WantedBy=sockets.target
