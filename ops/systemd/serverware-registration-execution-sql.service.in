# Unrendered, uninstalled deployment input. No accounts, credentials, journal,
# database privilege, network permission or current-state authority are created.
# Provision five root-owned TLS files separately: ca.pem/issuer.crt/executor.crt
# mode 0444; issuer.key/executor.key mode 0440 group 65512. Their exact originals
# and fixed runtime paths must match the independently signed bootstrap.
# Review literal-safe substitutions and independently restrict PostgreSQL
# egress to the admitted database; AF_INET/AF_INET6 are needed for actual TLS.
[Unit]
Description=Serverware dedicated registration SQL owner (trusted-host-local)
BindsTo=serverware-registration-execution-sql.socket
After=local-fs.target serverware-registration-execution-sql.socket
RequiresMountsFor=@SQL_RELEASE_ROOT@ @SQL_TRUST_DIR@ @SQL_TLS_DIR@ @SQL_JOURNAL_DIR@
AssertPathIsDirectory=@SQL_RELEASE_ROOT@
AssertPathIsDirectory=@SQL_TRUST_DIR@
AssertPathIsDirectory=@SQL_TLS_DIR@
AssertPathIsDirectory=@SQL_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root delivery drops permanently to 65512:65512, no supplementary groups.
# Exactly four inherited descriptors 198..201; no signing key. At most one
# accepted connection per cold launch, including rejection, then exit.
# No reconnect or automatic restart.
# Type=exec is not readiness or successful cryptographic/database admission.
User=root
Group=root
RootDirectory=@SQL_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@SQL_TRUST_DIR@:/run/serverware/registration-sql-trust
BindReadOnlyPaths=@SQL_TLS_DIR@:/run/serverware/registration-sql-tls
BindReadOnlyPaths=/run/serverware/registration-execution:/run/serverware/registration-execution
BindPaths=@SQL_JOURNAL_DIR@:/var/lib/serverware/registration-sql-attempts
ReadWritePaths=/var/lib/serverware/registration-sql-attempts
Sockets=serverware-registration-execution-sql.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/registration_execution_sql_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# TERM plus cgroup escalation is not a hard kernel syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
