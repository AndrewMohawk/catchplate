# Unrendered, uninstalled deployment input. Release, trust/key originals,
# independently current checkpoints and the private journal are provisioned
# separately. This template creates no account, key, journal or authority.
# State-socket DAC/ACL access for UID 65510 with no supplementary groups is also an
# independent deployment prerequisite; a bind mount does not supply access.
[Unit]
Description=Serverware dedicated registration finalization reserver (trusted-host-local)
BindsTo=serverware-registration-finalization-reserver.socket
After=local-fs.target serverware-registration-finalization-reserver.socket
RequiresMountsFor=@RESERVER_RELEASE_ROOT@ @RESERVER_TRUST_DIR@ @RESERVER_KEY_FILE@ @RESERVER_JOURNAL_DIR@
AssertPathIsDirectory=@RESERVER_RELEASE_ROOT@
AssertPathIsDirectory=@RESERVER_TRUST_DIR@
AssertPathIsDirectory=@RESERVER_JOURNAL_DIR@
StartLimitIntervalSec=infinity
StartLimitBurst=1

[Service]
Type=exec
# Root delivery permanently drops to 65510:65510 without supplementary groups.
# Cold admission must check exactly five inherited descriptors 198..202.
# Type=exec establishes neither readiness nor successful cryptographic admission.
User=root
Group=root
RootDirectory=@RESERVER_RELEASE_ROOT@
MountAPIVFS=yes
WorkingDirectory=/app
BindReadOnlyPaths=@RESERVER_TRUST_DIR@:/run/serverware/registration-finalization-reserver-trust
BindReadOnlyPaths=@RESERVER_KEY_FILE@:/run/secrets/serverware-registration-finalization-computation-key
BindReadOnlyPaths=/run/serverware/registration-finalization:/run/serverware/registration-finalization
BindReadOnlyPaths=/run/serverware/current-root:/run/serverware/current-root
BindPaths=@RESERVER_JOURNAL_DIR@:/var/lib/serverware/registration-finalization-reservations
ReadWritePaths=/var/lib/serverware/registration-finalization-reservations
Sockets=serverware-registration-finalization-reserver.socket
NonBlocking=yes
Environment=LD_LIBRARY_PATH=/runtime/python/lib
ExecStart=/runtime/python/bin/python3 -I /runtime/authority-bootstrap/registration_finalization_reserver_launcher.py --root-delivery
Restart=no
RuntimeMaxSec=300s
TimeoutStartSec=35s
# Cooperative TERM and cgroup escalation are not a hard kernel syscall watchdog.
TimeoutStopSec=35s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
OOMPolicy=stop
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=32
MemoryMax=512M
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
KeyringMode=private
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
