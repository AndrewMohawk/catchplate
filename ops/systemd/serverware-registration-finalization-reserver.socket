# Uninstalled deployment input. Independently admitted account/group access,
# release and signed launch material are required. Listener recreation changes
# both the socket-FD and pathname identities admitted by the bootstrap.
[Unit]
Description=Serverware dedicated registration finalization reserver ingress
Before=serverware-registration-finalization-reserver.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/serverware/registration-finalization/reserver.sock
FileDescriptorName=serverware-registration-finalization-reserver
SocketUser=65510
SocketGroup=65532
SocketMode=0660
DirectoryMode=0755
Backlog=16
Accept=no
FlushPending=yes
RemoveOnStop=yes
Service=serverware-registration-finalization-reserver.service

[Install]
WantedBy=sockets.target
