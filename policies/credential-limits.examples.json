{
  "apiVersion": "serverware.policy/v1",
  "kind": "PolicyBundle",
  "metadata": {
    "id": "serverware-credential-limit-examples",
    "sequence": 1,
    "rollbackEpoch": 1
  },
  "defaults": {
    "action": "deny",
    "failMode": "closed",
    "unknownHosts": "block",
    "unknownPaths": "block",
    "validationFailure": "block"
  },
  "principals": [
    {
      "id": "agent:example",
      "sourceCidrs": ["10.0.0.0/8", "127.0.0.1/32"],
      "requiredHeaders": {
        "X-Serverware-Agent": "example-agent"
      }
    }
  ],
  "credentials": [
    {
      "id": "cred-x",
      "provider": "x",
      "providerSubject": "replace-with-verified-x-user-id",
      "scopes": [
        "block.read",
        "bookmark.read",
        "dm.read",
        "follows.read",
        "like.read",
        "list.read",
        "mute.read",
        "offline.access",
        "space.read",
        "timeline.read",
        "tweet.read",
        "tweet.write",
        "users.read"
      ],
      "injection": {"type": "bearer", "header": "Authorization", "field": "access_token"}
    },
    {
      "id": "cred-gmail",
      "provider": "google",
      "providerSubject": "replace-with-verified-google-sub",
      "scopes": ["gmail.readonly"],
      "injection": {"type": "bearer", "header": "Authorization", "field": "access_token"}
    },
    {
      "id": "cred-npm",
      "provider": "npm",
      "scopes": ["automation"],
      "injection": {"type": "bearer", "header": "Authorization"}
    },
    {
      "id": "cred-slack",
      "provider": "slack",
      "scopes": ["chat:write"],
      "injection": {"type": "bearer", "header": "Authorization"}
    },
    {
      "id": "cred-github",
      "provider": "github",
      "scopes": ["issues:read"],
      "injection": {"type": "bearer", "header": "Authorization"}
    },
    {
      "id": "cred-stripe",
      "provider": "stripe",
      "scopes": ["customers:read", "payment_intents:write"],
      "injection": {"type": "bearer", "header": "Authorization"}
    },
    {
      "id": "cred-object-store",
      "provider": "object-store",
      "scopes": ["objects:write"],
      "injection": {"type": "header", "name": "X-Api-Key"}
    }
  ],
  "routes": [
    {
      "id": "example.x.tweet.one_per_day",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.x.com",
        "port": 443,
        "methods": ["POST"],
        "paths": ["/2/tweets"]
      },
      "credentialRef": "cred-x",
      "adapter": {
        "type": "x.v2",
        "config": {
          "mode": "controlledWrite",
          "blockWrites": false,
          "appIds": ["approved-x-app-id"],
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["data.id", "data.text"]
          }
        }
      },
      "constraints": [
        {
          "id": "operation-only-tweet-create",
          "type": "operationPolicy",
          "allowedOperations": ["tweets.write"]
        },
        {
          "id": "one-tweet-per-provider-account-per-day",
          "type": "rateLimit",
          "max": 1,
          "windowSeconds": 86400,
          "store": "shared",
          "key": {
            "scope": ["route", "operation"],
            "operationFields": ["providerAccount"]
          }
        },
        {
          "id": "plain-text-tweet-body",
          "type": "jsonBody",
          "contentTypes": ["application/json"],
          "allowedFields": ["text", "reply_settings"],
          "requiredFields": ["text"],
          "deniedFields": ["media", "poll", "direct_message_deep_link"],
          "fields": {
            "text": {"type": "string", "minLength": 1, "maxLength": 280},
            "reply_settings": {"type": "string", "enum": ["following", "mentionedUsers"]}
          }
        }
      ]
    },
    {
      "id": "example.x.full_bounded_read",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.x.com",
        "port": 443,
        "methods": ["GET"],
        "paths": ["/2/**"]
      },
      "credentialRef": "cred-x",
      "adapter": {
        "type": "x.v2",
        "config": {
          "mode": "readOnly",
          "blockWrites": true,
          "appIds": ["approved-x-app-id"],
          "allowedReadOperations": [
            "accountActivity.read",
            "activity.read",
            "analytics.read",
            "bookmarks.read",
            "chat.read",
            "communities.read",
            "compliance.read",
            "connections.read",
            "directMessages.read",
            "insights.read",
            "lists.read",
            "media.read",
            "news.read",
            "notes.read",
            "schema.read",
            "search.read",
            "spaces.read",
            "trends.read",
            "tweets.read",
            "usage.read",
            "users.read",
            "webhooks.read"
          ],
          "response": {
            "mode": "json",
            "maxBodyBytes": 16777216,
            "allowedFields": [
              "data",
              "includes",
              "meta",
              "errors",
              "title",
              "detail",
              "type",
              "status"
            ]
          }
        }
      },
      "constraints": [
        {
          "id": "all-currently-cataloged-bounded-x-reads",
          "type": "operationPolicy",
          "allowedOperations": [
            "accountActivity.read",
            "activity.read",
            "analytics.read",
            "bookmarks.read",
            "chat.read",
            "communities.read",
            "compliance.read",
            "connections.read",
            "directMessages.read",
            "insights.read",
            "lists.read",
            "media.read",
            "news.read",
            "notes.read",
            "schema.read",
            "search.read",
            "spaces.read",
            "trends.read",
            "tweets.read",
            "usage.read",
            "users.read",
            "webhooks.read"
          ]
        }
      ]
    },
    {
      "id": "example.x.search.seven_days",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.x.com",
        "port": 443,
        "methods": ["GET"],
        "paths": ["/2/tweets/search/recent"]
      },
      "credentialRef": "cred-x",
      "adapter": {
        "type": "x.v2",
        "config": {
          "mode": "recentSearchOnly",
          "blockWrites": true,
          "appIds": ["approved-x-app-id"],
          "allowedReadOperations": ["search.read"],
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["data.id", "data.text", "data.created_at", "meta.result_count"]
          }
        }
      },
      "constraints": [
        {
          "id": "search-lookback-seven-days",
          "type": "queryDateWindow",
          "parameters": ["start_time", "end_time"],
          "maxAgeDays": 7,
          "formats": ["rfc3339", "date"],
          "required": false
        },
        {
          "id": "search-page-cap",
          "type": "queryNumericBounds",
          "parameters": ["max_results"],
          "min": 1,
          "max": 100,
          "integer": true
        },
        {
          "id": "search-response-seven-days",
          "type": "responseDateWindow",
          "phase": "response",
          "items": ["data"],
          "dateFields": ["created_at"],
          "formats": ["rfc3339", "date"],
          "maxAgeDays": 7,
          "required": true
        }
      ]
    },
    {
      "id": "example.gmail.last_30_days",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "gmail.googleapis.com",
        "port": 443,
        "methods": ["GET"],
        "paths": ["/gmail/v1/users/{user}/messages", "/gmail/v1/users/{user}/messages/{message_id}"]
      },
      "credentialRef": "cred-gmail",
      "adapter": {
        "type": "gmail.v1",
        "config": {
          "maxAgeDays": 30,
          "maxResults": 10,
          "forceQuery": true,
          "allowMessageGetOnlyFromPriorSearch": true,
          "cacheTtlSeconds": 1800,
          "denyEquivalentEndpoints": ["threads", "history", "attachments", "imap"],
          "response": {
            "validateInternalDate": true,
            "validateListByMetadataFetch": true,
            "maxBodyBytes": 1048576,
            "allowedFields": ["id", "threadId", "labelIds", "snippet", "internalDate", "payload.headers"],
            "allowedHeaders": [],
            "allowedMessageHeaderNames": ["From", "Subject", "Date"],
            "error": {
              "mode": "json",
              "maxBodyBytes": 65536,
              "allowedFields": ["error.code", "error.status", "error.message", "error.errors.reason", "error.errors.domain"],
              "allowedHeaders": ["retry-after", "www-authenticate"],
              "onInvalid": "block"
            },
            "onViolation": "block"
          }
        }
      },
      "constraints": [
        {
          "id": "gmail-max-page-size",
          "type": "queryNumericBounds",
          "parameters": ["maxResults"],
          "min": 1,
          "max": 10,
          "integer": true
        },
        {
          "id": "gmail-list-response-30-days",
          "type": "responseDateWindow",
          "phase": "response",
          "operations": ["gmail.messages.list"],
          "items": ["messages"],
          "dateFields": ["internalDate"],
          "formats": ["epochMillis"],
          "maxAgeDays": 30,
          "required": true
        }
      ]
    },
    {
      "id": "example.npm.publish.yubikey_jit",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "registry.npmjs.org",
        "port": 443,
        "methods": ["PUT", "POST", "DELETE"],
        "paths": [
          "/{package}",
          "/{package}/-rev/{revision}",
          "/{package}/-/{tarball}/-rev/{revision}",
          "/-/package/{package}/dist-tags/{tag}",
          "/-/package/{package}/access",
          "/-/npm/v1/tokens",
          "/-/npm/v1/tokens/token/{token}",
          "/-/npm/v1/user",
          "/-/team/{scope}/{team}/package"
        ]
      },
      "credentialRef": "cred-npm",
      "adapter": {
        "type": "npm.registry",
        "config": {
          "operations": ["publish", "unpublish", "distTagWrite", "tokenWrite", "metadataWrite"],
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["package", "published", "tag", "dist_tag_written"],
            "allowedHeaders": [],
            "error": {
              "mode": "json",
              "maxBodyBytes": 65536,
              "allowedFields": ["error", "reason", "code"],
              "allowedHeaders": ["retry-after", "www-authenticate"],
              "onInvalid": "block"
            }
          }
        }
      },
      "constraints": [
        {
          "id": "npm-common-writes-require-jit",
          "type": "operationPolicy",
          "allowedOperations": [
            "npm.publish",
            "npm.unpublish",
            "npm.distTagWrite",
            "npm.tokenWrite",
            "npm.metadataWrite"
          ]
        }
      ],
      "jit": {
        "required": true,
        "mode": "perOperation",
        "ttlSeconds": 30,
        "maxUses": 1,
        "consumeOn": "forwardStart",
        "binding": {
          "type": "operationDigest",
          "fields": [
            "principal",
            "routeId",
            "credentialRef",
            "credentialVersion",
            "policyHash",
            "method",
            "authority",
            "path",
            "query",
            "selectedHeaders",
            "bodySha256",
            "operation",
            "packageName",
            "packageVersion",
            "tarballIntegrity"
          ]
        },
        "approvers": {
          "quorum": 1,
          "users": ["user:release-manager"],
          "authn": {
            "webauthnRequired": true,
            "userVerification": "required",
            "allowedAuthenticatorClasses": ["yubikey", "hardware"],
            "requireHardwareAttestation": true
          }
        }
      }
    },
    {
      "id": "example.slack.chat_post.hourly",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "slack.com",
        "port": 443,
        "methods": ["POST"],
        "paths": ["/api/chat.postMessage"]
      },
      "credentialRef": "cred-slack",
      "adapter": {
        "type": "generic.rest",
        "config": {
          "request": {
            "allowedHeaders": ["accept", "content-type", "user-agent"],
            "allowedQueryKeys": [],
            "bodyMode": "any",
            "maxBodyBytes": 32768
          },
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["ok", "channel", "ts", "message.text"]
          }
        }
      },
      "constraints": [
        {
          "id": "five-slack-posts-per-hour",
          "type": "rateLimit",
          "max": 5,
          "windowSeconds": 3600,
          "store": "shared",
          "key": {"scope": ["principal", "credential", "route"]}
        },
        {
          "id": "slack-weekday-utc-hours",
          "type": "requestTimeWindow",
          "timezone": "UTC",
          "weekdays": ["mon", "tue", "wed", "thu", "fri"],
          "dailyWindows": [
            {"start": "13:00", "end": "23:00"}
          ]
        },
        {
          "id": "slack-message-body",
          "type": "jsonBody",
          "contentTypes": ["application/json"],
          "allowedFields": ["channel", "text", "thread_ts"],
          "requiredFields": ["channel", "text"],
          "fields": {
            "channel": {"type": "string", "minLength": 1, "maxLength": 80},
            "text": {"type": "string", "minLength": 1, "maxLength": 4000}
          }
        }
      ]
    },
    {
      "id": "example.github.issues_since_30_days",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.github.com",
        "port": 443,
        "methods": ["GET"],
        "paths": ["/repos/{owner}/{repo}/issues"]
      },
      "credentialRef": "cred-github",
      "adapter": {
        "type": "generic.rest",
        "config": {
          "request": {
            "allowedHeaders": ["accept", "content-type", "user-agent"],
            "allowedQueryKeys": ["state", "since", "per_page", "page"],
            "bodyMode": "any",
            "maxBodyBytes": 0
          },
          "response": {
            "mode": "json",
            "maxBodyBytes": 1048576,
            "allowedFields": ["id", "number", "title", "state", "updated_at", "user.login"]
          }
        }
      },
      "constraints": [
        {
          "id": "github-issues-since-30-days",
          "type": "queryDateWindow",
          "parameters": ["since"],
          "maxAgeDays": 30,
          "formats": ["rfc3339", "date"],
          "required": true
        },
        {
          "id": "github-issues-page-cap",
          "type": "queryNumericBounds",
          "parameters": ["per_page"],
          "min": 1,
          "max": 50,
          "integer": true
        },
        {
          "id": "github-issues-response-30-days",
          "type": "responseDateWindow",
          "phase": "response",
          "dateFields": ["updated_at"],
          "formats": ["rfc3339", "date"],
          "maxAgeDays": 30,
          "required": true
        }
      ]
    },
    {
      "id": "example.stripe.readonly_customers",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.stripe.com",
        "port": 443,
        "methods": ["GET"],
        "paths": ["/v1/customers", "/v1/customers/{customer_id}"]
      },
      "credentialRef": "cred-stripe",
      "adapter": {
        "type": "generic.rest",
        "config": {
          "request": {
            "allowedHeaders": ["accept", "content-type", "user-agent"],
            "allowedQueryKeys": ["limit", "starting_after", "ending_before"],
            "bodyMode": "any",
            "maxBodyBytes": 0
          },
          "response": {
            "mode": "json",
            "maxBodyBytes": 1048576,
            "allowedFields": ["id", "object", "email", "created", "data.id", "data.email", "data.created"]
          }
        }
      },
      "constraints": [
        {
          "id": "stripe-customer-page-cap",
          "type": "queryNumericBounds",
          "parameters": ["limit"],
          "min": 1,
          "max": 25,
          "integer": true
        }
      ]
    },
    {
      "id": "example.stripe.payment_intent.tokenized_jit",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "api.stripe.com",
        "port": 443,
        "methods": ["POST"],
        "paths": ["/v1/payment_intents"]
      },
      "credentialRef": "cred-stripe",
      "adapter": {
        "type": "generic.rest",
        "config": {
          "request": {
            "allowedHeaders": ["accept", "content-type", "idempotency-key", "user-agent"],
            "requiredHeaders": {
              "idempotency-key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[-A-Za-z0-9._:]{1,255}$"
              }
            },
            "allowedQueryKeys": [],
            "bodyMode": "formUrlencoded",
            "maxBodyBytes": 16384,
            "operation": {
              "name": "stripe.payment_intents.create",
              "formFields": ["amount", "currency", "payment_method", "confirm", "metadata.agent_request_id"]
            }
          },
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["id", "object", "amount", "currency", "status", "payment_method", "created"]
          }
        }
      },
      "constraints": [
        {
          "id": "payment-intent-five-per-day",
          "type": "rateLimit",
          "max": 5,
          "windowSeconds": 86400,
          "store": "shared",
          "key": {"scope": ["principal", "credential", "route"]}
        },
        {
          "id": "payment-intent-tokenized-only",
          "type": "formBody",
          "contentTypes": ["application/x-www-form-urlencoded"],
          "allowedFields": [
            "amount",
            "currency",
            "payment_method",
            "confirm",
            "metadata.agent_request_id"
          ],
          "requiredFields": ["amount", "currency", "payment_method", "confirm"],
          "deniedFields": [
            "payment_method_data.card.number",
            "payment_method_data.card.cvc",
            "source",
            "card"
          ],
          "fields": {
            "amount": {"type": "integer", "min": 50, "max": 50000},
            "currency": {"type": "string", "equals": "usd"},
            "payment_method": {"type": "string", "pattern": "^pm_[A-Za-z0-9]{8,64}$", "maxLength": 67},
            "confirm": {"type": "string", "equals": "true"},
            "metadata.agent_request_id": {"type": "string", "maxLength": 128}
          }
        }
      ],
      "jit": {
        "required": true,
        "mode": "perOperation",
        "ttlSeconds": 60,
        "maxUses": 1,
        "consumeOn": "forwardStart",
        "binding": {
          "type": "requestDigest",
          "fields": [
            "principal",
            "routeId",
            "credentialRef",
            "credentialVersion",
            "policyHash",
            "method",
            "authority",
            "path",
            "query",
            "selectedHeaders",
            "bodySha256"
          ]
        },
        "approvers": {
          "quorum": 1,
          "users": ["user:finance-owner"],
          "authn": {
            "webauthnRequired": true,
            "userVerification": "required",
            "allowedAuthenticatorClasses": ["yubikey", "hardware"],
            "requireHardwareAttestation": true
          }
        }
      }
    },
    {
      "id": "example.object_store.small_puts",
      "principals": ["agent:example"],
      "match": {
        "scheme": "https",
        "host": "objects.example.com",
        "port": 443,
        "methods": ["PUT"],
        "paths": ["/agent-artifacts/{artifact_id}"]
      },
      "credentialRef": "cred-object-store",
      "adapter": {
        "type": "generic.rest",
        "config": {
          "request": {
            "allowedHeaders": ["accept", "content-type", "user-agent"],
            "allowedQueryKeys": [],
            "bodyMode": "any",
            "maxBodyBytes": 10485760
          },
          "response": {
            "mode": "json",
            "maxBodyBytes": 65536,
            "allowedFields": ["ok", "id", "sha256"]
          }
        }
      },
      "constraints": [
        {
          "id": "object-store-ten-puts-per-hour",
          "type": "rateLimit",
          "max": 10,
          "windowSeconds": 3600,
          "store": "shared",
          "key": {"scope": ["principal", "credential", "route"]}
        },
        {
          "id": "object-store-response-contract",
          "type": "responseJson",
          "phase": "response",
          "fields": {
            "ok": {"required": true, "type": "boolean", "equals": true},
                        "id": {
                            "required": true,
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9._-]{1,128}$"
                        },
                        "sha256": {
                            "required": true,
                            "type": "string",
                            "maxLength": 71,
                            "pattern": "^sha256:[0-9a-f]{64,64}$"
                        }
          }
        }
      ]
    }
  ]
}
