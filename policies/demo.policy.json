      "match": {
        "host": "demo-upstream",
        "methods": [
          "PUT",
          "POST"
        ],
        "paths": [
          "/npm/{package}",
          "/npm/-/package/{package}/dist-tags/{tag}"
        ],
        "port": 8443,
        "scheme": "https"
      },
      "principals": [
        "agent:demo"
      ]
    }
  ]
}
