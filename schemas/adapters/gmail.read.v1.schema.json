{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/gmail.read.v1.schema.json",
  "title": "Serverware closed Gmail message-read authority v1",
  "$comment": "Additive unrestricted-age message reads only. Optional queryMode orderedFormV1 binds original query wire and ordered decoded pairs in canonical request v3; absence retains legacy canonical query admission. Legacy gmail.v1, optional age enforcement and response proofs are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialBinding", "request", "agePolicy", "response"],
  "$defs": {
    "singleIdentity": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "errorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "contentTypes", "allowedHeaders", "onInvalid"],
      "properties": {
        "mode": {"const": "gmailReadJsonV1"},
        "maxBodyBytes": {"const": 65536},
        "contentTypes": {"const": ["application/json"]},
        "allowedHeaders": {"const": []},
        "onInvalid": {"const": "block"}
      }
    }
  },
  "properties": {
    "credentialBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialType", "provider", "subjects", "clientIds", "requiredScopes"],
      "properties": {
        "credentialType": {"const": "oauth2"},
        "provider": {"const": "google"},
        "subjects": {"$ref": "#/$defs/singleIdentity"},
        "clientIds": {"$ref": "#/$defs/singleIdentity"},
        "requiredScopes": {"const": ["https://www.googleapis.com/auth/gmail.readonly"]}
      }
    },
    "agePolicy": {"const": {"mode": "unrestricted"}},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["allowedHeaders", "allowedQueryKeys", "allowedMediaTypes", "maxBodyBytes", "valueRules"],
      "properties": {
        "allowedHeaders": {"type": "array"},
        "allowedQueryKeys": {"const": ["alt", "format", "includeSpamTrash", "labelIds", "maxResults", "metadataHeaders", "pageToken", "prettyPrint", "q"]},
        "allowedMediaTypes": {"const": []},
        "maxBodyBytes": {"const": 0},
        "queryMode": {"const": "orderedFormV1"},
        "valueRules": {"const": []},
        "discardHeaders": {"type": "array"}
      },
      "allOf": [{
        "if": {"required": ["queryMode"]},
        "then": {
          "required": ["discardHeaders"],
          "properties": {
            "allowedHeaders": {"const": ["accept", "user-agent", "x-goog-api-client"]},
            "discardHeaders": {"const": ["accept-encoding"]}
          }
        },
        "else": {"properties": {
          "allowedHeaders": {"const": ["accept", "accept-encoding", "user-agent", "x-goog-api-client"]},
          "discardHeaders": {"const": []}
        }}
      }]
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "contentTypes", "allowedHeaders", "error"],
      "properties": {
        "mode": {"const": "gmailReadJsonV1"},
        "maxBodyBytes": {"const": 1048576},
        "contentTypes": {"const": ["application/json"]},
        "allowedHeaders": {"const": []},
        "error": {"$ref": "#/$defs/errorResponse"}
      }
    }
  }
}
