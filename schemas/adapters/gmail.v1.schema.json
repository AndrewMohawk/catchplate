{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/gmail.v1.schema.json",
  "title": "Serverware Gmail v1 adapter config",
  "type": "object",
  "$defs": {
    "allowedFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
      }
    },
    "allowedHeaders": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cache-control",
          "content-language",
          "etag",
          "last-modified",
          "retry-after",
          "www-authenticate"
        ]
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "allowedFields", "allowedHeaders", "onInvalid"],
      "properties": {
        "mode": {"const": "json"},
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "onInvalid": {"const": "block"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedHeaders", "allowedQueryKeys", "allowedMediaTypes", "maxBodyBytes"],
      "properties": {
        "allowedHeaders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "allowedQueryKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "allowedMediaTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+/[a-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "maxBodyBytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "required": [
    "request",
    "maxAgeDays",
    "maxResults",
    "forceQuery",
    "allowMessageGetOnlyFromPriorSearch",
    "cacheTtlSeconds",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "request": {"$ref": "#/$defs/request"},
    "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650},
    "maxResults": {"type": "integer", "minimum": 1, "maximum": 500},
    "forceQuery": {"const": true},
    "allowMessageGetOnlyFromPriorSearch": {"const": true},
    "cacheTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "denyEquivalentEndpoints": {"type": "array", "items": {"type": "string"}},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validateInternalDate",
        "validateListByMetadataFetch",
        "maxBodyBytes",
        "allowedFields",
        "allowedHeaders",
        "error",
        "onViolation"
      ],
      "properties": {
        "validateInternalDate": {"const": true},
        "validateListByMetadataFetch": {"type": "boolean"},
        "metadataFetch": {
          "type": "object",
          "additionalProperties": false,
          "x-serverware-less-than-or-equal": {
            "left": "perRequestTimeoutMs",
            "right": "totalTimeoutMs"
          },
          "required": [
            "maxMessages",
            "perRequestTimeoutMs",
            "totalTimeoutMs",
            "maxBodyBytes"
          ],
          "properties": {
            "maxMessages": {"type": "integer", "minimum": 1, "maximum": 32},
            "perRequestTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 3000},
            "totalTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 10000},
            "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 8192}
          }
        },
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "allowedMessageHeaderNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^:\\r\\n]+$"
          }
        },
        "error": {"$ref": "#/$defs/errorResponse"},
        "onViolation": {"enum": ["block"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowedFields": {"contains": {"const": "payload.headers"}}
            },
            "required": ["allowedFields"]
          },
          "then": {"required": ["allowedMessageHeaderNames"]},
          "else": {"not": {"required": ["allowedMessageHeaderNames"]}}
        },
        {
          "if": {
            "properties": {
              "validateListByMetadataFetch": {"const": true}
            },
            "required": ["validateListByMetadataFetch"]
          },
          "then": {
            "required": ["metadataFetch"],
            "properties": {
              "allowedFields": {"contains": {"const": "id"}}
            }
          }
        }
      ]
    }
  }
}
