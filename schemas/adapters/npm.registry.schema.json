{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/npm.registry.schema.json",
  "title": "Serverware npm registry adapter config",
  "type": "object",
  "$defs": {
    "allowedFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
      }
    },
    "allowedHeaders": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cache-control",
          "content-language",
          "etag",
          "last-modified",
          "retry-after",
          "www-authenticate"
        ]
      }
    },
    "contentTypes": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 127,
        "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
      }
    },
    "valueRules": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "https://serverware.local/schemas/policy-bundle.v1.schema.json#/$defs/requestValueRule"
      }
    },
    "credentialBinding": {
      "type": "object",
      "required": ["credentialType", "provider", "subjects", "secretClass"],
      "additionalProperties": false,
      "properties": {
        "credentialType": {"const": "static"},
        "provider": {"const": "npm"},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "secretClass": {"enum": ["automationToken", "granularAccessToken", "legacyToken"]}
      },
      "$comment": "Admission must exactly match provider, npm account subject, and token class against the referenced non-OAuth credential."
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "allowedFields", "allowedHeaders", "onInvalid"],
      "properties": {
        "mode": {"const": "json"},
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "onInvalid": {"const": "block"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedHeaders", "allowedQueryKeys", "allowedMediaTypes", "maxBodyBytes", "valueRules"],
      "properties": {
        "allowedHeaders": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "https://serverware.local/schemas/policy-bundle.v1.schema.json#/$defs/adapterRequestHeaderName"
          }
        },
        "discardHeaders": {
          "type": "array",
          "default": [],
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9!#$%&'*+.^`|~-]+$"
          }
        },
        "allowedQueryKeys": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "allowedMediaTypes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+/[a-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "valueRules": {"$ref": "#/$defs/valueRules"}
      }
    }
  },
  "required": ["credentialBinding", "request", "operations", "response"],
  "additionalProperties": false,
  "properties": {
    "credentialBinding": {"$ref": "#/$defs/credentialBinding"},
    "request": {"$ref": "#/$defs/request"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["publish", "unpublish", "distTagWrite", "tokenWrite", "metadataWrite", "read"]}
    },
    "publishResponseContract": {
      "const": "npm-public-registry-receipt-v1"
    },
    "response": {
      "type": "object",
      "required": ["mode", "maxBodyBytes", "contentTypes", "allowedHeaders", "error"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "json"}}, "required": ["mode"]},
          "then": {
            "required": ["allowedFields"],
            "properties": {"contentTypes": {"const": ["application/json"]}}
          }
        },
        {
          "if": {"properties": {"mode": {"const": "headersOnly"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "maxBodyBytes": {"const": 0},
              "contentTypes": {"const": []}
            },
            "not": {"required": ["allowedFields"]}
          }
        }
      ],
      "properties": {
        "mode": {"enum": ["headersOnly", "json"]},
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "contentTypes": {"$ref": "#/$defs/contentTypes"},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "error": {"$ref": "#/$defs/errorResponse"}
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "request": {
          "required": ["discardHeaders"],
          "properties": {
            "discardHeaders": {
              "contains": {"const": "npm-session"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {"enum": ["publish", "unpublish", "distTagWrite", "tokenWrite", "metadataWrite"]}
          }
        },
        "required": ["operations"]
      },
      "then": {
        "properties": {
          "response": {
            "properties": {"mode": {"const": "json"}},
            "required": ["mode"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["publishResponseContract"]
      },
      "then": {
        "properties": {
          "operations": {
            "contains": {"const": "publish"}
          },
          "response": {
            "properties": {
              "mode": {"const": "json"},
              "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
              "allowedFields": {"const": ["ok", "published"]},
              "allowedHeaders": {"const": []}
            }
          }
        }
      }
    }
  ]
}
