{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/npm.registry.schema.json",
  "title": "Serverware npm registry adapter config",
  "type": "object",
  "required": ["operations"],
  "additionalProperties": false,
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["publish", "distTagWrite", "tokenWrite", "metadataWrite", "read"]}
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["headersOnly", "json", "any", "stream"]},
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "allowedFields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
