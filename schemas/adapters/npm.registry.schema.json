{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/npm.registry.schema.json",
  "title": "Serverware npm registry adapter config",
  "type": "object",
  "$defs": {
    "allowedFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
      }
    },
    "allowedHeaders": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cache-control",
          "content-language",
          "etag",
          "last-modified",
          "retry-after",
          "www-authenticate"
        ]
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "allowedFields", "allowedHeaders", "onInvalid"],
      "properties": {
        "mode": {"const": "json"},
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "onInvalid": {"const": "block"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedHeaders", "allowedQueryKeys", "allowedMediaTypes", "maxBodyBytes"],
      "properties": {
        "allowedHeaders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "allowedQueryKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "allowedMediaTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+/[a-z0-9!#$%&'*+.^_`|~-]+$"
          }
        },
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    }
  },
  "required": ["request", "operations", "response"],
  "additionalProperties": false,
  "properties": {
    "request": {"$ref": "#/$defs/request"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["publish", "unpublish", "distTagWrite", "tokenWrite", "metadataWrite", "read"]}
    },
    "publishResponseContract": {
      "const": "npm-public-registry-receipt-v1"
    },
    "response": {
      "type": "object",
      "required": ["mode", "maxBodyBytes", "allowedFields", "allowedHeaders", "error"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["headersOnly", "json", "any", "stream"]},
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "allowedFields": {"$ref": "#/$defs/allowedFields"},
        "allowedHeaders": {"$ref": "#/$defs/allowedHeaders"},
        "error": {"$ref": "#/$defs/errorResponse"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {"enum": ["publish", "unpublish", "distTagWrite", "tokenWrite", "metadataWrite"]}
          }
        },
        "required": ["operations"]
      },
      "then": {
        "properties": {
          "response": {
            "properties": {"mode": {"const": "json"}},
            "required": ["mode"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["publishResponseContract"]
      },
      "then": {
        "properties": {
          "operations": {
            "contains": {"const": "publish"}
          },
          "response": {
            "properties": {
              "mode": {"const": "json"},
              "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
              "allowedFields": {"const": ["ok", "published"]},
              "allowedHeaders": {"const": []}
            }
          }
        }
      }
    }
  ]
}
