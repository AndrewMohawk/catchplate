{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/x.v2.schema.json",
  "title": "Serverware X v2 adapter config",
  "type": "object",
  "$defs": {
    "allowedResponseHeaders": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["cache-control", "content-language", "etag", "last-modified", "retry-after", "www-authenticate"]}
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxBodyBytes", "allowedFields", "allowedHeaders", "onInvalid"],
      "properties": {
        "mode": {"const": "json"},
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "allowedFields": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"}},
        "allowedHeaders": {"$ref": "#/$defs/allowedResponseHeaders"},
        "onInvalid": {"const": "block"}
      }
    }
  },
  "required": ["mode", "blockWrites", "appIds", "response"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["readOnly", "recentSearchOnly"]}}, "required": ["mode"]},
      "then": {
        "required": ["allowedReadOperations"],
        "properties": {"blockWrites": {"const": true}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "controlledWrite"}}, "required": ["mode"]},
      "then": {
        "properties": {"blockWrites": {"const": false}},
        "not": {"required": ["allowedReadOperations"]}
      }
    }
  ],
  "properties": {
    "mode": {"enum": ["readOnly", "recentSearchOnly", "controlledWrite"]},
    "blockWrites": {"type": "boolean"},
    "appIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 255}
    },
    "allowedReadOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "accountActivity.read",
          "activity.read",
          "analytics.read",
          "bookmarks.read",
          "chat.read",
          "communities.read",
          "compliance.read",
          "connections.read",
          "directMessages.read",
          "insights.read",
          "lists.read",
          "media.read",
          "news.read",
          "notes.read",
          "schema.read",
          "search.read",
          "spaces.read",
          "streams.read",
          "trends.read",
          "tweets.read",
          "usage.read",
          "users.read",
          "webhooks.read"
        ]
      }
    },
    "response": {
      "type": "object",
      "required": ["mode", "maxBodyBytes"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "json"}}, "required": ["mode"]},
          "then": {"required": ["allowedFields"]}
        }
      ],
      "properties": {
        "mode": {"enum": ["headersOnly", "json", "any", "stream"]},
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "allowedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"}
        },
        "allowedHeaders": {"$ref": "#/$defs/allowedResponseHeaders"},
        "error": {"$ref": "#/$defs/errorResponse"}
      }
    }
  }
}
