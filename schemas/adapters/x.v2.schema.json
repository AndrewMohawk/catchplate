{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/adapters/x.v2.schema.json",
  "title": "Serverware X v2 adapter config",
  "type": "object",
  "required": ["mode", "blockWrites"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["readOnly", "recentSearchOnly"]}}, "required": ["mode"]},
      "then": {
        "required": ["allowedReadOperations"],
        "properties": {"blockWrites": {"const": true}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "controlledWrite"}}, "required": ["mode"]},
      "then": {
        "properties": {"blockWrites": {"const": false}}
      }
    }
  ],
  "properties": {
    "mode": {"enum": ["readOnly", "recentSearchOnly", "controlledWrite"]},
    "blockWrites": {"type": "boolean"},
    "appIds": {"type": "array", "items": {"type": "string"}},
    "allowedReadOperations": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["tweets.read", "users.read", "search.read"]}
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["headersOnly", "json", "any", "stream"]},
        "maxBodyBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "allowedFields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
