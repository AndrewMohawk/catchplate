{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/completion-proof.v5.schema.json",
  "title": "Serverware Release Completion Proof v5",
  "$comment": "This schema validates structural shape only. It does not authenticate evidence, verify signatures, enforce runtime semantics, or establish final completion. Final claims require the authenticated native verifier with caller-supplied expected context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "verification_passed",
    "verification_mode",
    "result_scope",
    "readiness_only",
    "readiness_ok",
    "completion_status",
    "release_completion",
    "final_completion",
    "hardware_proof",
    "assurance_ceiling",
    "generated_at_unix",
    "artifacts",
    "production_readiness",
    "production_readiness_config",
    "current_completion_host",
    "production_env_binding",
    "running_production_containers",
    "production_host_preflight",
    "bootstrap_launcher",
    "nitro_kms_evidence",
    "nitro_evidence_binding",
    "hardware_assurance_evidence",
    "final_challenge_consumption",
    "production_images_build",
    "production_images_published",
    "release_provenance",
    "image_signatures",
    "benchmark",
    "release_security_evidence",
    "production_proxy_response_proof",
    "proof_path",
    "integrity_metadata"
  ],
  "properties": {
    "apiVersion": {"const": "serverware.completionProof/v5"},
    "kind": {"enum": ["ServerwareCompletionProof", "ServerwarePreEnclaveReadiness"]},
    "verification_passed": {"const": true},
    "verification_mode": {"enum": ["readiness", "final"]},
    "result_scope": {"enum": ["readiness-only", "final-completion"]},
    "readiness_only": {"type": "boolean"},
    "readiness_ok": {"const": true},
    "completion_status": {"enum": ["pre-enclave-readiness", "hardware-backed-release-completion"]},
    "release_completion": {"enum": ["not-final", "pass"]},
    "final_completion": {"type": "boolean"},
    "hardware_proof": {"type": "boolean"},
    "assurance_ceiling": {"type": "object"},
    "generated_at_unix": {"type": "integer", "minimum": 1},
    "artifacts": {"type": "object"},
    "production_readiness": {"type": "object"},
    "production_readiness_config": {"type": "object"},
    "current_completion_host": {"type": "object"},
    "production_env_binding": {"type": "object"},
    "running_production_containers": {"type": "object"},
    "production_host_preflight": {"type": "object"},
    "bootstrap_launcher": {
      "oneOf": [
        {"$ref": "#/$defs/readinessLauncher"},
        {"$ref": "#/$defs/bootstrapLauncher"}
      ]
    },
    "nitro_kms_evidence": {"type": "object"},
    "nitro_evidence_binding": {"type": "object"},
    "hardware_assurance_evidence": {"type": "object"},
    "final_challenge_consumption": {"type": "object"},
    "production_images_build": {"type": "object"},
    "production_images_published": {"type": "object"},
    "release_provenance": {"type": "object"},
    "image_signatures": {"type": "object"},
    "benchmark": {"type": "object"},
    "release_security_evidence": {"type": "object"},
    "production_proxy_response_proof": {"type": "object"},
    "proof_path": {"$ref": "#/$defs/normalizedPath"},
    "proof_sha256": {"$ref": "#/$defs/sha256"},
    "proof_sha256_path": {"$ref": "#/$defs/normalizedPath"},
    "integrity_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "detached_sha256_path",
        "scope",
        "independently_authenticated",
        "authenticity_requires_external_signature_or_checkpoint"
      ],
      "properties": {
        "generation": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "detached_sha256_path": {"$ref": "#/$defs/normalizedPath"},
        "scope": {"const": "checksum-only"},
        "independently_authenticated": {"const": false},
        "authenticity_requires_external_signature_or_checkpoint": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verification_mode": {"const": "readiness"}}},
      "then": {
        "properties": {
          "kind": {"const": "ServerwarePreEnclaveReadiness"},
          "result_scope": {"const": "readiness-only"},
          "readiness_only": {"const": true},
          "completion_status": {"const": "pre-enclave-readiness"},
          "release_completion": {"const": "not-final"},
          "final_completion": {"const": false},
          "hardware_proof": {"const": false},
          "bootstrap_launcher": {"$ref": "#/$defs/readinessLauncher"},
          "final_challenge_consumption": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "consumed"],
            "properties": {
              "required": {"const": false},
              "consumed": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verification_mode": {"const": "final"}}},
      "then": {
        "properties": {
          "kind": {"const": "ServerwareCompletionProof"},
          "result_scope": {"const": "final-completion"},
          "readiness_only": {"const": false},
          "completion_status": {"const": "hardware-backed-release-completion"},
          "release_completion": {"const": "pass"},
          "final_completion": {"const": true},
          "hardware_proof": {"const": true},
          "bootstrap_launcher": {"$ref": "#/$defs/bootstrapLauncher"},
          "assurance_ceiling": {
            "type": "object",
            "required": ["final_completion", "hardware_proof", "hardware_evidence_verified"],
            "properties": {
              "final_completion": {"const": true},
              "hardware_proof": {"const": true},
              "hardware_evidence_verified": {"const": true}
            }
          },
          "hardware_assurance_evidence": {
            "type": "object",
            "required": ["verified"],
            "properties": {"verified": {"const": true}}
          },
          "final_challenge_consumption": {
            "type": "object",
            "required": ["consumed", "completion_identity"],
            "properties": {
              "consumed": {"const": true},
              "completion_identity": {"$ref": "#/$defs/finalCompletionIdentity"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000]+$",
      "not": {"pattern": "(^|/)\\.{1,2}(/|$)|//"}
    },
    "normalizedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$",
      "not": {"pattern": "(^|/)\\.{1,2}(/|$)|//"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "mode",
        "ownerUid",
        "ownerGid",
        "linkCount",
        "size",
        "modifiedUnixNanos",
        "changedUnixNanos"
      ],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "ownerUid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "ownerGid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "linkCount": {"const": 1},
        "size": {"type": "integer", "minimum": 0},
        "modifiedUnixNanos": {"type": "integer"},
        "changedUnixNanos": {"type": "integer"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "metadata"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "authorizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "launcherNonce",
        "bootIdSha256",
        "launcherSha256",
        "manifestSha256",
        "releaseProvenanceSha256",
        "provenanceDigest",
        "reproducibleBuildVerificationSha256",
        "sourceTreeDigest",
        "deploymentAudience",
        "deploymentIdentitySha256",
        "releaseSequence",
        "rollbackEpoch"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.launchAuthorizationRequest/v1"},
        "kind": {"const": "ProductionLaunchAuthorizationRequest"},
        "launcherNonce": {"$ref": "#/$defs/hex64"},
        "bootIdSha256": {"$ref": "#/$defs/sha256"},
        "launcherSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "releaseProvenanceSha256": {"$ref": "#/$defs/sha256"},
        "provenanceDigest": {"$ref": "#/$defs/sha256"},
        "reproducibleBuildVerificationSha256": {"$ref": "#/$defs/sha256"},
        "sourceTreeDigest": {"$ref": "#/$defs/sha256"},
        "deploymentAudience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "deploymentIdentitySha256": {"$ref": "#/$defs/sha256"},
        "releaseSequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "rollbackEpoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "authorizationStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId",
        "authorityKeyId",
        "requestSha256",
        "issuedAtUnixSeconds",
        "expiresAtUnixSeconds",
        "useLimit"
      ],
      "properties": {
        "authorizationId": {"$ref": "#/$defs/hex64"},
        "authorityKeyId": {"$ref": "#/$defs/sha256"},
        "requestSha256": {"$ref": "#/$defs/sha256"},
        "issuedAtUnixSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expiresAtUnixSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "useLimit": {"const": 1}
      }
    },
    "authorizationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "statement", "signature"],
      "properties": {
        "apiVersion": {"const": "serverware.launchAuthorization/v1"},
        "kind": {"const": "ProductionLaunchAuthorization"},
        "statement": {"$ref": "#/$defs/authorizationStatement"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"}
      }
    },
    "launchAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "requestSha256",
        "envelope",
        "authorizationSha256",
        "verifiedAtUnixSeconds"
      ],
      "properties": {
        "request": {"$ref": "#/$defs/authorizationRequest"},
        "requestSha256": {"$ref": "#/$defs/sha256"},
        "envelope": {"$ref": "#/$defs/authorizationEnvelope"},
        "authorizationSha256": {"$ref": "#/$defs/sha256"},
        "verifiedAtUnixSeconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "launchAuthorizationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "authorization_sha256",
        "request_sha256",
        "authority_key_id",
        "authority_root_sha256",
        "launch_id",
        "boot_id_sha256",
        "manifest_sha256",
        "deployment_audience",
        "deployment_identity_sha256",
        "release_sequence",
        "rollback_epoch",
        "release_provenance_sha256",
        "provenance_digest",
        "source_tree_digest",
        "launcher_sha256",
        "reproducible_build_verification_sha256",
        "issued_at_unix_seconds",
        "expires_at_unix_seconds",
        "verified_at_unix_seconds"
      ],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/hex64"},
        "authorization_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "authority_key_id": {"$ref": "#/$defs/sha256"},
        "authority_root_sha256": {"$ref": "#/$defs/sha256"},
        "launch_id": {"$ref": "#/$defs/hex64"},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "deployment_audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "deployment_identity_sha256": {"$ref": "#/$defs/sha256"},
        "release_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "rollback_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "release_provenance_sha256": {"$ref": "#/$defs/sha256"},
        "provenance_digest": {"$ref": "#/$defs/sha256"},
        "source_tree_digest": {"$ref": "#/$defs/sha256"},
        "launcher_sha256": {"$ref": "#/$defs/sha256"},
        "reproducible_build_verification_sha256": {"$ref": "#/$defs/sha256"},
        "issued_at_unix_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "expires_at_unix_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "verified_at_unix_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "finalCompletionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "release_identity_sha256",
        "current_host_identity_sha256",
        "launch_authorization",
        "hardware_verifier_key_id",
        "hardware_assurance_document_sha256",
        "hardware_assurance_signed_statement_sha256",
        "challenge_nonce_sha256",
        "proxy_server_statement_sha256",
        "security_role_map_sha256"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.finalCompletionIdentity/v1"},
        "release_identity_sha256": {"$ref": "#/$defs/sha256"},
        "current_host_identity_sha256": {"$ref": "#/$defs/sha256"},
        "launch_authorization": {"$ref": "#/$defs/launchAuthorizationIdentity"},
        "hardware_verifier_key_id": {"$ref": "#/$defs/sha256"},
        "hardware_assurance_document_sha256": {"$ref": "#/$defs/sha256"},
        "hardware_assurance_signed_statement_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "proxy_server_statement_sha256": {"$ref": "#/$defs/sha256"},
        "security_role_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "argv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflightSha256", "readinessSha256"],
      "properties": {
        "preflightSha256": {"$ref": "#/$defs/sha256"},
        "readinessSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "sha256"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {"const": "LANG"},
            {"const": "LC_ALL"},
            {"const": "PATH"},
            {"const": "SERVERWARE_BOOTSTRAP_RECEIPT_API_VERSION"},
            {"const": "SERVERWARE_BOOTSTRAP_RECEIPT_FD"},
            {"const": "SERVERWARE_BOOTSTRAP_RECEIPT_SHA256"},
            {"const": "TZ"}
          ],
          "items": false
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "readinessLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "verified"],
      "properties": {
        "required": {"const": false},
        "verified": {"const": false}
      }
    },
    "bootstrapLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "launchId",
        "sha256",
        "bootIdSha256",
        "sourceTreeDigest",
        "launchAuthorization",
        "launchAuthorityKeyId",
        "launchAuthorityRootSha256",
        "launcher",
        "manifest",
        "argv",
        "environment",
        "sealed",
        "sealMask"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.bootstrapReceipt/v2"},
        "kind": {"const": "ProductionBootstrapReceipt"},
        "launchId": {"$ref": "#/$defs/hex64"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bootIdSha256": {"$ref": "#/$defs/sha256"},
        "sourceTreeDigest": {"$ref": "#/$defs/sha256"},
        "launchAuthorization": {"$ref": "#/$defs/launchAuthorization"},
        "launchAuthorityKeyId": {"$ref": "#/$defs/sha256"},
        "launchAuthorityRootSha256": {"$ref": "#/$defs/sha256"},
        "launcher": {"$ref": "#/$defs/file"},
        "manifest": {"$ref": "#/$defs/file"},
        "argv": {"$ref": "#/$defs/argv"},
        "environment": {"$ref": "#/$defs/environment"},
        "sealed": {"const": true},
        "sealMask": {"type": "integer", "minimum": 15}
      }
    }
  }
}
