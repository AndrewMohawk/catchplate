{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/control-plane-custody-startup.v2.schema.json",
  "title": "Root-authorized ciphertext-only control-plane custody startup",
  "description": "Original canonical ASCII JSON <=16 KiB, delivered in root-owned fully sealed memfd. Signature covers every other field under serverware/control-plane-broker-startup/v1 NUL. Actual startup verifies against its independently admitted runtime root and exact configuration/source, UID/GID, descriptor inventory, directory identity and live original attestation. Browser/request inputs cannot select this profile. This does not provision measured broker resources.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "sourceRevision", "configurationDigest", "directoryFd", "device", "inode", "uid", "gid", "quotaBytes", "maximumRecords", "credentialBrokerProfile", "signature"],
  "properties": {
    "schema": {"const": "serverware.controlPlaneCustodyStartup/v2"},
    "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "configurationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "directoryFd": {"type": "integer", "minimum": 32, "maximum": 1023},
    "device": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "inode": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "uid": {"type": "integer", "minimum": 0, "maximum": 4294967294},
    "gid": {"type": "integer", "minimum": 0, "maximum": 4294967294},
    "quotaBytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
    "maximumRecords": {"type": "integer", "minimum": 1, "maximum": 4096},
    "credentialBrokerProfile": {"const": "enclave-ciphertext-rows-v1"},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"}
  }
}
