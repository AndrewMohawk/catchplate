{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.dev/schemas/credential-currentness-authority.v2.schema.json",
  "title": "Native measured credential-currentness authority policy v2",
  "description": "Closed purpose policy. The request must bind the complete independently admitted enclosing configuration digest; that digest is not embedded in this policy. Original native proof and holder admission remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deploymentId", "operationMaxSeconds", "maximumHolders", "trustRoots", "holders"],
  "properties": {
    "schema": {"const": "serverware.credentialCurrentnessAuthorityPolicy/v2"},
    "deploymentId": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/deployment"},
    "operationMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "maximumHolders": {"const": 64},
    "trustRoots": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/trustRoots"},
    "holders": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/assignment"}}
  }
}
