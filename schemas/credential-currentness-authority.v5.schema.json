{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.dev/schemas/credential-currentness-authority.v5.schema.json",
  "title": "Postboot currentness with authenticated static generation provenance",
  "description": "Explicit creation and N+1 rotation provenance, each joined to its actual completed protected outbox, current envelope and root. Fresh independent holder assignment and native evidence remain required. This is not rotation permission or configuration migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deploymentId",
    "operationMaxSeconds",
    "maximumHolders",
    "trustRoots",
    "targets",
    "assignmentAuthorizer",
    "staticCreationProvenance",
    "staticGenerationProvenance"
  ],
  "properties": {
    "schema": {
      "const": "catchplate.credentialCurrentnessAuthorityPolicy/v5"
    },
    "deploymentId": {
      "$ref": "credential-currentness-authority.v1.schema.json#/$defs/deployment"
    },
    "operationMaxSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "maximumHolders": {
      "const": 64
    },
    "trustRoots": {
      "$ref": "credential-currentness-authority.v1.schema.json#/$defs/trustRoots"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "assignmentAuthorizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicKeyPem",
        "publicKeyPemSha256",
        "publicKeySpkiSha256"
      ],
      "properties": {
        "publicKeyPem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "publicKeyPemSha256": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        },
        "publicKeySpkiSha256": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        }
      }
    },
    "staticCreationProvenance": {
      "const": "catchplate.staticCredentialCreationProvenance/v1"
    },
    "staticGenerationProvenance": {
      "const": "catchplate.staticCredentialRotationProvenance/v1"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "controlPlaneResponseSigningKeyId",
        "releaseRecordSha256",
        "policyHash",
        "expectedBinaryDigest",
        "expectedPcrs",
        "expectedEif",
        "maxAgeSeconds",
        "futureSkewSeconds"
      ],
      "properties": {
        "targetId": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/deployment"
        },
        "controlPlaneResponseSigningKeyId": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        },
        "releaseRecordSha256": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        },
        "policyHash": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        },
        "expectedBinaryDigest": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"
        },
        "expectedPcrs": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/expectedPcrs"
        },
        "expectedEif": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/sha384"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "futureSkewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    }
  }
}
