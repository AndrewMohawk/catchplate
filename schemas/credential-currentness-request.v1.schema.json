{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/credential-currentness-request.v1.schema.json",
  "title": "Public measured credential-holder registration and observation request",
  "description": "Exact POST /api/data-plane/credential-currentness with the existing data-plane credential-lease transport token and one valid response nonce; no query. Runtime cap 64 KiB. Only challenge/register/ack/poll are public. Quiesce/admit remain actual retained internal owners, not HTTP caller permissions. The existing independent policy and actual measured evidence authorize mutations.",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "credentialId", "credentialVersion", "request"],
  "properties": {
    "apiVersion": {"const": "serverware.credentialCurrentnessRequest/v1"},
    "credentialId": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/uuid"},
    "credentialVersion": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/integer"},
    "request": {"oneOf": [{"$ref": "#/$defs/challenge"}, {"$ref": "#/$defs/evidence"}, {"$ref": "#/$defs/poll"}]}
  },
  "$defs": {
    "challenge": {
      "type": "object", "additionalProperties": false, "required": ["phase", "arguments"],
      "properties": {"phase": {"const": "challenge"}, "arguments": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/challenge"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["phase", "arguments"],
      "properties": {"phase": {"enum": ["register", "ack"]}, "arguments": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/evidenceRequest"}}
    },
    "poll": {
      "type": "object", "additionalProperties": false, "required": ["phase", "arguments"],
      "properties": {"phase": {"const": "poll"}, "arguments": {"type": "object", "additionalProperties": false, "required": ["holderId"], "properties": {"holderId": {"$ref": "credential-currentness-authority.v1.schema.json#/$defs/digest"}}}}
    }
  }
}
