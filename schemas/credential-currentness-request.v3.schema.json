{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.dev/schemas/credential-currentness-request.v3.schema.json",
  "title": "Static successor currentness with original rotation provenance",
  "description": "Exact authenticated currentness POST for version >=2, bounded to 128KiB including escaping and full typed authority wrappers. Requires separately selected policy v5, genuine completed rotation outbox/current envelope/root and fresh native holder evidence; no rotation or public drain authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "credentialId",
    "credentialVersion",
    "request",
    "staticGenerationProvenanceOriginal"
  ],
  "properties": {
    "apiVersion": {
      "const": "serverware.credentialCurrentnessRequest/v3"
    },
    "credentialId": {
      "$ref": "credential-currentness-authority.v1.schema.json#/$defs/uuid"
    },
    "credentialVersion": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9223372036854775807
    },
    "request": {
      "$ref": "credential-currentness-request.v1.schema.json#/properties/request"
    },
    "staticGenerationProvenanceOriginal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40960,
      "contentMediaType": "application/json",
      "contentSchema": {
        "$ref": "static-credential-rotation-provenance.v1.schema.json"
      }
    }
  }
}
