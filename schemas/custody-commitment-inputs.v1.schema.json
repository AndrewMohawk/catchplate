{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/custody-commitment-inputs.v1.schema.json",
  "$ref":"#/$defs/configuration",
  "$defs":{
    "sha":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/sha256"},
    "pin":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"},
    "ns":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/ns"},
    "u64":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "service":{
      "type":"object","additionalProperties":false,
      "required":["executableSha256","deliveryConfiguration"],
      "properties":{"executableSha256":{"$ref":"#/$defs/sha"},"deliveryConfiguration":{"$ref":"#/$defs/pin"}}
    },
    "services":{
      "type":"object","additionalProperties":false,
      "required":["durable-recovery-store","cleanup-authorization-consumer","recovery-target-provider","current-signature-authority","bounded-cleanup-helper"],
      "properties":{
        "durable-recovery-store":{"$ref":"#/$defs/service"},
        "cleanup-authorization-consumer":{"$ref":"#/$defs/service"},
        "recovery-target-provider":{"$ref":"#/$defs/service"},
        "current-signature-authority":{"$ref":"#/$defs/service"},
        "bounded-cleanup-helper":{"$ref":"#/$defs/service"}
      }
    },
    "configuration":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","bootIdBase64url","timeNamespaceDevice","timeNamespaceInode","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","invocationId","services"],
      "properties":{
        "apiVersion":{"enum":["catchplate.custodyFiveServiceLaunch/v3","catchplate.custodyFiveServiceLaunch/v4"]},
        "bootIdBase64url":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/bytes32"},
        "timeNamespaceDevice":{"$ref":"#/$defs/u64"},
        "timeNamespaceInode":{"$ref":"#/$defs/u64"},
        "startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "invocationId":{"type":"string","pattern":"^[0-9a-f]{32}$","not":{"const":"00000000000000000000000000000000"}},
        "services":{"$ref":"#/$defs/services"}
      },
      "description":"Fixed root-protected /etc/catchplate/custody-commitment-five.json. Only start_commitment reads it; v4 selects retained privileged inspection. Direct v3 is not a distinct-UID nondumpable-peer fallback. Actual boot/time namespace and original startup/lifetime are checked by the owner."
    },
    "business":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","launchConfigurationSha256","invocationId","clientConfiguration"],
      "properties":{
        "apiVersion":{"const":"catchplate.custodyFiveServiceBusinessInputs/v2"},
        "launchConfigurationSha256":{"$ref":"#/$defs/sha"},
        "invocationId":{"type":"string","pattern":"^[0-9a-f]{32}$","not":{"const":"00000000000000000000000000000000"}},
        "clientConfiguration":{"$ref":"#/$defs/pin"}
      },
      "description":"Fixed root-protected /etc/catchplate/custody-commitment-business.json. Both actual existing source-fixed resource roots are exclusively retained. No caller path or generic resource list."
    },
    "dispatchGrant":{"$ref":"native-shadow-commit-request.v1.schema.json#/$defs/serviceGrant"},
    "nativeGrant":{"$ref":"native-shadow-commit-request.v1.schema.json#/$defs/configuration"},
    "bridgeSelection":{"$ref":"native-shadow-commit-request.v1.schema.json#/$defs/bridgeSelection"},
    "ordinaryLaunch":{"$ref":"native-shadow-commit-request.v1.schema.json#/$defs/ordinaryLaunch"},
    "inspectedOrdinaryLaunch":{"$ref":"native-shadow-commit-request.v1.schema.json#/$defs/inspectedOrdinaryLaunch"}
  }
}
