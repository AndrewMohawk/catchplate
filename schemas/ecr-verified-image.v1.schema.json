{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.dev/schemas/ecr-verified-image.v1.schema.json",
  "title": "ECR image content commitment, not publication authority",
  "description": "Produced after reading the original manifest and every referenced blob. A valid serialized document alone does not prove byte observation, durable staging, approval, credential authority or an AWS effect. Implementations also enforce media-family consistency, exact unique sorted blob roster, descriptor equality and aggregate accounting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest", "config", "layers", "blobs", "total_blob_bytes"],
  "properties": {
    "schema": {"const": "catchplate.ecrVerifiedImage/v1"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size"],
      "properties": {
        "media_type": {"enum": ["application/vnd.oci.image.manifest.v1+json", "application/vnd.docker.distribution.manifest.v2+json"]},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size"],
      "properties": {
        "media_type": {"enum": ["application/vnd.oci.image.config.v1+json", "application/vnd.docker.container.image.v1+json"]},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_type", "digest", "size"],
        "properties": {
          "media_type": {"enum": ["application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip", "application/vnd.oci.image.layer.v1.tar+zstd", "application/vnd.docker.image.rootfs.diff.tar.gzip"]},
          "digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 1, "maximum": 536870912}
        }
      }
    },
    "blobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "size"],
        "properties": {
          "digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 1, "maximum": 536870912}
        }
      }
    },
    "total_blob_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71}
  }
}
