{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/launch-authorization-request.v1.schema.json",
  "title": "Catchplate Production Launch Authorization Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "launcherNonce",
    "bootIdSha256",
    "launcherSha256",
    "manifestSha256",
    "releaseProvenanceSha256",
    "provenanceDigest",
    "reproducibleBuildVerificationSha256",
    "sourceTreeDigest",
    "deploymentAudience",
    "deploymentIdentitySha256",
    "releaseSequence",
    "rollbackEpoch"
  ],
  "properties": {
    "apiVersion": {"const": "catchplate.launchAuthorizationRequest/v1"},
    "kind": {"const": "ProductionLaunchAuthorizationRequest"},
    "launcherNonce": {"$ref": "#/$defs/hex64"},
    "bootIdSha256": {"$ref": "#/$defs/sha256"},
    "launcherSha256": {"$ref": "#/$defs/sha256"},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "releaseProvenanceSha256": {"$ref": "#/$defs/sha256"},
    "provenanceDigest": {"$ref": "#/$defs/sha256"},
    "reproducibleBuildVerificationSha256": {"$ref": "#/$defs/sha256"},
    "sourceTreeDigest": {"$ref": "#/$defs/sha256"},
    "deploymentAudience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "deploymentIdentitySha256": {"$ref": "#/$defs/sha256"},
    "releaseSequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "rollbackEpoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
