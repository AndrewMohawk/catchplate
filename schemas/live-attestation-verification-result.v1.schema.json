    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,255}$"
    },
    "publicNitroProvider": {
      "type": "string",
