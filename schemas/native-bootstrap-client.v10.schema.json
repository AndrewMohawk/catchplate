{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.dev/schemas/native-bootstrap-client.v10.schema.json",
  "title": "Fixed native bootstrap host installer with authenticated Setup readback",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "endpoint", "timeoutMilliseconds", "startupEvidence", "startupExpectations", "sessionScope", "trustRoots", "clientCertificate", "clientPrivateKey", "callerIssuer", "delegationAuthorizer", "setupAuthorizer", "request", "clientChallengeBase64url", "expectedCallerPrincipal", "expectedTargetPrincipal", "expectedTargetNonce", "expectedTargetRequestSha256", "installation", "setupInstallationObservation"],
  "properties": {
    "apiVersion": {"const": "catchplate.nativeBootstrapClient/v10"},
    "endpoint": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/endpoint"},
    "timeoutMilliseconds": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/timeoutMilliseconds"},
    "startupEvidence": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/startupEvidence"},
    "startupExpectations": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/startupExpectations"},
    "sessionScope": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/sessionScope"},
    "trustRoots": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/trustRoots"},
    "clientCertificate": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientCertificate"},
    "clientPrivateKey": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientPrivateKey"},
    "callerIssuer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/callerIssuer"},
    "delegationAuthorizer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/delegationAuthorizer"},
    "setupAuthorizer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/setupAuthorizer"},
    "request": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/request"},
    "clientChallengeBase64url": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientChallengeBase64url"},
    "expectedCallerPrincipal": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedCallerPrincipal"},
    "expectedTargetPrincipal": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetPrincipal"},
    "expectedTargetNonce": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetNonce"},
    "expectedTargetRequestSha256": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetRequestSha256"},
    "installation": {"$ref": "native-bootstrap-client.v2.schema.json#/properties/installation"},
    "setupInstallationObservation": {"type": "object", "additionalProperties": false,
      "required": ["prepared", "enrollment", "hostSigningSeed", "hostPublicKeyBase64url", "targetPrivateKey"],
      "properties": {"prepared": {"$ref": "native-bootstrap-client.v1.schema.json#/$defs/artifact"},
        "enrollment": {"$ref": "native-bootstrap-client.v1.schema.json#/$defs/artifact"},
        "hostSigningSeed": {"$ref": "native-bootstrap-client.v1.schema.json#/$defs/artifact"},
        "hostPublicKeyBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "targetPrivateKey": {"$ref": "native-bootstrap-client.v1.schema.json#/$defs/artifact"}}}
  },
  "$defs": {
    "capture": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "resultScope", "okForAction", "configurationSha256", "requestSha256", "endpoint", "challengeSource", "evidenceBase64url", "verification", "installation", "setupInstallationObservationOriginal"],
      "properties": {"apiVersion": {"const": "catchplate.nativeBootstrapClientCapture/v10"}, "resultScope": {"const": "local-authenticated-setup-ca-readback"}, "okForAction": {"const": false},
        "configurationSha256": {"$ref": "setup-native-ca-installation.v1.schema.json#/$defs/digest"}, "requestSha256": {"$ref": "setup-native-ca-installation.v1.schema.json#/$defs/digest"},
        "endpoint": {"type": "string"}, "challengeSource": {"const": "independently-pinned"}, "evidenceBase64url": {"type": "string"}, "verification": {"type": "object"},
        "installation": {"$ref": "native-ca-installation-receipt.v1.schema.json"}, "setupInstallationObservationOriginal": {"$ref": "setup-native-ca-installation.v1.schema.json#/$defs/observationOriginal"}}}
  },
  "description": "Explicit root-only successor, not v1-v9 widening. Fixed no-execution installer owns actual TLS/native proof, same host and original deadline, target key/leaf and distinct cold-assigned host key. Prepared and enrollment pins identify exact returned protected originals but do not authorize installation: the independently signed original host grant does. No generated keys, generic sign API, measured-host or final Setup claim. Config <=16384 bytes. Private originals must be protected root-owned files. Existing external watchdog prerequisite remains."
}
