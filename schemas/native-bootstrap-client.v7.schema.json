{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-bootstrap-client.v7.schema.json",
  "title": "Explicit native execution and owned-resource retirement bootstrap client v7",
  "description": "Closed independently pinned configuration, at most 16384 bytes: the original 18 fields plus required egress, attachment and execution objects and a required installation field that is either null or the existing installation object. Explicit v7 selects start authorization v2 and owned-resource retirement. Null installation selects execution manifest v1; an installation object selects manifest v2 with immutable in-image application trust. All older profiles remain unchanged. Actual same-session proof, independent installation/start/network grants, retained originals, one-use claims and terminal cleanup remain mandatory. Schema acceptance is neither installation nor execution permission.",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "endpoint", "timeoutMilliseconds", "startupEvidence", "startupExpectations", "sessionScope", "trustRoots", "clientCertificate", "clientPrivateKey", "callerIssuer", "delegationAuthorizer", "setupAuthorizer", "request", "clientChallengeBase64url", "expectedCallerPrincipal", "expectedTargetPrincipal", "expectedTargetNonce", "expectedTargetRequestSha256", "installation", "egress", "attachment", "execution"],
  "properties": {
    "apiVersion": {"const": "serverware.nativeBootstrapClient/v7"},
    "endpoint": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/endpoint"},
    "timeoutMilliseconds": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/timeoutMilliseconds"},
    "startupEvidence": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/startupEvidence"},
    "startupExpectations": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/startupExpectations"},
    "sessionScope": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/sessionScope"},
    "trustRoots": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/trustRoots"},
    "clientCertificate": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientCertificate"},
    "clientPrivateKey": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientPrivateKey"},
    "callerIssuer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/callerIssuer"},
    "delegationAuthorizer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/delegationAuthorizer"},
    "setupAuthorizer": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/setupAuthorizer"},
    "request": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/request"},
    "clientChallengeBase64url": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/clientChallengeBase64url"},
    "expectedCallerPrincipal": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedCallerPrincipal"},
    "expectedTargetPrincipal": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetPrincipal"},
    "expectedTargetNonce": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetNonce"},
    "expectedTargetRequestSha256": {"$ref": "native-bootstrap-client.v1.schema.json#/properties/expectedTargetRequestSha256"},
    "installation": {"oneOf": [{"type": "null"}, {"$ref": "native-bootstrap-client.v2.schema.json#/properties/installation"}]},
    "egress": {"$ref": "native-bootstrap-client.v5.schema.json#/properties/egress"},
    "attachment": {"$ref": "native-bootstrap-client.v4.schema.json#/properties/attachment"},
    "execution": {
      "$ref": "native-bootstrap-client.v5.schema.json#/properties/execution",
      "description": "The same four protected artifact roles, explicitly requiring nativeWorkloadStartAuthorization/v2 with remove-empty-owned-leaf-v1. A null installation selects nativeExecutionManifest/v1; otherwise nativeExecutionManifest/v2 pins immutable in-image single runtime CA PEM and DER certificate bytes that must join the genuine native CA and separately authorized host installation. No writable image trust injection or record-selected downgrade is allowed."
    }
  }
}
