{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-bootstrap-client.v9.schema.json",
  "title":"Explicit native ordinary-application CONNECT client v9",
  "description":"Closed 23-field cold configuration, <=16384 original bytes. Requires separate genuine CA installation, execution manifest v3, start authorization v4 and egress authorization v5. applicationProxy contains TARGET mTLS originals, never the bootstrap caller identity. Every pin is joined to the signed immutable manifest and current same-connection native principal preflight. No connection retry, authority fallback, DNS, or provider credentials in the application.",
  "type":"object","additionalProperties":false,
  "required":["apiVersion","endpoint","timeoutMilliseconds","startupEvidence","startupExpectations","sessionScope","trustRoots","clientCertificate","clientPrivateKey","callerIssuer","delegationAuthorizer","setupAuthorizer","request","clientChallengeBase64url","expectedCallerPrincipal","expectedTargetPrincipal","expectedTargetNonce","expectedTargetRequestSha256","installation","egress","attachment","execution","applicationProxy"],
  "properties":{
    "apiVersion":{"const":"serverware.nativeBootstrapClient/v9"},
    "endpoint":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/endpoint"},
    "timeoutMilliseconds":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/timeoutMilliseconds"},
    "startupEvidence":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/startupEvidence"},
    "startupExpectations":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/startupExpectations"},
    "sessionScope":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/sessionScope"},
    "trustRoots":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/trustRoots"},
    "clientCertificate":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/clientCertificate"},
    "clientPrivateKey":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/clientPrivateKey"},
    "callerIssuer":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/callerIssuer"},
    "delegationAuthorizer":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/delegationAuthorizer"},
    "setupAuthorizer":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/setupAuthorizer"},
    "request":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/request"},
    "clientChallengeBase64url":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/clientChallengeBase64url"},
    "expectedCallerPrincipal":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/expectedCallerPrincipal"},
    "expectedTargetPrincipal":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/expectedTargetPrincipal"},
    "expectedTargetNonce":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/expectedTargetNonce"},
    "expectedTargetRequestSha256":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/expectedTargetRequestSha256"},
    "installation":{"$ref":"native-bootstrap-client.v6.schema.json#/properties/installation"},
    "egress":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/egress"},
    "attachment":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/attachment"},
    "execution":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/execution","description":"Same four artifact roles, explicitly selected start authorization v4 and manifest v3; never incoming-version selection."},
    "applicationProxy":{
      "type":"object","additionalProperties":false,
      "required":["ingressConfiguration","targetCertificate","targetPrivateKey"],
      "properties":{
        "ingressConfiguration":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/startupEvidence","description":"Independently pinned nativeProxyIngress/v3 original and its retained transitive originals."},
        "targetCertificate":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/clientCertificate"},
        "targetPrivateKey":{"$ref":"native-bootstrap-client.v8.schema.json#/properties/clientPrivateKey"}
      },
      "description":"All three artifact roles distinct. Both target identity paths and hashes differ from BOTH bootstrap caller identity originals. The target leaf SPKI must equal actual bootstrap/egress target SPKI; selected mTLS principal is freshly verified before CONNECT. Private key remains launcher-owned, outside the immutable child root and its descriptor whitelist."
    }
  }
}
