{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-broker-credential-lease.common.schema.json",
  "title": "Ciphertext-only native broker lease shapes",
  "description": "Definitions only. Original native identity, request-authority and release shapes are reused without widening old wire families. Actual cold selection, measured recipient, currentness, ciphertext authentication and cross-field associations are mandatory runtime checks.",
  "$defs": {
    "requestBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "principalId", "routeId", "credentialId", "expectedCredentialVersion", "expectedMetadataSha256", "recipientPublicKey", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "maxTtlSeconds", "recipientAttestation"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.nativeBrokerCredentialLeaseRequest/v1", "catchplate.nativeBrokerCredentialLeaseRequest/v2"]},
        "purpose": {"enum": ["generationMetadata", "dispatchSecret"]},
        "principalId": {"$ref": "native-credential-lease.common.schema.json#/$defs/principal"},
        "routeId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "credentialId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "expectedCredentialVersion": {"oneOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
        "expectedMetadataSha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/nullableDigest"},
        "requestAuthority": {"$ref": "native-credential-lease.common.schema.json#/$defs/requestAuthority"},
        "releaseAuthorization": {"$ref": "native-credential-lease.common.schema.json#/$defs/nullableRelease"},
        "recipientPublicKey": {"$ref": "native-credential-lease.common.schema.json#/$defs/raw32"},
        "recipientKeyId": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "recipientNonce": {"$ref": "native-credential-lease.common.schema.json#/$defs/raw32"},
        "policyHash": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "dataPlaneBinaryDigest": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "maxTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 5},
        "recipientAttestation": {"$ref": "native-credential-recipient-evidence.v1.schema.json"}
      },
      "allOf": [{
        "if": {"properties": {"purpose": {"const": "generationMetadata"}}},
        "then": {"properties": {"expectedCredentialVersion": {"type": "null"}, "expectedMetadataSha256": {"type": "null"}}},
        "else": {"properties": {"expectedCredentialVersion": {"type": "integer"}, "expectedMetadataSha256": {"type": "string"}}}
      }]
    },
    "envelopeBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "algorithm", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "principalId", "routeId", "credentialId", "issuedAtEpochMs", "expiresAtEpochMs", "serverEphemeralPublicKey", "aeadNonce", "ciphertext", "ciphertextSha256"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.nativeBrokerCredentialLeaseEnvelope/v1", "catchplate.nativeBrokerCredentialLeaseEnvelope/v2"]},
        "algorithm": {"const": "X25519-HKDF-SHA256-AES-256-GCM"},
        "purpose": {"const": "dispatchSecret"},
        "requestBindingSha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "requestAuthoritySha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "recipientKeyId": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "recipientNonce": {"$ref": "native-credential-lease.common.schema.json#/$defs/raw32"},
        "policyHash": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "dataPlaneBinaryDigest": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "principalId": {"$ref": "native-credential-lease.common.schema.json#/$defs/principal"},
        "routeId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "credentialId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "issuedAtEpochMs": {"$ref": "native-credential-lease.common.schema.json#/$defs/positiveUint"},
        "expiresAtEpochMs": {"$ref": "native-credential-lease.common.schema.json#/$defs/positiveUint"},
        "serverEphemeralPublicKey": {"$ref": "native-credential-lease.common.schema.json#/$defs/raw32"},
        "aeadNonce": {"$ref": "native-credential-lease.common.schema.json#/$defs/envelopeBase/properties/aeadNonce"},
        "ciphertext": {"$ref": "native-credential-lease.common.schema.json#/$defs/envelopeBase/properties/ciphertext"},
        "ciphertextSha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"}
      }
    },
    "version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "encryptedCredential": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialId", "credentialVersion", "secretKekId", "encryptedDek", "secretNonce", "secretCiphertext", "secretUpdatedAt"],
      "properties": {
        "credentialId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "credentialVersion": {"$ref": "#/$defs/version"},
        "secretKekId": {"type": "string", "minLength": 1, "maxLength": 256},
        "encryptedDek": {"type": "string", "pattern": "^v1:[A-Za-z0-9_-]{16}:[A-Za-z0-9_-]{64}$"},
        "secretNonce": {"type": "string", "pattern": "^v1:[A-Za-z0-9_-]{16}$"},
        "secretCiphertext": {"type": "string", "minLength": 26, "maxLength": 1398127, "pattern": "^v1:[A-Za-z0-9_-]+={0,2}$"},
        "secretUpdatedAt": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "description": "Exact original at-rest strings, not re-encoded. Shared runtime readers accept canonical padded or canonical unpadded base64url, rejecting partial/surplus padding and nonzero unused pad bits. Runtime enforces nonce12, wrapped DEK48, secret ciphertext17..1048592 bytes, actual KEK assignment and exact credential/version AAD. Native creation/refresh admission codecs and writers are unchanged. No encrypted_secret fallback."
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialId", "credentialVersion", "metadataSha256", "metadata"],
      "properties": {
        "credentialId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "credentialVersion": {"$ref": "#/$defs/version"},
        "metadataSha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "metadata": {"$ref": "native-credential-lease.common.schema.json#/$defs/metadata"},
        "encryptedCredential": {"$ref": "#/$defs/encryptedCredential"},
        "storageMetadata": {"type": "string", "minLength": 2, "maxLength": 32768, "description": "Complete same-row stored metadata as the untouched JSON string; original UTF-8 <=32 KiB, duplicate keys/nonfinite values rejected before transport. String transmission preserves finite float spellings. Confidential: only inside the encrypted set. Broker checks token association, scopes and expiry against it. Not public metadata or provider-authorship proof."}
      }
    },
    "setBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "requestBindingSha256", "releaseAuthorization", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "principalId", "routeId", "credentialId", "issuedAtEpochMs", "expiresAtEpochMs", "credentials"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.nativeBrokerCredentialLeaseSet/v1", "catchplate.nativeBrokerCredentialLeaseSet/v2"]},
        "purpose": {"enum": ["generationMetadata", "dispatchSecret"]},
        "requestBindingSha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "requestAuthority": {"$ref": "native-credential-lease.common.schema.json#/$defs/requestAuthority"},
        "requestAuthoritySha256": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "releaseAuthorization": {"$ref": "native-credential-lease.common.schema.json#/$defs/nullableRelease"},
        "recipientKeyId": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "recipientNonce": {"$ref": "native-credential-lease.common.schema.json#/$defs/raw32"},
        "policyHash": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "dataPlaneBinaryDigest": {"$ref": "native-credential-lease.common.schema.json#/$defs/digest"},
        "principalId": {"$ref": "native-credential-lease.common.schema.json#/$defs/principal"},
        "routeId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "credentialId": {"$ref": "native-credential-lease.common.schema.json#/$defs/identity"},
        "issuedAtEpochMs": {"$ref": "native-credential-lease.common.schema.json#/$defs/positiveUint"},
        "expiresAtEpochMs": {"$ref": "native-credential-lease.common.schema.json#/$defs/positiveUint"},
        "credentials": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/entry"}}
      },
      "allOf": [{
        "if": {"properties": {"purpose": {"const": "generationMetadata"}}},
        "then": {"properties": {"credentials": {"items": {"not": {"anyOf": [{"required": ["encryptedCredential"]}, {"required": ["storageMetadata"]}]}}}}},
        "else": {"properties": {"credentials": {"items": {"required": ["encryptedCredential", "storageMetadata"]}}}}
      }]
    }
  }
}
