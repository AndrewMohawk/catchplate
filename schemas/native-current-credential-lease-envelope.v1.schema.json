{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-current-credential-lease-envelope.v1.schema.json",
  "title": "Nonce-authenticated native currentness lease envelope",
  "description": "Maximum final response is 8 MiB. The original native encrypted envelope and its AAD are unchanged. The HTTP proof binds this actual outer body. Metadata observation requires subsequent genuine holder registration; dispatch echoes the exact original holder pin. Runtime checks enforce all cross-field, current configuration, root, recipient and expiry relationships.",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "currentness", "envelope"],
  "properties": {
    "apiVersion": {"const": "catchplate.nativeCurrentCredentialLeaseEnvelope/v1"},
    "currentness": {"oneOf": [{"$ref": "#/$defs/metadata"}, {"$ref": "native-current-credential-lease-request.v1.schema.json#/$defs/dispatchPin"}]},
    "envelope": {"oneOf": [{"$ref": "native-credential-lease-envelope.v1.schema.json"}, {"$ref": "native-credential-lease-envelope.v2.schema.json"}]}
  },
  "$defs": {
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialVersion", "epoch", "rootSha256"],
      "properties": {
        "credentialVersion": {"$ref": "native-current-credential-lease-request.v1.schema.json#/$defs/version"},
        "epoch": {"$ref": "native-current-credential-lease-request.v1.schema.json#/$defs/version"},
        "rootSha256": {"$ref": "native-current-credential-lease-request.v1.schema.json#/$defs/digest"}
      }
    }
  }
}
