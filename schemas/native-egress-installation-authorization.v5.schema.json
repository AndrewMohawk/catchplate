{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/native-egress-installation-authorization.v5.schema.json",
  "title":"Explicit executable application loopback and adapter egress permission v5",
  "description":"Closed canonical ASCII/no-LF <=32768 bytes. Distinct v5 payload-schema plus NUL signing domain. New cold application profile only; old diagnostic/execution clients refuse it before effects. Existing irreversible creation claim precedes child-only loopback UP/listener creation. Existing kernel claim precedes fixed exact loopback TCP rules; no host firewall, NAT, default route or generic networking authority.",
  "type":"object","additionalProperties":false,"required":["schema","payload","signature"],
  "properties":{
    "schema":{"const":"catchplate.signedNativeEgressInstallationAuthorization/v5"},
    "signature":{"$ref":"native-egress-installation-authorization.v4.schema.json#/properties/signature"},
    "payload":{"$ref":"#/$defs/payload"}
  },
  "$defs":{"payload":{
