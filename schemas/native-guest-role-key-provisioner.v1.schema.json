{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-guest-role-key-provisioner.v1.schema.json",
  "title": "Purpose-fixed boot role-key provisioning originals",
  "description": "Data shapes only. Signatures, current Prepared delivery owners, protected filesystem custody, original deadlines, KMS Recipient evidence, cryptographic joins and successful child exit are checked by the actual owners.",
  "oneOf": [
    {"$ref": "#/$defs/configuration"}, {"$ref": "#/$defs/inventory"},
    {"$ref": "#/$defs/encryptedInventory"}, {"$ref": "#/$defs/recipientRequest"},
    {"$ref": "#/$defs/recipientResponse"}, {"$ref": "#/$defs/parentConfiguration"},
    {"$ref": "#/$defs/offlineAssignment"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "bootId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "deadline": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "base64url": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"},
    "context": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "required": ["catchplatePurpose"], "propertyNames": {"$ref": "#/$defs/text"},
      "properties": {"catchplatePurpose": {"const": "guest-role-keys/v1"}},
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "helperImage": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "imagePath", "imageSha256", "interpreterSha256", "helperSha256"],
      "properties": {
        "profile": {"const": "sealed-memfd-squashfs-v1"},
        "imagePath": {"const": "/opt/catchplate/native-role-key-provisioner-runtime.squashfs"},
        "imageSha256": {"$ref": "#/$defs/sha256"}, "interpreterSha256": {"$ref": "#/$defs/sha256"},
        "helperSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "helperImage", "kmsParentPort", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "kekSha256", "encryptedInventory"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeGuestRoleKeyProvisioner/v1"},
        "helperImage": {"$ref": "#/$defs/helperImage"},
        "kmsParentPort": {"type": "integer", "minimum": 1024, "maximum": 4294967294},
        "kmsKeyId": {"type": "string", "minLength": 1, "maxLength": 2048},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha256"}, "encryptionContext": {"$ref": "#/$defs/context"},
        "kekSha256": {"$ref": "#/$defs/sha256"},
        "encryptedInventory": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"const": "/run/catchplate-role-key-provisioning/inventory.enc.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "role": {"enum": ["custody-router", "state-authority", "credential-transport", "policy-proof-verifier", "immutable-artifact-ledger", "release-attestor-publisher", "cleanup-watchdog"]},
    "delivery": {
      "type": "object", "additionalProperties": false, "required": ["serviceRole", "deliverySha256"],
      "properties": {"serviceRole": {"$ref": "#/$defs/role"}, "deliverySha256": {"$ref": "#/$defs/sha256"}}
    },
    "seedBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["serviceRole", "logicalRole", "uid", "gid", "path", "seedSha256", "publicKeySha256"],
      "properties": {
        "serviceRole": {"$ref": "#/$defs/role"}, "logicalRole": {"type": "string", "minLength": 1, "maxLength": 128},
        "uid": {"type": "integer", "minimum": 1, "maximum": 4294967294, "not": {"enum": [64989, 64990, 65534]}},
        "gid": {"type": "integer", "minimum": 1, "maximum": 4294967294, "not": {"enum": [64989, 64990, 65534]}},
        "path": {"$ref": "#/$defs/path"}, "seedSha256": {"$ref": "#/$defs/sha256"}, "publicKeySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "configurationSha256", "generationId", "generation", "trustCheckpointSha256", "bootId", "deadlineBoottimeNs", "deliveries", "keys"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeGuestRoleKeyInventory/v1"},
        "configurationSha256": {"$ref": "#/$defs/sha256"}, "generationId": {"type": "string", "minLength": 1, "maxLength": 256},
        "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "trustCheckpointSha256": {"$ref": "#/$defs/sha256"}, "bootId": {"$ref": "#/$defs/bootId"},
        "deadlineBoottimeNs": {"$ref": "#/$defs/deadline"},
        "deliveries": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/delivery"}},
        "keys": {"type": "array", "minItems": 7, "maxItems": 64, "items": {"$ref": "#/$defs/seedBinding"}}
      }
    },
    "encryptedInventory": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "inventorySha256", "nonce", "ciphertext"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeGuestRoleKeyCiphertext/v1"}, "inventorySha256": {"$ref": "#/$defs/sha256"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16}$"},
        "ciphertext": {"allOf": [{"$ref": "#/$defs/base64url"}], "minLength": 23, "maxLength": 21846}
      }
    },
    "recipientRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "material", "configurationSha256", "deliveryInventorySha256", "provisionerConfigurationSha256", "helperImageSha256", "bootId", "deadlineBoottimeNs", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "recipientPublicKeySha256", "nonce"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeRoleKeyKmsRecipientRequest/v1"}, "material": {"const": "guest-role-key-kek"},
        "configurationSha256": {"$ref": "#/$defs/sha256"}, "deliveryInventorySha256": {"$ref": "#/$defs/sha256"},
        "provisionerConfigurationSha256": {"$ref": "#/$defs/sha256"}, "helperImageSha256": {"$ref": "#/$defs/sha256"},
        "bootId": {"$ref": "#/$defs/bootId"}, "deadlineBoottimeNs": {"$ref": "#/$defs/deadline"},
        "kmsKeyId": {"type": "string", "minLength": 1, "maxLength": 2048}, "ciphertextBlobSha256": {"$ref": "#/$defs/sha256"},
        "encryptionContext": {"$ref": "#/$defs/context"}, "recipientPublicKeySha256": {"$ref": "#/$defs/sha256"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
      }
    },
    "recipientResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "requestSha256", "ciphertextForRecipient", "ciphertextSha256"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeRoleKeyKmsRecipientCiphertext/v1"}, "requestSha256": {"$ref": "#/$defs/sha256"},
        "ciphertextForRecipient": {"allOf": [{"$ref": "#/$defs/base64url"}], "maxLength": 87382},
        "ciphertextSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "parentConfiguration": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "enclaveCid", "port", "kmsKeyId", "ciphertextBlob", "encryptionContext", "region", "configurationSha256", "deliveryInventorySha256", "provisionerConfigurationSha256", "helperImageSha256"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeRoleKeyKmsParent/v1"},
        "enclaveCid": {"type": "integer", "minimum": 4, "maximum": 4294967294}, "port": {"type": "integer", "minimum": 1024, "maximum": 4294967294},
        "kmsKeyId": {"type": "string", "minLength": 1, "maxLength": 2048},
        "ciphertextBlob": {"allOf": [{"$ref": "#/$defs/base64url"}], "maxLength": 8192},
        "encryptionContext": {"$ref": "#/$defs/context"}, "region": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "configurationSha256": {"$ref": "#/$defs/sha256"}, "deliveryInventorySha256": {"$ref": "#/$defs/sha256"},
        "provisionerConfigurationSha256": {"$ref": "#/$defs/sha256"}, "helperImageSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "offlineAssignment": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "inventorySha256", "kekPath", "seedPaths"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeGuestRoleKeyOfflineAssignment/v1"}, "inventorySha256": {"$ref": "#/$defs/sha256"},
        "kekPath": {"$ref": "#/$defs/path"}, "seedPaths": {"type": "array", "minItems": 7, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      }
    }
  }
}
