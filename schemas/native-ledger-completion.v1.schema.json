        "regularAppendCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "capacityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regularAppendCapacity",
        "committedRegularAppends",
        "disposition"
