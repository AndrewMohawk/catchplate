    "retrievalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "assignmentPayloadSha256",
        "keyAuthorizationSha256",
        "trustCheckpointId",
        "revocationGeneration",
        "revocationRootSha256",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos",
        "signingKeyId",
        "signingKeySpkiSha256",
        "proofScopeOriginalBase64url",
        "expectedPeer",
        "spoolScope",
        "ingress",
        "ledger",
        "terminal",
        "store"
      ],
      "properties": {
        "apiVersion": {
          "const": "serverware.nativeLedgerSpoolRetrievalGrant/v2"
        },
        "purpose": {
          "const": "native-ledger-spool-retrieval"
        },
        "guest": {
          "$ref": "#/$defs/guest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "trustCheckpointId": {
          "$ref": "#/$defs/sha"
        },
        "revocationGeneration": {
          "$ref": "#/$defs/epoch"
        },
        "revocationRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "issuedAtUnixNanos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expiresAtUnixNanos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signingKeyId": {
          "$ref": "#/$defs/sha"
        },
        "signingKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "proofScopeOriginalBase64url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 21846,
          "pattern": "^[A-Za-z0-9_-]+$"
