      "properties": {
        "apiVersion": {
          "const": "serverware.nativeShadowTerminalSpoolGuestLaunch/v1"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "terminalSpool": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "ledgerLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "keyAdmission",
        "commitRequest"
