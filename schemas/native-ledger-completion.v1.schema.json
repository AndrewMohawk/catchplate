      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "runtimeConfigurationSha256",
        "authorityHistoryManifestSha256",
        "headGrantOriginal",
        "durableAuthorityEpoch",
        "durablePublicKeyBase64url",
        "initialTransitionHeadSha256"
