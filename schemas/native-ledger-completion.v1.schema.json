          "const": "serverware.nativeSpoolHeadGrant/v2"
        },
        "purpose": {
          "const": "native-shared-spool-head"
        },
        "guest": {
          "$ref": "#/$defs/guest"
        },
        "runtimeConfigurationSha256": {
          "$ref": "#/$defs/sha"
        },
        "authorityHistoryManifestSha256": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "originVerifier": {
          "$ref": "#/$defs/key"
        },
        "ingress": {
          "$ref": "native-ledger-spool.v1.schema.json#/$defs/roleKey"
        },
        "ledger": {
          "$ref": "native-ledger-spool.v1.schema.json#/$defs/roleKey"
        },
        "retrieval": {
          "$ref": "native-ledger-spool.v1.schema.json#/$defs/roleKey"
        },
        "proofScopeOriginal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[\\u0000-\\u007f]+$"
        },
        "initialTransitionHeadSha256": {
          "$ref": "#/$defs/sha"
        },
        "completion": {
          "$ref": "#/$defs/completionPolicy"
        }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signatureBase64url"
