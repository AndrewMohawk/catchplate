    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "operation",
        "operationIdSha256",
        "requestSha256",
        "durableRequestSha256",
        "terminationFenceSha256",
        "productionConfigurationBindingSha256",
        "kernelDriverIdentitySha256",
        "retainedDescriptorSetSha256",
        "driverGenerationReceiptSha256",
        "openedAtBoottimeNanos",
        "operationDeadlineBoottimeNanos",
        "cleanupDeadlineBoottimeNanos",
        "replayIdSha256",
        "bindingSha256"
      ],
      "properties": {
        "apiVersion": {
          "const": "serverware.policyCustodyProductionDispatch/v4"
        },
        "operation": {
          "enum": [
            "begin-ingress",
            "reserve-spool-append",
            "append-spool-event",
            "append-terminal"
          ]
        },
