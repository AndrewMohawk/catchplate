      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "keyId",
        "keySpkiSha256",
        "publicKeyBase64url",
        "grantSha256"
      ],
      "properties": {
        "role": {
          "const": "custody-terminal-append"
        },
        "keyId": {
          "$ref": "#/$defs/sha"
        },
        "keySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "publicKeyBase64url": {
          "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/bytes32"
        },
        "grantSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal",
        "regularAppendCapacity"
