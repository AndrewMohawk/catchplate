      "properties": {
        "apiVersion": {
          "const": "serverware.nativeShadowCommitRequestGuestLaunch/v3"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "commitRequest": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "retrievalLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "keyAdmission",
        "retrieval"
      ],
      "properties": {
        "apiVersion": {
          "const": "serverware.nativeShadowRetrievalGuestLaunch/v3"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "retrieval": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "bridgeLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "keyAdmission",
        "trustedTime"
      ],
      "properties": {
        "apiVersion": {
          "const": "serverware.nativeProofBridgeLaunch/v4"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "trustedTime": {
          "$ref": "#/$defs/pin"
        }
      }
