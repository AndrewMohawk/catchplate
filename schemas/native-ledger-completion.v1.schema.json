          "$ref": "#/$defs/sha"
        },
        "request_commitment_sha256": {
          "$ref": "#/$defs/sha"
        },
        "phase": {
          "enum": [
            "ingress-open",
            "capture",
            "decision",
            "pre-dispatch-terminal",
            "post-dispatch-terminal",
            "response",
            "candidate",
            "range-closure"
          ]
