      "properties": {
        "payload": {
          "$ref": "#/$defs/signerPayload"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "headPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "runtimeConfigurationSha256",
        "authorityHistoryManifestSha256",
        "scope",
        "originVerifier",
        "ingress",
        "ledger",
        "retrieval",
        "proofScopeOriginal",
        "initialTransitionHeadSha256",
        "completion"
