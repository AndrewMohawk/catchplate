          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[\\u0000-\\u007f]+$"
        },
        "currentGrantOriginal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072,
          "pattern": "^[\\u0000-\\u007f]+$"
        },
        "originFdName": {
          "const": "generation-origin"
        }
      }
    },
    "signerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "assignmentPayloadSha256",
        "keyAuthorizationSha256",
        "scope",
        "proofScopeOriginal",
        "originVerifier",
        "expectedPeer",
        "commitRequest",
        "trustCheckpointId",
        "revocationGeneration",
        "revocationRootSha256",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos",
