          "$ref": "#/$defs/guest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "proofScopeOriginal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[\\u0000-\\u007f]+$"
        },
        "originVerifier": {
          "$ref": "#/$defs/key"
        },
        "expectedPeer": {
          "$ref": "#/$defs/peer"
        },
        "commitRequest": {
          "oneOf": [
            {
              "$ref": "#/$defs/pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "trustCheckpointId": {
          "$ref": "#/$defs/sha"
        },
        "revocationGeneration": {
          "$ref": "#/$defs/epoch"
        },
        "revocationRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "issuedAtUnixNanos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "expiresAtUnixNanos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "signingKeyId": {
          "$ref": "#/$defs/sha"
        },
        "signingKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "oneOf": [
        {
          "properties": {
            "apiVersion": {
              "const": "serverware.nativeShadowLedgerSpoolServiceAssignment/v2"
            },
            "purpose": {
              "const": "native-ledger-spool-and-sampling-with-unavailability"
            },
            "commitRequest": {
              "$ref": "#/$defs/pin"
            }
          }
        },
        {
          "properties": {
            "apiVersion": {
              "const": "serverware.nativeShadowTerminalSpoolServiceAssignment/v1"
            },
            "purpose": {
              "const": "native-terminal-slot-append"
            },
            "commitRequest": {
              "type": "null"
            }
          }
        }
      ]
