        "expectedPeer": {
          "$ref": "#/$defs/peer"
        },
        "spoolScope": {
          "$ref": "#/$defs/scope"
        },
        "ingress": {
          "$ref": "native-ledger-spool.v1.schema.json#/$defs/roleKey"
        },
        "ledger": {
          "$ref": "native-ledger-spool.v1.schema.json#/$defs/roleKey"
        },
        "terminal": {
          "$ref": "#/$defs/terminalKey"
        },
        "store": {
          "$ref": "#/$defs/storeAdmission"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
