{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-ledger-completion.v1.schema.json",
  "$ref": "#/$defs/bridgeSelection",
  "description": "Explicit native terminal and definite reservation-unavailable successor. Old profiles unchanged. Source verifies actual eight owners, independent grants/keys/currentness, full original signatures, shared DRS head/counters, storage/fsync/readback and unchanged original deadlines. Canonical complete endpoint framing remains <=8 MiB. Schema is data shape, never effect permission or successful installation.",
  "$defs": {
    "sha": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/sha"
    },
    "signature": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/signature"
    },
    "epoch": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/epoch"
    },
    "u64": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/u64"
    },
    "pin": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/pin"
    },
    "guest": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/guest"
    },
    "key": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/key"
    },
    "peer": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/peer"
    },
    "scope": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/scope"
    },
    "storeAdmission": {
      "$ref": "native-ledger-spool.v1.schema.json#/$defs/storeAdmission"
    },
