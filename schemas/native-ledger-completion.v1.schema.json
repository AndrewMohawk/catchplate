      "properties": {
        "regularAppendCapacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "committedRegularAppends": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "disposition": {
          "enum": [
            "proceed",
            "reservation-unavailable"
          ]
        }
      }
    },
    "bridgeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "headGrantOriginal",
        "currentGrantOriginal",
        "originFdName"
