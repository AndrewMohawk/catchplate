{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-ledger-fresh-retrieval.v1.schema.json",
  "title": "Explicit native fresh-ledger retrieval grant",
  "description": "Closed nativeLedgerSpoolRetrievalGrant/v4 signed envelope. Unchanged v3 fields retain their existing schemas; fresh-ledger adds explicit initialization and sequence-zero admission. Canonical bytes, signature verification under catchplate.nativeLedgerSpoolRetrievalGrant.signature/v4, decoded strict production proof scope/v2, scope/assignment/key/currentness joins, headSha256 == genesisSha256, actual genesis and empty-directory checks remain runtime obligations. This schema establishes neither authority, a receipt, successful absence nor service readiness; legacy grant schemas are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {"$ref": "#/$defs/retrievalPayload"},
    "signature": {"$ref": "native-active-effects.v1.schema.json#/$defs/signature"}
  },
  "$defs": {
    "freshStore": {
      "$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/store",
      "type": "object",
      "additionalProperties": false,
      "required": ["genesisSha256", "sequence", "headSha256"],
      "properties": {
        "genesisSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/sha"},
        "sequence": {"type": "integer", "const": 0},
        "headSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/sha"}
      }
    },
    "retrievalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion", "purpose", "guest", "assignmentPayloadSha256", "keyAuthorizationSha256",
        "trustCheckpointId", "revocationGeneration", "revocationRootSha256", "issuedAtUnixNanos",
        "expiresAtUnixNanos", "signingKeyId", "signingKeySpkiSha256", "proofScopeOriginalBase64url",
        "expectedPeer", "spoolScope", "ingress", "ledger", "terminal", "store", "effects", "initialization"
      ],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeLedgerSpoolRetrievalGrant/v4"},
        "purpose": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/purpose"},
        "guest": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/guest"},
        "assignmentPayloadSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/assignmentPayloadSha256"},
        "keyAuthorizationSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/keyAuthorizationSha256"},
        "trustCheckpointId": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/trustCheckpointId"},
        "revocationGeneration": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/revocationGeneration"},
        "revocationRootSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/revocationRootSha256"},
        "issuedAtUnixNanos": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/issuedAtUnixNanos"},
        "expiresAtUnixNanos": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/expiresAtUnixNanos"},
        "signingKeyId": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/signingKeyId"},
        "signingKeySpkiSha256": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/signingKeySpkiSha256"},
        "proofScopeOriginalBase64url": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/proofScopeOriginalBase64url"},
        "expectedPeer": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/expectedPeer"},
        "spoolScope": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/spoolScope"},
        "ingress": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/ingress"},
        "ledger": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/ledger"},
        "terminal": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/terminal"},
        "store": {"$ref": "#/$defs/freshStore"},
        "effects": {"$ref": "native-active-effects.v1.schema.json#/$defs/retrievalPayload/properties/effects"},
        "initialization": {"const": "fresh-ledger"}
      }
    }
  }
}
