          "$ref": "#/$defs/digest"
        },
        "currentnessBarrierSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "contactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journalRowSha256",
        "ownerNonce",
        "tokenPurpose",
        "contactRequestSha256"
      ],
      "properties": {
        "journalRowSha256": {
          "$ref": "#/$defs/digest"
        },
        "ownerNonce": {
          "$ref": "#/$defs/bytes32"
        },
        "tokenPurpose": {
          "enum": [
            "access_token",
            "refresh_token"
          ]
        },
        "contactRequestSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "finishRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journalRowSha256",
        "ownerNonce",
        "tokenPurpose",
        "attemptRowSha256",
        "transportOriginal"
      ],
      "properties": {
        "journalRowSha256": {
          "$ref": "#/$defs/digest"
        },
        "ownerNonce": {
          "$ref": "#/$defs/bytes32"
        },
        "tokenPurpose": {
          "enum": [
            "access_token",
            "refresh_token"
          ]
        },
        "attemptRowSha256": {
          "$ref": "#/$defs/digest"
        },
        "transportOriginal": {
          "$ref": "#/$defs/encoded",
          "maxLength": 524288
        }
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "authorization_original",
        "enrollment_original",
        "historical_root_original",
        "control_plane_configuration_digest",
        "assignment_original",
        "request",
        "evidence"
      ],
      "properties": {
        "work_id": {
          "$ref": "#/$defs/uuid"
        },
        "authorization_original": {
          "$ref": "#/$defs/encoded",
          "maxLength": 87382
        },
        "enrollment_original": {
          "$ref": "native-oauth-measured-refresh.v1.schema.json#/$defs/enrollmentOriginal"
        },
        "historical_root_original": {
          "$ref": "#/$defs/encoded",
          "maxLength": 5462
        },
        "control_plane_configuration_digest": {
          "$ref": "#/$defs/digest"
        },
        "assignment_original": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/assignment"
            }
          ]
        },
        "request": {
          "oneOf": [
            {
              "$ref": "#/$defs/readRequest"
            },
            {
              "$ref": "#/$defs/claimRequest"
            },
            {
              "$ref": "#/$defs/contactRequest"
            },
            {
              "$ref": "#/$defs/finishRequest"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "httpRequest": {
      "type": "object",
      "additionalProperties": false,
