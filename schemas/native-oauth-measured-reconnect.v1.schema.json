{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-oauth-measured-reconnect.v1.schema.json",
  "title": "Explicit native active-family reconnect cold configuration",
  "$comment": "Data-only closed configuration. Runtime requires the retained native browser TLS/key owner, separate family permission, actual signed fence originals, same-account target ID/N+1 sealing and distinct-person activation. Neither initial issuance nor Setup authority selects reconnect.",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "sourceRevision", "authorityRootPublicKey", "authorityRootSpkiSha256", "authorityConfigurationOriginal", "controlPlaneConfigurationDigest", "deploymentId", "instanceId", "limits", "reconnectLimits", "windows", "applications", "recoveryTargets", "callbackOrigin", "portalOrigin", "browserVsockPort"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeOAuthReconnectExchangeConfiguration/v1"},
        "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 128},
        "authorityRootPublicKey": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/bytes32"},
        "authorityRootSpkiSha256": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/digest"},
        "authorityConfigurationOriginal": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/encoded", "maxLength": 1398102},
        "controlPlaneConfigurationDigest": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/digest"},
        "deploymentId": {"type": "string", "minLength": 1, "maxLength": 128},
        "instanceId": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^spiffe://"},
        "limits": {"const": {"pendingCapacity": 64, "revocationCapacity": 64}},
        "reconnectLimits": {
          "type": "object", "additionalProperties": false,
          "required": ["affectedLineageCapacity", "historyCapacity", "authorizationMaxSeconds"],
          "properties": {"affectedLineageCapacity": {"const": 7}, "historyCapacity": {"const": 64}, "authorizationMaxSeconds": {"const": 3600}}
        },
        "windows": {"const": {"contactMaxSeconds": 600, "retentionMaxSeconds": 600, "pendingMaxSeconds": 3600, "operationMaxSeconds": 30, "recoveryMaxSeconds": 30}},
        "applications": {
          "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 2,
          "properties": {"google": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/application"}, "x": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/application"}}
        },
        "recoveryTargets": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/uuid"}},
        "callbackOrigin": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/origin"},
        "portalOrigin": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/origin"},
        "browserVsockPort": {"type": "integer", "minimum": 1024, "maximum": 4294967294}
      },
      "$comment": "Canonical <=2MiB, distinct exact HTTPS origins, sorted recovery targets, independent root and actual configuration verification. Shared references describe only scalar/encrypted application data, never policy or signed authority. Helper identity and actual ingress leaf commitments are supplied only by the native owner. reconnectLimits must match the separate signed reconnect policy; helper messages including encoded originals remain bounded by the existing aggregate 8MiB frame."
    },
    "reconnectBinding": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/reconnectBinding"},
    "statement": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/statement"},
    "evidence": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/evidence"},
    "httpRequest": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/httpRequest"},
    "httpResponse": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/httpResponse"},
    "recoveryOriginalRequest": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/recoveryOriginalRequest"},
    "recoveryOriginalResponse": {"$ref": "oauth-measured-reconnect-authority.v1.schema.json#/$defs/recoveryOriginalResponse"}
  }
}
