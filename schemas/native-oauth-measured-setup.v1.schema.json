{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-oauth-measured-setup.v1.schema.json",
  "title": "Explicit native Setup issuance cold configuration",
  "$comment": "Data-only description, not enrollment or authority. Runtime requires the actual same-owner browser TLS/CA, a separate measured-Setup policy and assignment, original Setup row binding, genuine hardware consent, exact signed writer receipts and unchanged absolute lifetimes. Prior unbound issuance grants never select this purpose.",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "sourceRevision", "authorityRootPublicKey", "authorityRootSpkiSha256", "authorityConfigurationOriginal", "controlPlaneConfigurationDigest", "deploymentId", "instanceId", "limits", "setupLimits", "windows", "applications", "recoveryTargets", "callbackOrigin", "portalOrigin", "browserVsockPort"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeOAuthSetupExchangeConfiguration/v1"},
        "sourceRevision": {"type": "string", "minLength": 1, "maxLength": 256},
        "authorityRootPublicKey": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/bytes32"},
        "authorityRootSpkiSha256": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/digest"},
        "authorityConfigurationOriginal": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/encoded", "maxLength": 1398102},
        "controlPlaneConfigurationDigest": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/digest"},
        "deploymentId": {"type": "string", "minLength": 1, "maxLength": 128},
        "instanceId": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^spiffe://"},
        "limits": {"const": {"pendingCapacity": 64, "revocationCapacity": 64}},
        "setupLimits": {
          "type": "object", "additionalProperties": false,
          "required": ["setupCapacity", "setupMaxSeconds"],
          "properties": {"setupCapacity": {"const": 64}, "setupMaxSeconds": {"type": "integer", "minimum": 300, "maximum": 604800}}
        },
        "windows": {"const": {"contactMaxSeconds": 600, "retentionMaxSeconds": 600, "pendingMaxSeconds": 3600, "operationMaxSeconds": 30, "recoveryMaxSeconds": 30}},
        "applications": {
          "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 2,
          "properties": {"google": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/application"}, "x": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/application"}}
        },
        "recoveryTargets": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/uuid"}},
        "callbackOrigin": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/origin"},
        "portalOrigin": {"$ref": "native-oauth-measured-exchange.v1.schema.json#/$defs/origin"},
        "browserVsockPort": {"type": "integer", "minimum": 1024, "maximum": 4294967294}
      },
      "$comment": "Canonical <=2MiB, distinct exact HTTPS origins, sorted recovery targets, independent root and actual configuration verification. Shared references describe only scalar/encrypted application data, never policy or signed authority. Helper identity and actual ingress leaf commitments are supplied only by the native owner. setupLimits must match the separate signed Setup policy."
    },
    "setupBinding": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/setupBinding"},
    "statement": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/statement"},
    "evidence": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/evidence"},
    "httpRequest": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/httpRequest"},
    "httpResponse": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/httpResponse"},
    "recoveryOriginalRequest": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/recoveryOriginalRequest"},
    "recoveryOriginalResponse": {"$ref": "oauth-measured-setup-authority.v1.schema.json#/$defs/recoveryOriginalResponse"}
  }
}
