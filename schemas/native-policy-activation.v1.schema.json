{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-policy-activation.v1.schema.json",
  "title":"Native READY and independently approved protected activation",
  "$comment":"Data grammar only. No schema, PREPARE response, copied row or HTTP status is authority. The native effect requires the actual independently verified planner/executor/witness transition and persistent effect hold. Full canonical frames remain <=8 MiB; original strings are ASCII JSON without LF, not base64 except authorityConfigurationOriginal. No automatic retry or expiry unlock.",
  "anyOf":[{"$ref":"#/$defs/authorityPolicy"},{"$ref":"#/$defs/intent"},{"$ref":"#/$defs/prepared"},{"$ref":"#/$defs/ready"},{"$ref":"#/$defs/effectHold"},{"$ref":"#/$defs/runtimeResponse"},{"$ref":"#/$defs/httpRequest"},{"$ref":"#/$defs/requestLocator"}],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "approvalId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "canaryId":{"type":"string","minLength":1,"maxLength":256},
    "original":{"type":"string","minLength":2,"maxLength":1048576,"pattern":"^[\\x20-\\x7e]+$"},
    "wholeOriginal":{"type":"string","minLength":2,"maxLength":8388608,"pattern":"^[\\x20-\\x7e]+$"},
    "nullableDigest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},
    "nullableOriginal":{"oneOf":[{"$ref":"#/$defs/original"},{"type":"null"}]},
    "checkpoint":{"$ref":"policy-activation-readiness.v2.schema.json#/$defs/trustCheckpoint"},
    "before":{
      "type":"object","additionalProperties":false,"required":["revision","policySha256","policySequence","rollbackEpoch"],
      "properties":{"revision":{"$ref":"#/$defs/epoch"},"policySha256":{"$ref":"#/$defs/digest"},"policySequence":{"$ref":"#/$defs/epoch"},"rollbackEpoch":{"type":"integer","minimum":0,"maximum":9223372036854775807}}
    },
    "after":{
      "type":"object","additionalProperties":false,"required":["policySha256","policySequence","rollbackEpoch"],
      "properties":{"policySha256":{"$ref":"#/$defs/digest"},"policySequence":{"$ref":"#/$defs/epoch"},"rollbackEpoch":{"type":"integer","minimum":0,"maximum":9223372036854775807}}
    },
    "authorityPolicy":{
      "type":"object","additionalProperties":false,"required":["schema","deploymentId","issuedAtEpochNs","expiresAtEpochNs","maximumActivationNanos","canaries","publicationKeys"],
      "properties":{
        "schema":{"const":"serverware.policyCanaryNativeActivationAuthorityPolicy/v1"},
        "deploymentId":{"type":"string","pattern":"^[A-Za-z0-9._-]{1,128}$"},
        "issuedAtEpochNs":{"$ref":"#/$defs/epoch"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"},
        "maximumActivationNanos":{"type":"integer","minimum":1000000000,"maximum":300000000000},
        "canaries":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{
          "type":"object","additionalProperties":false,"required":["canaryId","assignmentSha256"],
          "properties":{"canaryId":{"$ref":"#/$defs/canaryId"},"assignmentSha256":{"$ref":"#/$defs/digest"}}}},
        "publicationKeys":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{
          "type":"object","additionalProperties":false,"required":["keyId","publicKeyBase64Url"],
          "properties":{"keyId":{"$ref":"#/$defs/digest"},"publicKeyBase64Url":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"}}}}
      },
      "description":"Optional policyCanaryNativeActivationPolicy in the actual signed authority configuration/v6, <=16 KiB and <=24h. Sorted unique canary/key populations, Ed25519 keyId=SPKI SHA, all five independently enabled operations and actual assignment key independence are checked in source. Embedded configuration self-pins are forbidden; the retained full signed configuration is pinned externally."
    },
    "intent":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","activationId","replayId","canaryId","readinessRequestId","readinessResultSha256","readinessCoreSha256","readyStateSha256","generationPublicationEnvelopeSha256","generationId","publicationBefore","publicationAfter","trustCheckpoint","issuedAtUnixNanos","expiresAtUnixNanos"],
      "properties":{
        "apiVersion":{"const":"serverware.nativePolicyActivationIntent/v1"},"activationId":{"$ref":"#/$defs/uuid"},"replayId":{"$ref":"#/$defs/uuid"},
        "canaryId":{"$ref":"#/$defs/canaryId"},"readinessRequestId":{"$ref":"#/$defs/uuid"},
        "readinessResultSha256":{"$ref":"#/$defs/digest"},"readinessCoreSha256":{"$ref":"#/$defs/digest"},"readyStateSha256":{"$ref":"#/$defs/digest"},
        "generationPublicationEnvelopeSha256":{"$ref":"#/$defs/digest"},"generationId":{"$ref":"#/$defs/digest"},
        "publicationBefore":{"$ref":"#/$defs/before"},"publicationAfter":{"$ref":"#/$defs/after"},"trustCheckpoint":{"$ref":"#/$defs/checkpoint"},
        "issuedAtUnixNanos":{"$ref":"#/$defs/epoch"},"expiresAtUnixNanos":{"$ref":"#/$defs/epoch"}
      },
      "description":"Exact15, <=16 KiB. Original complete native readiness time/checkpoint and genuine selected generation-publication revision. New browser request/clock never renews readiness. Actual candidate sequence must advance with nondecreasing rollback epoch."
    },
    "ready":{
      "type":"object","additionalProperties":false,"required":["apiVersion","canaryId","assignmentSha256","previousRevision","previousStateSha256","revision","readinessCoreSha256","readinessResultSha256","expiresAtUnixNanos"],
      "properties":{
        "apiVersion":{"const":"serverware.nativePolicyReadyState/v1"},"canaryId":{"$ref":"#/$defs/canaryId"},"assignmentSha256":{"$ref":"#/$defs/digest"},
        "previousRevision":{"$ref":"#/$defs/epoch"},"previousStateSha256":{"$ref":"#/$defs/digest"},"revision":{"$ref":"#/$defs/epoch"},
        "readinessCoreSha256":{"$ref":"#/$defs/digest"},"readinessResultSha256":{"$ref":"#/$defs/digest"},"expiresAtUnixNanos":{"$ref":"#/$defs/epoch"}
      },"description":"Protected native sidecar, never a Fleet-signed revision. Legacy sealing predecessor stays immutable; native head advances separately."
    },
    "prepared":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","activationId","replayId","canaryId","assignmentSha256","assignmentPayloadSha256","assignmentRevision","authorityKeyIndependenceSha256","generationId","generationPublicationEnvelopeSha256","readyStateSha256","readinessRequestId","readinessResultSha256","readinessCoreSha256","publicationBefore","publicationAfter","trustCheckpoint","approvalOriginal","readinessOriginal","readyOriginal","controlPlaneConfigurationSha256","activationPolicySha256","issuedAtUnixNanos","expiresAtUnixNanos"],
      "properties":{
        "apiVersion":{"const":"serverware.nativePolicyActivationPrepared/v1"},"activationId":{"$ref":"#/$defs/uuid"},"replayId":{"$ref":"#/$defs/uuid"},"canaryId":{"$ref":"#/$defs/canaryId"},
        "assignmentSha256":{"$ref":"#/$defs/digest"},"assignmentPayloadSha256":{"$ref":"#/$defs/digest"},"assignmentRevision":{"$ref":"#/$defs/epoch"},"authorityKeyIndependenceSha256":{"$ref":"#/$defs/digest"},
        "generationId":{"$ref":"#/$defs/digest"},"generationPublicationEnvelopeSha256":{"$ref":"#/$defs/digest"},"readyStateSha256":{"$ref":"#/$defs/digest"},"readinessRequestId":{"$ref":"#/$defs/uuid"},
        "readinessResultSha256":{"$ref":"#/$defs/digest"},"readinessCoreSha256":{"$ref":"#/$defs/digest"},"publicationBefore":{"$ref":"#/$defs/before"},"publicationAfter":{"$ref":"#/$defs/after"},
        "trustCheckpoint":{"$ref":"#/$defs/checkpoint"},"approvalOriginal":{"$ref":"#/$defs/original"},"readinessOriginal":{"$ref":"#/$defs/original","maxLength":262144},"readyOriginal":{"$ref":"#/$defs/original","maxLength":16384},
        "controlPlaneConfigurationSha256":{"$ref":"#/$defs/digest"},"activationPolicySha256":{"$ref":"#/$defs/digest"},"issuedAtUnixNanos":{"$ref":"#/$defs/epoch"},"expiresAtUnixNanos":{"$ref":"#/$defs/epoch"}
      },"description":"Exact24 <=1 MiB. RAW SQL consumed-approval original plus actual result/READY originals. PREPARE alone is not a current-root lease; mandatory actual effect hold and complete independent proof5 are required."
    },
    "effectHold":{
      "type":"object","additionalProperties":false,"required":["scope","phase","canary_id","activation_id","prepared_sha256","prepare_request_digest","configuration_digest","guard_sha256","issued_at_epoch_ns","expires_at_epoch_ns","publication_sha256","finalization_digest"],
      "properties":{
        "scope":{"const":"native-policy-publication"},"phase":{"enum":["held","published"]},"canary_id":{"$ref":"#/$defs/canaryId"},"activation_id":{"$ref":"#/$defs/uuid"},
        "prepared_sha256":{"$ref":"#/$defs/digest"},"prepare_request_digest":{"$ref":"#/$defs/digest"},"configuration_digest":{"$ref":"#/$defs/digest"},"guard_sha256":{"$ref":"#/$defs/digest"},
        "issued_at_epoch_ns":{"$ref":"#/$defs/epoch"},"expires_at_epoch_ns":{"$ref":"#/$defs/epoch"},"publication_sha256":{"$ref":"#/$defs/nullableDigest"},"finalization_digest":{"$ref":"#/$defs/nullableDigest"}
      },"allOf":[{"if":{"properties":{"phase":{"const":"held"}}},"then":{"properties":{"publication_sha256":{"type":"null"},"finalization_digest":{"type":"null"}}},"else":{"properties":{"publication_sha256":{"$ref":"#/$defs/digest"},"finalization_digest":{"$ref":"#/$defs/digest"}}}}]
    },
    "publicApproval":{
      "type":"object","additionalProperties":false,"required":["id","action","resource_id","payload_digest","requester_id","request","status","requested_at","expires_at","approved_by","approved_at","consumed_by","consumed_at","decision_note","approver_webauthn_credential_id"],
      "properties":{
        "id":{"$ref":"#/$defs/approvalId"},"action":{"const":"policy.native.activate"},"resource_id":{"const":"native-policy-activation"},"payload_digest":{"$ref":"#/$defs/digest"},
        "requester_id":{"type":"string","maxLength":512},"request":{"$ref":"#/$defs/intent"},"status":{"enum":["pending","approved","consumed"]},
        "requested_at":{"type":"string"},"expires_at":{"type":"string"},"approved_by":{"type":["string","null"]},"approved_at":{"type":["string","null"]},
        "consumed_by":{"type":["string","null"]},"consumed_at":{"type":["string","null"]},"decision_note":{"type":"null"},"approver_webauthn_credential_id":{"type":["string","null"]}
      }
    },
    "operation":{"enum":["native-policy-activation.request","native-policy-activation.decide","native-policy-activation.consume","native-policy-activation.record-inclusion","native-policy-activation.finalize"]},
    "result":{
      "type":"object","additionalProperties":false,"required":["ok","operation","requestDigest","auditEventDigest","idempotentReplay","approval","preparedOriginal","preparedSha256","readyOriginal"],
      "properties":{"ok":{"const":true},"operation":{"$ref":"#/$defs/operation"},"requestDigest":{"$ref":"#/$defs/digest"},"auditEventDigest":{"$ref":"#/$defs/digest"},"idempotentReplay":{"const":false},
        "approval":{"$ref":"#/$defs/publicApproval"},"preparedOriginal":{"$ref":"#/$defs/nullableOriginal"},"preparedSha256":{"$ref":"#/$defs/nullableDigest"},"readyOriginal":{"$ref":"#/$defs/original","maxLength":16384}}
    },
    "activationOriginals":{
      "type":"object","additionalProperties":false,"required":["signedMeasuredPlanOriginal","executorCompletionOriginal","witnessRequestOriginal","witnessResponseOriginal","nativeEffectHoldOriginal"],
      "properties":{"signedMeasuredPlanOriginal":{"$ref":"#/$defs/wholeOriginal"},"executorCompletionOriginal":{"$ref":"#/$defs/wholeOriginal"},
        "witnessRequestOriginal":{"$ref":"#/$defs/original","maxLength":8192},"witnessResponseOriginal":{"$ref":"#/$defs/original","maxLength":8192},"nativeEffectHoldOriginal":{"$ref":"#/$defs/original"}}
    },
    "runtimeResponse":{
      "type":"object","additionalProperties":false,
      "required":["schema","requestId","operation","configurationDigest","requestDigest","issuedAtEpochNs","deadlineMonotonicNs","fence","result","resultDigest","commitReceiptDigest","witnessCommitDigest","attestationReceiptDigest","attestationConsumptionReceipt","attestationConsumptionReceiptDigest","signature","authorityConfigurationOriginal","activationOriginals"],
      "properties":{
        "schema":{"const":"serverware.policyAuthorityNativeActivationRuntimeResponse/v1"},"requestId":{"$ref":"#/$defs/digest"},"operation":{"const":"native-policy-activation.consume"},
        "configurationDigest":{"$ref":"#/$defs/digest"},"requestDigest":{"$ref":"#/$defs/digest"},"issuedAtEpochNs":{"$ref":"#/$defs/epoch"},"deadlineMonotonicNs":{"$ref":"#/$defs/epoch"},"fence":{"$ref":"#/$defs/epoch"},
        "result":{"$ref":"#/$defs/result"},"resultDigest":{"$ref":"#/$defs/digest"},"commitReceiptDigest":{"$ref":"#/$defs/digest"},"witnessCommitDigest":{"$ref":"#/$defs/digest"},"attestationReceiptDigest":{"$ref":"#/$defs/digest"},
        "attestationConsumptionReceipt":{"$ref":"policy-canary-durable-delivery.v1.schema.json#/$defs/runtimeResponse/properties/attestationConsumptionReceipt"},
        "attestationConsumptionReceiptDigest":{"$ref":"#/$defs/digest"},"signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"},
        "authorityConfigurationOriginal":{"$ref":"policy-canary-durable-delivery.v1.schema.json#/$defs/runtimeResponse/properties/authorityConfigurationOriginal"},"activationOriginals":{"$ref":"#/$defs/activationOriginals"}
      }
    },
    "nativeRequest":{"$ref":"native-policy-activation-custody.v1.schema.json#/$defs/request"},
    "publication":{"$ref":"native-policy-activation-custody.v1.schema.json#/$defs/publication"},
    "phase":{"enum":["request","decide","publish","record-inclusion","finalize"]},
    "mfa":{
      "type":"object","additionalProperties":false,"required":["nativePolicyActivationProfile","assertion"],
      "properties":{"nativePolicyActivationProfile":{"const":"serverware.nativePolicyActivationHttp/v1"},"assertion":{"$ref":"control-plane-publication-approval.v1.schema.json#/$defs/assertion"}}
    },
    "requestLocator":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","actorId","activationId","readinessRequestId","approvalId","argumentsSha256","requestDigest","okForAction","automaticRetryAllowed"],
      "properties":{
        "apiVersion":{"const":"serverware.nativePolicyActivationLocator/v1"},"actorId":{"type":"string","minLength":6,"maxLength":512,"pattern":"^oidc:[^\\u0000-\\u0020\\u007f]+$"},
        "activationId":{"$ref":"#/$defs/uuid"},"readinessRequestId":{"$ref":"#/$defs/uuid"},"approvalId":{"$ref":"#/$defs/approvalId"},
        "argumentsSha256":{"$ref":"#/$defs/digest"},"requestDigest":{"$ref":"#/$defs/digest"},"okForAction":{"const":false},"automaticRetryAllowed":{"const":false}
      },
      "description":"Non-authoritative exact-request navigation hint. The real protected transition derives this same deterministic approvalId from the requestDigest. No row is created, selected or reserved and no challenge or readiness permission is issued. Browser retention contains only IDs/digests, never arguments or assertions; authenticated lookup is still required and absence does not permit retry."
    },
    "httpRequest":{
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["apiVersion","phase","readinessRequestId","generationPublicationEnvelopeSha256"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"phase":{"const":"request"},"readinessRequestId":{"$ref":"#/$defs/uuid"},"generationPublicationEnvelopeSha256":{"$ref":"#/$defs/digest"}}},
        {"type":"object","additionalProperties":false,"required":["apiVersion","phase","approvalId"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"phase":{"enum":["decide","publish","finalize"]},"approvalId":{"$ref":"#/$defs/approvalId"}}},
        {"type":"object","additionalProperties":false,"required":["apiVersion","phase","approvalId","nativeRequest","publicationOriginal"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"phase":{"const":"record-inclusion"},"approvalId":{"$ref":"#/$defs/approvalId"},"nativeRequest":{"$ref":"#/$defs/nativeRequest"},"publicationOriginal":{"$ref":"#/$defs/original","maxLength":32768}}},
        {"type":"object","additionalProperties":false,"required":["apiVersion","approvalId"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"approvalId":{"$ref":"#/$defs/approvalId"}}},
        {"type":"object","additionalProperties":false,"required":["apiVersion","phase","argumentsOriginal"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"phase":{"$ref":"#/$defs/phase"},"argumentsOriginal":{"$ref":"#/$defs/wholeOriginal"}}},
        {"type":"object","additionalProperties":false,"required":["apiVersion","phase","argumentsOriginal","mfa"],"properties":{
          "apiVersion":{"const":"serverware.nativePolicyActivationHttp/v1"},"phase":{"enum":["request","decide","publish"]},"argumentsOriginal":{"$ref":"#/$defs/wholeOriginal"},"mfa":{"$ref":"#/$defs/mfa"}}}
      ],"description":"POST only, exact JSON Content-Type/Content-Length, no query. /draft is data only; /request-locator takes phase=request and exact argumentsOriginal to derive a non-authoritative deterministic approval locator without a write or challenge. /options creates the genuine phase-bound hardware challenge. /request, /decide and /publish require fresh actual hardware. /publish performs protected consume then exactly one native contact, not a replayable preparation export. Receipt record-inclusion and finalize are separate audit-gated protected operations. /lookup is nonactionable and never contacts native."
    }
  }
}
