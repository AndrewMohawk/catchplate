{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-policy-canary-finalization.v1.schema.json",
  "title": "Separately assigned native interval finalization",
  "$ref": "#/$defs/record",
  "$comment": "Closed v3 selection, distinct finalization policy and signature/quote purpose. Full signed statement33 includes required-null seal. Actual admission arm/close and last-Arc census bind the final full ledger snapshot. No legacy heartbeat expiry extension, readiness or activation permission. Original window sealDeadline and all byte/work/storage limits remain enforced.",
  "$defs": {
"seal": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "apiVersion",
      "generationId",
      "coverageStartedAtUnixNanos",
      "windowEndsAtUnixNanos",
      "sealDeadlineUnixNanos",
      "admissionClosedAtUnixNanos",
      "drainedAtUnixNanos",
      "admissionAttempts",
      "pendingAdmissions",
      "liveLifecycles",
      "unfinishedLifecycles",
      "lifecycles"
    ],
    "properties": {
      "apiVersion": {
        "const": "catchplate.nativePolicyShadowDrain/v1"
      },
      "generationId": {
        "$ref": "#/$defs/digest"
      },
      "coverageStartedAtUnixNanos": {
        "$ref": "#/$defs/epoch"
      },
      "windowEndsAtUnixNanos": {
        "$ref": "#/$defs/epoch"
      },
      "sealDeadlineUnixNanos": {
        "$ref": "#/$defs/epoch"
      },
      "admissionClosedAtUnixNanos": {
        "$ref": "#/$defs/epoch"
      },
      "drainedAtUnixNanos": {
        "$ref": "#/$defs/epoch"
      },
      "admissionAttempts": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64
      },
      "pendingAdmissions": {
        "const": 0
      },
      "liveLifecycles": {
        "const": 0
      },
      "unfinishedLifecycles": {
        "const": 0
      },
      "lifecycles": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    }
  },
  "lifecycle": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ingressSequence",
      "requestBindingSha256",
      "requestCommitmentSha256",
      "dispatchAuthorized",
      "observations"
    ],
    "properties": {
      "ingressSequence": {
        "$ref": "#/$defs/epoch"
      },
      "requestBindingSha256": {
        "$ref": "#/$defs/digest"
      },
      "requestCommitmentSha256": {
        "$ref": "#/$defs/digest"
      },
      "dispatchAuthorized": {
        "type": "boolean"
      },
      "observations": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "openingReceiptSha256",
          "terminalReceiptSha256",
          "candidateReceiptSha256",
          "responseReceiptSha256"
        ],
        "properties": {
          "openingReceiptSha256": {
            "$ref": "#/$defs/digest"
          },
          "terminalReceiptSha256": {
            "$ref": "#/$defs/digest"
          },
          "candidateReceiptSha256": {
            "$ref": "#/$defs/digest"
          },
          "responseReceiptSha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/digest"
              }
            ]
          }
        }
      }
    }
  },
    "digest": {
      "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/digest"
    },
    "epoch": {
      "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/epoch"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holderId",
        "bootId",
        "keyId",
        "controlPlaneResponseSigningKeyId",
        "releaseRecordSha256",
        "policyHash",
        "configurationSha256",
        "caCertificateSha256",
        "caPublicKeySpkiSha256",
        "expectedBinaryDigest",
        "expectedPcrs",
        "expectedEif",
        "expectedModuleId",
        "maxAgeSeconds",
        "futureSkewSeconds",
        "instanceId",
        "canaryId",
        "canaryAssignmentSha256",
        "canaryBootId"
      ],
      "properties": {
        "holderId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/holderId"
        },
        "bootId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/bootId"
        },
        "keyId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/keyId"
        },
        "controlPlaneResponseSigningKeyId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/controlPlaneResponseSigningKeyId"
        },
        "releaseRecordSha256": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/releaseRecordSha256"
        },
        "policyHash": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/policyHash"
        },
        "configurationSha256": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/configurationSha256"
        },
        "caCertificateSha256": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/caCertificateSha256"
        },
        "caPublicKeySpkiSha256": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/caPublicKeySpkiSha256"
        },
        "expectedBinaryDigest": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/expectedBinaryDigest"
        },
        "expectedPcrs": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/expectedPcrs"
        },
        "expectedEif": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/expectedEif"
        },
        "expectedModuleId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/expectedModuleId"
        },
        "maxAgeSeconds": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/maxAgeSeconds"
        },
        "futureSkewSeconds": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/futureSkewSeconds"
        },
        "instanceId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/instanceId"
        },
        "canaryId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/canaryId"
        },
        "canaryAssignmentSha256": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/canaryAssignmentSha256"
        },
        "canaryBootId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/assignment/properties/canaryBootId"
        }
      }
    },
    "trustRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "awsNitroRootCertificatesPem",
        "awsNitroCrlsDerBase64url",
        "nitroCertificateProfile"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.policyCanaryFinalizationTrustRoots/v1"
        },
        "awsNitroRootCertificatesPem": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/trustRoots/properties/awsNitroRootCertificatesPem"
        },
        "awsNitroCrlsDerBase64url": {
          "const": []
        },
        "nitroCertificateProfile": {
          "$ref": "credential-currentness-authority.v1.schema.json#/$defs/certificateProfile"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "deploymentId",
        "issuedAtEpochNs",
        "expiresAtEpochNs",
        "operationMaxSeconds",
        "maximumGapNanos",
        "trustRoots",
        "assignments"
      ],
      "properties": {
        "schema": {
          "const": "catchplate.policyCanaryFinalizationAuthorityPolicy/v1"
        },
        "deploymentId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/component"
        },
        "issuedAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "operationMaxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "maximumGapNanos": {
          "type": "integer",
          "minimum": 1000000000,
          "maximum": 60000000000
        },
        "trustRoots": {
          "$ref": "#/$defs/trustRoots"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assignment"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "intakeUrl",
        "deploymentId",
        "instanceId",
        "authorityRootPublicKeyBase64Url",
        "authorityRootSpkiSha256",
        "authorityConfigurationOriginalBase64Url",
        "authorityConfigurationSha256",
        "canaries",
        "recoveryTargets"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeCanaryDurableDelivery/v3"
        },
        "intakeUrl": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/intakeUrl"
        },
        "deploymentId": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/deploymentId"
        },
        "instanceId": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/instanceId"
        },
        "authorityRootPublicKeyBase64Url": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/authorityRootPublicKeyBase64Url"
        },
        "authorityRootSpkiSha256": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/authorityRootSpkiSha256"
        },
        "authorityConfigurationOriginalBase64Url": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/authorityConfigurationOriginalBase64Url"
        },
        "authorityConfigurationSha256": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/authorityConfigurationSha256"
        },
        "canaries": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/canaries"
        },
        "recoveryTargets": {
          "$ref": "native-policy-canary-durable-delivery.v1.schema.json#/$defs/configuration/properties/recoveryTargets"
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "deploymentId",
        "instanceId",
        "holderId",
        "keyId",
        "controlPlaneResponseSigningKeyId",
        "policyHash",
        "dataPlaneBinarySha256",
        "purposeAssignmentSha256",
        "canaryAssignmentSha256",
        "canaryBootId",
        "assignmentPayloadSha256",
        "loadReceiptSha256",
        "publicationSha256",
        "generationId",
        "runtimeIdentitySha256",
        "previousHeartbeatSha256",
        "baselineHeadSha256",
        "headSha256",
        "bootId",
        "nonce",
        "canaryId",
        "heartbeatSequence",
        "baselineEventOrdinal",
        "eventOrdinal",
        "originalCount",
        "lastIngressSequence",
        "openingReceiptSha256",
        "observedAtUnixNanos",
        "issuedAtEpochNs",
        "expiresAtEpochNs",
        "seal"
      ],
      "properties": {
        "seal": {"oneOf": [{"type":"null"},{"$ref":"#/$defs/seal"}]},
        "apiVersion": {
          "const": "catchplate.nativePolicyShadowHeartbeatStatement/v2"
        },
        "purpose": {
          "const": "native-policy-shadow-finalization"
        },
        "deploymentId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/component"
        },
        "instanceId": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/component"
        },
        "holderId": {
          "$ref": "#/$defs/digest"
        },
        "keyId": {
          "$ref": "#/$defs/digest"
        },
        "controlPlaneResponseSigningKeyId": {
          "$ref": "#/$defs/digest"
        },
        "policyHash": {
          "$ref": "#/$defs/digest"
        },
        "dataPlaneBinarySha256": {
          "$ref": "#/$defs/digest"
        },
        "purposeAssignmentSha256": {
          "$ref": "#/$defs/digest"
        },
        "canaryAssignmentSha256": {
          "$ref": "#/$defs/digest"
        },
        "canaryBootId": {
          "$ref": "#/$defs/digest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/digest"
        },
        "loadReceiptSha256": {
          "$ref": "#/$defs/digest"
        },
        "publicationSha256": {
          "$ref": "#/$defs/digest"
        },
        "generationId": {
          "$ref": "#/$defs/digest"
        },
        "runtimeIdentitySha256": {
          "$ref": "#/$defs/digest"
        },
        "previousHeartbeatSha256": {
          "$ref": "#/$defs/digest"
        },
        "baselineHeadSha256": {
          "$ref": "#/$defs/digest"
        },
        "headSha256": {
          "$ref": "#/$defs/digest"
        },
        "bootId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "canaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "heartbeatSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "baselineEventOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "eventOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "originalCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "lastIngressSequence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/epoch"
            }
          ]
        },
        "openingReceiptSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "observedAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "issuedAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtEpochNs": {
          "$ref": "#/$defs/epoch"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "signature",
        "nativeKeyEvidence"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/statement"
        },
        "signature": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
        },
        "nativeKeyEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiVersion",
            "responseProofPublicKey",
            "attestationDocumentB64"
          ],
          "properties": {
            "apiVersion": {
              "const": "catchplate.nativeResponseProofKeyEvidence/v1"
            },
            "responseProofPublicKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            },
            "attestationDocumentB64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "canary_id",
        "instance_id",
        "boot_id",
        "assignment_envelope_digest",
        "assignment_payload_digest",
        "load_receipt_envelope_digest",
        "publication_envelope_digest",
        "evidence"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativePolicyShadowHeartbeat/v2"
        },
        "canary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instance_id": {
          "$ref": "policy-canary-controlled-evidence.v1.schema.json#/$defs/component"
        },
        "boot_id": {
          "$ref": "#/$defs/digest"
        },
        "assignment_envelope_digest": {
          "$ref": "#/$defs/digest"
        },
        "assignment_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "load_receipt_envelope_digest": {
          "$ref": "#/$defs/digest"
        },
        "publication_envelope_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "coverage",
        "recordSha256",
        "generationId",
        "heartbeatSequence",
        "eventOrdinal",
        "headSha256",
        "observedAtUnixNanos",
        "okForAction"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativePolicyShadowHeartbeat/v2"
        },
        "coverage": {
          "const": "native-finalization-heartbeat-only"
        },
        "recordSha256": {
          "$ref": "#/$defs/digest"
        },
        "generationId": {
          "$ref": "#/$defs/digest"
        },
        "heartbeatSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "eventOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "headSha256": {
          "$ref": "#/$defs/digest"
        },
        "observedAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "okForAction": {
          "const": false
        }
      }
    }
  }
}
