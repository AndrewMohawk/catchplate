{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-protected-request-commitment.v1.schema.json",
  "$ref":"#/$defs/protectedRequest",
  "description":"Actual signed later native computation, embedded only in nativeRequestObservationOriginal/v3. The original six v2 fields are unchanged; protectedRequest is its seventh field. The complete observation still fits 8192 bytes, 512 nodes and depth 32. This is not early sampling, readiness or an effect capability.",
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "positive":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "protectedRequest":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","openingReceiptSha256","samplingCommitmentSha256","computationOriginal"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeProtectedRequestCommitment/v1"},
        "openingReceiptSha256":{"$ref":"#/$defs/sha"},
        "samplingCommitmentSha256":{"$ref":"#/$defs/sha"},
        "computationOriginal":{"$ref":"#/$defs/computation"}
      }
    },
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","kind","canonicalBytesBase64","canonicalBytesLength","canonicalBytesSha256","artifactSha256"],
      "properties":{
        "apiVersion":{"const":"serverware.policyCustodyProductionDispatch/v4"},
        "kind":{"enum":["protected-request-facts","request-commitment-context","request-commitment"]},
        "canonicalBytesBase64":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","maxLength":10923},
        "canonicalBytesLength":{"type":"integer","minimum":1,"maximum":8192},
        "canonicalBytesSha256":{"$ref":"#/$defs/sha"},"artifactSha256":{"$ref":"#/$defs/sha"}
      },
      "description":"Existing exact canonical ASCII artifact bytes. Source-fixed consumer validates the decoded closed facts12/context5/commitment10 shapes, exact byte length/hash, unchanged framed artifact hash and correct selected kind; base64 is not an authority boundary."
    },
    "binding":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","operation","operationIdSha256","requestSha256","durableRequestSha256","terminationFenceSha256","productionConfigurationBindingSha256","kernelDriverIdentitySha256","retainedDescriptorSetSha256","driverGenerationReceiptSha256","openedAtBoottimeNanos","operationDeadlineBoottimeNanos","cleanupDeadlineBoottimeNanos","replayIdSha256","bindingSha256"],
      "properties":{
        "apiVersion":{"const":"serverware.policyCustodyProductionDispatch/v4"},"operation":{"const":"commit-request"},
        "operationIdSha256":{"$ref":"#/$defs/sha"},"requestSha256":{"$ref":"#/$defs/sha"},
        "durableRequestSha256":{"$ref":"#/$defs/sha"},"terminationFenceSha256":{"$ref":"#/$defs/sha"},
        "productionConfigurationBindingSha256":{"$ref":"#/$defs/sha"},"kernelDriverIdentitySha256":{"$ref":"#/$defs/sha"},
        "retainedDescriptorSetSha256":{"$ref":"#/$defs/sha"},"driverGenerationReceiptSha256":{"$ref":"#/$defs/sha"},
        "openedAtBoottimeNanos":{"$ref":"#/$defs/positive"},"operationDeadlineBoottimeNanos":{"$ref":"#/$defs/positive"},
        "cleanupDeadlineBoottimeNanos":{"$ref":"#/$defs/positive"},"replayIdSha256":{"$ref":"#/$defs/sha"},
        "bindingSha256":{"$ref":"#/$defs/sha"}
      }
    },
    "request":{
      "type":"object","additionalProperties":false,"required":["operation","body"],
      "properties":{
        "operation":{"const":"commit-request"},
        "body":{
          "type":"object","additionalProperties":false,"required":["binding","facts","context"],
          "properties":{
            "binding":{"$ref":"#/$defs/binding"},
            "facts":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"kind":{"const":"protected-request-facts"}}}]},
            "context":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"kind":{"const":"request-commitment-context"}}}]}
          }
        }
      }
    },
    "result":{
      "type":"object","additionalProperties":false,"required":["outcome","body"],
      "properties":{
        "outcome":{"const":"artifact"},
        "body":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"kind":{"const":"request-commitment"}}}]}
      }
    },
    "computation":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","nativeGrantSha256","request","result","resultSha256","computedAtBoottimeNanos","signatureBase64url"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowCommitRequestComputation/v1"},
        "nativeGrantSha256":{"$ref":"#/$defs/sha"},"request":{"$ref":"#/$defs/request"},
        "result":{"$ref":"#/$defs/result"},"resultSha256":{"$ref":"#/$defs/sha"},
        "computedAtBoottimeNanos":{"$ref":"#/$defs/positive"},
        "signatureBase64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"}
      },
      "description":"Unchanged nativeShadowCommitRequestComputation.signature/v1 domain over the canonical six-element ordered tuple excluding signature. Existing serverware-signature-v1 NUL plus u64 length-framed domain and payload, not a Fleet envelope or Ledger spill signature. Exact current native Ledger key and original assignment/window/configuration are independently checked."
    }
  }
}
