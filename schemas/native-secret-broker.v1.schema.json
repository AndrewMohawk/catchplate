{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-secret-broker.v1.schema.json",
  "title": "Native non-exporting secret broker cold configuration and ciphertext transport",
  "$comment": "Schema validation is not release/KMS/currentness admission. Source enforces canonical ASCII private frames, original monotonic deadlines, exact byte bounds, independently assigned full KEK pin, actual measured identity and sealed image/loop/mount ownership. Paths and ciphertext do not grant authority. No plaintext/key-return RPC exists.",
  "oneOf": [{"$ref": "#/$defs/configuration"}, {"$ref": "#/$defs/parentConfiguration"}, {"$ref": "#/$defs/kmsRequestEnvelope"}, {"$ref": "#/$defs/kmsCiphertext"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "port": {"type": "integer", "minimum": 1024, "maximum": 4294967294},
    "text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\u0000-\u001f\u007f]+$"},
    "kmsKey": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\u0000-\u001f\u007f]+$"},
    "context": {
      "$comment": "Source additionally caps canonical context bytes at 8192 and each UTF8 key/value at 1024 bytes.",
      "type": "object", "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/text"}, "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kmsParentPort", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "kekSha256", "secretKekId", "helperImage"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeSecretBrokerConfiguration/v1"},
        "kmsParentPort": {"$ref": "#/$defs/port"}, "kmsKeyId": {"$ref": "#/$defs/kmsKey"},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha"}, "encryptionContext": {"$ref": "#/$defs/context"},
        "kekSha256": {"$ref": "#/$defs/sha"},
        "secretKekId": {"type": "string", "pattern": "^attested-memory-kek:[0-9a-f]{24}$", "$comment": "Must equal the first24 hex characters of the independently assigned full KEK digest."},
        "helperImage": {"$ref": "#/$defs/image"}
      }
    },
    "image": {
      "$comment": "Copy <=512MiB exact source image into actual owned memfd, verify full hash, apply/read all four immutable seals, configure readonly autoclear loop at offset0/full length, retain detached readonly SquashFS root. Fixed actual ELF /usr/local/bin/python3.11 and helper /opt/catchplate/catchplate/native_secret_broker_helper.py are separately pinned. Entire image contains their loader/DSO/stdlib/package closure; no fs-verity-on-initramfs assumption.",
      "type": "object", "additionalProperties": false,
      "required": ["profile", "imagePath", "imageSha256", "interpreterSha256", "helperSha256"],
      "properties": {
        "profile": {"const": "sealed-memfd-squashfs-v1"},
        "imagePath": {"const": "/opt/catchplate/native-broker-runtime.squashfs"},
        "imageSha256": {"$ref": "#/$defs/sha"}, "interpreterSha256": {"$ref": "#/$defs/sha"}, "helperSha256": {"$ref": "#/$defs/sha"}
      }
    },
    "parentConfiguration": {
      "$comment": "Parent routing configuration only, canonical ASCII <=32768 bytes. Fixed /usr/local/bin/aws executable. No parent output is verification authority.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "enclaveCid", "port", "kmsKeyId", "ciphertextBlob", "encryptionContext", "region"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeBrokerKmsParent/v1"},
        "enclaveCid": {"type": "integer", "minimum": 4, "maximum": 4294967294}, "port": {"$ref": "#/$defs/port"},
        "kmsKeyId": {"$ref": "#/$defs/kmsKey"},
        "ciphertextBlob": {"type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$"},
        "encryptionContext": {"$ref": "#/$defs/context"},
        "region": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]}
      }
    },
    "kmsRequest": {
      "$comment": "Exact canonical request original is SHA256-bound in actual native role6 NSM user data with real generated RSA public key and random nonce. Neither request labels nor unverified document grant KMS release.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "material", "configurationSha256", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "recipientPublicKeySha256", "nonce", "deadlineBoottimeNs"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeBrokerKmsRecipientRequest/v1"}, "material": {"const": "broker-kek"},
        "configurationSha256": {"$ref": "#/$defs/sha"}, "kmsKeyId": {"$ref": "#/$defs/kmsKey"},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha"}, "encryptionContext": {"$ref": "#/$defs/context"},
        "recipientPublicKeySha256": {"$ref": "#/$defs/sha"},
        "nonce": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$"},
        "deadlineBoottimeNs": {"$ref": "#/$defs/u64"}
      }
    },
    "kmsRequestEnvelope": {
      "$comment": "Canonical ASCII <=32768 bytes, four-byte big-endian length prefix on fixed parent CID3. Parent uses its own bounded contact clock because VM boottime origins differ; it cannot renew the retained gate deadline.",
      "type": "object", "additionalProperties": false, "required": ["request", "requestSha256", "attestationDocument"],
      "properties": {
        "request": {"$ref": "#/$defs/kmsRequest"}, "requestSha256": {"$ref": "#/$defs/sha"},
        "attestationDocument": {"type": "string", "minLength": 1, "maxLength": 21846, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    },
    "kmsCiphertext": {
      "$comment": "Canonical ASCII <=96KiB, ciphertext <=64KiB decoded, no plaintext/secret fields. Actual helper independently checks recovered KEK against full cold commitment.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "requestSha256", "ciphertextForRecipient", "ciphertextSha256"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeBrokerKmsRecipientCiphertext/v1"}, "requestSha256": {"$ref": "#/$defs/sha"},
        "ciphertextForRecipient": {"type": "string", "minLength": 1, "maxLength": 87382, "pattern": "^[A-Za-z0-9_-]+$"},
        "ciphertextSha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
