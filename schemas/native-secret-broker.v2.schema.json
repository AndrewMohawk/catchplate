{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-secret-broker.v2.schema.json",
  "title": "Explicit historical native broker inventory and ciphertext parent",
  "$comment": "The full canonical inventory is admitted before the first contact. Source enforces sorted unique full KEK digests and IDs, exact native original, blob/context/key correspondence and one original lifetime. Key custody is not permission to decrypt; only an actual definite MATERIAL-CLAIM owner selects a historical key. No plaintext parent exchange or generic decrypt endpoint exists. Broker/v1 is unchanged.",
  "oneOf": [{"$ref": "#/$defs/configuration"}, {"$ref": "#/$defs/parentConfiguration"}, {"$ref": "#/$defs/requestEnvelope"}, {"$ref": "#/$defs/ciphertext"}],
  "$defs": {
    "sha": {"$ref": "native-secret-broker.v1.schema.json#/$defs/sha"},
    "encoded": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$"},
    "keyAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "kekSha256", "secretKekId"],
      "properties": {
        "kmsKeyId": {"$ref": "native-secret-broker.v1.schema.json#/$defs/kmsKey"},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha"},
        "encryptionContext": {"$ref": "native-secret-broker.v1.schema.json#/$defs/context"},
        "kekSha256": {"$ref": "#/$defs/sha"},
        "secretKekId": {"type": "string", "pattern": "^attested-memory-kek:[0-9a-f]{24}$"}
      }
    },
    "configuration": {
      "$comment": "Exact9 canonical ASCII <=262144 bytes. Historical list sorted by full kekSha256, excludes current, and has unique full digests and derived IDs. A shared historical key is selected by its exact commitment, never an ID-only or current-key alias.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kmsParentPort", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "kekSha256", "secretKekId", "helperImage", "historicalKeys"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeSecretBrokerConfiguration/v2"},
        "kmsParentPort": {"$ref": "native-secret-broker.v1.schema.json#/$defs/port"},
        "kmsKeyId": {"$ref": "native-secret-broker.v1.schema.json#/$defs/kmsKey"},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha"},
        "encryptionContext": {"$ref": "native-secret-broker.v1.schema.json#/$defs/context"},
        "kekSha256": {"$ref": "#/$defs/sha"},
        "secretKekId": {"type": "string", "pattern": "^attested-memory-kek:[0-9a-f]{24}$"},
        "helperImage": {"$ref": "native-secret-broker.v1.schema.json#/$defs/image"},
        "historicalKeys": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/keyAssignment"}}
      }
    },
    "parentConfiguration": {
      "$comment": "Protected root-owned original <=524288 bytes; nativeConfigurationOriginal is canonical v2 <=262144 decoded. Keys include current plus every historical key, sorted by full commitment, each exact KMS ciphertext digest. The selected enclave CID and native port are fixed; no incoming endpoint override.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "nativeConfigurationOriginal", "enclaveCid", "region", "keys"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeHistoricalBrokerKmsParent/v1"},
        "nativeConfigurationOriginal": {"$ref": "#/$defs/encoded", "maxLength": 349526},
        "enclaveCid": {"type": "integer", "minimum": 4, "maximum": 4294967294},
        "region": {"$ref": "native-secret-broker.v1.schema.json#/$defs/parentConfiguration/properties/region"},
        "keys": {"type": "array", "minItems": 1, "maxItems": 17, "items": {
          "type": "object", "additionalProperties": false, "required": ["kekSha256", "ciphertextBlob"],
          "properties": {"kekSha256": {"$ref": "#/$defs/sha"}, "ciphertextBlob": {"$ref": "#/$defs/encoded", "maxLength": 8192}}
        }}
      }
    },
    "request": {
      "$comment": "Exact11 actual helper-only RSA recipient, nonce and full request SHA are bound in role7 NSM user data. Actual KMS authenticates the NSM and independently configured release policy. Native and helper retain the full v2 original; a host correspondence check is not TEE verification.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "material", "configurationSha256", "kmsKeyId", "ciphertextBlobSha256", "encryptionContext", "kekSha256", "secretKekId", "recipientPublicKeySha256", "nonce", "deadlineBoottimeNs"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeHistoricalBrokerKmsRecipientRequest/v1"},
        "material": {"const": "historical-broker-kek"}, "configurationSha256": {"$ref": "#/$defs/sha"},
        "kmsKeyId": {"$ref": "native-secret-broker.v1.schema.json#/$defs/kmsKey"},
        "ciphertextBlobSha256": {"$ref": "#/$defs/sha"}, "encryptionContext": {"$ref": "native-secret-broker.v1.schema.json#/$defs/context"},
        "kekSha256": {"$ref": "#/$defs/sha"}, "secretKekId": {"$ref": "#/$defs/keyAssignment/properties/secretKekId"},
        "recipientPublicKeySha256": {"$ref": "#/$defs/sha"},
        "nonce": {"$ref": "native-secret-broker.v1.schema.json#/$defs/kmsRequest/properties/nonce"},
        "deadlineBoottimeNs": {"$ref": "native-secret-broker.v1.schema.json#/$defs/u64"}
      }
    },
    "requestEnvelope": {
      "$comment": "Whole canonical envelope <=32768 bytes; actual ordered primary request retains its v1 wire but commits full v2 configuration. It must precede all historical requests. One fixed parent connection per key, no retry after uncertainty.",
      "type": "object", "additionalProperties": false, "required": ["request", "requestSha256", "attestationDocument"],
      "properties": {
        "request": {"oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "native-secret-broker.v1.schema.json#/$defs/kmsRequest"}]},
        "requestSha256": {"$ref": "#/$defs/sha"},
        "attestationDocument": {"$ref": "#/$defs/encoded", "maxLength": 21846}
      }
    },
    "ciphertext": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "requestSha256", "ciphertextForRecipient", "ciphertextSha256"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.nativeBrokerKmsRecipientCiphertext/v1", "catchplate.nativeHistoricalBrokerKmsRecipientCiphertext/v1"]},
        "requestSha256": {"$ref": "#/$defs/sha"},
        "ciphertextForRecipient": {"$ref": "#/$defs/encoded", "maxLength": 87382},
        "ciphertextSha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
