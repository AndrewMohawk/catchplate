{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-shadow-activation-receiver.v1.schema.json",
  "title": "Service-enclave activation connection acquisition",
  "$ref": "#/$defs/configuration",
  "$comment": "Acquisition only, not authorization. A receiver running inside the service enclave retains one actual parent-CID-3 connection on port 9102 and its journal directory. Its public BE32-framed observation precedes independent signing of existing C9/service originals. One canonical BE32-framed completion followed by EOF selects those exact originals. Existing signatures, NSM, keys, journal and signed time windows remain authoritative. No cross-kernel descriptor transfer or host-as-enclave claim.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ns": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "uint64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "positiveUint64": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "configuration": {
      "oneOf": [ { "$ref": "#/$defs/configurationV1" }, { "$ref": "#/$defs/configurationV2" } ]
    },
    "configurationV1": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "deliveryConfiguration"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverConfiguration/v1" },
        "deliveryConfiguration": { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/pin" }
      }
    },
    "configurationV2": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "deliveryConfiguration", "installationAuthority"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverConfiguration/v2" },
        "deliveryConfiguration": { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/pin" },
        "installationAuthority": { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/authority" }
      },
      "$comment": "Explicit new delegation of the exact independently pinned C9 public key to sign a purpose-fixed public installation capsule. The installation authority must equal deliveryConfiguration.authority. Cold v1 never grants installation permission. Neither this delegation nor installation replaces native C9/service/key/NSM admission."
    },
    "imageInputs": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "sourceManifestSha256", "receiverConfigurationSha256", "deliveryConfigurationSha256"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeActivationReceiverImageInputs/v1" },
        "sourceManifestSha256": { "$ref": "#/$defs/sha256" },
        "receiverConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "deliveryConfigurationSha256": { "$ref": "#/$defs/sha256" }
      },
      "$comment": "Explicit artifact-only build input. The input directory contains exactly inputs.json (this canonical document, no trailing LF), receiver.json and delivery-configuration.json. The receiver delivery pin must target /etc/serverware/native-activation-delivery.json and match the literal delivery configuration bytes. Zero digests are refused. No signed delivery, service assignment, launch, keys or journal state is packaged; the external enclave launcher must provide real inherited resources and late originals."
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "observationSha256", "launchSha256"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverCompletion/v1" },
        "observationSha256": { "$ref": "#/$defs/sha256" },
        "launchSha256": { "$ref": "#/$defs/sha256" }
      },
      "$comment": "SHA256 values bind literal canonical observation and retained native launch bytes. Payload length is 1..1024 bytes. Completion grants no authority and cannot extend the independently signed C9 startup or lifetime deadlines."
    },
    "completionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "installation"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverCompletion/v2" },
        "installation": {
          "type": "object", "additionalProperties": false,
          "required": ["payload", "signature"],
          "properties": {
            "payload": { "$ref": "#/$defs/installationPayload" },
            "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
          }
        }
      },
      "$comment": "At most 1 MiB of exact canonical bytes, BE32 framed and followed by EOF. Requires explicit cold-v2 installation delegation and a valid purpose-fixed installation signature before any filesystem write. Existing cold-v1 completion semantics are unchanged."
    },
    "installationPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "configurationSha256", "deliveryConfigurationSha256", "observationSha256", "launchSha256", "issuedAtBoottimeNs", "startupDeadlineBoottimeNs", "files"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverInstallation/v1" },
        "purpose": { "const": "install-activation-public-originals" },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "deliveryConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "observationSha256": { "$ref": "#/$defs/sha256" },
        "launchSha256": { "$ref": "#/$defs/sha256" },
        "issuedAtBoottimeNs": { "$ref": "#/$defs/ns" },
        "startupDeadlineBoottimeNs": { "$ref": "#/$defs/ns" },
        "files": { "type": "array", "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/installationFile" } }
      },
      "$comment": "Signature domain serverware.nativeShadowActivationReceiverInstallation.signature/v1. Exactly the fixed unique 13-file roster; decoded originals total at most 720 KiB, each intersected with its downstream parser limit and at most 512 KiB. Issuance equals the retained observation timestamp; startup is at most 30 seconds later and must still be future on the actual enclave clock. Both must equal the genuine C9 interval. The installer never writes cold inputs, credential originals, binaries, helpers, images or journal state."
    },
    "installationFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "originalBase64url"],
      "properties": {
        "path": { "enum": [
          "/etc/serverware/native-shadow-guest-launch.json", "/etc/serverware/native-shadow-public-exchange.json",
          "/etc/serverware/native-activation-inputs/delivery.json", "/etc/serverware/native-activation-inputs/runtime.json",
          "/etc/serverware/native-activation-inputs/trust.json", "/etc/serverware/native-activation-inputs/time-bootstrap.json",
          "/etc/serverware/native-activation-inputs/assignment.json", "/etc/serverware/native-activation-inputs/closure.json",
          "/etc/serverware/native-activation-inputs/keys.json", "/etc/serverware/native-activation-inputs/encrypted-keys.json",
          "/etc/serverware/native-activation-inputs/admission.json", "/etc/serverware/native-activation-inputs/activation.json",
          "/etc/serverware/native-activation-inputs/activation-authority.json"
        ] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "originalBase64url": { "type": "string", "minLength": 2, "maxLength": 699051, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "okForAction", "configurationSha256", "deliveryConfigurationSha256", "processId", "processStartTicks", "processPidfdInode", "bootIdBase64url", "timeNamespaceDevice", "timeNamespaceInode", "observedAtBoottimeNs", "localCid", "localPort", "peerCid", "peerPort", "activation"],
      "properties": {
        "apiVersion": { "const": "serverware.nativeShadowActivationReceiverObservation/v1" },
        "okForAction": { "const": false },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "deliveryConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "processId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "processStartTicks": { "$ref": "#/$defs/positiveUint64" },
        "processPidfdInode": { "$ref": "#/$defs/positiveUint64" },
        "bootIdBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
        "timeNamespaceDevice": { "$ref": "#/$defs/positiveUint64" },
        "timeNamespaceInode": { "$ref": "#/$defs/positiveUint64" },
        "observedAtBoottimeNs": { "$ref": "#/$defs/ns" },
        "localCid": { "type": "integer", "minimum": 4, "maximum": 4294967294 },
        "localPort": { "const": 9102 },
        "peerCid": { "const": 3 },
        "peerPort": { "type": "integer", "minimum": 1024, "maximum": 4294967294 },
        "activation": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            { "allOf": [
              { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/activation" },
              { "properties": { "name": { "const": "activation-channel" }, "fd": { "const": 6 } } }
            ] },
            { "allOf": [
              { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/activation" },
              { "properties": { "name": { "const": "activation-journal" }, "fd": { "const": 7 } } }
            ] }
          ],
          "items": false
        }
      },
      "$comment": "Public-only projection of retained real process, clock domain, socket and journal identities; 1..8192 canonical bytes. C9 issuance must not predate observedAtBoottimeNs. FD numbers are future child slots, not host descriptors to transfer into the enclave."
    }
  }
}
