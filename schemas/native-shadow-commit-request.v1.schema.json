{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-shadow-commit-request.v1.schema.json",
  "$ref": "#/$defs/launch",
  "$defs": {
    "sha": {
      "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/sha256"
    },
    "signature": {
      "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/signature"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "u64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "pin": {
      "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/pin"
    },
    "peer": {
      "$ref": "native-shadow-retrieval-service.v1.schema.json#/$defs/peer"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "spiffeId",
        "bootIdSha256",
        "teePlatform",
        "teeEvidenceSha256",
        "teeMeasurementSha256",
        "teeAttestationKeyId",
        "teeAttestationKeySpkiSha256",
        "ingressSigningKeyId",
        "ingressSigningKeySpkiSha256",
        "activeDecisionSigningKeyId",
        "activeDecisionSigningKeySpkiSha256",
        "shadowSigningKeyId",
        "shadowSigningKeySpkiSha256"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "spiffeId": {
          "type": "string",
          "pattern": "^spiffe://"
        },
        "bootIdSha256": {
          "$ref": "#/$defs/sha"
        },
        "teePlatform": {
          "enum": [
            "aws-nitro-enclave",
            "amd-sev-snp",
            "intel-tdx"
          ]
        },
        "teeEvidenceSha256": {
          "$ref": "#/$defs/sha"
        },
        "teeMeasurementSha256": {
          "$ref": "#/$defs/sha"
        },
        "teeAttestationKeyId": {
          "$ref": "#/$defs/sha"
        },
        "teeAttestationKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "ingressSigningKeyId": {
          "$ref": "#/$defs/sha"
        },
        "ingressSigningKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "activeDecisionSigningKeyId": {
          "$ref": "#/$defs/sha"
        },
        "activeDecisionSigningKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "shadowSigningKeyId": {
          "$ref": "#/$defs/sha"
        },
        "shadowSigningKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionConfigurationBindingSha256",
        "kernelDriverIdentitySha256",
        "retainedDescriptorSetSha256",
        "driverGenerationReceiptSha256",
        "assignmentPayloadSha256",
        "assignmentRevision",
        "runtime",
        "requestCommitmentKeyId",
        "requestCommitmentKeyEpoch",
        "issuedAtBoottimeNanos",
        "expiresAtBoottimeNanos"
      ],
      "properties": {
        "productionConfigurationBindingSha256": {
          "$ref": "#/$defs/sha"
        },
        "kernelDriverIdentitySha256": {
          "$ref": "#/$defs/sha"
        },
        "retainedDescriptorSetSha256": {
          "$ref": "#/$defs/sha"
        },
        "driverGenerationReceiptSha256": {
          "$ref": "#/$defs/sha"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "assignmentRevision": {
          "$ref": "#/$defs/u64"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "requestCommitmentKeyId": {
          "$ref": "#/$defs/sha"
        },
        "requestCommitmentKeyEpoch": {
          "$ref": "#/$defs/epoch"
        },
        "issuedAtBoottimeNanos": {
          "$ref": "#/$defs/u64"
        },
        "expiresAtBoottimeNanos": {
          "$ref": "#/$defs/u64"
        }
      },
      "description": "An independently authorized operation context, never an attested driver constructor. The actual owner verifies the entire request binding and original interval."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "assignmentPayloadSha256",
        "keyAuthorizationSha256",
        "trustCheckpointId",
        "revocationGeneration",
        "revocationRootSha256",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos",
        "signingKeyId",
        "signingKeySpkiSha256",
        "scope",
        "expectedPeer"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowCommitRequestServiceAssignment/v1"
        },
        "purpose": {
          "const": "native-shadow-ledger-commit-request"
        },
        "guest": {
          "$ref": "native-custody-closure.v1.schema.json#/$defs/guest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "trustCheckpointId": {
          "$ref": "#/$defs/sha"
        },
        "revocationGeneration": {
          "$ref": "#/$defs/u64"
        },
        "revocationRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "issuedAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "signingKeyId": {
          "$ref": "#/$defs/sha"
        },
        "signingKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "expectedPeer": {
          "$ref": "#/$defs/peer"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "keyAdmission",
        "commitRequest"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowCommitRequestGuestLaunch/v1"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "commitRequest": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "keyAdmission",
        "trustedTime"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeProofBridgeLaunch/v2"
        },
        "keyAdmission": {
          "$ref": "native-shadow-guest-admission.v1.schema.json#/$defs/launch"
        },
        "trustedTime": {
          "$ref": "#/$defs/pin"
        }
      }
    },
    "role": {
      "enum": [
        "durable-recovery-store",
        "current-signature-authority"
      ]
    },
    "servicePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "serviceRole",
        "guest",
        "runtimeConfigurationSha256",
        "authorityHistoryManifestSha256",
        "scope",
        "nativeGrantSha256",
        "nativeLedgerKeyId",
        "nativeLedgerKeySpkiSha256",
        "nativeLedgerPublicKeyBase64url",
        "initialHeadSha256"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.custodyCommitRequestServiceGrant/v1"
        },
        "purpose": {
          "const": "commit-request-service-transition"
        },
        "serviceRole": {
          "$ref": "#/$defs/role"
        },
        "guest": {
          "$ref": "native-custody-closure.v1.schema.json#/$defs/guest"
        },
        "runtimeConfigurationSha256": {
          "$ref": "#/$defs/sha"
        },
        "authorityHistoryManifestSha256": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "nativeGrantSha256": {
          "$ref": "#/$defs/sha"
        },
        "nativeLedgerKeyId": {
          "$ref": "#/$defs/sha"
        },
        "nativeLedgerKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "nativeLedgerPublicKeyBase64url": {
          "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/bytes32"
        },
        "initialHeadSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "serviceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signatureBase64url"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/servicePayload"
        },
        "signatureBase64url": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "serviceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantFdName"
      ],
      "properties": {
        "grantFdName": {
          "const": "dispatch-grant"
        }
      }
    },
    "ordinaryLaunch": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","deliveryConfiguration","delivery"],
      "properties":{"apiVersion":{"const":"catchplate.custodyOrdinaryServiceGuestLaunch/v3"},
        "deliveryConfiguration":{"$ref":"#/$defs/pin"},"delivery":{"$ref":"#/$defs/pin"}}
    },
    "inspectedOrdinaryLaunch": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","deliveryConfiguration","delivery","peerInspectionCredential"],
      "properties":{"apiVersion":{"const":"catchplate.custodyOrdinaryServiceGuestLaunch/v4"},
        "deliveryConfiguration":{"$ref":"#/$defs/pin"},"delivery":{"$ref":"#/$defs/pin"},
        "peerInspectionCredential":{"const":"peer-inspection-policy"}}
    },
    "bridgeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "serviceGrantOriginals"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeCommitRequestServices/v1"
        },
        "serviceGrantOriginals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durable-recovery-store",
            "current-signature-authority"
          ],
          "properties": {
            "durable-recovery-store": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^[\\x00-\\x7f]+$"
            },
            "current-signature-authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "pattern": "^[\\x00-\\x7f]+$"
            }
          }
        }
      },
      "description": "Only production runtime/v6 with actual inspected native proof bridge/v2 selects this. Both canonical raw grant strings remain independently signed authority-history-root originals."
    }
  }
}
