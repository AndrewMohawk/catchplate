{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-shadow-commitment-keys.v1.schema.json",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "sha": {
      "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/sha256"
    },
    "signature": {
      "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/signature"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "u64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "bytes32": {
      "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/bytes32"
    },
    "guest": {
      "$ref": "native-custody-closure.v1.schema.json#/$defs/guest"
    },
    "ns": {
      "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/ns"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "keyEpoch",
        "secretSha256"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/sha"
        },
        "keyEpoch": {
          "$ref": "#/$defs/epoch"
        },
        "secretSha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "description": "secretSha256 is SHA256(b'catchplate/native-shadow-request-commitment-secret/v1\\0' + independently provisioned 32-byte HMAC secret). Key ID/epoch must match the independently signed assignment observationWindow, distinct from all 18 Ed25519 roles."
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "assignmentPayloadSha256",
        "keyAuthorizationSha256",
        "trustCheckpointId",
        "revocationGeneration",
        "revocationRootSha256",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos",
        "signingKeyId",
        "signingKeySpkiSha256",
        "requestCommitment"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowRequestCommitmentAssignment/v1"
        },
        "purpose": {
          "const": "native-shadow-request-commitment-hmac"
        },
        "guest": {
          "$ref": "#/$defs/guest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "trustCheckpointId": {
          "$ref": "#/$defs/sha"
        },
        "revocationGeneration": {
          "$ref": "#/$defs/u64"
        },
        "revocationRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "issuedAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "signingKeyId": {
          "$ref": "#/$defs/sha"
        },
        "signingKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "requestCommitment": {
          "$ref": "#/$defs/descriptor"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/assignment"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kmsParentPort",
        "kmsKeyId",
        "ciphertextBlobSha256",
        "encryptionContext",
        "kekSha256",
        "helperImage",
        "encryptedInventorySha256"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowKeyKmsTransport/v2"
        },
        "kmsParentPort": {
          "$ref": "native-shadow-encrypted-keys.v1.schema.json#/$defs/port"
        },
        "kmsKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "ciphertextBlobSha256": {
          "$ref": "#/$defs/sha"
        },
        "encryptionContext": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "required": [
            "catchplatePurpose"
          ],
          "properties": {
            "catchplatePurpose": {
              "const": "native-shadow-local-role-keys-and-request-commitment/v2"
            }
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "kekSha256": {
          "$ref": "#/$defs/sha"
        },
        "helperImage": {
          "$ref": "native-shadow-encrypted-keys.v1.schema.json#/$defs/image"
        },
        "encryptedInventorySha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "deliveryAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "purpose",
        "guest",
        "assignmentPayloadSha256",
        "keyAuthorizationSha256",
        "trustCheckpointId",
        "revocationGeneration",
        "revocationRootSha256",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos",
        "signingKeyId",
        "signingKeySpkiSha256",
        "assignmentId",
        "assignmentRevision",
        "fullKeySetRootSha256",
        "localKeySetRootSha256",
        "challengeBase64url",
        "transport"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowEncryptedKeyDeliveryAssignment/v2"
        },
        "purpose": {
          "const": "kms-recipient-shadow-local-keys-and-request-commitment"
        },
        "guest": {
          "$ref": "#/$defs/guest"
        },
        "assignmentPayloadSha256": {
          "$ref": "#/$defs/sha"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "trustCheckpointId": {
          "$ref": "#/$defs/sha"
        },
        "revocationGeneration": {
          "$ref": "#/$defs/u64"
        },
        "revocationRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "issuedAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtUnixNanos": {
          "$ref": "#/$defs/epoch"
        },
        "signingKeyId": {
          "$ref": "#/$defs/sha"
        },
        "signingKeySpkiSha256": {
          "$ref": "#/$defs/sha"
        },
        "assignmentId": {
          "$ref": "#/$defs/sha"
        },
        "assignmentRevision": {
          "$ref": "#/$defs/u64"
        },
        "fullKeySetRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "localKeySetRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "challengeBase64url": {
          "$ref": "#/$defs/bytes32"
        },
        "transport": {
          "$ref": "#/$defs/transport"
        }
      }
    },
    "deliveryAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/deliveryAssignment"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "authorization",
        "requestCommitment"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowEncryptedKeyDelivery/v2"
        },
        "authorization": {
          "$ref": "#/$defs/deliveryAuthorization"
        },
        "requestCommitment": {
          "$ref": "#/$defs/authorization"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "fullKeySetRootSha256",
        "localKeySetRootSha256",
        "localKeys",
        "requestCommitment"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowLocalKeyInventory/v2"
        },
        "fullKeySetRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "localKeySetRootSha256": {
          "$ref": "#/$defs/sha"
        },
        "localKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/publicKey"
          }
        },
        "requestCommitment": {
          "$ref": "#/$defs/descriptor"
        }
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "inventorySha256",
        "seeds",
        "requestCommitment"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowLocalKeySeeds/v2"
        },
        "inventorySha256": {
          "$ref": "#/$defs/sha"
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "keyId",
              "seedBase64url"
            ],
            "properties": {
              "role": {
                "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/localRole"
              },
              "keyId": {
                "$ref": "#/$defs/sha"
              },
              "seedBase64url": {
                "$ref": "#/$defs/bytes32"
              }
            }
          }
        },
        "requestCommitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyId",
            "keyEpoch",
            "secretBase64url"
          ],
          "properties": {
            "keyId": {
              "$ref": "#/$defs/sha"
            },
            "keyEpoch": {
              "$ref": "#/$defs/epoch"
            },
            "secretBase64url": {
              "$ref": "#/$defs/bytes32"
            }
          }
        }
      },
      "description": "Private canonical plaintext <=16368 bytes, accepted only from actual sealed offline FD or measured recipient helper into the retained final-role owner. No plaintext RPC or seed-file substitute. HMAC must differ from every Ed25519 seed; no derivation or key generation."
    },
    "encryptedInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "inventorySha256",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowEncryptedLocalKeys/v2"
        },
        "inventorySha256": {
          "$ref": "#/$defs/sha"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 23,
          "maxLength": 21846
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "guest",
        "keyAuthorizationSha256",
        "deliveryAuthorizationSha256",
        "inventory",
        "challengeBase64url",
        "executionClosureManifestSha256",
        "workerExecutableSha256",
        "structurallyVerifiedSeccompPolicySha256"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowKeyDeliveryBinding/v2"
        },
        "guest": {
          "$ref": "#/$defs/guest"
        },
        "keyAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "deliveryAuthorizationSha256": {
          "$ref": "#/$defs/sha"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "challengeBase64url": {
          "$ref": "#/$defs/bytes32"
        },
        "executionClosureManifestSha256": {
          "$ref": "#/$defs/sha"
        },
        "workerExecutableSha256": {
          "$ref": "#/$defs/sha"
        },
        "structurallyVerifiedSeccompPolicySha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "material",
        "binding",
        "transport",
        "recipientPublicKeySha256",
        "roleRecipientPublicKey",
        "nonce",
        "deadlineBoottimeNs"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowKeyKmsRecipientRequest/v2"
        },
        "material": {
          "const": "shadow-local-key-and-commitment-kek"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "recipientPublicKeySha256": {
          "$ref": "#/$defs/sha"
        },
        "roleRecipientPublicKey": {
          "$ref": "#/$defs/bytes32"
        },
        "nonce": {
          "$ref": "#/$defs/bytes32"
        },
        "deadlineBoottimeNs": {
          "$ref": "#/$defs/ns"
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "enclaveCid",
        "transport",
        "bindingSha256",
        "ciphertextBlob",
        "region"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.nativeShadowKeyKmsParent/v2"
        },
        "enclaveCid": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4294967294
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "bindingSha256": {
          "$ref": "#/$defs/sha"
        },
        "ciphertextBlob": {
          "$ref": "native-shadow-encrypted-keys.v1.schema.json#/$defs/parent/properties/ciphertextBlob"
        },
        "region": {
          "$ref": "native-shadow-encrypted-keys.v1.schema.json#/$defs/parent/properties/region"
        }
      }
    }
  }
}
