{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-shadow-driver-bootstrap.v1.schema.json",
  "$ref":"#/$defs/configuration",
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "ns":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/ns"},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "identity":{"type":"integer","minimum":1,"maximum":4294967294,"not":{"enum":[64988,64989,64990,65534]}},
    "signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"},
    "invocation":{"type":"string","pattern":"^[0-9a-f]{32}$","not":{"const":"00000000000000000000000000000000"}},
    "authority":{"type":"object","additionalProperties":false,"required":["publicKeyBase64url","keyId"],
      "properties":{"publicKeyBase64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"keyId":{"$ref":"#/$defs/sha"}}},
    "image":{"type":"object","additionalProperties":false,
      "required":["imageSha256","executableSha256","seccompPolicy","bootstrapRuntimeSha256","dependencyLockSha256","buildRecipeSha256","provenanceSha256"],
      "properties":{"imageSha256":{"$ref":"#/$defs/sha"},"executableSha256":{"$ref":"#/$defs/sha"},
        "seccompPolicy":{"$ref":"native-custody-closure.v1.schema.json#/$defs/seccompPolicy"},
        "bootstrapRuntimeSha256":{"$ref":"#/$defs/sha"},"dependencyLockSha256":{"$ref":"#/$defs/sha"},
        "buildRecipeSha256":{"$ref":"#/$defs/sha"},"provenanceSha256":{"$ref":"#/$defs/sha"}}},
    "configuration":{"type":"object","additionalProperties":false,
      "description":"Protected fixed cold original; bootstrap and phase-two keys must differ. No operational keys, arbitrary process selector or renewed deadline.",
      "required":["apiVersion","bootstrapAuthority","phaseTwoAuthority","deliveryConfiguration","uid","gid","image"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverBootstrapConfiguration/v1"},
        "bootstrapAuthority":{"$ref":"#/$defs/authority"},"phaseTwoAuthority":{"$ref":"#/$defs/authority"},
        "deliveryConfiguration":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"},
        "uid":{"$ref":"#/$defs/identity"},"gid":{"$ref":"#/$defs/identity"},"image":{"$ref":"#/$defs/image"}}},
    "bootstrapRuntime":{"type":"object","additionalProperties":false,"required":["apiVersion","purpose"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverBootstrapRuntime/v1"},
        "purpose":{"const":"measure-final-driver-before-operational-admission"}}},
    "windowPayload":{"type":"object","additionalProperties":false,
      "required":["configurationSha256","signingKeyId","bootIdBase64url","timeNamespaceDevice","timeNamespaceInode","issuedAtBoottimeNs","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","invocationId"],
      "properties":{"configurationSha256":{"$ref":"#/$defs/sha"},"signingKeyId":{"$ref":"#/$defs/sha"},
        "bootIdBase64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{22}$"},
        "timeNamespaceDevice":{"$ref":"#/$defs/positive"},"timeNamespaceInode":{"$ref":"#/$defs/positive"},
        "issuedAtBoottimeNs":{"$ref":"#/$defs/ns"},"startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"invocationId":{"$ref":"#/$defs/invocation"}}},
    "window":{"type":"object","additionalProperties":false,"required":["apiVersion","payload","signatureBase64url"],
      "description":"Ed25519 over serverware.nativeShadowDriverBootstrapWindow.signature/v1 plus NUL plus exact canonical payload. Original startup interval <=30 seconds.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverBootstrapWindow/v1"},
        "payload":{"$ref":"#/$defs/windowPayload"},"signatureBase64url":{"$ref":"#/$defs/signature"}}},
    "descriptor":{"type":"object","additionalProperties":false,"required":["name","device","inode","mode","mountId"],
      "properties":{"name":{"enum":["self-pidfd","executable","cgroup","root"]},
        "device":{"type":"integer","minimum":0,"maximum":18446744073709551615},"inode":{"$ref":"#/$defs/positive"},
        "mode":{"type":"integer","minimum":0,"maximum":4294967295},"mountId":{"$ref":"#/$defs/positive"}}},
    "driver":{"type":"object","additionalProperties":false,
      "required":["driverInstanceSha256","driverExecutableSha256","supervisorBootIdSha256","processStartTimeTicks","pidfdInode","cgroupId","cgroupMountId","cgroupInode","retainedDescriptorManifestSha256","verifiedAtBoottimeNanos","identitySha256"],
      "properties":{"driverInstanceSha256":{"$ref":"#/$defs/sha"},"driverExecutableSha256":{"$ref":"#/$defs/sha"},
        "supervisorBootIdSha256":{"$ref":"#/$defs/sha"},"processStartTimeTicks":{"$ref":"#/$defs/positive"},
        "pidfdInode":{"$ref":"#/$defs/positive"},"cgroupId":{"$ref":"#/$defs/positive"},
        "cgroupMountId":{"$ref":"#/$defs/positive"},"cgroupInode":{"$ref":"#/$defs/positive"},
        "retainedDescriptorManifestSha256":{"$ref":"#/$defs/sha"},"verifiedAtBoottimeNanos":{"$ref":"#/$defs/positive"},
        "identitySha256":{"$ref":"#/$defs/sha"}}},
    "observation":{"type":"object","additionalProperties":false,
      "description":"Authenticated local data from the actually executing final-UID child, independently checked by its retained privileged parent. NOT a software signature, NSM quote, full operational descriptor census or readiness receipt.",
      "required":["apiVersion","configurationSha256","windowSha256","invocationId","processId","uid","gid","cgroupOriginalSha256","root","seccompFilterCount","descriptors","driver"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverObservation/v1"},
        "configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "invocationId":{"$ref":"#/$defs/invocation"},"processId":{"type":"integer","minimum":2,"maximum":2147483647},
        "uid":{"$ref":"#/$defs/identity"},"gid":{"$ref":"#/$defs/identity"},
        "cgroupOriginalSha256":{"$ref":"#/$defs/sha"},"root":{"$ref":"#/$defs/descriptor"},
        "seccompFilterCount":{"$ref":"#/$defs/positive"},"descriptors":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/descriptor"}},
        "driver":{"$ref":"#/$defs/driver"}}},
    "grantPins":{"type":"object","additionalProperties":false,
      "required":["bounded-cleanup-helper","cleanup-authorization-consumer","current-signature-authority","durable-recovery-store","recovery-target-provider"],
      "properties":{"bounded-cleanup-helper":{"$ref":"#/$defs/sha"},"cleanup-authorization-consumer":{"$ref":"#/$defs/sha"},
        "current-signature-authority":{"$ref":"#/$defs/sha"},"durable-recovery-store":{"$ref":"#/$defs/sha"},"recovery-target-provider":{"$ref":"#/$defs/sha"}}},
    "originalPins":{"type":"object","additionalProperties":false,"required":["runtimeSha256","deliverySha256","generationGrants"],
      "properties":{"runtimeSha256":{"$ref":"#/$defs/sha"},"deliverySha256":{"$ref":"#/$defs/sha"},"generationGrants":{"$ref":"#/$defs/grantPins"}}},
    "scopePayload":{"type":"object","additionalProperties":false,
      "required":["apiVersion","configurationSha256","windowSha256","observationSha256","kernelDriverIdentitySha256","invocationId","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","originals","publicBundleSha256","signingKeyId"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverScope/v1"},
        "configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "observationSha256":{"$ref":"#/$defs/sha"},"kernelDriverIdentitySha256":{"$ref":"#/$defs/sha"},
        "invocationId":{"$ref":"#/$defs/invocation"},"startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"originals":{"$ref":"#/$defs/originalPins"},
        "publicBundleSha256":{"$ref":"#/$defs/sha"},"signingKeyId":{"$ref":"#/$defs/sha"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["payload","signatureBase64url"],
      "description":"Dedicated phase-two Ed25519 domain serverware.nativeShadowDriverScope.signature/v1 plus NUL plus canonical payload. Authorizes retention only. Does not substitute for inner grant/history/current assignment or native-key admission.",
      "properties":{"payload":{"$ref":"#/$defs/scopePayload"},"signatureBase64url":{"$ref":"#/$defs/signature"}}},
    "original":{"type":"string","minLength":2,"maxLength":65536,"pattern":"^[\\x00-\\x7f]*$",
      "description":"Exact canonical ASCII JSON original bytes, preserved without parse/reserialize projection."},
    "grantOriginals":{"type":"object","additionalProperties":false,
      "required":["bounded-cleanup-helper","cleanup-authorization-consumer","current-signature-authority","durable-recovery-store","recovery-target-provider"],
      "properties":{"bounded-cleanup-helper":{"$ref":"#/$defs/original"},"cleanup-authorization-consumer":{"$ref":"#/$defs/original"},
        "current-signature-authority":{"$ref":"#/$defs/original"},"durable-recovery-store":{"$ref":"#/$defs/original"},"recovery-target-provider":{"$ref":"#/$defs/original"}}},
    "publicBundle":{"type":"object","additionalProperties":false,"required":["runtimeOriginal","deliveryOriginal","generationOriginals"],
      "description":"One canonical <=1MiB root-owned mode0400 fully sealed memfd, SCM_RIGHTS exactly1. No credentials/seeds or business descriptors. Each inner original <=65536 bytes.",
      "properties":{"runtimeOriginal":{"$ref":"#/$defs/original"},"deliveryOriginal":{"$ref":"#/$defs/original"},"generationOriginals":{"$ref":"#/$defs/grantOriginals"}}},
    "retained":{"type":"object","additionalProperties":false,"required":["apiVersion","observationSha256","scopeSha256"],
      "description":"Observation of public-original retention only. No constructed notice, startup disarm, service effect or retry permission.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverPhaseTwoRetained/v1"},
        "observationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"}}},
    "control":{"type":"object","additionalProperties":false,"required":["apiVersion","supervisorExecutableSha256","configurationSha256","windowSha256"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverBootstrapControl/v1"},
        "supervisorExecutableSha256":{"$ref":"#/$defs/sha"},"configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"}}}
  }
}
