{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/native-shadow-driver-continuation.v1.schema.json",
  "$ref":"#/$defs/configuration",
  "$defs":{
    "sha":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/sha"},
    "ns":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/ns"},
    "pin":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"},
    "configuration":{"type":"object","additionalProperties":false,
      "required":["apiVersion","bootstrapAuthority","phaseTwoAuthority","deliveryConfiguration","uid","gid","image","continuation"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverBootstrapConfiguration/v2"},
        "bootstrapAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "phaseTwoAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "deliveryConfiguration":{"$ref":"#/$defs/pin"},
        "uid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "gid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "image":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/image"},
        "continuation":{"$ref":"#/$defs/preparation"}}},
    "preparation":{"type":"object","additionalProperties":false,"required":["apiVersion","keyTransport"],
      "description":"Independently cold-selected public mechanism. Opens real NSM handles and one fixed encrypted-key helper before drop; no role key or quote is consumed before current phase-two/C9/assignment admission.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverContinuationPreparation/v1"},
        "keyTransport":{"$ref":"native-shadow-encrypted-keys.v1.schema.json#/$defs/transport"}}},
    "u64":{"type":"integer","minimum":0,"maximum":18446744073709551615},
    "u32":{"type":"integer","minimum":0,"maximum":4294967295},
    "descriptor":{"type":"object","additionalProperties":false,
      "required":["name","device","inode","mode","uid","gid","length"],
      "description":"Actual retained descriptor metadata, independently signed with the entire operation. Names are the closed source inventory; root also opens the corresponding protected named original. An inode row is not path or key authority.",
      "properties":{"name":{"type":"string","minLength":1,"maxLength":256},
        "device":{"$ref":"#/$defs/u64"},"inode":{"$ref":"#/$defs/u64"},"mode":{"$ref":"#/$defs/u32"},
        "uid":{"$ref":"#/$defs/u32"},"gid":{"$ref":"#/$defs/u32"},"length":{"$ref":"#/$defs/u64"}}},
    "production":{"type":"object","additionalProperties":false,
      "required":["signerBackendSha256","persistenceBackendSha256","retrievalBackendSha256","dispatcherProtocolSetSha256","maximumRpcNanos","cleanupReserveNanos","maximumInFlightCalls","maximumAsyncDurabilityNanos","expectedConfigurationBindingSha256"],
      "description":"Independent scope inputs to the real native configuration factory. Driver/executable/boot/closure come only from retained runtime owners. Factory checks all original global bounds. Expected binding is comparison only, never observed native identity or activated attestation.",
      "properties":{"signerBackendSha256":{"$ref":"#/$defs/sha"},"persistenceBackendSha256":{"$ref":"#/$defs/sha"},
        "retrievalBackendSha256":{"$ref":"#/$defs/sha"},"dispatcherProtocolSetSha256":{"$ref":"#/$defs/sha"},
        "maximumRpcNanos":{"type":"integer","minimum":250000000,"maximum":1000000000},
        "cleanupReserveNanos":{"type":"integer","minimum":1},"maximumInFlightCalls":{"type":"integer","minimum":1,"maximum":64},
        "maximumAsyncDurabilityNanos":{"type":"integer","minimum":1,"maximum":1000000000},
        "expectedConfigurationBindingSha256":{"$ref":"#/$defs/sha"}}},
    "operation":{"type":"object","additionalProperties":false,"required":["apiVersion","launch","descriptors","production"],
      "description":"Descriptors sorted uniquely by name, no inode alias. At most94 plus sealed bundle and separately parent-created inspector channel makes96 on the child hop. Ordinary endpoint framing is unchanged.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverOperation/v1"},"launch":{"$ref":"#/$defs/pin"},
        "descriptors":{"type":"array","minItems":1,"maxItems":94,"items":{"$ref":"#/$defs/descriptor"}},
        "production":{"$ref":"#/$defs/production"}}},
    "scopePayload":{"type":"object","additionalProperties":false,
      "required":["apiVersion","configurationSha256","windowSha256","observationSha256","kernelDriverIdentitySha256","invocationId","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","originals","publicBundleSha256","signingKeyId","operation"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverScope/v2"},
        "configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "observationSha256":{"$ref":"#/$defs/sha"},"kernelDriverIdentitySha256":{"$ref":"#/$defs/sha"},
        "invocationId":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/invocation"},
        "startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "originals":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/originalPins"},
        "publicBundleSha256":{"$ref":"#/$defs/sha"},"signingKeyId":{"$ref":"#/$defs/sha"},"operation":{"$ref":"#/$defs/operation"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["payload","signatureBase64url"],
      "description":"<=32768 canonical bytes. Ed25519 signs catchplate.nativeShadowDriverScope.signature/v2 + NUL + entire canonical payload. Separate independently pinned phase-two key. No exclusions or signature/domain aliases.",
      "properties":{"payload":{"$ref":"#/$defs/scopePayload"},"signatureBase64url":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/signature"}}},
    "constructed":{"type":"object","additionalProperties":false,"required":["apiVersion","observationSha256","scopeSha256"],
      "description":"Authenticated same-child observation emitted only by the actual complete inspected bridge constructor. Disarms only original startup timers; lifetime stays armed. Not full-configuration TEE activation, generation readiness, fleet readiness, completion or resend authority.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverBridgeConstructed/v1"},
        "observationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"}}}
  }
}
