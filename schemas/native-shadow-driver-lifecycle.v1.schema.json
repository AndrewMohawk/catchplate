{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/native-shadow-driver-lifecycle.v1.schema.json",
  "$ref":"#/$defs/bootstrapConfiguration",
  "$defs":{
    "sha":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/sha"},
    "ns":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/ns"},
    "uint":{"type":"integer","minimum":0,"maximum":18446744073709551615},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "pid":{"type":"integer","minimum":2,"maximum":2147483647},
    "gate":{"type":"object","additionalProperties":false,"required":["uid","gid","executableSha256"],
      "description":"Cold approved executable and final native serving role. Actual PID/start come only from the authenticated live connection, not this policy.",
      "properties":{"uid":{"const":65534},"gid":{"const":65534},"executableSha256":{"$ref":"#/$defs/sha"}}},
    "policy":{"type":"object","additionalProperties":false,"required":["apiVersion","gate","cleanupReserveNanos"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecyclePolicy/v1"},"gate":{"$ref":"#/$defs/gate"},
        "cleanupReserveNanos":{"type":"integer","minimum":1000000,"maximum":5000000000}}},
    "preparation":{"type":"object","additionalProperties":false,"required":["apiVersion","keyTransport"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverContinuationPreparation/v3"},
        "keyTransport":{"$ref":"native-shadow-driver-continuation.v1.schema.json#/$defs/preparation/properties/keyTransport"}}},
    "bootstrapConfiguration":{"type":"object","additionalProperties":false,
      "required":["apiVersion","bootstrapAuthority","phaseTwoAuthority","deliveryConfiguration","uid","gid","image","continuation","lifecycle"],
      "description":"Explicit additive v4. Existing v1-v3 remain closed. The original signed bootstrap window authenticates these exact cold bytes; cleanup reserve shortens operation, never extends lifetime.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverBootstrapConfiguration/v4"},
        "bootstrapAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "phaseTwoAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "deliveryConfiguration":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"},
        "uid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "gid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "image":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/image"},
        "continuation":{"$ref":"#/$defs/preparation"},"lifecycle":{"$ref":"#/$defs/policy"}}},
    "scopePayload":{"type":"object","additionalProperties":false,
      "required":["apiVersion","configurationSha256","windowSha256","observationSha256","kernelDriverIdentitySha256","invocationId","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","originals","publicBundleSha256","signingKeyId","operation"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverScope/v4"},
        "configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},"observationSha256":{"$ref":"#/$defs/sha"},
        "kernelDriverIdentitySha256":{"$ref":"#/$defs/sha"},"invocationId":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/invocation"},
        "startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "originals":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/originalPins"},"publicBundleSha256":{"$ref":"#/$defs/sha"},
        "signingKeyId":{"$ref":"#/$defs/sha"},"operation":{"$ref":"native-shadow-driver-continuation.v1.schema.json#/$defs/scopePayload/properties/operation"}}},
    "scope":{"type":"object","additionalProperties":false,"required":["payload","signatureBase64url"],
      "description":"Ed25519 over catchplate.nativeShadowDriverScope.signature/v4, NUL, full canonical payload. Actual final gate PID/start/role/executable must match the independently signed runtime expectedFacadePeer. Other peer fields still require their unchanged privileged inspector.",
      "properties":{"payload":{"$ref":"#/$defs/scopePayload"},"signatureBase64url":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/signature"}}},
    "receiver":{"type":"object","additionalProperties":false,
      "required":["apiVersion","parentPeer","driverConfigurationSha256","driverWindowSha256","bootstrapObservationSha256","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","cleanupReserveNanos"],
      "description":"Selected only from the actual root-admitted retained custody original. This is a live lifecycle receiver prerequisite, not ProductionProcessConfigV4 or a native configuration manifest.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowCustodyLifecycleReceiver/v1"},
        "parentPeer":{"$ref":"native-shadow-retrieval-service.v1.schema.json#/$defs/peer"},
        "driverConfigurationSha256":{"$ref":"#/$defs/sha"},"driverWindowSha256":{"$ref":"#/$defs/sha"},"bootstrapObservationSha256":{"$ref":"#/$defs/sha"},
        "startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "cleanupReserveNanos":{"type":"integer","minimum":1000000,"maximum":5000000000}}},
    "request":{"type":"object","additionalProperties":false,
      "required":["apiVersion","operation","sequence","configurationSha256","windowSha256","deadlineBoottimeNs"],
      "description":"Fixed socket, no rights, <=4096 bytes. Prepare sequence1 before drop; bind sequence2 after drop; subsequent observe only after genuine construction. No arbitrary target or deadline renewal.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecycleExchange/v1"},"operation":{"enum":["prepare","bind","observe"]},
        "sequence":{"$ref":"#/$defs/positive"},"configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},"deadlineBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "reply":{"type":"object","additionalProperties":false,"required":["apiVersion","sequence","requestSha256","original"],
      "description":"Whole response <=65536 bytes and no rights. Authenticated local observation only. A missing response cannot authorize replay or retry.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecycleExchange/v1"},"sequence":{"$ref":"#/$defs/positive"},
        "requestSha256":{"$ref":"#/$defs/sha"},"original":{"type":"string","minLength":2,"maxLength":65536,"pattern":"^[\\x00-\\x7f]*$"}}},
    "process":{"type":"object","additionalProperties":false,"required":["processId","startTimeTicks","parentId","pidfdDevice","pidfdInode"],
      "properties":{"processId":{"$ref":"#/$defs/pid"},"startTimeTicks":{"$ref":"#/$defs/positive"},"parentId":{"$ref":"#/$defs/pid"},
        "pidfdDevice":{"$ref":"#/$defs/uint"},"pidfdInode":{"$ref":"#/$defs/positive"}}},
    "prepared":{"type":"object","additionalProperties":false,"required":["apiVersion","configurationSha256","windowSha256","parent","parentExecutableSha256","pidNamespaceSha256","lifetimeDeadlineBoottimeNs"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecyclePrepared/v1"},"configurationSha256":{"$ref":"#/$defs/sha"},
        "windowSha256":{"$ref":"#/$defs/sha"},"parent":{"$ref":"#/$defs/process"},"parentExecutableSha256":{"$ref":"#/$defs/sha"},
        "pidNamespaceSha256":{"$ref":"#/$defs/sha"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "bound":{"type":"object","additionalProperties":false,"required":["apiVersion","preparedSha256","gateProcessId","gateStartTimeTicks","uid","gid","observedAtBoottimeNs"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecycleBound/v1"},"preparedSha256":{"$ref":"#/$defs/sha"},
        "gateProcessId":{"$ref":"#/$defs/pid"},"gateStartTimeTicks":{"$ref":"#/$defs/positive"},"uid":{"const":65534},"gid":{"const":65534},"observedAtBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "gateNotice":{"type":"object","additionalProperties":false,"required":["apiVersion","configurationSha256","windowSha256","bootstrapObservationSha256","gateExecutableSha256","binding"],
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverGateBound/v1"},"configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "bootstrapObservationSha256":{"$ref":"#/$defs/sha"},"gateExecutableSha256":{"$ref":"#/$defs/sha"},"binding":{"$ref":"#/$defs/bound"}}},
    "listening":{"type":"object","additionalProperties":false,"required":["apiVersion","observationSha256","scopeSha256","listenerDevice","listenerInode"],
      "description":"Actual same-child final-role listen notice, not constructed or ready. Parent checks retained signed production-listener FD before releasing pending gate bind.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverFacadeListening/v1"},"observationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"},
        "listenerDevice":{"$ref":"#/$defs/uint"},"listenerInode":{"$ref":"#/$defs/positive"}}},
    "descriptor":{"type":"object","additionalProperties":false,"required":["fd","device","inode","mode","uid","gid","mountId","flags"],
      "properties":{"fd":{"type":"integer","minimum":0,"maximum":2147483647},"device":{"$ref":"#/$defs/uint"},"inode":{"$ref":"#/$defs/positive"},
        "mode":{"$ref":"#/$defs/uint"},"uid":{"$ref":"#/$defs/uint"},"gid":{"$ref":"#/$defs/uint"},"mountId":{"$ref":"#/$defs/positive"},"flags":{"$ref":"#/$defs/uint"}}},
    "observation":{"type":"object","additionalProperties":false,
      "required":["apiVersion","configurationSha256","windowSha256","bootstrapObservationSha256","scopeSha256","phase","parent","parentExecutableSha256","pidNamespaceSha256","driver","descendants","descriptors","descriptorSetSha256","observedAtBoottimeNs","lifetimeDeadlineBoottimeNs"],
      "description":"Actual driver FD identity census with retained pidfd_getfd duplicates, <=256 descriptors and <=16 descendants. Not immutable content hashes, a stop-the-world snapshot, or a signed full operational manifest. The five independent service peers are outside this subtree.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverLifecycleObservation/v1"},"configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "bootstrapObservationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"},"phase":{"const":"constructed-driver-subtree"},
        "parent":{"$ref":"#/$defs/process"},"parentExecutableSha256":{"$ref":"#/$defs/sha"},"pidNamespaceSha256":{"$ref":"#/$defs/sha"},"driver":{"$ref":"#/$defs/process"},
        "descendants":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/process"}},"descriptors":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/descriptor"}},
        "descriptorSetSha256":{"$ref":"#/$defs/sha"},"observedAtBoottimeNs":{"$ref":"#/$defs/ns"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "driverTerminal":{"type":"object","additionalProperties":false,"required":["processId","startTimeTicks","pidfdDevice","pidfdInode","terminalCode","terminalStatus","observedAtBoottimeNs","reapedAtBoottimeNs"],
      "properties":{"processId":{"$ref":"#/$defs/pid"},"startTimeTicks":{"$ref":"#/$defs/positive"},"pidfdDevice":{"$ref":"#/$defs/uint"},"pidfdInode":{"$ref":"#/$defs/positive"},
        "terminalCode":{"enum":[1,2,3]},"terminalStatus":{"type":"integer"},"observedAtBoottimeNs":{"$ref":"#/$defs/ns"},"reapedAtBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "adoptedTerminal":{"type":"object","additionalProperties":false,"required":["process","terminalCode","terminalStatus","reapedAtBoottimeNs"],
      "properties":{"process":{"$ref":"#/$defs/process"},"terminalCode":{"enum":[1,2,3]},"terminalStatus":{"type":"integer"},"reapedAtBoottimeNs":{"$ref":"#/$defs/ns"}}},
    "subtreeTerminal":{"type":"object","additionalProperties":false,"required":["apiVersion","configurationSha256","windowSha256","parent","driver","adopted","completedAtBoottimeNs","lifetimeDeadlineBoottimeNs"],
      "description":"Actual original-parent waitid/reap observations only after its entire bridge subtree is empty before original lifetime. Not five-service termination, cleanup-consumed authority, or a signed stable reaper manifest. Unknown/overflow/timeout emits no successful terminal original.",
      "properties":{"apiVersion":{"const":"catchplate.nativeShadowDriverSubtreeReaped/v1"},"configurationSha256":{"$ref":"#/$defs/sha"},"windowSha256":{"$ref":"#/$defs/sha"},
        "parent":{"$ref":"#/$defs/process"},"driver":{"$ref":"#/$defs/driverTerminal"},"adopted":{"type":"array","maxItems":15,"items":{"$ref":"#/$defs/adoptedTerminal"}},
        "completedAtBoottimeNs":{"$ref":"#/$defs/ns"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"}}}
  }
}
