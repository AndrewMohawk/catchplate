{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-shadow-gate-facade.v1.schema.json",
  "$ref":"#/$defs/receiver",
  "$defs":{
    "sha":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/sha"},
    "ns":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/ns"},
    "policy":{"type":"object","additionalProperties":false,"required":["apiVersion","gate","cleanupReserveNanos"],
      "description":"Explicit nested v2, authenticated by the original independently signed bootstrap configuration/window. Enables only four same-driver inspections and public admission-original delivery. No new signing permission.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverLifecyclePolicy/v2"},
        "gate":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/gate"},
        "cleanupReserveNanos":{"type":"integer","minimum":1000000,"maximum":5000000000}}},
    "bootstrapConfiguration":{"type":"object","additionalProperties":false,
      "required":["apiVersion","bootstrapAuthority","phaseTwoAuthority","deliveryConfiguration","uid","gid","image","continuation","lifecycle"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverBootstrapConfiguration/v4"},
        "bootstrapAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "phaseTwoAuthority":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/authority"},
        "deliveryConfiguration":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"},
        "uid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "gid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "image":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/image"},
        "continuation":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/preparation"},
        "lifecycle":{"$ref":"#/$defs/policy"}}},
    "receiver":{"type":"object","additionalProperties":false,
      "required":["apiVersion","parentPeer","driverConfigurationSha256","driverWindowSha256","bootstrapObservationSha256","startupDeadlineBoottimeNs","lifetimeDeadlineBoottimeNs","cleanupReserveNanos"],
      "description":"Root-admitted actual custody-file selection. Same-process permanent gate drop precedes four real connections. Not a ProductionProcessConfig or a native configuration grant.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowCustodyLifecycleReceiver/v2"},
        "parentPeer":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/receiver/properties/parentPeer"},
        "driverConfigurationSha256":{"$ref":"#/$defs/sha"},"driverWindowSha256":{"$ref":"#/$defs/sha"},
        "bootstrapObservationSha256":{"$ref":"#/$defs/sha"},"startupDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},"cleanupReserveNanos":{"type":"integer","minimum":1000000,"maximum":5000000000}}},
    "original":{"type":"string","minLength":1,"maxLength":4194304,"pattern":"^[\\x00-\\x7f]+$"},
    "publicAdmission":{"type":"object","additionalProperties":false,
      "required":["apiVersion","bootstrapObservationOriginal","phaseScopeOriginal","phaseBundleOriginal","closureOriginal","assignmentOriginal","keyConfigurationOriginal","admissionAuthorizationOriginal","evidenceOriginal","combinedResultOriginal"],
      "description":"Exact original strings from the actual same-child combined-admission owner, transported in one sealed public memfd. Complete canonical ASCII object <=8388608 bytes. No encrypted delivery or secret key. Authenticated transport alone is not signature/currentness/configuration admission.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverPublicAdmission/v1"},
        "bootstrapObservationOriginal":{"$ref":"#/$defs/original"},"phaseScopeOriginal":{"$ref":"#/$defs/original"},
        "phaseBundleOriginal":{"$ref":"#/$defs/original"},"closureOriginal":{"$ref":"#/$defs/original"},
        "assignmentOriginal":{"$ref":"#/$defs/original"},"keyConfigurationOriginal":{"$ref":"#/$defs/original"},
        "admissionAuthorizationOriginal":{"$ref":"#/$defs/original"},
        "evidenceOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":131072}]},
        "combinedResultOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":32768}]}}},
    "notice":{"type":"object","additionalProperties":false,
      "required":["apiVersion","observationSha256","scopeSha256","originalSha256","length"],
      "description":"Exact one SCM_RIGHTS descriptor, sealed against write/grow/shrink/seal changes, original bridge UID/GID and mode0400. Same parent forwards the same file once to the same retained gate. No resend after uncertainty.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverPublicAdmissionNotice/v1"},
        "observationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"},"originalSha256":{"$ref":"#/$defs/sha"},
        "length":{"type":"integer","minimum":1,"maximum":8388608}}},
    "description":{"type":"object","additionalProperties":false,
      "required":["apiVersion","listenerPath","listenerDevice","listenerInode","runtimeConfigurationSha256","scopeSha256","processId","startTimeTicks","uid","gid"],
      "description":"Same-parent observation from the actual signed runtime and retained listener/Child, not caller selectors. The runtime driver process digest must match independently measured complete peer facts.",
      "properties":{"apiVersion":{"const":"serverware.nativeShadowDriverFacadeDescription/v1"},
        "listenerPath":{"type":"string","minLength":1,"maxLength":107,"pattern":"^/"},
        "listenerDevice":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/uint"},
        "listenerInode":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/positive"},
        "runtimeConfigurationSha256":{"$ref":"#/$defs/sha"},"scopeSha256":{"$ref":"#/$defs/sha"},
        "processId":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/pid"},
        "startTimeTicks":{"$ref":"native-shadow-driver-lifecycle.v1.schema.json#/$defs/positive"},
        "uid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"},
        "gid":{"$ref":"native-shadow-driver-bootstrap.v1.schema.json#/$defs/identity"}}}
  }
}
