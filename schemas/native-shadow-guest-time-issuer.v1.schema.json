{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-shadow-guest-time-issuer.v1.schema.json",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "sha256": { "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/sha256" },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "ns": { "$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/ns" },
    "bracket": { "type": "string", "pattern": "^(?:[1-9][0-9]{0,8}|1000000000)$" },
    "bytes32": { "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/bytes32" },
    "signature": { "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/signature" },
    "guest": { "$ref": "native-shadow-role-keys.v1.schema.json#/$defs/guest" },
    "uid": { "$ref": "native-shadow-nitro-verifier.v1.schema.json#/$defs/uid" },
    "timestampError": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "rateError": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["keyId", "keySpkiSha256", "publicKeyBase64url", "notBeforeUnixNanos", "notAfterUnixNanos"],
      "properties": {
        "keyId": { "$ref": "#/$defs/sha256" }, "keySpkiSha256": { "$ref": "#/$defs/sha256" },
        "publicKeyBase64url": { "$ref": "#/$defs/bytes32" },
        "notBeforeUnixNanos": { "$ref": "#/$defs/positive" }, "notAfterUnixNanos": { "$ref": "#/$defs/positive" }
      }
    },
    "authorizationPayload": {
      "type": "object", "additionalProperties": false,
      "description": "Separate cold-authority signature, at most 300 seconds. configurationSha256 hashes the complete canonical configuration excluding only authorization; no digest self-reference.",
      "required": ["apiVersion", "purpose", "configurationSha256", "issuedAtUnixNanos", "expiresAtUnixNanos", "signingKeyId"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeIssuerAuthorization/v1" },
        "purpose": { "const": "native-shadow-guest-time-issuance" }, "configurationSha256": { "$ref": "#/$defs/sha256" },
        "issuedAtUnixNanos": { "$ref": "#/$defs/positive" }, "expiresAtUnixNanos": { "$ref": "#/$defs/positive" },
        "signingKeyId": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false, "required": ["payload", "signature"],
      "properties": { "payload": { "$ref": "#/$defs/authorizationPayload" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "transport": {
      "type": "object", "additionalProperties": false, "required": ["localIp", "localPort", "peerIp"],
      "properties": {
        "localIp": { "type": "string", "minLength": 1, "maxLength": 45 },
        "localPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "peerIp": { "type": "string", "minLength": 1, "maxLength": 45 }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "description": "Canonical ASCII no-LF original <=512 KiB at fixed /etc/catchplate/native-shadow-guest-time-issuer.json, root:root0400 FD3. Its separate signed authorization and original signed C9 delivery must verify before challenge. Scalar bounds never establish guest sample provenance.",
      "required": ["apiVersion", "uid", "gid", "operation", "issuerAuthorityKey", "timeKey", "guestAuthorityPublicKeyBase64url", "guestConfigurationOriginalBase64url", "guestDeliveryOriginalBase64url", "nitro", "collateralRevocation", "transport", "maximumBracketNanos", "timestampErrorNanos", "maximumClockRateErrorPpm", "maximumAnchorAgeNanos", "authorization"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeIssuerConfiguration/v1" },
        "uid": { "$ref": "#/$defs/uid" }, "gid": { "$ref": "#/$defs/uid" },
        "operation": { "$ref": "native-shadow-nitro-verifier.v1.schema.json#/$defs/operation" },
        "issuerAuthorityKey": { "$ref": "#/$defs/key" }, "timeKey": { "$ref": "#/$defs/key" },
        "guestAuthorityPublicKeyBase64url": { "$ref": "#/$defs/bytes32" },
        "guestConfigurationOriginalBase64url": { "type": "string", "minLength": 1, "maxLength": 87382, "pattern": "^[A-Za-z0-9_-]+$" },
        "guestDeliveryOriginalBase64url": { "type": "string", "minLength": 1, "maxLength": 87382, "pattern": "^[A-Za-z0-9_-]+$" },
        "nitro": { "$ref": "native-shadow-nitro-verifier.v1.schema.json#/$defs/nitro" },
        "collateralRevocation": { "$ref": "native-shadow-nitro-verifier.v1.schema.json#/$defs/revocation" },
        "transport": { "$ref": "#/$defs/transport" }, "maximumBracketNanos": { "$ref": "#/$defs/bracket" },
        "timestampErrorNanos": { "$ref": "#/$defs/timestampError" }, "maximumClockRateErrorPpm": { "$ref": "#/$defs/rateError" },
        "maximumAnchorAgeNanos": { "type": "integer", "minimum": 1, "maximum": 300000000000 },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    },
    "challengePayload": {
      "type": "object", "additionalProperties": false,
      "description": "Fresh issuer entropy and actual issuer time; <=30-second original issuer operation. This timestamp is NOT the guest BOOTTIME correlation.",
      "required": ["apiVersion", "purpose", "guest", "nonceBase64url", "issuedAtUnixNanos", "expiresAtUnixNanos", "maximumBracketNanos", "timestampErrorNanos", "maximumClockRateErrorPpm", "signingKeyId"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeChallenge/v1" },
        "purpose": { "const": "native-shadow-guest-time-challenge" }, "guest": { "$ref": "#/$defs/guest" },
        "nonceBase64url": { "$ref": "#/$defs/bytes32" }, "issuedAtUnixNanos": { "$ref": "#/$defs/positive" },
        "expiresAtUnixNanos": { "$ref": "#/$defs/positive" }, "maximumBracketNanos": { "$ref": "#/$defs/bracket" },
        "timestampErrorNanos": { "$ref": "#/$defs/timestampError" }, "maximumClockRateErrorPpm": { "$ref": "#/$defs/rateError" },
        "signingKeyId": { "$ref": "#/$defs/sha256" }
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false, "required": ["payload", "signature"],
      "properties": { "payload": { "$ref": "#/$defs/challengePayload" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "guest", "challengeSha256", "beforeBoottimeNs", "publicKeyBase64url"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeStatement/v1" },
        "purpose": { "const": "native-shadow-guest-time-sample" }, "guest": { "$ref": "#/$defs/guest" },
        "challengeSha256": { "$ref": "#/$defs/sha256" }, "beforeBoottimeNs": { "$ref": "#/$defs/ns" },
        "publicKeyBase64url": { "$ref": "#/$defs/bytes32" }
      }
    },
    "samplePayload": {
      "type": "object", "additionalProperties": false, "required": ["statement", "afterBoottimeNs", "quoteSha256"],
      "properties": { "statement": { "$ref": "#/$defs/statement" }, "afterBoottimeNs": { "$ref": "#/$defs/ns" }, "quoteSha256": { "$ref": "#/$defs/sha256" } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "description": "Whole canonical evidence <=64 KiB; NSM document <=12 KiB. The quoted ephemeral key signs exact samplePayload, including the after sample and original quote SHA.",
      "required": ["apiVersion", "statement", "afterBoottimeNs", "attestationDocumentBase64url", "signature"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeEvidence/v1" }, "statement": { "$ref": "#/$defs/statement" },
        "afterBoottimeNs": { "$ref": "#/$defs/ns" },
        "attestationDocumentBase64url": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[A-Za-z0-9_-]+$" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "anchorPayload": {
      "type": "object", "additionalProperties": false,
      "description": "An interval at the exact before-sample BOOTTIME, not an exact epoch point. Expiry is <=earliest+300 seconds and never renews original guest startup/lifetime. Consumers widen both bounds with elapsed BOOTTIME/rate and validate whole intervals.",
      "required": ["apiVersion", "purpose", "guest", "challengeSha256", "evidenceSha256", "quoteSha256", "anchorBoottimeNs", "earliestUnixNanos", "latestUnixNanos", "expiresAtUnixNanos", "maximumClockRateErrorPpm", "signingKeyId"],
      "properties": {
        "apiVersion": { "const": "catchplate.nativeShadowGuestTimeAnchor/v2" },
        "purpose": { "const": "native-shadow-guest-trusted-time" }, "guest": { "$ref": "#/$defs/guest" },
        "challengeSha256": { "$ref": "#/$defs/sha256" }, "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "quoteSha256": { "$ref": "#/$defs/sha256" }, "anchorBoottimeNs": { "$ref": "#/$defs/ns" },
        "earliestUnixNanos": { "$ref": "#/$defs/positive" }, "latestUnixNanos": { "$ref": "#/$defs/positive" },
        "expiresAtUnixNanos": { "$ref": "#/$defs/positive" }, "maximumClockRateErrorPpm": { "$ref": "#/$defs/rateError" },
        "signingKeyId": { "$ref": "#/$defs/sha256" }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false, "required": ["payload", "signature"],
      "properties": { "payload": { "$ref": "#/$defs/anchorPayload" }, "signature": { "$ref": "#/$defs/signature" } }
    }
  }
}
