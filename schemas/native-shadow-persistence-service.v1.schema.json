{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-shadow-persistence-service.v1.schema.json",
  "$ref":"#/$defs/launch",
  "$defs":{
    "sha":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/sha256"},
    "signature":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/signature"},
    "guest":{"$ref":"native-custody-closure.v1.schema.json#/$defs/guest"},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "encoded":{"type":"string","minLength":1,"maxLength":4194304,"pattern":"^[A-Za-z0-9_-]+$"},
    "launch":{
      "type":"object","additionalProperties":false,"required":["apiVersion","keyAdmission","persistence"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowPersistenceGuestLaunch/v1"},
        "keyAdmission":{"$ref":"native-shadow-guest-admission.v1.schema.json#/$defs/launch"},
        "persistence":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"}}
    },
    "assignment":{
      "type":"object","additionalProperties":false,"required":["payload","signature"],
      "properties":{"payload":{"$ref":"#/$defs/grant"},"signature":{"$ref":"#/$defs/signature"}}
    },
    "grant":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","purpose","permissions","guest","assignmentPayloadSha256","keyAuthorizationSha256","proofScopeOriginalBase64url","journal","expectedPeer","trustCheckpointId","revocationGeneration","revocationRootSha256","issuedAtUnixNanos","expiresAtUnixNanos","signingKeyId","signingKeySpkiSha256"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowPersistenceServiceAssignment/v1"},
        "purpose":{"const":"native-shadow-receipt-persistence"},
        "permissions":{"enum":[["verify-persistence"],["store-dispatch-original","verify-persistence"]]},
        "guest":{"$ref":"#/$defs/guest"},"assignmentPayloadSha256":{"$ref":"#/$defs/sha"},"keyAuthorizationSha256":{"$ref":"#/$defs/sha"},
        "proofScopeOriginalBase64url":{"type":"string","minLength":1,"maxLength":21846,"pattern":"^[A-Za-z0-9_-]+$"},
        "journal":{"$ref":"#/$defs/journalAdmission"},"expectedPeer":{"$ref":"native-shadow-retrieval-service.v1.schema.json#/$defs/peer"},
        "trustCheckpointId":{"$ref":"#/$defs/sha"},"revocationGeneration":{"$ref":"#/$defs/positive"},"revocationRootSha256":{"$ref":"#/$defs/sha"},
        "issuedAtUnixNanos":{"$ref":"#/$defs/epoch"},"expiresAtUnixNanos":{"$ref":"#/$defs/epoch"},
        "signingKeyId":{"$ref":"#/$defs/sha"},"signingKeySpkiSha256":{"$ref":"#/$defs/sha"}
      },
      "description":"Independent assigned CustodySupervisorCapability signature under nativeShadowPersistenceServiceAssignment.signature/v1. Store permission is explicit and never implied by Verify, Retrieval, key possession or native activation. Actual assigned CustodyStoreResponse key stays inside the admitted guest."
    },
    "journalAdmission":{
      "type":"object","additionalProperties":false,"required":["genesisSha256","headSequence","headSha256"],
      "properties":{"genesisSha256":{"$ref":"#/$defs/sha"},"headSequence":{"type":"integer","minimum":0,"maximum":128},"headSha256":{"$ref":"#/$defs/sha"}},
      "description":"Exact independently admitted existing chain head. Sequence zero requires headSha256 equal genesisSha256. Missing, extra or partial records refuse; never repair/reset based on absence. Not an independent monotonic witness."
    },
    "genesis":{
      "type":"object","additionalProperties":false,"required":["apiVersion","proofScopeSha256","guest"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowPersistenceGenesis/v1"},"proofScopeSha256":{"$ref":"#/$defs/sha"},"guest":{"$ref":"#/$defs/guest"}}
    },
    "storeBody":{
      "type":"object","additionalProperties":false,"required":["requestKind","body"],
      "properties":{"requestKind":{"const":"store-dispatch-original"},"body":{
        "type":"object","additionalProperties":false,"required":["request_original_base64url","reply_original_base64url"],
        "properties":{"request_original_base64url":{"$ref":"#/$defs/encoded"},"reply_original_base64url":{"$ref":"#/$defs/encoded"}}
      }},
      "description":"Existing endpoint/v4 wrapper, fixed Persistence identity. Body fields retain existing enum snake-case convention. Entire canonical frame remains <=4194304 bytes; no payload fragmentation or higher global cap. Exact source-owned signed Dispatch request/reply only."
    },
    "committedResult":{
      "type":"object","additionalProperties":false,"required":["resultKind","body"],
      "properties":{"resultKind":{"const":"persistence-committed"},"body":{
        "type":"object","additionalProperties":false,"required":["commit_original_sha256"],"properties":{"commit_original_sha256":{"$ref":"#/$defs/sha"}}
      }}
    },
    "receipt":{
      "type":"object","additionalProperties":false,"required":["signerRole","persistenceReceiptSha256","canonicalPayloadBase64url","signedAuthorityPayloadBase64url","signingKeyId","signingKeySpkiSha256","signature","observedAtUnixNanos","trustedTimeCheckpointSha256"],
      "properties":{"signerRole":{"$ref":"native-shadow-retrieval-service.v1.schema.json#/$defs/role"},"persistenceReceiptSha256":{"$ref":"#/$defs/sha"},
        "canonicalPayloadBase64url":{"$ref":"#/$defs/encoded"},"signedAuthorityPayloadBase64url":{"$ref":"#/$defs/encoded"},
        "signingKeyId":{"$ref":"#/$defs/sha"},"signingKeySpkiSha256":{"$ref":"#/$defs/sha"},"signature":{"$ref":"#/$defs/signature"},
        "observedAtUnixNanos":{"$ref":"#/$defs/epoch"},"trustedTimeCheckpointSha256":{"$ref":"#/$defs/sha"}},
      "description":"Typed actual receipt, not caller input. Existing persistenceReceiptSha256 is its signed immutable lookup reference; commit original SHA separately commits the full signed original, avoiding self-hashing fixed points."
    },
    "commit":{
      "type":"object","additionalProperties":false,"required":["payload","signature"],
      "properties":{"signature":{"$ref":"#/$defs/signature"},"payload":{
        "type":"object","additionalProperties":false,"required":["apiVersion","guest","proofScopeSha256","sequence","previousHeadSha256","requestOriginalSha256","requestOriginalBase64url","replyOriginalBase64url","originalDeadlineBoottimeNanos","storedAtBoottimeNanos","receipt","signingKeyId","signingKeySpkiSha256"],
        "properties":{"apiVersion":{"const":"serverware.nativeShadowPersistenceCommit/v1"},"guest":{"$ref":"#/$defs/guest"},"proofScopeSha256":{"$ref":"#/$defs/sha"},
          "sequence":{"type":"integer","minimum":1,"maximum":128},"previousHeadSha256":{"$ref":"#/$defs/sha"},"requestOriginalSha256":{"$ref":"#/$defs/sha"},
          "requestOriginalBase64url":{"$ref":"#/$defs/encoded"},"replyOriginalBase64url":{"$ref":"#/$defs/encoded"},
          "originalDeadlineBoottimeNanos":{"$ref":"#/$defs/positive"},"storedAtBoottimeNanos":{"$ref":"#/$defs/positive"},
          "receipt":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/receipt"}]},"signingKeyId":{"$ref":"#/$defs/sha"},"signingKeySpkiSha256":{"$ref":"#/$defs/sha"}}
      }},
      "description":"CustodyStoreResponse signature under nativeShadowPersistenceCommit.signature/v1. Actual ordered request/reply original pair synced before signing; signed original and linked immutable head synced/read back before ACK. Null receipt retains a real nonreceipt dispatch result but cannot satisfy VerifyPersistence."
    },
    "head":{
      "type":"object","additionalProperties":false,"required":["apiVersion","sequence","previousHeadSha256","commitOriginalSha256"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowPersistenceHead/v1"},"sequence":{"type":"integer","minimum":1,"maximum":128},"previousHeadSha256":{"$ref":"#/$defs/sha"},"commitOriginalSha256":{"$ref":"#/$defs/sha"}}
    },
    "inspectionRequest":{
      "type":"object","additionalProperties":false,"required":["apiVersion","sequence","phase","frameSha256","deadlineBoottimeNs"],
      "properties":{"apiVersion":{"const":"serverware.nativeShadowPersistenceInspection/v1"},"sequence":{"$ref":"#/$defs/positive"},
        "phase":{"enum":["connection","before-dispatch","before-response"]},"frameSha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},
        "deadlineBoottimeNs":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/ns"}}
    }
  }
}
