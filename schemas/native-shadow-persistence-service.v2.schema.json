{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-shadow-persistence-service.v2.schema.json",
  "$ref": "#/$defs/assignment",
  "$defs": {
    "sha": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/sha"},
    "assignment": {
      "type": "object", "additionalProperties": false, "required": ["payload", "signature"],
      "properties": {
        "payload": {"$ref": "#/$defs/grant"},
        "signature": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/signature"}
      }
    },
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "permissions", "guest", "assignmentPayloadSha256", "keyAuthorizationSha256", "proofScopeOriginalBase64url", "journal", "expectedPeer", "trustCheckpointId", "revocationGeneration", "revocationRootSha256", "issuedAtUnixNanos", "expiresAtUnixNanos", "signingKeyId", "signingKeySpkiSha256"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeShadowPersistenceServiceAssignment/v2"},
        "purpose": {"const": "native-shadow-receipt-persistence"},
        "permissions": {"const": ["store-dispatch-original", "verify-persistence", "verify-completed-invocation"]},
        "guest": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/guest"},
        "assignmentPayloadSha256": {"$ref": "#/$defs/sha"},
        "keyAuthorizationSha256": {"$ref": "#/$defs/sha"},
        "proofScopeOriginalBase64url": {"type": "string", "minLength": 1, "maxLength": 21846, "pattern": "^[A-Za-z0-9_-]+$"},
        "journal": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/journalAdmission"},
        "expectedPeer": {"$ref": "native-shadow-retrieval-service.v1.schema.json#/$defs/peer"},
        "trustCheckpointId": {"$ref": "#/$defs/sha"},
        "revocationGeneration": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/positive"},
        "revocationRootSha256": {"$ref": "#/$defs/sha"},
        "issuedAtUnixNanos": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/epoch"},
        "expiresAtUnixNanos": {"$ref": "native-shadow-persistence-service.v1.schema.json#/$defs/epoch"},
        "signingKeyId": {"$ref": "#/$defs/sha"},
        "signingKeySpkiSha256": {"$ref": "#/$defs/sha"}
      },
      "description": "Explicit independent CustodySupervisorCapability signature under nativeShadowPersistenceServiceAssignment.signature/v2. Completion export is read-only, returns authenticated actual final originals, and does not assert provider success or process death. v1 grant grammar/domain remain unchanged."
    }
  }
}
