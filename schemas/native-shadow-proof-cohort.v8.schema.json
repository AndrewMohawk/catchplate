{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-shadow-proof-cohort.v8.schema.json",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "sha": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/sha"},
    "pin": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/pin"},
    "ns": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/ns"},
    "invocation": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/invocation"},
    "signature": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/signature"},
    "childOriginal": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/childOriginal"},
    "childTerminal": {"$ref": "native-shadow-proof-cohort.v2.schema.json#/$defs/childTerminal"},
    "roleRelease": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/roleRelease"},
    "controlConfiguration": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/controlConfiguration"},
    "precreation": {"$ref": "native-shadow-proof-cohort.v1.schema.json#/$defs/precreation"},
    "externalDriverPins": {"$ref": "native-shadow-proof-cohort.v7.schema.json#/$defs/externalDriverPins"},
    "driverBinding": {"$ref": "native-shadow-proof-cohort.v7.schema.json#/$defs/driverBinding"},
    "retainedProcess": {"$ref": "native-shadow-proof-cohort.v7.schema.json#/$defs/retainedProcess"},
    "externalDriverOriginal": {"$ref": "native-shadow-proof-cohort.v7.schema.json#/$defs/externalDriverOriginal"},
    "genesis": {"$ref": "native-shadow-proof-cohort.v2.schema.json#/$defs/genesis"},
    "record": {"$ref": "native-shadow-proof-cohort.v2.schema.json#/$defs/record"},
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "authority", "executableSha256", "retrievalConfiguration", "persistenceConfiguration", "trustedTimeConfiguration", "generationInstallConfiguration", "commitRequestConfiguration", "ingressAdmissionConfiguration", "terminalAppendConfiguration", "dispatchBarrierConfiguration", "activeEffectBarrierConfiguration", "activeEffectCommitConfiguration", "publicationReconciliationConfiguration", "externalDriver", "cleanup"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortConfiguration/v8"},
        "authority": {"$ref": "policy-custody-guest-delivery.v1.schema.json#/$defs/authority"},
        "executableSha256": {"$ref": "#/$defs/sha"},
        "retrievalConfiguration": {"$ref": "#/$defs/pin"},
        "persistenceConfiguration": {"$ref": "#/$defs/pin"},
        "trustedTimeConfiguration": {"$ref": "#/$defs/pin"},
        "generationInstallConfiguration": {"$ref": "#/$defs/pin"},
        "commitRequestConfiguration": {"$ref": "#/$defs/pin"},
        "ingressAdmissionConfiguration": {"$ref": "#/$defs/pin"},
        "terminalAppendConfiguration": {"$ref": "#/$defs/pin"},
        "dispatchBarrierConfiguration": {"$ref": "#/$defs/pin"},
        "activeEffectBarrierConfiguration": {"$ref": "#/$defs/pin"},
        "activeEffectCommitConfiguration": {"$ref": "#/$defs/pin"},
        "publicationReconciliationConfiguration": {"$ref": "#/$defs/pin"},
        "externalDriver": {"$ref": "#/$defs/externalDriverPins"},
        "cleanup": {"$ref": "native-shadow-proof-cohort.v2.schema.json#/$defs/cleanupConfiguration"}
      },
      "description": "Explicit adopted-publication successor: eleven owned endpoint children in the listed order, plus a separately retained real DriverBootstrap driver at logical slot 4. No bridgeConfiguration or bridge child. Retrieval requires launch/v6 and grant/v6 with all five actual activation FDs including readonly publication-genesis-core at FD10; Persistence requires launch/v3 and assignment/v4; PublicationReconciliation requires launch/v2 and assignment/v2. The new publication endpoint uses its real hot twelve-member closure role. Existing v1-v7 selections remain unchanged; profile choice is never inferred from extra roles."
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "configurationSha256", "precreationSha256", "invocationId", "retrieval", "persistence", "trustedTime", "generationInstall", "commitRequest", "ingressAdmission", "terminalAppend", "dispatchBarrier", "activeEffectBarrier", "activeEffectCommit", "publicationReconciliation", "externalDriver"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortOriginals/v7"},
        "configurationSha256": {"$ref": "#/$defs/sha"},
        "precreationSha256": {"$ref": "#/$defs/sha"},
        "invocationId": {"$ref": "#/$defs/invocation"},
        "retrieval": {"$ref": "#/$defs/childOriginal"},
        "persistence": {"$ref": "#/$defs/childOriginal"},
        "trustedTime": {"$ref": "#/$defs/childOriginal"},
        "generationInstall": {"$ref": "#/$defs/childOriginal"},
        "commitRequest": {"$ref": "#/$defs/childOriginal"},
        "ingressAdmission": {"$ref": "#/$defs/childOriginal"},
        "terminalAppend": {"$ref": "#/$defs/childOriginal"},
        "dispatchBarrier": {"$ref": "#/$defs/childOriginal"},
        "activeEffectBarrier": {"$ref": "#/$defs/childOriginal"},
        "activeEffectCommit": {"$ref": "#/$defs/childOriginal"},
        "publicationReconciliation": {"$ref": "#/$defs/childOriginal"},
        "externalDriver": {"$ref": "#/$defs/externalDriverOriginal"}
      },
      "description": "Actual eleven local child observations plus the separately retained live external driver binding. The external driver is not a cohort-owned ChildOriginal or a reaping claim."
    },
    "releasePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "configurationSha256", "precreationSha256", "observationSha256", "invocationId", "retrieval", "persistence", "trustedTime", "generationInstall", "commitRequest", "ingressAdmission", "terminalAppend", "dispatchBarrier", "activeEffectBarrier", "activeEffectCommit", "publicationReconciliation", "externalDriverSha256", "signingKeyId"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortRelease/v7"},
        "configurationSha256": {"$ref": "#/$defs/sha"},
        "precreationSha256": {"$ref": "#/$defs/sha"},
        "observationSha256": {"$ref": "#/$defs/sha"},
        "invocationId": {"$ref": "#/$defs/invocation"},
        "retrieval": {"$ref": "#/$defs/roleRelease"},
        "persistence": {"$ref": "#/$defs/roleRelease"},
        "trustedTime": {"$ref": "#/$defs/roleRelease"},
        "generationInstall": {"$ref": "#/$defs/roleRelease"},
        "commitRequest": {"$ref": "#/$defs/roleRelease"},
        "ingressAdmission": {"$ref": "#/$defs/roleRelease"},
        "terminalAppend": {"$ref": "#/$defs/roleRelease"},
        "dispatchBarrier": {"$ref": "#/$defs/roleRelease"},
        "activeEffectBarrier": {"$ref": "#/$defs/roleRelease"},
        "activeEffectCommit": {"$ref": "#/$defs/roleRelease"},
        "publicationReconciliation": {"$ref": "#/$defs/roleRelease"},
        "externalDriverSha256": {"$ref": "#/$defs/sha"},
        "signingKeyId": {"$ref": "#/$defs/sha"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "signatureBase64url"],
      "properties": {"payload": {"$ref": "#/$defs/releasePayload"}, "signatureBase64url": {"$ref": "#/$defs/signature"}},
      "description": "C9 authority signs ASCII serverware.nativeShadowProofCohortRelease.signature/v7, NUL, complete canonical payload. All eleven inventories, exact actual descriptors, parked peers and image/closure originals are checked before first release. Existing 32768-byte packet and 128-rights bounds remain. Driver continuation is a separate real operation."
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "configurationSha256", "precreationSha256", "observationSha256", "releaseSha256", "invocationId", "operationIdSha256", "requestedAtBoottimeNs", "deadlineBoottimeNs", "signingKeyId", "externalDriverSha256"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortCleanup/v7"},
        "purpose": {"const": "terminate-owned-proof-cohort"},
        "configurationSha256": {"$ref": "#/$defs/sha"},
        "precreationSha256": {"$ref": "#/$defs/sha"},
        "observationSha256": {"$ref": "#/$defs/sha"},
        "releaseSha256": {"$ref": "#/$defs/sha"},
        "invocationId": {"$ref": "#/$defs/invocation"},
        "operationIdSha256": {"$ref": "#/$defs/sha"},
        "requestedAtBoottimeNs": {"$ref": "#/$defs/ns"},
        "deadlineBoottimeNs": {"$ref": "#/$defs/ns"},
        "signingKeyId": {"$ref": "#/$defs/sha"},
        "externalDriverSha256": {"$ref": "#/$defs/sha"}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["payload", "signatureBase64url"],
      "properties": {"payload": {"$ref": "#/$defs/payload"}, "signatureBase64url": {"$ref": "#/$defs/signature"}},
      "description": "Independent cleanup authority signs ASCII serverware.nativeShadowProofCohortCleanup.signature/v7, NUL, complete canonical payload. Original lifetime and cleanup bounds remain; only the eleven owned endpoints may be signaled and reaped."
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "authorizationSha256", "configurationSha256", "precreationSha256", "observationSha256", "releaseSha256", "invocationId", "completedAtBoottimeNs", "children", "externalDriverSha256"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortTerminal/v7"},
        "authorizationSha256": {"$ref": "#/$defs/sha"},
        "configurationSha256": {"$ref": "#/$defs/sha"},
        "precreationSha256": {"$ref": "#/$defs/sha"},
        "observationSha256": {"$ref": "#/$defs/sha"},
        "releaseSha256": {"$ref": "#/$defs/sha"},
        "invocationId": {"$ref": "#/$defs/invocation"},
        "completedAtBoottimeNs": {"$ref": "#/$defs/ns"},
        "externalDriverSha256": {"$ref": "#/$defs/sha"},
        "children": {
          "type": "object", "additionalProperties": false,
          "required": ["retrieval", "persistence", "trustedTime", "generationInstall", "commitRequest", "ingressAdmission", "terminalAppend", "dispatchBarrier", "activeEffectBarrier", "activeEffectCommit", "publicationReconciliation"],
          "properties": {
            "retrieval": {"$ref": "#/$defs/childTerminal"},
            "persistence": {"$ref": "#/$defs/childTerminal"},
            "trustedTime": {"$ref": "#/$defs/childTerminal"},
            "generationInstall": {"$ref": "#/$defs/childTerminal"},
            "commitRequest": {"$ref": "#/$defs/childTerminal"},
            "ingressAdmission": {"$ref": "#/$defs/childTerminal"},
            "terminalAppend": {"$ref": "#/$defs/childTerminal"},
            "dispatchBarrier": {"$ref": "#/$defs/childTerminal"},
            "activeEffectBarrier": {"$ref": "#/$defs/childTerminal"},
            "activeEffectCommit": {"$ref": "#/$defs/childTerminal"},
            "publicationReconciliation": {"$ref": "#/$defs/childTerminal"}
          }
        }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "authorizationSha256", "intentRecordSha256", "terminalOriginal", "terminalRecordSha256", "externalDriverSha256"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeShadowProofCohortCleanupResult/v7"},
        "authorizationSha256": {"$ref": "#/$defs/sha"},
        "intentRecordSha256": {"$ref": "#/$defs/sha"},
        "terminalRecordSha256": {"$ref": "#/$defs/sha"},
        "externalDriverSha256": {"$ref": "#/$defs/sha"},
        "terminalOriginal": {"type": "string", "minLength": 1, "maxLength": 32256, "pattern": "^[\\u0000-\\u007f]+$"}
      },
      "description": "Complete response <=32768 bytes. Literal eleven-endpoint terminal plus actual durable journal readback after consuming each owned child's PIDFD wait. The foreign driver binding is retained, not claimed terminated or reaped."
    }
  }
}
