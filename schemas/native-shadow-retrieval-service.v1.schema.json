{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/native-shadow-retrieval-service.v1.schema.json",
  "$ref":"#/$defs/launch",
  "$defs":{
    "sha":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/sha256"},
    "ns":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/ns"},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "uid":{"type":"integer","minimum":1,"maximum":4294967294},
    "launch":{
      "type":"object","additionalProperties":false,"required":["apiVersion","keyAdmission","retrieval"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowRetrievalGuestLaunch/v1"},
        "keyAdmission":{"$ref":"native-shadow-guest-admission.v1.schema.json#/$defs/launch"},
        "retrieval":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"}
      }
    },
    "peer":{
      "type":"object","additionalProperties":false,
      "required":["uid","gid","pid","processIdentitySha256","startTimeTicks","executableDevice","executableInode","executableLength","executableSha256","cgroupPathSha256","cgroupMountId","cgroupInode","securityLabelSha256","configurationGenerationSha256"],
      "properties":{
        "uid":{"$ref":"#/$defs/uid"},"gid":{"$ref":"#/$defs/uid"},"pid":{"type":"integer","minimum":2,"maximum":2147483647},
        "processIdentitySha256":{"$ref":"#/$defs/sha"},"startTimeTicks":{"$ref":"#/$defs/positive"},
        "executableDevice":{"$ref":"#/$defs/positive"},"executableInode":{"$ref":"#/$defs/positive"},
        "executableLength":{"type":"integer","minimum":1,"maximum":268435456},"executableSha256":{"$ref":"#/$defs/sha"},
        "cgroupPathSha256":{"$ref":"#/$defs/sha"},"cgroupMountId":{"$ref":"#/$defs/positive"},
        "cgroupInode":{"$ref":"#/$defs/positive"},"securityLabelSha256":{"$ref":"#/$defs/sha"},
        "configurationGenerationSha256":{"$ref":"#/$defs/sha"}
      }
    },
    "assignment":{
      "type":"object","additionalProperties":false,"required":["payload","signature"],
      "properties":{"payload":{"$ref":"#/$defs/payload"},"signature":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/signature"}}
    },
    "payload":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","purpose","guest","assignmentPayloadSha256","keyAuthorizationSha256","proofScopeOriginalBase64url","expectedPeer","trustCheckpointId","revocationGeneration","revocationRootSha256","issuedAtUnixNanos","expiresAtUnixNanos","signingKeyId","signingKeySpkiSha256"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowRetrievalServiceAssignment/v1"},
        "purpose":{"const":"native-shadow-immutable-retrieval"},
        "guest":{"$ref":"native-custody-closure.v1.schema.json#/$defs/guest"},
        "assignmentPayloadSha256":{"$ref":"#/$defs/sha"},"keyAuthorizationSha256":{"$ref":"#/$defs/sha"},
        "proofScopeOriginalBase64url":{"type":"string","minLength":1,"maxLength":21846,"pattern":"^[A-Za-z0-9_-]+$","description":"Exact canonical original from genuine ProductionCustodyConfiguration.proof_scope(); decoded maximum 16384 bytes. Not a driver constructor."},
        "expectedPeer":{"$ref":"#/$defs/peer"},"trustCheckpointId":{"$ref":"#/$defs/sha"},
        "revocationGeneration":{"$ref":"#/$defs/positive"},"revocationRootSha256":{"$ref":"#/$defs/sha"},
        "issuedAtUnixNanos":{"$ref":"#/$defs/epoch"},"expiresAtUnixNanos":{"$ref":"#/$defs/epoch"},
        "signingKeyId":{"$ref":"#/$defs/sha"},"signingKeySpkiSha256":{"$ref":"#/$defs/sha"}
      }
    },
    "role":{"enum":["ingress-admission","unavailable-ingress","dispatch-barrier","terminal-append","ledger-append","spool-compaction","active-effect-barrier","active-effect-commit","publication-reconciliation","activation-publication"]},
    "object":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","proofScopeSha256","signerRole","canonicalReceiptPayloadBase64url","signedAuthorityPayloadBase64url"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowImmutableRetrievalObject/v1"},
        "proofScopeSha256":{"$ref":"#/$defs/sha"},"signerRole":{"$ref":"#/$defs/role"},
        "canonicalReceiptPayloadBase64url":{"type":"string","minLength":1,"maxLength":1398102,"pattern":"^[A-Za-z0-9_-]+$"},
        "signedAuthorityPayloadBase64url":{"type":"string","minLength":1,"maxLength":21846,"pattern":"^[A-Za-z0-9_-]+$"}
      },
      "description":"Whole canonical object is additionally capped at 1048576 bytes. Root:root0444, one link, actual SHA256 fs-verity enabled; no absence, read-only mount, or caller measurement substitute."
    },
    "inspectionRequest":{
      "type":"object","additionalProperties":false,"required":["apiVersion","sequence","phase","frameSha256","deadlineBoottimeNs"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowRetrievalInspection/v1"},"sequence":{"$ref":"#/$defs/positive"},
        "phase":{"enum":["connection","before-dispatch","before-response"]},
        "frameSha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"deadlineBoottimeNs":{"$ref":"#/$defs/ns"}
      },
      "description":"Private FD4 only; connection has null frame and exact accepted socket+connection PIDFD rights, other phases have frame SHA and exact packet PIDFD right. Kernel sender credentials/PIDFD required throughout."
    },
    "inspectionReply":{
      "type":"object","additionalProperties":false,"required":["apiVersion","requestSha256","processIdentitySha256"],
      "properties":{
        "apiVersion":{"const":"serverware.nativeShadowRetrievalInspection/v1"},
        "requestSha256":{"$ref":"#/$defs/sha"},"processIdentitySha256":{"$ref":"#/$defs/sha"}
      },
      "description":"Exact same-parent kernel-authenticated measurement response, not a serialized host measurement owner or generic verified verdict."
    }
  }
}

