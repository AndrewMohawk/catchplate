{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/native-shadow-trusted-time-service.v1.schema.json",
  "$ref":"#/$defs/launch",
  "$defs":{
    "sha":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/sha256"},
    "ns":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/ns"},
    "epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "launch":{
      "type":"object","additionalProperties":false,"required":["apiVersion","keyAdmission","trustedTime"],
      "properties":{
        "apiVersion":{"const":"catchplate.nativeShadowTrustedTimeGuestLaunch/v1"},
        "keyAdmission":{"$ref":"native-shadow-guest-admission.v1.schema.json#/$defs/launch"},
        "trustedTime":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"}
      }
    },
    "proofBridgeLaunch":{
      "type":"object","additionalProperties":false,"required":["apiVersion","keyAdmission","trustedTime"],
      "properties":{
        "apiVersion":{"const":"catchplate.nativeProofBridgeLaunch/v1"},
        "keyAdmission":{"$ref":"native-shadow-guest-admission.v1.schema.json#/$defs/launch"},
        "trustedTime":{"$ref":"policy-custody-guest-delivery.v1.schema.json#/$defs/pin"}
      },
      "description":"Separately pins the original server operational grant after C9 exists. Runtime retains complete five-service/ten-signer/four-proof requirements and selects all four fixed inspected proof endpoints; no generic endpoint list."
    },
    "assignment":{
      "type":"object","additionalProperties":false,"required":["payload","signature"],
      "properties":{"payload":{"$ref":"#/$defs/payload"},"signature":{"$ref":"native-shadow-role-keys.v1.schema.json#/$defs/signature"}}
    },
    "payload":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","purpose","guest","assignmentPayloadSha256","keyAuthorizationSha256","clockBootstrapSha256","expectedPeer","trustCheckpointId","revocationGeneration","revocationRootSha256","issuedAtUnixNanos","expiresAtUnixNanos","signingKeyId","signingKeySpkiSha256"],
      "properties":{
        "apiVersion":{"const":"catchplate.nativeShadowTrustedTimeServiceAssignment/v1"},
        "purpose":{"const":"native-shadow-trusted-time-response"},
        "guest":{"$ref":"native-custody-closure.v1.schema.json#/$defs/guest"},
        "assignmentPayloadSha256":{"$ref":"#/$defs/sha"},"keyAuthorizationSha256":{"$ref":"#/$defs/sha"},
        "clockBootstrapSha256":{"$ref":"#/$defs/sha"},
        "expectedPeer":{"$ref":"native-shadow-retrieval-service.v1.schema.json#/$defs/peer"},
        "trustCheckpointId":{"$ref":"#/$defs/sha"},"revocationGeneration":{"$ref":"#/$defs/positive"},
        "revocationRootSha256":{"$ref":"#/$defs/sha"},"issuedAtUnixNanos":{"$ref":"#/$defs/epoch"},
        "expiresAtUnixNanos":{"$ref":"#/$defs/epoch"},"signingKeyId":{"$ref":"#/$defs/sha"},"signingKeySpkiSha256":{"$ref":"#/$defs/sha"}
      },
      "description":"SupervisorCapability signature under the NEW trusted-time service domain, not key-admission or issuer authority. Whole canonical envelope <=65536 bytes."
    },
    "sample":{
      "type":"object","additionalProperties":false,
      "required":["apiVersion","purpose","assignmentPayloadSha256","serviceGuestSha256","clockAnchorSha256","clockBootstrapSha256","bootIdBase64url","timeNamespaceDevice","timeNamespaceInode","sampledAtBoottimeNs","earliestUnixNanos","latestUnixNanos","maximumClockRateErrorPpm","anchorExpiresAtUnixNanos","lifetimeDeadlineBoottimeNs","operationSha256"],
      "properties":{
        "apiVersion":{"const":"catchplate.nativeShadowTrustedTimeSample/v1"},
        "purpose":{"const":"native-shadow-trusted-time-sample"},
        "assignmentPayloadSha256":{"$ref":"#/$defs/sha"},"serviceGuestSha256":{"$ref":"#/$defs/sha"},
        "clockAnchorSha256":{"$ref":"#/$defs/sha"},"clockBootstrapSha256":{"$ref":"#/$defs/sha"},
        "bootIdBase64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{22}$"},
        "timeNamespaceDevice":{"$ref":"#/$defs/positive"},"timeNamespaceInode":{"$ref":"#/$defs/positive"},
        "sampledAtBoottimeNs":{"$ref":"#/$defs/ns"},"earliestUnixNanos":{"$ref":"#/$defs/epoch"},
        "latestUnixNanos":{"$ref":"#/$defs/epoch"},
        "maximumClockRateErrorPpm":{"type":"integer","minimum":0,"maximum":10000},
        "anchorExpiresAtUnixNanos":{"$ref":"#/$defs/epoch"},"lifetimeDeadlineBoottimeNs":{"$ref":"#/$defs/ns"},
        "operationSha256":{"$ref":"#/$defs/sha"}
      },
      "description":"Data only until exact native endpoint signature and retained operational grant admission. Both interval ends advance from sampled CLOCK_BOOTTIME, widened by ceil(elapsed*ppm/1e6); never arrival time."
    },
    "endpointRequestBody":{
      "type":"object","additionalProperties":false,"required":["requestKind","body"],
      "properties":{"requestKind":{"const":"sample-trusted-time"},"body":{
        "type":"object","additionalProperties":false,"required":["operation_sha256"],
        "properties":{"operation_sha256":{"$ref":"#/$defs/sha"}}
      }}
    },
    "endpointResultBody":{
      "type":"object","additionalProperties":false,"required":["resultKind","body"],
      "properties":{"resultKind":{"const":"trusted-time-interval"},"body":{"$ref":"#/$defs/sample"}}
    },
    "proofInspectionRequest":{
      "type":"object","additionalProperties":false,"required":["apiVersion","endpoint","sequence","phase","frameSha256","deadlineBoottimeNs"],
      "properties":{
        "apiVersion":{"const":"catchplate.nativeShadowProofClientInspection/v1"},
        "endpoint":{"enum":["retrieval","persistence","trusted-time","generation-install-envelope"]},
        "sequence":{"$ref":"#/$defs/positive"},"phase":{"enum":["connection","before-send","after-receive","after-verify"]},
        "frameSha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"deadlineBoottimeNs":{"$ref":"#/$defs/ns"}
      },
      "description":"Actual private FD4 only; exact child SCM credentials/PIDFD and one original server PIDFD required. Endpoint is a fixed registry key, never a PID/path selector."
    }
  }
}
