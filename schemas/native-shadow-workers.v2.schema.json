{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-shadow-workers.v2.schema.json",
  "title": "Explicit native shadow worker with local publication resources",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "configuration": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","executable","resources"],
      "properties": {
        "apiVersion":{"const":"serverware.nativeShadowWorkers/v2"},
        "executable": {
          "type":"object","additionalProperties":false,"required":["path","sha256"],
          "properties": {
            "path":{"const":"/usr/local/bin/serverware-native-shadow-worker"},
            "sha256":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/sha256"}
          }
        },
        "resources":{"$ref":"native-shadow-publication-resources.v1.schema.json#/$defs/configuration"}
      },
      "$comment":"Explicit v2 only. Legacy v1 remains its original closed two-field configuration. Only Publication jobs receive admitted key/journal resources; Runtime and WebAuthn retain their original descriptor roster. Private process framing is not public resource admission."
    },
    "shadowConfiguration": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","trustManifest","runtimeVerifier","webauthnVerifier","publicationHandoff","custodyConfig","startupActiveAuthorization","workers"],
      "properties": {
        "apiVersion":{"const":"serverware.nativeShadowConfiguration/v4"},
        "trustManifest":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "runtimeVerifier":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "webauthnVerifier":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "publicationHandoff":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "custodyConfig":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "startupActiveAuthorization":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "workers":{"$ref":"#/$defs/configuration"},
        "nativeActivation":{"oneOf":[
          {"$ref":"native-policy-activation-custody.v1.schema.json#/$defs/client"},
          {"$ref":"native-policy-activation-custody.v2.schema.json#/$defs/client"},
          {"$ref":"native-policy-activation-custody.v3.schema.json#/$defs/client"}
        ]}
      },
      "$comment":"Explicit v4 selects worker-v2 and permits separately admitted native activation. Legacy shadow v2/v3 retain worker-v1; this does not widen those original profiles or grant runtime authority."
    }
  }
}
