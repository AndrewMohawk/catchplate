{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-shadow-workers.v3.schema.json",
  "title": "Native shadow worker with independent runtime verifier resources",
  "$ref": "#/$defs/configuration",
  "$defs": {
    "configuration": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","executable","runtimeResources"],
      "properties": {
        "apiVersion":{"const":"serverware.nativeShadowWorkers/v3"},
        "executable":{"$ref":"native-shadow-workers.v2.schema.json#/$defs/configuration/properties/executable"},
        "runtimeResources":{"$ref":"native-shadow-runtime-resources.v1.schema.json#/$defs/configuration"},
        "publicationResources":{"$ref":"native-shadow-publication-resources.v1.schema.json#/$defs/configuration"}
      },
      "$comment":"Runtime resources go only to the fixed runtime verifier; optional publication resources go only to the fixed publication job. WebAuthn remains unchanged. Inherited descriptor presence cannot select authority."
    },
    "shadowConfiguration": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","trustManifest","runtimeVerifier","webauthnVerifier","publicationHandoff","custodyConfig","startupActiveAuthorization","workers"],
      "properties": {
        "apiVersion":{"const":"serverware.nativeShadowConfiguration/v5"},
        "trustManifest":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "runtimeVerifier":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "webauthnVerifier":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "publicationHandoff":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/command"},
        "custodyConfig":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "startupActiveAuthorization":{"$ref":"native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "workers":{"$ref":"#/$defs/configuration"},
        "nativeActivation":{"$ref":"native-policy-activation-custody.v1.schema.json#/$defs/client"}
      }
    }
  }
}
