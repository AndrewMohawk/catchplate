{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-startup-configuration.v14.schema.json",
  "title": "Explicit native gate-cgroup startup",
  "$comment": "Exact v13 owners plus mandatory gateCgroup. Earlier versions never create or attach this leaf. All existing encrypted-service, independent authority, native identity, original deadline, broker, guest cohort, actual readiness and secret provisioning requirements remain. Local cgroup creation grants neither staging nor target dispatch and is not evidence of supported/running Nitro kernel behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "gate", "native", "shadow", "responseObservationV2", "policy",
    "enrollmentAuthorizer", "enrollmentSetupAuthorizer", "enrollmentProxyEndpoint",
    "credentialCurrentness", "secretBroker", "measuredAudit", "encryptedServiceTokens",
    "measuredRefresh", "guestInspector", "measuredIssuance", "guestCohort", "measuredCleanup",
    "guestRoleKeyProvisioner", "measuredPendingRetirement", "gateCgroup"
  ],
  "properties": {
    "apiVersion": {"const": "serverware.nativeStartupConfiguration/v14"},
    "gate": {"$ref": "native-startup-configuration.v13.schema.json#/properties/gate"},
    "native": {"$ref": "native-startup-configuration.v13.schema.json#/properties/native"},
    "shadow": {"$ref": "native-startup-configuration.v13.schema.json#/properties/shadow"},
    "responseObservationV2": {"oneOf": [
      {"$ref": "native-startup-configuration.v13.schema.json#/properties/responseObservationV2"},
      {"$ref": "response-v2-native-staging.v1.schema.json#/$defs/nativeClient"}
    ]},
    "policy": {"$ref": "native-startup-configuration.v13.schema.json#/properties/policy"},
    "enrollmentAuthorizer": {"$ref": "native-startup-configuration.v13.schema.json#/properties/enrollmentAuthorizer"},
    "enrollmentSetupAuthorizer": {"$ref": "native-startup-configuration.v13.schema.json#/properties/enrollmentSetupAuthorizer"},
    "enrollmentProxyEndpoint": {"$ref": "native-startup-configuration.v13.schema.json#/properties/enrollmentProxyEndpoint"},
    "credentialCurrentness": {"$ref": "native-startup-configuration.v13.schema.json#/properties/credentialCurrentness"},
    "secretBroker": {"$ref": "native-startup-configuration.v13.schema.json#/properties/secretBroker"},
    "measuredAudit": {"$ref": "native-startup-configuration.v13.schema.json#/properties/measuredAudit"},
    "encryptedServiceTokens": {"$ref": "native-startup-configuration.v13.schema.json#/properties/encryptedServiceTokens"},
    "measuredRefresh": {"$ref": "native-startup-configuration.v13.schema.json#/properties/measuredRefresh"},
    "guestInspector": {"$ref": "native-startup-configuration.v13.schema.json#/properties/guestInspector"},
    "measuredIssuance": {"$ref": "native-startup-configuration.v13.schema.json#/properties/measuredIssuance"},
    "guestCohort": {"$ref": "native-startup-configuration.v13.schema.json#/properties/guestCohort"},
    "measuredCleanup": {"$ref": "native-startup-configuration.v13.schema.json#/properties/measuredCleanup"},
    "guestRoleKeyProvisioner": {"$ref": "native-startup-configuration.v13.schema.json#/properties/guestRoleKeyProvisioner"},
    "measuredPendingRetirement": {"$ref": "native-startup-configuration.v13.schema.json#/properties/measuredPendingRetirement"},
    "gateCgroup": {"$ref": "native-gate-cgroup.v1.schema.json"}
  }
}
