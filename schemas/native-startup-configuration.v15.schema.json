{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-startup-configuration.v15.schema.json",
  "title": "Explicit native measured Setup startup",
  "$comment": "Exact v14 owners with measuredSetup replacing measuredIssuance. There is one cold-selected actual browser/helper purpose; no second listener, callback inference or signed-authority conversion. All earlier profiles remain unchanged. Source configuration does not supply independent enrollment, assignments, KMS custody or runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "gate", "native", "shadow", "responseObservationV2", "policy",
    "enrollmentAuthorizer", "enrollmentSetupAuthorizer", "enrollmentProxyEndpoint",
    "credentialCurrentness", "secretBroker", "measuredAudit", "encryptedServiceTokens",
    "measuredRefresh", "guestInspector", "measuredSetup", "guestCohort", "measuredCleanup",
    "guestRoleKeyProvisioner", "measuredPendingRetirement", "gateCgroup"
  ],
  "properties": {
    "apiVersion": {"const": "catchplate.nativeStartupConfiguration/v15"},
    "gate": {"$ref": "native-startup-configuration.v14.schema.json#/properties/gate"},
    "native": {"$ref": "native-startup-configuration.v14.schema.json#/properties/native"},
    "shadow": {"oneOf": [
      {"$ref": "native-startup-configuration.v14.schema.json#/properties/shadow"},
      {"$ref": "native-shadow-workers.v1.schema.json#/$defs/shadowConfiguration"},
      {"$ref": "native-policy-activation-custody.v1.schema.json#/$defs/shadowConfiguration"},
      {"$ref": "native-shadow-workers.v2.schema.json#/$defs/shadowConfiguration"},
      {"$ref": "native-shadow-workers.v3.schema.json#/$defs/shadowConfiguration"},
      {"$ref": "#/$defs/nativeOnlyShadowConfiguration"}
    ]},
    "responseObservationV2": {"$ref": "native-startup-configuration.v14.schema.json#/properties/responseObservationV2"},
    "policy": {"$ref": "native-startup-configuration.v14.schema.json#/properties/policy"},
    "enrollmentAuthorizer": {"$ref": "native-startup-configuration.v14.schema.json#/properties/enrollmentAuthorizer"},
    "enrollmentSetupAuthorizer": {"$ref": "native-startup-configuration.v14.schema.json#/properties/enrollmentSetupAuthorizer"},
    "enrollmentProxyEndpoint": {"$ref": "native-startup-configuration.v14.schema.json#/properties/enrollmentProxyEndpoint"},
    "credentialCurrentness": {"$ref": "native-startup-configuration.v14.schema.json#/properties/credentialCurrentness"},
    "secretBroker": {"$ref": "native-startup-configuration.v14.schema.json#/properties/secretBroker"},
    "measuredAudit": {"$ref": "native-startup-configuration.v14.schema.json#/properties/measuredAudit"},
    "encryptedServiceTokens": {"$ref": "native-startup-configuration.v14.schema.json#/properties/encryptedServiceTokens"},
    "measuredRefresh": {"$ref": "native-startup-configuration.v14.schema.json#/properties/measuredRefresh"},
    "guestInspector": {"$ref": "native-startup-configuration.v14.schema.json#/properties/guestInspector"},
    "measuredSetup": {"$ref": "native-oauth-measured-setup.v1.schema.json#/$defs/configuration"},
    "guestCohort": {"$ref": "native-startup-configuration.v14.schema.json#/properties/guestCohort"},
    "measuredCleanup": {"$ref": "native-startup-configuration.v14.schema.json#/properties/measuredCleanup"},
    "guestRoleKeyProvisioner": {"$ref": "native-startup-configuration.v14.schema.json#/properties/guestRoleKeyProvisioner"},
    "measuredPendingRetirement": {"$ref": "native-startup-configuration.v14.schema.json#/properties/measuredPendingRetirement"},
    "gateCgroup": {"$ref": "native-gate-cgroup.v1.schema.json"}
  },
  "$defs": {
    "nativeOnlyShadowConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "trustManifest", "runtimeVerifier", "publicationHandoff", "custodyConfig", "startupActiveAuthorization", "workers", "nativeActivation"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeShadowConfiguration/v6"},
        "trustManifest": {"$ref": "native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "runtimeVerifier": {"$ref": "native-shadow-workers.v1.schema.json#/$defs/command"},
        "publicationHandoff": {"$ref": "native-shadow-workers.v1.schema.json#/$defs/command"},
        "custodyConfig": {"$ref": "native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "startupActiveAuthorization": {"$ref": "native-shadow-workers.v1.schema.json#/$defs/artifact"},
        "workers": {"allOf": [
          {"$ref": "native-shadow-workers.v3.schema.json#/$defs/configuration"},
          {"required": ["publicationResources"]}
        ]},
        "nativeActivation": {"oneOf": [
          {"$ref": "native-policy-activation-custody.v1.schema.json#/$defs/client"},
          {"$ref": "native-policy-activation-custody.v2.schema.json#/$defs/client"},
          {"$ref": "native-policy-activation-custody.v3.schema.json#/$defs/client"}
        ]}
      },
      "$comment": "Only genuine native controlled activation is selected. WebAuthn verifier commands and legacy activation are absent, not replaced by synthetic approvals. Runtime/publication resources and native activation channel are required; existing trust-manifest requirements remain unchanged. Preboot delivery does not synthesize these inherited resources."
    }
  }
}
