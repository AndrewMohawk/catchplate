    "secretBroker": {"$ref": "native-startup-configuration.v15.schema.json#/properties/secretBroker"},
    "measuredAudit": {"$ref": "native-startup-configuration.v15.schema.json#/properties/measuredAudit"},
    "encryptedServiceTokens": {"$ref": "native-startup-configuration.v15.schema.json#/properties/encryptedServiceTokens"},
    "measuredRefresh": {"$ref": "native-startup-configuration.v15.schema.json#/properties/measuredRefresh"},
    "guestInspector": {"$ref": "native-startup-configuration.v15.schema.json#/properties/guestInspector"},
