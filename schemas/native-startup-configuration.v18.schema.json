    "guestRoleKeyProvisioner": {"$ref": "native-startup-configuration.v17.schema.json#/properties/guestRoleKeyProvisioner"},
    "measuredPendingRetirement": {"$ref": "native-startup-configuration.v17.schema.json#/properties/measuredPendingRetirement"},
    "gateCgroup": {"$ref": "native-startup-configuration.v17.schema.json#/properties/gateCgroup"},
    "measuredCaptureRetirement": {"$ref": "native-oauth-capture-retirement.v1.schema.json#/$defs/configuration"}
  }
