    "enrollmentAuthorizer", "enrollmentSetupAuthorizer", "enrollmentProxyEndpoint",
    "credentialCurrentness", "secretBroker", "measuredAudit", "encryptedServiceTokens",
    "measuredRefresh", "guestInspector", "measuredSuccession", "guestCohort", "measuredCleanup",
    "guestRoleKeyProvisioner", "measuredPendingRetirement", "gateCgroup", "measuredCaptureRetirement"
  ],
  "properties": {
    "apiVersion": {"const": "serverware.nativeStartupConfiguration/v18"},
    "gate": {"$ref": "native-startup-configuration.v17.schema.json#/properties/gate"},
    "native": {"$ref": "native-startup-configuration.v17.schema.json#/properties/native"},
    "shadow": {"$ref": "native-startup-configuration.v17.schema.json#/properties/shadow"},
    "responseObservationV2": {"$ref": "native-startup-configuration.v17.schema.json#/properties/responseObservationV2"},
    "policy": {"$ref": "native-startup-configuration.v17.schema.json#/properties/policy"},
    "enrollmentAuthorizer": {"$ref": "native-startup-configuration.v17.schema.json#/properties/enrollmentAuthorizer"},
    "enrollmentSetupAuthorizer": {"$ref": "native-startup-configuration.v17.schema.json#/properties/enrollmentSetupAuthorizer"},
    "enrollmentProxyEndpoint": {"$ref": "native-startup-configuration.v17.schema.json#/properties/enrollmentProxyEndpoint"},
    "credentialCurrentness": {"$ref": "native-startup-configuration.v17.schema.json#/properties/credentialCurrentness"},
    "secretBroker": {"$ref": "native-secret-broker.v2.schema.json#/$defs/configuration"},
    "measuredAudit": {"$ref": "native-startup-configuration.v17.schema.json#/properties/measuredAudit"},
    "encryptedServiceTokens": {"$ref": "native-startup-configuration.v17.schema.json#/properties/encryptedServiceTokens"},
    "measuredRefresh": {"$ref": "native-startup-configuration.v17.schema.json#/properties/measuredRefresh"},
    "guestInspector": {"$ref": "native-startup-configuration.v17.schema.json#/properties/guestInspector"},
    "measuredSuccession": {"$ref": "native-oauth-retired-scope-succession.v1.schema.json#/$defs/configuration"},
