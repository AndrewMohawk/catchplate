{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/native-startup-configuration.v5.schema.json",
  "title": "Cold native full proxy with measured secret-broker and audit owners",
  "$comment": "Explicit additive v5, original <=16MiB integer-only duplicate-free JSON. This configuration is not independent release admission. Source finishes privileged device/image/child preparation, permanently drops to fixed UID/GID65534 with no groups/capabilities, and only then creates serving identities/clients. Actual NSM/broker resources require the same retained private owner; no identity rebinding or deadline renewal. Old versions do not select these owners. Private service tokens, real ledger/socket/file permissions, full image provisioning and original-deadline checks remain mandatory beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "gate", "native", "shadow", "responseObservationV2", "policy", "enrollmentAuthorizer", "enrollmentSetupAuthorizer", "enrollmentProxyEndpoint", "credentialCurrentness", "secretBroker", "measuredAudit"],
  "properties": {
    "apiVersion": {"const": "catchplate.nativeStartupConfiguration/v5"},
    "gate": {
      "allOf": [
        {"$ref": "native-startup-configuration.v4.schema.json#/$defs/gate"},
        {"required": ["auditUrl"], "properties": {"auditUrl": {"type": "string", "minLength": 1, "maxLength": 4096}, "auditToken": {"type": "null"}}}
      ]
    },
    "native": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/native"},
    "shadow": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/shadow"},
    "responseObservationV2": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/responseObservation"},
    "policy": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/artifact"},
    "enrollmentAuthorizer": {"$ref": "native-enrollment-authorizer.v1.schema.json"},
    "enrollmentSetupAuthorizer": {"$ref": "native-enrollment-setup-authorizer.v1.schema.json"},
    "enrollmentProxyEndpoint": {"type": "string", "minLength": 1, "maxLength": 4096},
    "credentialCurrentness": {"$ref": "native-startup-configuration.v4.schema.json#/properties/credentialCurrentness"},
    "secretBroker": {"$ref": "native-secret-broker.v1.schema.json#/$defs/configuration"},
    "measuredAudit": {"$ref": "measured-data-plane-audit.v1.schema.json#/$defs/nativeConfiguration"}
  }
}
