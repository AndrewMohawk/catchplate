{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/native-startup-configuration.v8.schema.json",
  "title": "Cold native guest inspector parent and original lifetime",
  "$comment": "Explicit --native-startup-inspector-v8 only, or fixed image entrypoint --guest-inspector-v8. Exact v7 encrypted/measured-refresh fields plus guestInspector. Old modes refuse v8. <=16MiB retained independently pinned cold configuration. Actual signed guest router delivery and root Prepared owner precede the fixed clone; initialization is not cohort readiness or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion","gate","native","shadow","responseObservationV2","policy","enrollmentAuthorizer","enrollmentSetupAuthorizer","enrollmentProxyEndpoint","credentialCurrentness","secretBroker","measuredAudit","encryptedServiceTokens","measuredRefresh","guestInspector"],
  "properties": {
    "apiVersion": {"const": "serverware.nativeStartupConfiguration/v8"},
    "gate": {"$ref": "native-startup-configuration.v6.schema.json#/$defs/gate"},
    "native": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/native"},
    "shadow": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/shadow"},
    "responseObservationV2": {"$ref": "response-v2-guest-listener.v1.schema.json#/$defs/nativeClient"},
    "policy": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/artifact"},
    "enrollmentAuthorizer": {"$ref": "native-enrollment-authorizer.v1.schema.json"},
    "enrollmentSetupAuthorizer": {"$ref": "native-enrollment-setup-authorizer.v1.schema.json"},
    "enrollmentProxyEndpoint": {"type": "string","minLength": 1,"maxLength": 4096},
    "credentialCurrentness": {"$ref": "native-startup-configuration.v4.schema.json#/properties/credentialCurrentness"},
    "secretBroker": {"$ref": "native-secret-broker.v1.schema.json#/$defs/configuration"},
    "measuredAudit": {"$ref": "measured-data-plane-audit.v1.schema.json#/$defs/nativeConfiguration"},
    "encryptedServiceTokens": {"$ref": "native-service-tokens.v1.schema.json#/$defs/envelope"},
    "measuredRefresh": {"$ref": "native-oauth-measured-refresh.v1.schema.json#/$defs/configuration"},
    "guestInspector": {"$ref": "#/$defs/guestInspector"}
  },
  "$defs": {
    "sha256": {"type": "string","pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "artifact": {
      "type": "object","additionalProperties": false,"required": ["path","sha256"],
      "properties": {
        "path": {"type": "string","minLength": 2,"maxLength": 4096,"pattern": "^/(?!\\.{1,2}(?:/|$))[^/\\u0000]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000]+)*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "guestInspector": {
      "type": "object","additionalProperties": false,"required": ["apiVersion","executable","configuration","delivery"],
      "properties": {
        "apiVersion": {"const": "serverware.nativeGuestInspector/v1"},
        "executable": {
          "type": "object","additionalProperties": false,"required": ["path","sha256"],
          "properties": {
            "path": {"const": "/usr/local/bin/serverware-response-v2-guest-inspector"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "configuration": {"$ref": "#/$defs/artifact"},
        "delivery": {"$ref": "#/$defs/artifact"}
      },
      "$comment": "All three paths distinct. Fixed executable root:root, regular/single-link, protected ancestors, no group/other write or special mode, native 64-bit little-endian static ELF without PT_INTERP/DT_NEEDED, <=64MiB. Parent copies exact pinned bytes into sealed executable memfd; bootstrap memfd root:root0600 nlink0, canonical no-LF<=16KiB/all four seals. Actual signed delivery must match configuration pin, generation and router UID. No args/env accepted."
    }
  }
}
