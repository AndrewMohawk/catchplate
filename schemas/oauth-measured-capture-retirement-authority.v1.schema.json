        {"if":{"properties":{"workSource":{"const":"measured-oauth-setup-exchange/v1"}}},"then":{"properties":{"setupSessionId":{"$ref":"#/$defs/uuid"},"setupInitialSha256":{"$ref":"#/$defs/digest"},"setupStartedSha256":{"$ref":"#/$defs/digest"},"setupCurrentSha256":{"$ref":"#/$defs/digest"}}},"else":{"properties":{"setupSessionId":{"type":"null"},"setupInitialSha256":{"type":"null"},"setupStartedSha256":{"type":"null"},"setupCurrentSha256":{"type":"null"}}}}
