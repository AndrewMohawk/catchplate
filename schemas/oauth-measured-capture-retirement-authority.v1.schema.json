{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/oauth-measured-capture-retirement-authority.v1.schema.json",
  "title": "Measured pre-subject complete-provider retirement originals",
  "$comment": "Data shapes only. Actual independently signed configuration/grant, original Nitro evidence, protected exact pre-subject capture joins, complete local inventories, current all-holder drains and atomic one-use claims remain mandatory. A constructible object, accepted transport response, missing acknowledgement or elapsed deadline grants no contact/retry. Canonical ASCII no-LF: grant64KiB, arguments1MiB, authenticated response6MiB, HTTP envelope8MiB. The grant has35 fields; source canonical validation does not borrow the old32-field grant parser. Native cold configuration is a separate source-selected contract.",
  "oneOf": [{"$ref":"#/$defs/signedAuthorization"},{"$ref":"#/$defs/policy"},{"$ref":"#/$defs/httpRequest"},{"$ref":"#/$defs/httpResponse"},{"$ref":"#/$defs/transport"}],
  "$defs": {
    "digest": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/digest"},
    "uuid": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/uuid"},
    "epoch": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/integer"},
    "deployment": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/deployment"},
    "bytes32": {"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "encoded": {"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_-]+$"},
    "original": {"type":"string","minLength":2,"maxLength":6291456},
    "nullableOriginal": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/original"}]},
    "lineage": {
