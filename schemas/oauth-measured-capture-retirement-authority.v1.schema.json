    },
    "barriers": {"type":"array","maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/barrier"}},
    "nullableDigest": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},
    "scope": {
