      "properties":{"profile":{"const":"complete-local-provider-retirement/v1"},"providerId":{"enum":["google","x"]},"allLocalApplicationsAndSubjects":{"const":true},"externalRelatedGrantImpactAuthorized":{"const":true},"automaticReopen":{"const":false}}
    },
    "authorization": {
