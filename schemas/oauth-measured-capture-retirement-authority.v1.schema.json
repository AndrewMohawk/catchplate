        "expectedModuleId":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/expectedModuleId"},
        "maxAgeSeconds":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/maxAgeSeconds"},
        "futureSkewSeconds":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/futureSkewSeconds"},
        "instanceId":{"$ref":"native-oauth-measured-refresh.v1.schema.json#/$defs/assignment/properties/instanceId"},
        "providerId":{"enum":["google","x"]},"enrollmentSha256":{"$ref":"#/$defs/digest"},"applicationMaterialSha256":{"$ref":"#/$defs/digest"},
        "secretKekId":{"type":"string","pattern":"^attested-memory-kek:[0-9a-f]{24}$"},"providerTlsRootSha256":{"$ref":"#/$defs/digest"},
        "exchangeIds":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/uuid"}},
        "recoveryAuthorizationSha256s":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}}
