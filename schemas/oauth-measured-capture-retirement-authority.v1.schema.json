        {"if":{"properties":{"operation":{"const":"oauth.measured-capture-retirement.claim"}}},"then":{"properties":{"arguments":{"properties":{"request":{"$ref":"#/$defs/claimRequest"}}}}}},
        {"if":{"properties":{"operation":{"const":"oauth.measured-capture-retirement.contact"}}},"then":{"properties":{"arguments":{"properties":{"request":{"$ref":"#/$defs/contactRequest"}}}}}},
        {"if":{"properties":{"operation":{"const":"oauth.measured-capture-retirement.finish"}}},"then":{"properties":{"arguments":{"properties":{"request":{"$ref":"#/$defs/finishRequest"}}}}}}
      ]
    },
    "httpResponse": {"type":"object","additionalProperties":false,"required":["apiVersion","requestOriginal","responseOriginal","currentnessBarriers"],"properties":{"apiVersion":{"const":"serverware.nativeOAuthCaptureRetirementResponse/v1"},"requestOriginal":{"$ref":"#/$defs/encoded","maxLength":4194304},"responseOriginal":{"$ref":"#/$defs/encoded","maxLength":8388608},"currentnessBarriers":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/barriers"}]}}},
    "affectedOriginal": {"type":"object","additionalProperties":false,"required":["credentialOriginal","generationOriginal"],"properties":{"credentialOriginal":{"$ref":"#/$defs/original","maxLength":524288},"generationOriginal":{"$ref":"#/$defs/original","maxLength":8192}}},
