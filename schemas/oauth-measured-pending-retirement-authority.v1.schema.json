      "properties":{"apiVersion":{"const":"serverware.nativeOAuthPendingRetirementStatement/v1"},"phase":{"enum":["inspect","claim","contact","finish","recover"]},"holderId":{"$ref":"#/$defs/digest"},"bootId":{"$ref":"#/$defs/bytes32"},"keyId":{"$ref":"#/$defs/digest"},"controlPlaneResponseSigningKeyId":{"$ref":"#/$defs/digest"},"deploymentId":{"$ref":"#/$defs/deployment"},"instanceId":{"$ref":"#/$defs/assignment/properties/instanceId"},"providerId":{"enum":["google","x"]},"enrollmentSha256":{"$ref":"#/$defs/digest"},"pendingId":{"$ref":"#/$defs/uuid"},"authorizationSha256":{"$ref":"#/$defs/digest"},"inputSha256":{"$ref":"#/$defs/digest"},"challenge":{"$ref":"#/$defs/bytes32"},"policyHash":{"$ref":"#/$defs/digest"},"dataPlaneBinarySha256":{"$ref":"#/$defs/digest"},"issuedAtEpochNs":{"$ref":"#/$defs/epoch"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"}}
