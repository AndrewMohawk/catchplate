    "operation": {"enum":["oauth.measured-pending-retirement.inspect","oauth.measured-pending-retirement.claim","oauth.measured-pending-retirement.contact","oauth.measured-pending-retirement.finish","oauth.measured-pending-retirement.recover"]},
    "httpRequest": {
