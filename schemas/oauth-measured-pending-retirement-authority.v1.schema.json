      "required":["status","exchangeOriginal","measuredExchangeOriginal","initialPendingOriginal","currentPendingOriginal","enrollmentOriginal","stageArgumentsOriginal","normalizedEnvelopeOriginal","normalizedTokenSha256","affectedLineages","journalOriginal","custodyOriginal","attemptOriginals"],
      "properties":{"status":{"enum":["ready","no-local-claim","outcome-unknown","unknown","observed-accepted","observed-rejected"]},"exchangeOriginal":{"$ref":"#/$defs/original"},"measuredExchangeOriginal":{"$ref":"#/$defs/original"},"initialPendingOriginal":{"$ref":"#/$defs/original","maxLength":1048576},"currentPendingOriginal":{"$ref":"#/$defs/original","maxLength":1048576},"enrollmentOriginal":{"$ref":"#/$defs/original","maxLength":65536},"stageArgumentsOriginal":{"$ref":"#/$defs/original"},"normalizedEnvelopeOriginal":{"$ref":"#/$defs/original"},"normalizedTokenSha256":{"$ref":"#/$defs/digest"},"affectedLineages":{"type":"array","maxItems":24,"items":{"$ref":"#/$defs/affectedOriginal"}},"journalOriginal":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/original","maxLength":2097152}]},"custodyOriginal":{"$ref":"#/$defs/nullableOriginal"},"attemptOriginals":{"type":"array","maxItems":2,"items":{"$ref":"#/$defs/original","maxLength":524288}}}
    },
