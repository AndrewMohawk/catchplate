    "contactRequest": {"type":"object","additionalProperties":false,"required":["journalRowSha256","ownerNonce","tokenPurpose","contactRequestSha256"],"properties":{"journalRowSha256":{"$ref":"#/$defs/digest"},"ownerNonce":{"$ref":"#/$defs/bytes32"},"tokenPurpose":{"enum":["access_token","refresh_token"]},"contactRequestSha256":{"$ref":"#/$defs/digest"}}},
    "finishRequest": {"type":"object","additionalProperties":false,"required":["journalRowSha256","ownerNonce","attemptRowSha256","tokenPurpose","transportOriginal"],"properties":{"journalRowSha256":{"$ref":"#/$defs/digest"},"ownerNonce":{"$ref":"#/$defs/bytes32"},"attemptRowSha256":{"$ref":"#/$defs/digest"},"tokenPurpose":{"enum":["access_token","refresh_token"]},"transportOriginal":{"$ref":"#/$defs/encoded","maxLength":524288}}},
