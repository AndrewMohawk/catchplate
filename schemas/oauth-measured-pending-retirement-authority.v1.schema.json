        "initialPendingRowSha256":{"$ref":"#/$defs/digest"},"currentPendingRowSha256":{"$ref":"#/$defs/digest"},"stageArgumentsSha256":{"$ref":"#/$defs/digest"},
        "enrollmentSha256":{"$ref":"#/$defs/digest"},"historicalEnrollmentRootSpkiSha256":{"$ref":"#/$defs/digest"},
