{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/oauth-measured-pending-retirement-authority.v1.schema.json",
  "title": "Measured staged-pending family retirement originals",
  "$comment": "Data shapes only. Actual independently signed configuration/grant, original Nitro evidence, protected staged-history joins, complete local inventories, current all-holder drains and atomic one-use claims remain mandatory. A constructible object, accepted transport response, missing acknowledgement or elapsed deadline grants no contact/retry. Canonical ASCII no-LF: grant64KiB, arguments1MiB, authenticated response6MiB, HTTP envelope8MiB. Authority payloads fit32 fields. Native cold configuration is a separate source-selected contract.",
  "oneOf": [{"$ref":"#/$defs/signedAuthorization"},{"$ref":"#/$defs/policy"},{"$ref":"#/$defs/httpRequest"},{"$ref":"#/$defs/httpResponse"},{"$ref":"#/$defs/transport"}],
  "$defs": {
    "digest": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/digest"},
    "uuid": {"$ref":"credential-currentness-authority.v1.schema.json#/$defs/uuid"},
