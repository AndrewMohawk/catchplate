        "caCertificateSha256":{"$ref":"#/$defs/digest"},"caPublicKeySpkiSha256":{"$ref":"#/$defs/digest"},"expectedBinaryDigest":{"$ref":"#/$defs/digest"},
        "expectedPcrs":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/expectedPcrs"},
        "expectedEif":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/expectedEif"},
        "expectedModuleId":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/expectedModuleId"},
        "maxAgeSeconds":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/assignment/properties/maxAgeSeconds"},
