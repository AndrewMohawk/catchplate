    },
    "evidence":{"type":"object","additionalProperties":false,"required":["statement","signature","nativeKeyEvidence"],"properties":{"statement":{"$ref":"#/$defs/statement"},"signature":{"type":"string","pattern":"^ed25519:[A-Za-z0-9_-]{86}$"},"nativeKeyEvidence":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/nativeKeyEvidence"}}},
    "requestProperties":{
      "type":"object","additionalProperties":false,
