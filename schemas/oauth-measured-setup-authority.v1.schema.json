{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/oauth-measured-setup-authority.v1.schema.json",
  "title":"Separately authorized measured NEW-credential Setup originals",
  "$comment":"Data projections only. Actual independent signed policy, native purpose evidence, requester hardware, distinct-person activation, complete population roots, original Setup CAS and writer fencing are mandatory. Reconnect and later Setup completion are not granted. No conversion of legacy signed bytes.",
  "oneOf":[{"$ref":"#/$defs/policy"},{"$ref":"#/$defs/httpRequest"},{"$ref":"#/$defs/httpResponse"},{"$ref":"#/$defs/recoveryOriginalRequest"},{"$ref":"#/$defs/recoveryOriginalResponse"},{"$ref":"#/$defs/humanArguments"},{"$ref":"#/$defs/startup"}],
  "$defs":{
    "digest":{"$ref":"native-oauth-measured-exchange.v1.schema.json#/$defs/digest"},
