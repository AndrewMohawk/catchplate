      "properties":{"schema":{"const":"catchplate.oauthMeasuredSetupAuthorityPolicy/v1"},"enrollmentRootPublicKeyBase64Url":{"$ref":"#/$defs/bytes32"},
        "enrollmentRootSpkiSha256":{"$ref":"#/$defs/digest"},"controlPlaneConfigurationDigest":{"$ref":"#/$defs/digest"},
        "deploymentId":{"$ref":"oauth-application-enrollment.v1.schema.json#/$defs/identifier"},"pendingCapacity":{"type":"integer","minimum":1,"maximum":64},
        "revocationCapacity":{"type":"integer","minimum":1,"maximum":64},"contactMaxSeconds":{"type":"integer","minimum":1,"maximum":600},
