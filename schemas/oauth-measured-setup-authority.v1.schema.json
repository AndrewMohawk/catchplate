        "pkceVerifierSha256":{"$ref":"#/$defs/digest"},"stateOriginalSha256":{"$ref":"#/$defs/digest"},"stateEnvelope":{"$ref":"#/$defs/envelope"},"reservedEnvelope":{"$ref":"#/$defs/envelope"},
        "providerId":{"$ref":"#/$defs/provider"},"redirectUri":{"$ref":"oauth-exchange-authority.v1.schema.json#/$defs/prepare/properties/redirectUri"},
