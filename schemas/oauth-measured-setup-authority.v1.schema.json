        "operationMaxSeconds":{"type":"integer","minimum":1,"maximum":30},"recoveryMaxSeconds":{"type":"integer","minimum":1,"maximum":30},
        "trustRoots":{"$ref":"credential-currentness-authority.v1.schema.json#/$defs/trustRoots"},"assignments":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/assignment"}},
        "setupCapacity":{"const":64},"setupMaxSeconds":{"type":"integer","minimum":300,"maximum":604800}},
      "$comment":"NEW oauthMeasuredSetupPolicy within actual signed authority configuration/v6, plus explicit enabled operations. Reused assignment scalar shape is not old measured-exchange permission. Original Setup expiry also caps every contact/retention/pending/recovery window."
    },
    "statement":{
      "type":"object","additionalProperties":false,
