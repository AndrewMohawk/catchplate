        "exchangeRowSha256":{"$ref":"#/$defs/digest"},"ownerNonceSha256":{"$ref":"#/$defs/digest"},"callbackSha256":{"$ref":"#/$defs/digest"},"callbackEnvelope":{"$ref":"#/$defs/envelope"},"codeSha256":{"$ref":"#/$defs/digest"},"contactRequestSha256":{"$ref":"#/$defs/digest"},
        "ownerNonce":{"$ref":"#/$defs/bytes32"},"rawResponseSha256":{"$ref":"#/$defs/digest"},"rawResponseEnvelope":{"$ref":"#/$defs/envelope"},"issuedMaterialSha256":{"$ref":"#/$defs/nullableDigest"},"issuedMaterialEnvelope":{"$ref":"#/$defs/nullableEnvelope"},"receivedAtEpochNs":{"$ref":"#/$defs/epoch"},
        "tokenSecretSha256":{"$ref":"#/$defs/digest"},"tokenEnvelope":{"$ref":"#/$defs/envelope"},"identityRawSha256":{"$ref":"#/$defs/digest"},"identityRawEnvelope":{"$ref":"#/$defs/envelope"},"review":{"type":"object"},"payloadDigest":{"$ref":"#/$defs/digest"},"recoveryRequestDigest":{"$ref":"#/$defs/nullableDigest"},
        "custodyRowSha256":{"$ref":"#/$defs/digest"},"captureInputSha256":{"$ref":"#/$defs/digest"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"}}
    },
    "prepare":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","stateSha256","browserNonceSha256","pkceVerifierSha256","stateOriginalSha256","stateEnvelope","reservedEnvelope","providerId","redirectUri","credentialName","scopes","metadata","issuedAtEpochNs","contactExpiresAtEpochNs","retentionExpiresAtEpochNs","pendingExpiresAtEpochNs","enrollmentSha256","limits","pkceChallenge","portalOrigin","callbackOrigin","setupBinding"],"maxProperties":22}]},
    "claim":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","exchangeRowSha256","ownerNonceSha256","callbackSha256","callbackEnvelope","codeSha256","contactRequestSha256","limits","setupBinding"],"maxProperties":9}]},
    "capture":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","exchangeRowSha256","ownerNonce","rawResponseSha256","rawResponseEnvelope","issuedMaterialSha256","issuedMaterialEnvelope","receivedAtEpochNs","limits","setupBinding"],"maxProperties":10},{"if":{"properties":{"issuedMaterialEnvelope":{"type":"null"}}},"then":{"properties":{"issuedMaterialSha256":{"type":"null"}}},"else":{"properties":{"issuedMaterialSha256":{"$ref":"#/$defs/digest"}}}}]},
    "stage":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","exchangeRowSha256","ownerNonce","tokenSecretSha256","tokenEnvelope","identityRawSha256","identityRawEnvelope","metadata","review","payloadDigest","recoveryRequestDigest","limits","setupBinding"],"maxProperties":13}]},
    "recover":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","custodyRowSha256","captureInputSha256","ownerNonceSha256","issuedAtEpochNs","expiresAtEpochNs","limits","setupBinding"],"maxProperties":8}]},
    "cancel":{"allOf":[{"$ref":"#/$defs/requestProperties"},{"required":["exchangeId","exchangeRowSha256","callbackSha256","callbackEnvelope","limits","setupBinding"],"maxProperties":6}]},
    "arguments":{
      "type":"object","additionalProperties":false,"required":["action","resource_id","payload_digest","actor_id","request","approval_id","credential_policy","enrollment_original","control_plane_configuration_digest","assignment_original","native_evidence"],
      "properties":{"action":{"const":"credential.oauth.measured-setup-consent"},"resource_id":{"$ref":"#/$defs/uuid"},"payload_digest":{"$ref":"#/$defs/digest"},"actor_id":{"$ref":"#/$defs/actor"},
        "request":{"oneOf":[{"$ref":"#/$defs/prepare"},{"$ref":"#/$defs/claim"},{"$ref":"#/$defs/capture"},{"$ref":"#/$defs/stage"},{"$ref":"#/$defs/recover"},{"$ref":"#/$defs/cancel"}]},
        "approval_id":{"type":"null"},"credential_policy":{"$ref":"#/$defs/credentialPolicy"},"enrollment_original":{"$ref":"#/$defs/enrollmentOriginal"},"control_plane_configuration_digest":{"$ref":"#/$defs/digest"},
        "assignment_original":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/assignment"}]},"native_evidence":{"$ref":"#/$defs/evidence"}},
      "$comment":"Canonical original<=2MiB. Prepare assignment null; later exact independently admitted assignment. Actual phase, exact field set, all digest/binding/original joins and unchanged initial expiry are enforced by the closed source codec."
    },
    "httpRequest":{"type":"object","additionalProperties":false,"required":["apiVersion","operation","arguments"],"properties":{"apiVersion":{"const":"catchplate.nativeOAuthSetupExchangeRequest/v1"},"operation":{"enum":["oauth.measured-setup.claim","oauth.measured-setup.capture","oauth.measured-setup.stage","oauth.measured-setup.recover","oauth.measured-setup.cancel"]},"arguments":{"$ref":"#/$defs/arguments"}},"$comment":"Fixed machine route /api/data-plane/oauth-setup-issuance; <=3MiB. Never human prepare."},
    "httpResponse":{"type":"object","additionalProperties":false,"required":["apiVersion","requestOriginal","responseOriginal"],"properties":{"apiVersion":{"const":"catchplate.nativeOAuthSetupExchangeResponse/v1"},"requestOriginal":{"$ref":"#/$defs/encoded","maxLength":4194304},"responseOriginal":{"$ref":"#/$defs/encoded","maxLength":8388608}},"$comment":"Aggregate<=8MiB; actual signed runtime response original<=6MiB. Separate catchplate.policyAuthorityMeasuredSetupRuntimeResponse/v1; no HTTP verdict is authority."},
    "resultOriginals":{"type":"object","additionalProperties":false,"required":["exchangeOriginal","custodyOriginal","setupOriginal"],"properties":{"exchangeOriginal":{"type":"string","minLength":1,"maxLength":1048576},"custodyOriginal":{"type":"string","minLength":1,"maxLength":4194304},"setupOriginal":{"type":"string","minLength":1,"maxLength":65536}},"$comment":"Exact retained canonical ASCII row strings, not base64. Custody retains initial/started/final Setup row originals. Current Setup row is not replacement initial binding."},
    "recoveryOriginalRequest":{"type":"object","additionalProperties":false,"required":["apiVersion","exchangeId"],"properties":{"apiVersion":{"const":"catchplate.nativeOAuthSetupRecoveryOriginalRequest/v1"},"exchangeId":{"$ref":"#/$defs/uuid"}}},
    "recoveryOriginalResponse":{"type":"object","additionalProperties":false,"required":["apiVersion","okForAction","exchangeOriginal","custodyOriginal","setupOriginal"],"properties":{"apiVersion":{"const":"catchplate.nativeOAuthSetupRecoveryOriginalResponse/v1"},"okForAction":{"const":false},"exchangeOriginal":{"type":"string","minLength":1,"maxLength":1048576},"custodyOriginal":{"type":"string","minLength":1,"maxLength":4194304},"setupOriginal":{"type":"string","minLength":1,"maxLength":65536}},"$comment":"Authenticated fixed SELECT-only acquisition <=6MiB. Not a recovery processing grant, provider contact, expiry renewal or absence proof."},
    "create":{"type":"object","additionalProperties":false,"required":["sessionId","providerId","templateId","principalId","routeId","routePolicyDigest","enrollmentSha256","issuedAtEpochNs","expiresAtEpochNs"],"properties":{"sessionId":{"$ref":"#/$defs/uuid"},"providerId":{"$ref":"#/$defs/provider"},"templateId":{"$ref":"#/$defs/nullableText"},"principalId":{"$ref":"#/$defs/nullableText"},"routeId":{"$ref":"#/$defs/nullableText"},"routePolicyDigest":{"type":"null"},"enrollmentSha256":{"$ref":"#/$defs/digest"},"issuedAtEpochNs":{"$ref":"#/$defs/epoch","multipleOf":1000},"expiresAtEpochNs":{"$ref":"#/$defs/epoch","multipleOf":1000}},"$comment":"Actual draft create purpose. 300..604800 seconds and independently signed lower maximum/enrollment expiry. Original issued time must be within30s. No authoritative route-policy binding."},
    "activation":{"type":"object","additionalProperties":false,"required":["pendingCredentialId","pendingRowSha256","enrollmentSha256","payloadDigest","setupBinding"],"properties":{"pendingCredentialId":{"$ref":"#/$defs/uuid"},"pendingRowSha256":{"$ref":"#/$defs/digest"},"enrollmentSha256":{"$ref":"#/$defs/digest"},"payloadDigest":{"$ref":"#/$defs/digest"},"setupBinding":{"$ref":"#/$defs/setupBinding"}}},
    "humanArguments":{"type":"object","additionalProperties":false,"required":["action","resource_id","payload_digest","actor_id","request","approval_id","credential_policy","enrollment_original"],"properties":{"action":{"enum":["credential.oauth.setup-create","credential.oauth.setup-activate"]},"resource_id":{"$ref":"#/$defs/uuid"},"payload_digest":{"$ref":"#/$defs/digest"},"actor_id":{"$ref":"#/$defs/actor"},"request":{"oneOf":[{"$ref":"#/$defs/create"},{"$ref":"#/$defs/activation"}]},"approval_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/uuid"}]},"credential_policy":{"$ref":"#/$defs/credentialPolicy"},"enrollment_original":{"$ref":"#/$defs/enrollmentOriginal"}},"$comment":"Source joins operation/action/phase/request exactly. Genuine hardware assertion is supplied separately; no serialized success assertion. Create/request approval null; decide/activate exact retained distinct-person approval UUID. Canonical<=192KiB."},
    "startup":{"type":"object","additionalProperties":false,"required":["schema","sourceRevision","configurationDigest","authorityRootFd","authorityRootSha256","applications"],"properties":{"schema":{"const":"catchplate.oauthApplicationStartup/v3"},"sourceRevision":{"$ref":"oauth-application-enrollment.v1.schema.json#/$defs/revision"},"configurationDigest":{"$ref":"#/$defs/digest"},"authorityRootFd":{"oneOf":[{"type":"null"},{"$ref":"oauth-application-enrollment.v1.schema.json#/$defs/descriptor"}]},"authorityRootSha256":{"$ref":"#/$defs/nullableDigest"},"applications":{"type":"array","maxItems":2,"items":{"$ref":"oauth-application-enrollment.v1.schema.json#/$defs/application"}}},"allOf":[{"if":{"properties":{"applications":{"maxItems":0}}},"then":{"properties":{"authorityRootFd":{"type":"null"},"authorityRootSha256":{"type":"null"}}},"else":{"properties":{"authorityRootFd":{"$ref":"oauth-application-enrollment.v1.schema.json#/$defs/descriptor"},"authorityRootSha256":{"$ref":"#/$defs/digest"}}}}],"$comment":"Explicit actual root-admitted inherited config selection. Same encrypted-client original admission as v2, but new issuance is Setup-only. Separate signed oauthMeasuredSetupPolicy is still mandatory; browser labels never select this owner."}
