        "rowSha256":{"$ref":"#/$defs/digest"},"ownerId":{"$ref":"#/$defs/actor"},"currentAssigneeId":{"$ref":"#/$defs/nullableText"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"}},
      "$comment":"Native phases retain INITIAL controlled revision0 and exact canonical row hash. Activation instead binds actual staged revision2. Owner/assignee/expiry do not renew. Source chain uses0,1,2,3 and one-based events1..4; generic upper bound reserves all required increments."
    },
