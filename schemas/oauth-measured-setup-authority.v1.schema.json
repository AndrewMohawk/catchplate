    "origin":{"$ref":"native-oauth-measured-exchange.v1.schema.json#/$defs/origin"},
    "provider":{"enum":["google","x"]},
    "actor":{"type":"string","minLength":1,"maxLength":512,"pattern":"^oidc:"},
