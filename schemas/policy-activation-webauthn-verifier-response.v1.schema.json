{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/policy-activation-webauthn-verifier-response.v1.schema.json",
  "title": "Serverware Policy Activation Signed WebAuthn Verifier Response v1",
  "$comment": "The envelope signature must be verified against the independently pinned WebAuthn verifier key and executable identity; schema validation alone is not verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "assertionEvidenceSha256", "verification"],
  "properties": {
    "apiVersion": {"const": "serverware.policyActivationWebAuthnVerification/v1"},
    "assertionEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "verification": {"$ref": "#/$defs/envelope"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegativeI64": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveI64": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "status", "verifierExecutableSha256", "verificationPolicySha256", "assertionEvidenceSha256", "principalId", "credentialId", "readinessCoreChallengeSha256", "assertionObjectSha256", "authenticatorDataSha256", "clientDataJsonSha256", "assertionSignatureSha256", "cosePublicKeySha256", "rpId", "origin", "credentialStateRevision", "previousSignatureCounter", "signatureCounter", "replayStateSha256", "approvedAtUnixNanos", "hardwareBacked", "userPresent", "userVerified", "verifiedAtUnixNanos", "maximumAgeNanos", "issuedAtUnixNanos", "expiresAtUnixNanos"],
      "properties": {
        "schemaVersion": {"const": "serverware.policyActivationWebAuthnVerification/v1"}, "status": {"const": "verified"},
        "verifierExecutableSha256": {"$ref": "#/$defs/sha256"}, "verificationPolicySha256": {"$ref": "#/$defs/sha256"}, "assertionEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "principalId": {"type": "string", "minLength": 1, "maxLength": 256}, "credentialId": {"$ref": "#/$defs/sha256"}, "readinessCoreChallengeSha256": {"$ref": "#/$defs/sha256"},
        "assertionObjectSha256": {"$ref": "#/$defs/sha256"}, "authenticatorDataSha256": {"$ref": "#/$defs/sha256"}, "clientDataJsonSha256": {"$ref": "#/$defs/sha256"}, "assertionSignatureSha256": {"$ref": "#/$defs/sha256"}, "cosePublicKeySha256": {"$ref": "#/$defs/sha256"},
        "rpId": {"type": "string", "minLength": 1, "maxLength": 256}, "origin": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[\\x20-\\x7e]+$"},
        "credentialStateRevision": {"$ref": "#/$defs/positiveI64"}, "previousSignatureCounter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegativeI64"}]}, "signatureCounter": {"$ref": "#/$defs/nonnegativeI64"}, "replayStateSha256": {"$ref": "#/$defs/sha256"},
        "approvedAtUnixNanos": {"$ref": "#/$defs/nonnegativeI64"}, "hardwareBacked": {"const": true}, "userPresent": {"const": true}, "userVerified": {"const": true},
        "verifiedAtUnixNanos": {"$ref": "#/$defs/positiveI64"}, "maximumAgeNanos": {"$ref": "#/$defs/positiveI64"}, "issuedAtUnixNanos": {"$ref": "#/$defs/positiveI64"}, "expiresAtUnixNanos": {"$ref": "#/$defs/positiveI64"}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "canonicalProfile", "signatureDomain", "payload", "payloadSha256", "signatureAlgorithm", "signingKeyId", "signingKeySpkiSha256", "signature"],
      "properties": {
        "apiVersion": {"const": "serverware.policyActivationWebAuthnVerification/v1"}, "kind": {"const": "PolicyActivationWebAuthnVerification"},
        "canonicalProfile": {"const": "serverware.canonicalJson/ascii-integer-v1"}, "signatureDomain": {"const": "serverware.policyActivationWebAuthnVerification/v1"},
        "payload": {"$ref": "#/$defs/payload"}, "payloadSha256": {"$ref": "#/$defs/sha256"}, "signatureAlgorithm": {"const": "Ed25519"},
        "signingKeyId": {"$ref": "#/$defs/sha256"}, "signingKeySpkiSha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
