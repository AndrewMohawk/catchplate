{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/policy-authority-analysis.v1.schema.json",
  "title": "Serverware Policy Authority Analysis v1",
  "$comment": "A separately signed compiler analysis of every active-to-candidate authority expansion. Native verification pins signingKeyId, signingKeySpkiSha256, and resolved public-key material to the assignment's compiler-analysis binding, joins the exact assignment and compiled snapshots, recomputes every semantic expansion cell, and rejects any expansion not represented by a positive, bounded constrained-pilot cell. Observation verifiers derive the complete applicable set and its root from this signed analysis plus the signed active/candidate evaluations; evaluators cannot select or omit cells. Request/decision expansion cells require positive request coverage even when active enforcement legitimately does not dispatch; response-field exposure, response-validation relaxation, and response-filter reduction cells additionally require comparable exact response evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "canonicalProfile",
    "signatureDomain",
    "payload",
    "payloadSha256",
    "signatureAlgorithm",
    "signingKeyId",
    "signingKeySpkiSha256",
    "signature"
  ],
  "properties": {
    "apiVersion": {"const": "serverware.policyAuthorityAnalysis/v1"},
    "kind": {"const": "PolicyAuthorityAnalysis"},
    "canonicalProfile": {"const": "serverware.canonicalJson/ascii-integer-v1"},
    "signatureDomain": {"const": "serverware.policyAuthorityAnalysis/v1"},
    "payload": {"$ref": "#/$defs/payload"},
    "payloadSha256": {"$ref": "#/$defs/sha256"},
    "signatureAlgorithm": {"const": "Ed25519"},
    "signingKeyId": {"$ref": "#/$defs/sha256"},
    "signingKeySpkiSha256": {"$ref": "#/$defs/sha256"},
    "signature": {
      "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/ed25519Signature"
    }
  },
  "$defs": {
    "sha256": {
      "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/sha256"
    },
    "signedI64": {
      "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/signedI64"
    },
    "positiveI64": {
      "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/positiveI64"
    },
    "unsignedI64": {
      "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/unsignedI64"
    },
    "semanticExpansionCell": {
      "$ref": "policy-shadow-observation.v1.schema.json#/$defs/semanticExpansionCell"
    },
    "noExpansionAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expansionCells"],
      "properties": {
        "mode": {"const": "no-expansion"},
        "expansionCells": {
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/semanticExpansionCell"}
        }
      }
    },
    "approvedExpansionAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expansionCells", "approvalMode"],
      "properties": {
        "mode": {"const": "approved-expansion"},
        "expansionCells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticExpansionCell"}
        },
        "approvalMode": {
          "enum": [
            "single-person-hardware-webauthn",
            "two-person-hardware-webauthn"
          ]
        }
      }
    },
    "authorityAnalysis": {
      "oneOf": [
        {"$ref": "#/$defs/noExpansionAnalysis"},
        {"$ref": "#/$defs/approvedExpansionAnalysis"}
      ]
    },
    "notApplicablePilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"const": "not-applicable"}
      }
    },
    "constrainedPilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "principalSetRootSha256",
        "routeSetRootSha256",
        "maximumRequests",
        "maximumDurationNanos",
        "maximumWriteRequests",
        "cells"
      ],
      "properties": {
        "mode": {"const": "constrained"},
        "principalSetRootSha256": {"$ref": "#/$defs/sha256"},
        "routeSetRootSha256": {"$ref": "#/$defs/sha256"},
        "maximumRequests": {"$ref": "#/$defs/positiveI64"},
        "maximumDurationNanos": {"$ref": "#/$defs/positiveI64"},
        "maximumWriteRequests": {"$ref": "#/$defs/unsignedI64"},
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semanticExpansionCell"}
        }
      }
    },
    "pilotRestrictions": {
      "oneOf": [
        {"$ref": "#/$defs/notApplicablePilot"},
        {"$ref": "#/$defs/constrainedPilot"}
      ]
    },
    "terminalReceiptEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptClass",
        "signerRole",
        "expectedSigningKeyId",
        "expectedSigningKeySpkiSha256",
        "expectedSigningKeyMaterialSha256",
        "countUnit",
        "minimumCountPerUnit",
        "leafDomain",
        "rootDomain",
        "requirementRootSha256"
      ],
      "properties": {
        "receiptClass": {"const": "terminal"},
        "signerRole": {"const": "terminal-append"},
        "expectedSigningKeyId": {"$ref": "#/$defs/sha256"},
        "expectedSigningKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "expectedSigningKeyMaterialSha256": {"$ref": "#/$defs/sha256"},
        "countUnit": {"const": "covered-ingress"},
        "minimumCountPerUnit": {"const": 1},
        "leafDomain": {"const": "serverware.policyShadowTerminalReceiptLeaf/v1"},
        "rootDomain": {"const": "serverware.policyShadowTerminalReceiptRoot/v1"},
        "requirementRootSha256": {"$ref": "#/$defs/sha256"}
      },
      "$comment": "The expected signer fields exactly match the assignment custody-terminal-append authority binding. requirementRootSha256 commits this complete canonical requirement."
    },
    "publicationReceiptEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptClass",
        "signerRole",
        "expectedSigningKeyId",
        "expectedSigningKeySpkiSha256",
        "expectedSigningKeyMaterialSha256",
        "countUnit",
        "minimumCountPerUnit",
        "leafDomain",
        "rootDomain",
        "requirementRootSha256"
      ],
      "properties": {
        "receiptClass": {"const": "publication"},
        "signerRole": {"const": "publication-reconciliation"},
        "expectedSigningKeyId": {"$ref": "#/$defs/sha256"},
        "expectedSigningKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "expectedSigningKeyMaterialSha256": {"$ref": "#/$defs/sha256"},
        "countUnit": {"const": "covered-member"},
        "minimumCountPerUnit": {"const": 1},
        "leafDomain": {"const": "serverware.policyShadowPublicationReceiptLeaf/v1"},
        "rootDomain": {"const": "serverware.policyShadowPublicationReceiptRoot/v1"},
        "requirementRootSha256": {"$ref": "#/$defs/sha256"}
      },
      "$comment": "The expected signer fields exactly match the assignment custody-publication-reconciliation authority binding. At least one verified published-state reconciliation receipt per covered member is required before readiness."
    },
    "custodyReceiptEvidenceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal",
        "publication",
        "requirementsRootSha256"
      ],
      "properties": {
        "terminal": {"$ref": "#/$defs/terminalReceiptEvidenceRequirement"},
        "publication": {"$ref": "#/$defs/publicationReceiptEvidenceRequirement"},
        "requirementsRootSha256": {"$ref": "#/$defs/sha256"}
      },
      "$comment": "requirementsRootSha256 is the domain-separated root over the distinct terminal and publication requirement roots in fixed terminal-then-publication order. It does not contain observed pilot roots and therefore introduces no analysis/observation cycle."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisId",
        "assignmentSha256",
        "assignmentPayloadSha256",
        "assignmentRevision",
        "expectedAnalysisKeyId",
        "expectedAnalysisKeySpkiSha256",
        "expectedAnalysisKeyMaterialSha256",
        "canaryId",
        "policyIdentity",
        "expectedLoadedSnapshots",
        "custodyAuthoritySha256",
        "authorityKeyIndependenceSha256",
        "custodyReceiptEvidenceRequirements",
        "custodyReceiptEvidenceRequirementsSha256",
        "responseValidationObligationsRootSha256",
        "routeAuthorityRootSha256",
        "operationAuthorityRootSha256",
        "authorityAnalysis",
        "pilotRestrictions",
        "issuedAtUnixNanos",
        "expiresAtUnixNanos"
      ],
      "properties": {
        "analysisId": {"$ref": "#/$defs/sha256"},
        "assignmentSha256": {"$ref": "#/$defs/sha256"},
        "assignmentPayloadSha256": {"$ref": "#/$defs/sha256"},
        "assignmentRevision": {"$ref": "#/$defs/positiveI64"},
        "expectedAnalysisKeyId": {"$ref": "#/$defs/sha256"},
        "expectedAnalysisKeySpkiSha256": {"$ref": "#/$defs/sha256"},
        "expectedAnalysisKeyMaterialSha256": {"$ref": "#/$defs/sha256"},
        "canaryId": {"$ref": "#/$defs/sha256"},
        "policyIdentity": {
          "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/policyIdentity"
        },
        "expectedLoadedSnapshots": {
          "$ref": "policy-shadow-assignment.v1.schema.json#/$defs/assignedSnapshotIdentities"
        },
        "custodyAuthoritySha256": {"$ref": "#/$defs/sha256"},
        "authorityKeyIndependenceSha256": {
          "$ref": "#/$defs/sha256",
          "$comment": "Exact assignment authorityKeyIndependence.independenceRootSha256."
        },
        "custodyReceiptEvidenceRequirements": {
          "$ref": "#/$defs/custodyReceiptEvidenceRequirements"
        },
        "custodyReceiptEvidenceRequirementsSha256": {
          "$ref": "#/$defs/sha256",
          "$comment": "Domain-separated digest of the complete canonical custodyReceiptEvidenceRequirements object."
        },
        "responseValidationObligationsRootSha256": {"$ref": "#/$defs/sha256"},
        "routeAuthorityRootSha256": {"$ref": "#/$defs/sha256"},
        "operationAuthorityRootSha256": {"$ref": "#/$defs/sha256"},
        "authorityAnalysis": {"$ref": "#/$defs/authorityAnalysis"},
        "pilotRestrictions": {"$ref": "#/$defs/pilotRestrictions"},
        "issuedAtUnixNanos": {"$ref": "#/$defs/signedI64"},
        "expiresAtUnixNanos": {"$ref": "#/$defs/signedI64"}
      },
      "$comment": "The expected analysis key fields exactly equal the assignment compiler-analysis binding. The enclosing envelope signingKeyId/signingKeySpkiSha256 and independently resolved public-key material must match these payload fields before any analysis authority is accepted."
    }
  }
}
