{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/policy-authority-draft-request.v1.schema.json",
  "title": "Unsigned policy authority draft request",
  "description": "Operator review input only, not approval, signature, or runtime evidence. The assembler additionally checks the exact draft hash, signed bundle, predecessor and selection joins. Maximum input is 8 MiB; string byte bounds and policy semantics are enforced by consumers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "unsignedPolicyBundle", "predecessorPolicyHash", "previewDraftHash", "selection", "dryRun", "approved", "signed"],
  "properties": {
    "apiVersion": {"const": "serverware.policyAuthorityDraftRequest/v1"},
    "approved": {"const": false},
    "signed": {"const": false},
    "predecessorPolicyHash": {"$ref": "#/$defs/digest"},
    "previewDraftHash": {"$ref": "#/$defs/digest"},
    "unsignedPolicyBundle": {
      "type": "object",
      "required": ["apiVersion", "metadata", "principals", "credentials", "routes"],
      "properties": {
        "apiVersion": {"enum": ["serverware.policy/v1", "serverware.policy/v2"]},
        "metadata": {
          "type": "object",
          "not": {"anyOf": [{"required": ["signature"]}, {"required": ["signingKeyId"]}]}
        },
        "principals": {"type": "array", "items": {"type": "object"}},
        "credentials": {"type": "array", "items": {"type": "object"}},
        "routes": {"type": "array", "items": {"type": "object"}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "routeId", "principalId", "credentialId"],
      "properties": {
        "templateId": {"$ref": "#/$defs/selectionId"},
        "routeId": {"$ref": "#/$defs/selectionId"},
        "principalId": {"$ref": "#/$defs/selectionId"},
        "credentialId": {"$ref": "#/$defs/selectionId"}
      }
    },
    "dryRun": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalId", "host", "method", "path"],
        "properties": {
          "name": {"type": ["string", "null"], "minLength": 1},
          "principalId": {"type": "string", "minLength": 1},
          "scheme": {"type": "string", "minLength": 1, "maxLength": 32},
          "host": {"type": "string", "minLength": 1},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "method": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "expect": {"enum": ["allow", "deny"]},
          "expectedRouteId": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selectionId": {"type": "string", "minLength": 1, "maxLength": 1024}
  }
}
