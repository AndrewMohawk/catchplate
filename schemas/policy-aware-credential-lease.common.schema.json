{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/policy-aware-credential-lease.common.schema.json",
  "title": "Shared policy-aware credential lease data shapes",
  "description": "Definitions only, not an authority or a wire profile. The versioned entry schemas select closed policy-aware families. Runtime checks enforce UTF-8 byte bounds, trim stability, canonical encodings/hashes, currentness, cross-field associations and real recipient/authorization provenance; JSON Schema alone cannot prove these.",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "uint": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positiveUint": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "principal": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$",
      "description": "Policy-aware principal retains legacy limits: runtime requires trim-stable UTF-8 of at most 256 bytes, with no Unicode Cc characters. maxLength counts characters, not bytes."
    },
    "identity": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$",
      "description": "Existing producer identity predicate: runtime requires trim-stable UTF-8 of at most 256 bytes and no Unicode Cc characters."
    },
    "authorityId": {"type": "string", "minLength": 1, "maxLength": 512},
    "raw32": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"},
    "canonicalValue": {
      "description": "Runtime additionally limits nesting to 32, object-key UTF-8 to 1024 bytes, and the complete operationContext's sorted compact ensure_ascii JSON to 64 KiB. No floats or negative integers.",
      "oneOf": [
        {"type": ["null", "boolean", "string"]},
        {"$ref": "#/$defs/uint"},
        {"type": "array", "items": {"$ref": "#/$defs/canonicalValue"}},
        {"type": "object", "propertyNames": {"maxLength": 1024}, "additionalProperties": {"$ref": "#/$defs/canonicalValue"}}
      ]
    },
    "operationContext": {
      "allOf": [{"$ref": "#/$defs/canonicalValue"}],
      "type": "object", "required": ["operation"],
      "properties": {"operation": {"type": "string", "minLength": 1, "maxLength": 256}},
      "description": "Existing structured operation context, not an executable command. The operation string has a runtime UTF-8 bound of 256 bytes."
    },
    "requestAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "attemptId", "reservationId", "bindingDigest", "requestDigest", "operationDigest", "operationContext", "reservationExpiresAtEpochMs"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareCredentialLeaseRequestAuthority/v1"},
        "attemptId": {"$ref": "#/$defs/digest"},
        "reservationId": {"$ref": "#/$defs/digest"},
        "bindingDigest": {"$ref": "#/$defs/digest"},
        "requestDigest": {"$ref": "#/$defs/digest"},
        "operationDigest": {"$ref": "#/$defs/digest"},
        "operationContext": {"$ref": "#/$defs/operationContext"},
        "reservationExpiresAtEpochMs": {"$ref": "#/$defs/positiveUint"}
      }
    },
    "quotaClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["counterKey", "constraintId", "windowKind", "windowSeconds", "windowStartEpochMs", "windowEndEpochMs", "max", "count", "remaining", "reservationState"],
      "properties": {
        "counterKey": {"$ref": "#/$defs/digest"},
        "constraintId": {"$ref": "#/$defs/identity"},
        "operation": {"oneOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
        "windowKind": {"enum": ["fixed", "utcDay", "utcIsoWeek", "utcMonth"]},
        "windowSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 31536000},
        "windowStartEpochMs": {"$ref": "#/$defs/uint"},
        "windowEndEpochMs": {"$ref": "#/$defs/positiveUint"},
        "max": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "reservationState": {"const": "reserved"}
      },
      "allOf": [{
        "if": {"properties": {"windowKind": {"const": "fixed"}}},
        "then": {"properties": {"windowSeconds": {"type": "integer"}}},
        "else": {"properties": {"windowSeconds": {"type": "null"}}}
      }],
      "description": "Runtime verifies positive/nonempty window, fixed duration arithmetic, count+remaining=max, current reservation and strict counter-key ordering across claims."
    },
    "durablePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["reservationId", "actorId", "claimDigest", "reservationDeadlineAtEpochMs", "releaseBindingDigest"],
      "properties": {
        "reservationId": {"$ref": "#/$defs/digest"},
        "actorId": {"$ref": "#/$defs/identity"},
        "claimDigest": {"$ref": "#/$defs/digest"},
        "reservationDeadlineAtEpochMs": {"$ref": "#/$defs/positiveUint"},
        "releaseBindingDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "releaseBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "state", "attemptId", "reservationId", "bindingDigest", "principalId", "routeId", "credentialId", "credentialVersion", "policyHash", "requestDigest", "operationDigest", "quotaClaims", "grantId", "approvalRequestId", "reservationExpiresAtEpochMs"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.policyAwareCredentialLeaseReleaseAuthorization/v1", "catchplate.policyAwareCredentialLeaseReleaseAuthorization/v2"]},
        "kind": {"enum": ["jitGrant", "atomicReservation"]}, "state": {"const": "reserved"},
        "attemptId": {"$ref": "#/$defs/identity"},
        "reservationId": {"$ref": "#/$defs/digest"}, "bindingDigest": {"$ref": "#/$defs/digest"},
        "principalId": {"$ref": "#/$defs/principal"}, "routeId": {"$ref": "#/$defs/identity"}, "credentialId": {"$ref": "#/$defs/identity"},
        "credentialVersion": {"$ref": "#/$defs/positiveUint"}, "policyHash": {"$ref": "#/$defs/digest"}, "requestDigest": {"$ref": "#/$defs/digest"},
        "operationDigest": {"$ref": "#/$defs/nullableDigest"},
        "quotaClaims": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/quotaClaim"}},
        "durablePolicy": {"$ref": "#/$defs/durablePolicy"},
        "grantId": {"oneOf": [{"$ref": "#/$defs/authorityId"}, {"type": "null"}]},
        "approvalRequestId": {"oneOf": [{"$ref": "#/$defs/authorityId"}, {"type": "null"}]},
        "reservationExpiresAtEpochMs": {"$ref": "#/$defs/positiveUint"}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "jitGrant"}}},
        "then": {"properties": {"grantId": {"type": "string"}, "approvalRequestId": {"type": "string"}}},
        "else": {
          "properties": {"grantId": {"type": "null"}, "approvalRequestId": {"type": "null"}},
          "anyOf": [{"properties": {"quotaClaims": {"minItems": 1}}}, {"required": ["durablePolicy"]}]
        }
      }]
    },
    "release": {"oneOf": [{"$ref": "policy-aware-credential-lease-release-authorization.v1.schema.json"}, {"$ref": "policy-aware-credential-lease-release-authorization.v2.schema.json"}]},
    "nullableRelease": {"oneOf": [{"$ref": "#/$defs/release"}, {"type": "null"}]},
    "requestBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "principalId", "routeId", "credentialId", "expectedCredentialVersion", "expectedMetadataSha256", "recipientPublicKey", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "maxTtlSeconds", "recipientAttestation"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.policyAwareCredentialLeaseRequest/v1", "catchplate.policyAwareCredentialLeaseRequest/v2"]},
        "purpose": {"enum": ["generationMetadata", "dispatchSecret"]},
        "principalId": {"$ref": "#/$defs/principal"}, "routeId": {"$ref": "#/$defs/identity"}, "credentialId": {"$ref": "#/$defs/identity"},
        "expectedCredentialVersion": {"oneOf": [{"$ref": "#/$defs/positiveUint"}, {"type": "null"}]},
        "expectedMetadataSha256": {"$ref": "#/$defs/nullableDigest"},
        "requestAuthority": {"$ref": "#/$defs/requestAuthority"}, "releaseAuthorization": {"$ref": "#/$defs/nullableRelease"},
        "recipientPublicKey": {"$ref": "#/$defs/raw32"}, "recipientKeyId": {"$ref": "#/$defs/digest"}, "recipientNonce": {"$ref": "#/$defs/raw32"},
        "policyHash": {"$ref": "#/$defs/digest"}, "dataPlaneBinaryDigest": {"$ref": "#/$defs/digest"},
        "maxTtlSeconds": {"type": "integer", "minimum": 1, "maximum": 5},
        "recipientAttestation": {"$ref": "native-credential-recipient-evidence.v1.schema.json"}
      },
      "allOf": [{
        "if": {"properties": {"purpose": {"const": "generationMetadata"}}},
        "then": {"properties": {"expectedCredentialVersion": {"type": "null"}, "expectedMetadataSha256": {"type": "null"}}},
        "else": {"required": ["expectedCredentialVersion", "expectedMetadataSha256"], "properties": {"expectedCredentialVersion": {"type": "integer"}, "expectedMetadataSha256": {"type": "string"}}}
      }]
    },
    "envelopeBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "algorithm", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "principalId", "routeId", "credentialId", "issuedAtEpochMs", "expiresAtEpochMs", "serverEphemeralPublicKey", "aeadNonce", "ciphertext", "ciphertextSha256"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.policyAwareCredentialLeaseEnvelope/v1", "catchplate.policyAwareCredentialLeaseEnvelope/v2"]},
        "algorithm": {"const": "X25519-HKDF-SHA256-AES-256-GCM"},
        "purpose": {"const": "dispatchSecret"}, "requestBindingSha256": {"$ref": "#/$defs/digest"}, "requestAuthoritySha256": {"$ref": "#/$defs/digest"},
        "recipientKeyId": {"$ref": "#/$defs/digest"}, "recipientNonce": {"$ref": "#/$defs/raw32"},
        "policyHash": {"$ref": "#/$defs/digest"}, "dataPlaneBinaryDigest": {"$ref": "#/$defs/digest"},
        "principalId": {"$ref": "#/$defs/principal"}, "routeId": {"$ref": "#/$defs/identity"}, "credentialId": {"$ref": "#/$defs/identity"},
        "issuedAtEpochMs": {"$ref": "#/$defs/positiveUint"}, "expiresAtEpochMs": {"$ref": "#/$defs/positiveUint"},
        "serverEphemeralPublicKey": {"$ref": "#/$defs/raw32"},
        "aeadNonce": {"type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[A-Za-z0-9_-]{16}$"},
        "ciphertext": {"type": "string", "minLength": 22, "maxLength": 5592427, "pattern": "^[A-Za-z0-9_-]+$"},
        "ciphertextSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "metadataString": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "Runtime enforces 4096 UTF-8 bytes, not characters."},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "description": "Existing public metadata allowlist; encoded total is bounded to 64 KiB at runtime. No secret material is permitted here.",
      "properties": {
        "account_subject": {"$ref": "#/$defs/metadataString"}, "app_id": {"$ref": "#/$defs/metadataString"}, "client_id": {"$ref": "#/$defs/metadataString"},
        "expires_at_epoch_ms": {"$ref": "#/$defs/positiveUint"},
        "injection_field": {"$ref": "#/$defs/metadataString"}, "injection_name": {"$ref": "#/$defs/metadataString"}, "injection_prefix": {"$ref": "#/$defs/metadataString"},
        "managed": {"type": "boolean"}, "oauth": {"type": "boolean"}, "oauth_client_id": {"$ref": "#/$defs/metadataString"},
        "provider": {"$ref": "#/$defs/metadataString"}, "provider_id": {"$ref": "#/$defs/metadataString"}, "provider_identity_verified": {"type": "boolean"}, "provider_subject": {"$ref": "#/$defs/metadataString"},
        "scope": {"$ref": "#/$defs/metadataString"}, "scopes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/metadataString"}},
        "secret_class": {"$ref": "#/$defs/metadataString"}, "subject": {"$ref": "#/$defs/metadataString"}, "token_class": {"$ref": "#/$defs/metadataString"},
        "username": {"$ref": "#/$defs/metadataString"}, "x_app_id": {"$ref": "#/$defs/metadataString"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["credentialId", "credentialVersion", "metadataSha256", "metadata"],
      "properties": {
        "credentialId": {"$ref": "#/$defs/identity"}, "credentialVersion": {"$ref": "#/$defs/positiveUint"},
        "metadataSha256": {"$ref": "#/$defs/digest"}, "metadata": {"$ref": "#/$defs/metadata"},
        "secret": {"type": "string", "minLength": 1, "maxLength": 4194304}
      }
    },
    "setBase": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "requestBindingSha256", "releaseAuthorization", "recipientKeyId", "recipientNonce", "policyHash", "dataPlaneBinaryDigest", "principalId", "routeId", "credentialId", "issuedAtEpochMs", "expiresAtEpochMs", "credentials"],
      "properties": {
        "apiVersion": {"enum": ["catchplate.policyAwareCredentialLeaseSet/v1", "catchplate.policyAwareCredentialLeaseSet/v2"]},
        "purpose": {"enum": ["generationMetadata", "dispatchSecret"]}, "requestBindingSha256": {"$ref": "#/$defs/digest"},
        "requestAuthority": {"$ref": "#/$defs/requestAuthority"}, "requestAuthoritySha256": {"$ref": "#/$defs/digest"}, "releaseAuthorization": {"$ref": "#/$defs/nullableRelease"},
        "recipientKeyId": {"$ref": "#/$defs/digest"}, "recipientNonce": {"$ref": "#/$defs/raw32"},
        "policyHash": {"$ref": "#/$defs/digest"}, "dataPlaneBinaryDigest": {"$ref": "#/$defs/digest"},
        "principalId": {"$ref": "#/$defs/principal"}, "routeId": {"$ref": "#/$defs/identity"}, "credentialId": {"$ref": "#/$defs/identity"},
        "issuedAtEpochMs": {"$ref": "#/$defs/positiveUint"}, "expiresAtEpochMs": {"$ref": "#/$defs/positiveUint"},
        "credentials": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/entry"}}
      },
      "allOf": [{
        "if": {"properties": {"purpose": {"const": "generationMetadata"}}},
        "then": {"properties": {"credentials": {"items": {"not": {"required": ["secret"]}}}}},
        "else": {"properties": {"credentials": {"items": {"required": ["secret"]}}}}
      }]
    }
  }
}
