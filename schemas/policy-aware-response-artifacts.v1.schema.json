{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/policy-aware-response-artifacts.v1.schema.json",
  "title": "Policy-aware ordinary response proof and capture artifacts v1",
  "description": "Strict data-only shapes for five client artifact labels. These are not Native capture wrappers and confer no authorization. Runtime envelopes deliberately retain their ordinary versions; their exact nested statements and vendor attested claims must use the independently selected PolicyAware APIs. Original signatures, quote/verifier trust, time, TLS, receipt, digest and capture associations require genuine runtime verification. No self-approved vendor or collector result is authority.",
  "oneOf": [{"$ref": "#/$defs/bufferedProof"}, {"$ref": "#/$defs/streamingProof"}, {"$ref": "#/$defs/observationProof"}, {"$ref": "#/$defs/bufferedCapture"}, {"$ref": "#/$defs/streamingCapture"}],
  "$defs": {
    "sha256": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/sha256"},
    "positiveUint64": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/positiveUint64"},
    "uint64": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/uint64"},
    "identifier": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/identifier"},
    "bufferedIdentity": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedIdentity"},
    "vendorText": {"type": "string", "minLength": 1},
    "signature": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/ed25519Signature"},
    "signatureText": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/ed25519SignatureText"},
    "bufferedTlsPeer": {
      "type": "object", "additionalProperties": false,
      "required": ["spiffe_id", "leaf_certificate_sha256"],
      "properties": {
        "spiffe_id": {"allOf": [{"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedServerInstance/properties/id"}, {"pattern": "^spiffe://"}]},
        "leaf_certificate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "quote": {
      "type": "object", "additionalProperties": false, "required": ["format", "body_b64"],
      "properties": {
        "format": {"$ref": "#/$defs/vendorText"},
        "body_b64": {"allOf": [{"$ref": "streaming-response-proof.v1.schema.json#/$defs/base64url"}, {"minLength": 86}]}
      }
    },
    "bufferedProof": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "external_capture", "collector_signature", "server_statement", "server_signature", "vendor_tee"],
      "properties": {
        "apiVersion": {"const": "serverware.policyAwareProxyResponseProof/v1"},
        "kind": {"const": "ServerwarePolicyAwareProxyResponseProof"},
        "external_capture": {"$ref": "#/$defs/bufferedCapture"},
        "collector_signature": {"$ref": "#/$defs/signature"},
        "server_statement": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/buffered"},
        "server_signature": {"$ref": "#/$defs/signature"}, "vendor_tee": {"$ref": "#/$defs/bufferedVendor"}
      }
    },
    "streamingProof": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "external_capture", "collector_signature", "streaming_response_statement", "server_signature", "vendor_tee"],
      "properties": {
        "apiVersion": {"const": "serverware.policyAwareStreamingProxyResponseProof/v1"},
        "kind": {"const": "ServerwarePolicyAwareStreamingProxyResponseProof"},
        "external_capture": {"$ref": "#/$defs/streamingCapture"},
        "collector_signature": {"$ref": "#/$defs/signature"},
        "streaming_response_statement": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/streaming"},
        "server_signature": {"$ref": "#/$defs/signature"}, "vendor_tee": {"$ref": "#/$defs/streamingVendor"}
      }
    },
    "observationProof": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "captured_at_unix", "request", "response", "runtime_proof", "collector"],
      "properties": {
        "apiVersion": {"const": "serverware.policyAwareResponseObservationProof/v1"},
        "kind": {"const": "ServerwarePolicyAwareResponseObservationProof"},
        "captured_at_unix": {"$ref": "#/$defs/positiveUint64"},
        "request": {"$ref": "response-observation-proof.v1.schema.json#/$defs/collectorRequest"},
        "response": {"$ref": "response-observation-proof.v1.schema.json#/$defs/observedResponse"},
        "runtime_proof": {"$ref": "#/$defs/observationRuntime"},
        "collector": {"$ref": "response-observation-proof.v1.schema.json#/$defs/collector"}
      }
    },
    "bufferedCapture": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "environment", "collection_mode", "captured_at_unix", "client_nonce", "client_request_digest", "principal_id", "route_id", "request_digest", "operation_digest", "release_authority", "control_plane_authorization_receipt", "upstream_response", "response", "tls_channel_binding", "tls_peer", "server_statement_sha256"],
      "properties": {
        "apiVersion": {"const": "serverware.policyAwareProxyResponseCapture/v1"},
        "environment": {"enum": ["development", "production"]}, "collection_mode": {"const": "external-client-capture"},
        "captured_at_unix": {"$ref": "#/$defs/positiveUint64"},
        "client_nonce": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedNonce"},
        "client_request_digest": {"$ref": "#/$defs/sha256"},
        "principal_id": {"$ref": "#/$defs/bufferedIdentity"}, "route_id": {"$ref": "#/$defs/bufferedIdentity"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedReleaseAuthority"},
        "control_plane_authorization_receipt": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/bufferedReceipt"},
        "upstream_response": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedUpstreamResponse"},
        "response": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedResponse"},
        "tls_channel_binding": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedTlsChannelBinding"},
        "tls_peer": {"$ref": "#/$defs/bufferedTlsPeer"},
        "server_statement_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "streamingCapture": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "environment", "collection_mode", "classification", "captured_at_unix", "client_nonce", "client_request_digest", "principal_id", "route_id", "request_digest", "operation_digest", "release_authority", "authorization_binding_commitment", "control_plane_authorization_receipt", "control_plane_authorization_receipt_sha256", "upstream_response", "released_response", "tls_channel_binding", "tls_peer", "streaming_response_statement_sha256", "runtime_proof_sha256"],
      "properties": {
        "apiVersion": {"const": "serverware.policyAwareStreamingProxyResponseCapture/v1"},
        "environment": {"enum": ["development", "production"]},
        "collection_mode": {"const": "strict-incremental-stream-capture"}, "classification": {"const": "runtime-verified-complete-stream"},
        "captured_at_unix": {"$ref": "#/$defs/positiveUint64"},
        "client_nonce": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/nonce"},
        "client_request_digest": {"$ref": "#/$defs/sha256"},
        "principal_id": {"$ref": "#/$defs/identifier"}, "route_id": {"$ref": "#/$defs/identifier"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releaseAuthority"},
        "authorization_binding_commitment": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/authorizationBindingCommitment"},
        "control_plane_authorization_receipt": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/streamingReceipt"},
        "control_plane_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/upstreamResponse"},
        "released_response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releasedResponse"},
        "tls_channel_binding": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/tlsChannelBinding"},
        "tls_peer": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/tlsPeer"},
        "streaming_response_statement_sha256": {"$ref": "#/$defs/sha256"}, "runtime_proof_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bufferedRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "server_statement", "server_statement_sha256", "server_signature", "vendor_tee"],
      "properties": {
        "apiVersion": {"const": "serverware.proxyResponseRuntimeProof/v2"}, "kind": {"const": "ServerwareProxyResponseRuntimeProof"},
        "server_statement": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/buffered"},
        "server_statement_sha256": {"$ref": "#/$defs/sha256"}, "server_signature": {"$ref": "#/$defs/signature"},
        "vendor_tee": {"$ref": "#/$defs/bufferedVendor"}
      }
    },
    "streamingRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "streaming_response_statement", "streaming_response_statement_sha256", "server_signature", "vendor_tee"],
      "properties": {
        "apiVersion": {"const": "serverware.streamingResponseRuntimeProof/v1"}, "kind": {"const": "ServerwareStreamingResponseRuntimeProof"},
        "streaming_response_statement": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/streaming"},
        "streaming_response_statement_sha256": {"$ref": "#/$defs/sha256"}, "server_signature": {"$ref": "#/$defs/signature"},
        "vendor_tee": {"$ref": "#/$defs/streamingVendor"}
      }
    },
    "observationRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "server_statement", "server_statement_sha256", "server_signature", "vendor_tee"],
      "properties": {
        "apiVersion": {"const": "serverware.responseObservationRuntimeProof/v1"}, "kind": {"const": "ServerwareResponseObservationRuntimeProof"},
        "server_statement": {"$ref": "policy-aware-response-statements.v1.schema.json#/$defs/observation"},
        "server_statement_sha256": {"$ref": "#/$defs/sha256"}, "server_signature": {"$ref": "#/$defs/signature"},
        "vendor_tee": {"$ref": "#/$defs/observationVendor"}
      }
    },
    "bufferedClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["server_statement_sha256", "server_statement_api_version", "issued_at_unix", "client_nonce_sha256", "client_request_digest", "principal_id", "route_id", "request_digest", "operation_digest", "release_authority", "control_plane_authorization_receipt_sha256", "upstream_response", "response_status", "selected_response_headers_digest", "response_body_digest", "policy_digest", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "server_instance_id", "server_instance_identity_digest", "tls_channel_binding_type", "tls_channel_binding_sha256", "response_signing_key_id"],
      "properties": {
        "server_statement_sha256": {"$ref": "#/$defs/sha256"}, "server_statement_api_version": {"const": "serverware.policyAwareProxyResponseStatement/v1"},
        "issued_at_unix": {"$ref": "#/$defs/positiveUint64"}, "client_nonce_sha256": {"$ref": "#/$defs/sha256"},
        "client_request_digest": {"$ref": "#/$defs/sha256"},
        "principal_id": {"$ref": "#/$defs/bufferedIdentity"}, "route_id": {"$ref": "#/$defs/bufferedIdentity"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedReleaseAuthority"},
        "control_plane_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_response": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedUpstreamResponse"},
        "response_status": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/status"},
        "selected_response_headers_digest": {"$ref": "#/$defs/sha256"}, "response_body_digest": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"}, "runtime_manifest_digest": {"$ref": "#/$defs/sha256"},
        "data_plane_binary_digest": {"$ref": "#/$defs/sha256"}, "release_digest": {"$ref": "#/$defs/sha256"},
        "server_instance_id": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedServerInstance/properties/id"},
        "server_instance_identity_digest": {"$ref": "#/$defs/sha256"}, "tls_channel_binding_type": {"const": "tls-exporter"},
        "tls_channel_binding_sha256": {"$ref": "#/$defs/sha256"}, "response_signing_key_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "streamingClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["streaming_response_statement_api_version", "streaming_response_statement_sha256", "issued_at_unix", "client_nonce_sha256", "client_request_digest", "principal_id", "route_id", "request_digest", "operation_digest", "release_authority", "authorization_binding_digest", "control_plane_authorization_receipt_sha256", "upstream_status", "upstream_selected_raw_policy_headers_digest", "upstream_body_digest", "upstream_body_bytes", "upstream_canonical_digest", "released_response_status", "released_response_content_type", "selected_response_wire_headers_digest", "released_response_body_digest", "released_response_body_bytes", "response_framing", "response_completion", "response_trailer_names", "policy_digest", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "server_instance_id", "server_instance_identity_digest", "tls_channel_binding_type", "tls_exporter_label", "tls_channel_binding_sha256", "response_signing_key_id"],
      "properties": {
        "streaming_response_statement_api_version": {"const": "serverware.policyAwareStreamingResponseStatement/v1"},
        "streaming_response_statement_sha256": {"$ref": "#/$defs/sha256"}, "issued_at_unix": {"$ref": "#/$defs/positiveUint64"},
        "client_nonce_sha256": {"$ref": "#/$defs/sha256"}, "client_request_digest": {"$ref": "#/$defs/sha256"},
        "principal_id": {"$ref": "#/$defs/identifier"}, "route_id": {"$ref": "#/$defs/identifier"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releaseAuthority"},
        "authorization_binding_digest": {"$ref": "#/$defs/sha256"}, "control_plane_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_status": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/status"},
        "upstream_selected_raw_policy_headers_digest": {"$ref": "#/$defs/sha256"}, "upstream_body_digest": {"$ref": "#/$defs/sha256"},
        "upstream_body_bytes": {"$ref": "#/$defs/uint64"}, "upstream_canonical_digest": {"$ref": "#/$defs/sha256"},
        "released_response_status": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/status"},
        "released_response_content_type": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/attestedClaims/properties/released_response_content_type"},
        "selected_response_wire_headers_digest": {"$ref": "#/$defs/sha256"}, "released_response_body_digest": {"$ref": "#/$defs/sha256"},
        "released_response_body_bytes": {"$ref": "#/$defs/uint64"}, "response_framing": {"const": "http1.1-chunked-trailers"},
        "response_completion": {"const": "normal-eof"}, "response_trailer_names": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/trailerNames"},
        "policy_digest": {"$ref": "#/$defs/sha256"}, "runtime_manifest_digest": {"$ref": "#/$defs/sha256"},
        "data_plane_binary_digest": {"$ref": "#/$defs/sha256"}, "release_digest": {"$ref": "#/$defs/sha256"},
        "server_instance_id": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/attestedClaims/properties/server_instance_id"},
        "server_instance_identity_digest": {"$ref": "#/$defs/sha256"}, "tls_channel_binding_type": {"const": "tls-exporter"},
        "tls_exporter_label": {"const": "EXPORTER-Serverware-Proxy-Stream-v1"}, "tls_channel_binding_sha256": {"$ref": "#/$defs/sha256"},
        "response_signing_key_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "observationClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["server_statement_sha256", "server_statement_api_version", "issued_at_unix", "observation_id", "client_nonce_sha256", "request_aggregate_digest", "response_path", "upstream_attempt", "upstream_observation_digest", "emitted_response_digest", "policy_digest", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "server_instance_id", "server_instance_identity_digest", "tls_exporter_label", "tls_channel_binding_sha256", "response_signing_key_id", "observation_source"],
      "properties": {
        "server_statement_sha256": {"$ref": "#/$defs/sha256"}, "server_statement_api_version": {"const": "serverware.policyAwareResponseObservationStatement/v1"},
        "issued_at_unix": {"$ref": "#/$defs/positiveUint64"}, "observation_id": {"$ref": "#/$defs/sha256"},
        "client_nonce_sha256": {"$ref": "#/$defs/sha256"}, "request_aggregate_digest": {"$ref": "#/$defs/sha256"},
        "response_path": {"$ref": "response-observation-proof.v1.schema.json#/$defs/attestedClaims/properties/response_path"},
        "upstream_attempt": {"$ref": "response-observation-proof.v1.schema.json#/$defs/attestedClaims/properties/upstream_attempt"},
        "upstream_observation_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "emitted_response_digest": {"$ref": "#/$defs/sha256"}, "policy_digest": {"$ref": "#/$defs/sha256"},
        "runtime_manifest_digest": {"$ref": "#/$defs/sha256"}, "data_plane_binary_digest": {"$ref": "#/$defs/sha256"},
        "release_digest": {"$ref": "#/$defs/sha256"},
        "server_instance_id": {"$ref": "response-observation-proof.v1.schema.json#/$defs/attestedClaims/properties/server_instance_id"},
        "server_instance_identity_digest": {"$ref": "#/$defs/sha256"},
        "tls_exporter_label": {"const": "EXPORTER-Serverware-Response-Observation-v1"},
        "tls_channel_binding_sha256": {"$ref": "#/$defs/sha256"}, "response_signing_key_id": {"$ref": "#/$defs/sha256"},
        "observation_source": {"const": "gate-authored"}
      }
    },
    "verifierStatement": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "verifier_key_id": {"$ref": "#/$defs/sha256"}, "outcome": {"enum": ["development-fixture", "verified"]},
        "environment": {"enum": ["development", "production"]}, "trust_basis": {"const": "vendor-root-certificate-chain"},
        "vendor_quote_verified": {"const": true}, "certificate_chain_verified": {"const": true}, "revocation_checked": {"const": true},
        "debug": {"type": "boolean"}, "verified_at_unix": {"$ref": "#/$defs/positiveUint64"}, "expires_at_unix": {"$ref": "#/$defs/positiveUint64"},
        "tee_platform": {"$ref": "#/$defs/vendorText"}, "quote_provider": {"$ref": "#/$defs/vendorText"},
        "vendor_quote_sha256": {"$ref": "#/$defs/sha256"}, "server_statement_sha256": {"$ref": "#/$defs/sha256"},
        "streaming_response_statement_sha256": {"$ref": "#/$defs/sha256"}, "response_signing_key_id": {"$ref": "#/$defs/sha256"},
        "attested_claims": {"oneOf": [{"$ref": "#/$defs/bufferedClaims"}, {"$ref": "#/$defs/streamingClaims"}, {"$ref": "#/$defs/observationClaims"}]}
      },
      "oneOf": [
        {"maxProperties": 6, "required": ["outcome", "environment", "debug", "server_statement_sha256", "response_signing_key_id", "attested_claims"], "properties": {"outcome": {"const": "development-fixture"}, "environment": {"const": "development"}, "debug": {"const": true}}},
        {"maxProperties": 6, "required": ["outcome", "environment", "debug", "streaming_response_statement_sha256", "response_signing_key_id", "attested_claims"], "properties": {"outcome": {"const": "development-fixture"}, "environment": {"const": "development"}, "debug": {"const": true}}},
        {"maxProperties": 16, "required": ["verifier_key_id", "outcome", "environment", "trust_basis", "vendor_quote_verified", "certificate_chain_verified", "revocation_checked", "debug", "verified_at_unix", "expires_at_unix", "tee_platform", "quote_provider", "vendor_quote_sha256", "server_statement_sha256", "response_signing_key_id", "attested_claims"], "properties": {"outcome": {"const": "verified"}, "environment": {"const": "production"}, "debug": {"const": false}}},
        {"maxProperties": 16, "required": ["verifier_key_id", "outcome", "environment", "trust_basis", "vendor_quote_verified", "certificate_chain_verified", "revocation_checked", "debug", "verified_at_unix", "expires_at_unix", "tee_platform", "quote_provider", "vendor_quote_sha256", "streaming_response_statement_sha256", "response_signing_key_id", "attested_claims"], "properties": {"outcome": {"const": "verified"}, "environment": {"const": "production"}, "debug": {"const": false}}}
      ]
    },
    "trustedVerifier": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "statement", "signature"],
      "properties": {
        "apiVersion": {"const": "serverware.vendorTeeVerification/v1"}, "kind": {"const": "ServerwareVendorTeeVerification"},
        "statement": {"$ref": "#/$defs/verifierStatement"}, "signature": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signatureText"}]}
      },
      "if": {"properties": {"statement": {"properties": {"environment": {"const": "development"}}}}},
      "then": {"properties": {"signature": {"type": "null"}}},
      "else": {"properties": {"signature": {"$ref": "#/$defs/signatureText"}}}
    },
    "vendor": {
      "type": "object", "additionalProperties": false, "required": ["platform", "provider", "quote_sha256", "quote", "trusted_verifier"],
      "properties": {
        "platform": {"$ref": "#/$defs/vendorText"}, "provider": {"$ref": "#/$defs/vendorText"},
        "quote_sha256": {"$ref": "#/$defs/sha256"}, "quote": {"$ref": "#/$defs/quote"},
        "trusted_verifier": {"$ref": "#/$defs/trustedVerifier"}
      }
    },
    "bufferedVendor": {"allOf": [{"$ref": "#/$defs/vendor"}, {"properties": {"trusted_verifier": {"properties": {"statement": {"required": ["server_statement_sha256"], "properties": {"attested_claims": {"$ref": "#/$defs/bufferedClaims"}}}}}}}]},
    "streamingVendor": {"allOf": [{"$ref": "#/$defs/vendor"}, {"properties": {"trusted_verifier": {"properties": {"statement": {"required": ["streaming_response_statement_sha256"], "properties": {"attested_claims": {"$ref": "#/$defs/streamingClaims"}}}}}}}]},
    "observationVendor": {"allOf": [{"$ref": "#/$defs/vendor"}, {"properties": {"trusted_verifier": {"properties": {"statement": {"required": ["server_statement_sha256"], "properties": {"attested_claims": {"$ref": "#/$defs/observationClaims"}}}}}}}]}
  }
}
