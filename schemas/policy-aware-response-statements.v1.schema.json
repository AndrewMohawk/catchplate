{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/policy-aware-response-statements.v1.schema.json",
  "title": "Policy-aware ordinary response statements v1",
  "description": "Closed data shapes only. The actual ordinary cold owner and independent receiver select PolicyAware before effects. No Native1024 principal widening or legacy version relabeling. Exact signatures, receipts, canonical commitments, request/response/TLS, current policy and original lifetimes remain runtime duties. Reused native-schema components below contain only unchanged ordinary structures, never a native statement or receipt version.",
  "oneOf": [{"$ref": "#/$defs/buffered"}, {"$ref": "#/$defs/streaming"}, {"$ref": "#/$defs/observation"}],
  "$defs": {
    "sha256": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/sha256"},
    "bufferedIdentity": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedIdentity"},
    "identifier": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/identifier"},
    "bufferedReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "principal_id", "route_id", "release_authority", "request", "response"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareControlPlaneAuthorizationReceipt/v1"},
        "kind": {"const": "CatchplatePolicyAwareControlPlaneAuthorizationReceipt"},
        "principal_id": {"$ref": "#/$defs/bufferedIdentity"},
        "route_id": {"$ref": "#/$defs/bufferedIdentity"},
        "release_authority": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedReleaseAuthority"},
        "request": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/receiptRequest"},
        "response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/receiptResponse"}
      }
    },
    "streamingReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "principal_id", "route_id", "release_authority", "request", "response"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareControlPlaneAuthorizationReceipt/v1"},
        "kind": {"const": "CatchplatePolicyAwareControlPlaneAuthorizationReceipt"},
        "principal_id": {"$ref": "#/$defs/identifier"},
        "route_id": {"$ref": "#/$defs/identifier"},
        "release_authority": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releaseAuthority"},
        "request": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/receiptRequest"},
        "response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/receiptResponse"}
      }
    },
    "authorizationBindingCommitment": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "attempt_id", "flow_id", "principal_id", "route_id", "credential_id", "credential_version", "policy_hash", "request_digest", "operation_digest", "operation_context_digest", "require_jit_grant", "approver_policy_sha256", "shared_quotas"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareResponseAuthorizationCommitment/v1"},
        "attempt_id": {"$ref": "#/$defs/sha256"}, "flow_id": {"$ref": "#/$defs/sha256"},
        "principal_id": {"$ref": "#/$defs/identifier"}, "route_id": {"$ref": "#/$defs/identifier"},
        "credential_id": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/identifier"}]},
        "credential_version": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/uint64"},
        "policy_hash": {"$ref": "#/$defs/sha256"}, "request_digest": {"$ref": "#/$defs/sha256"},
        "operation_digest": {"$ref": "#/$defs/sha256"}, "operation_context_digest": {"$ref": "#/$defs/sha256"},
        "require_jit_grant": {"type": "boolean"}, "approver_policy_sha256": {"$ref": "#/$defs/sha256"},
        "shared_quotas": {"type": "array", "maxItems": 256, "items": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/quota"}}
      },
      "oneOf": [
        {"properties": {"credential_id": {"const": ""}, "credential_version": {"const": 0}}},
        {"properties": {"credential_id": {"$ref": "#/$defs/identifier"}, "credential_version": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/positiveUint64"}}}
      ]
    },
    "authorizationBindingValidation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "binding_commitment", "binding_digest"],
      "properties": {
        "status": {"const": "validated"},
        "binding_commitment": {"$ref": "#/$defs/authorizationBindingCommitment"},
        "binding_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "observationAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "binding_digest", "release_authority", "control_plane_authorization_receipt", "control_plane_authorization_receipt_sha256"],
      "properties": {
        "state": {"enum": ["not-evaluated", "denied", "reserved", "dispatching", "completed-forwarded", "completion-unknown"]},
        "binding_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "release_authority": {"anyOf": [{"type": "null"}, {"$ref": "response-observation-proof.v1.schema.json#/$defs/releaseAuthority"}]},
        "control_plane_authorization_receipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/streamingReceipt"}]},
        "control_plane_authorization_receipt_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      },
      "oneOf": [
        {"properties": {"state": {"enum": ["not-evaluated", "denied", "reserved"]}, "binding_digest": {"type": "null"}, "release_authority": {"type": "null"}, "control_plane_authorization_receipt": {"type": "null"}, "control_plane_authorization_receipt_sha256": {"type": "null"}}},
        {"properties": {"state": {"enum": ["dispatching", "completed-forwarded", "completion-unknown"]}, "binding_digest": {"$ref": "#/$defs/sha256"}, "release_authority": {"$ref": "response-observation-proof.v1.schema.json#/$defs/releaseAuthority"}, "control_plane_authorization_receipt": {"$ref": "#/$defs/streamingReceipt"}, "control_plane_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "buffered": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "issued_at_unix", "client_nonce", "principal_id", "route_id", "request_digest", "operation_digest", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "client_request_digest", "release_authority", "control_plane_authorization_receipt", "upstream_response", "response", "policy_digest", "server_instance", "tls_channel_binding"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareProxyResponseStatement/v1"},
        "issued_at_unix": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/positiveUint64"},
        "client_nonce": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedNonce"},
        "principal_id": {"$ref": "#/$defs/bufferedIdentity"}, "route_id": {"$ref": "#/$defs/bufferedIdentity"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "runtime_manifest_digest": {"$ref": "#/$defs/sha256"}, "data_plane_binary_digest": {"$ref": "#/$defs/sha256"},
        "release_digest": {"$ref": "#/$defs/sha256"}, "client_request_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedReleaseAuthority"},
        "control_plane_authorization_receipt": {"$ref": "#/$defs/bufferedReceipt"},
        "upstream_response": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedUpstreamResponse"},
        "response": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedResponse"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "server_instance": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedServerInstance"},
        "tls_channel_binding": {"$ref": "native-response-runtime-proof.v1.schema.json#/$defs/bufferedTlsChannelBinding"}
      }
    },
    "streaming": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "issued_at_unix", "client_nonce", "principal_id", "route_id", "request_digest", "operation_digest", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "client_request_digest", "release_authority", "authorization_binding_validation", "control_plane_authorization_receipt", "control_plane_authorization_receipt_sha256", "upstream_response", "released_response", "policy_digest", "server_instance", "tls_channel_binding"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareStreamingResponseStatement/v1"},
        "issued_at_unix": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/positiveUint64"},
        "client_nonce": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/nonce"},
        "principal_id": {"$ref": "#/$defs/identifier"}, "route_id": {"$ref": "#/$defs/identifier"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "operation_digest": {"$ref": "#/$defs/sha256"},
        "runtime_manifest_digest": {"$ref": "#/$defs/sha256"}, "data_plane_binary_digest": {"$ref": "#/$defs/sha256"},
        "release_digest": {"$ref": "#/$defs/sha256"}, "client_request_digest": {"$ref": "#/$defs/sha256"},
        "release_authority": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releaseAuthority"},
        "authorization_binding_validation": {"$ref": "#/$defs/authorizationBindingValidation"},
        "control_plane_authorization_receipt": {"$ref": "#/$defs/streamingReceipt"},
        "control_plane_authorization_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "upstream_response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/upstreamResponse"},
        "released_response": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/releasedResponse"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "server_instance": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/serverInstance"},
        "tls_channel_binding": {"$ref": "streaming-response-proof.v1.schema.json#/$defs/tlsChannelBinding"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "issued_at_unix", "observation_id", "client_nonce", "request", "policy", "principal_id", "route_id", "request_digest", "operation_digest", "credential", "authorization", "response_path", "upstream_attempt", "upstream_observation", "emitted_response", "runtime_manifest_digest", "data_plane_binary_digest", "release_digest", "server_instance", "tls_channel_binding", "observation_authority"],
      "properties": {
        "apiVersion": {"const": "catchplate.policyAwareResponseObservationStatement/v1"},
        "issued_at_unix": {"$ref": "response-observation-proof.v1.schema.json#/$defs/positiveUint64"},
        "observation_id": {"$ref": "#/$defs/sha256"},
        "client_nonce": {"$ref": "response-observation-proof.v1.schema.json#/$defs/nonce32"},
        "request": {"$ref": "response-observation-proof.v1.schema.json#/$defs/observedRequest"},
        "policy": {"$ref": "response-observation-proof.v1.schema.json#/$defs/policy"},
        "principal_id": {"anyOf": [{"type": "null"}, {"$ref": "response-observation-proof.v1.schema.json#/$defs/identifier"}]},
        "route_id": {"anyOf": [{"type": "null"}, {"$ref": "response-observation-proof.v1.schema.json#/$defs/identifier"}]},
        "request_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "operation_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "credential": {"$ref": "response-observation-proof.v1.schema.json#/$defs/credential"},
        "authorization": {"$ref": "#/$defs/observationAuthorization"},
        "response_path": {"$ref": "response-observation-proof.v1.schema.json#/$defs/statement/properties/response_path"},
        "upstream_attempt": {"$ref": "response-observation-proof.v1.schema.json#/$defs/statement/properties/upstream_attempt"},
        "upstream_observation": {"anyOf": [{"type": "null"}, {"$ref": "response-observation-proof.v1.schema.json#/$defs/upstreamObservation"}]},
        "emitted_response": {"$ref": "response-observation-proof.v1.schema.json#/$defs/observedResponse"},
        "runtime_manifest_digest": {"$ref": "#/$defs/sha256"}, "data_plane_binary_digest": {"$ref": "#/$defs/sha256"},
        "release_digest": {"$ref": "#/$defs/sha256"},
        "server_instance": {"$ref": "response-observation-proof.v1.schema.json#/$defs/serverInstance"},
        "tls_channel_binding": {"$ref": "response-observation-proof.v1.schema.json#/$defs/tlsChannelBinding"},
        "observation_authority": {"$ref": "response-observation-proof.v1.schema.json#/$defs/observationAuthority"}
      }
    }
  }
}
