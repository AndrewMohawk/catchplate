{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.local/schemas/policy-bundle.v1.schema.json",
  "title": "Serverware PolicyBundle v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "defaults", "principals", "credentials", "routes"],
  "additionalProperties": false,
  "$defs": {
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "type": {"enum": ["string", "number", "integer", "boolean", "object", "array", "null"]},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "pattern": {"type": "string", "maxLength": 256},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0},
        "enum": {"type": "array"},
        "equals": {}
      }
    },
    "credentialConstraint": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "type": {
          "enum": [
            "rateLimit",
            "operationPolicy",
            "queryDateWindow",
            "queryNumericBounds",
            "requestTimeWindow",
            "jsonBody",
            "formBody",
            "responseDateWindow"
          ]
        },
        "phase": {"enum": ["request", "response"]},
        "statusCode": {"type": "integer", "minimum": 400, "maximum": 599},
        "store": {"enum": ["local", "shared"]},
        "max": {"type": "number"},
        "windowSeconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {"enum": ["principal", "credential", "credentialVersion", "route", "operation"]}
            },
            "operationFields": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"}
            }
          }
        },
        "allowedOperations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "deniedOperations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "parameters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required": {"type": "boolean"},
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["rfc3339", "date", "epochSeconds", "epochMillis"]}
        },
        "maxAgeDays": {"type": "integer", "minimum": 1},
        "allowFutureSkewSeconds": {"type": "integer", "minimum": 0},
        "min": {"type": "number"},
        "integer": {"type": "boolean"},
        "timezone": {"const": "UTC"},
        "notBefore": {"type": "string", "format": "date-time"},
        "notAfter": {"type": "string", "format": "date-time"},
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]}
        },
        "dailyWindows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
              "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
            }
          }
        },
        "contentTypes": {"type": "array", "items": {"type": "string"}},
        "allowedFields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requiredFields": {"type": "array", "items": {"type": "string"}},
        "deniedFields": {"type": "array", "items": {"type": "string"}},
        "fields": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/fieldRule"}
        },
        "items": {"type": "array", "items": {"type": "string"}},
        "dateFields": {"type": "array", "items": {"type": "string"}},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"}
        },
        "extensions": {"type": "object", "maxProperties": 0, "additionalProperties": false}
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {"type": {"const": "responseDateWindow"}}
          },
          "then": {
            "required": ["phase"],
            "properties": {"phase": {"const": "response"}}
          },
          "else": {
            "properties": {"phase": {"const": "request"}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "rateLimit"}}, "required": ["type"]},
          "then": {"required": ["max", "windowSeconds"]}
        },
        {
          "if": {"properties": {"type": {"const": "operationPolicy"}}, "required": ["type"]},
          "then": {"anyOf": [{"required": ["allowedOperations"]}, {"required": ["deniedOperations"]}]}
        },
        {
          "if": {"properties": {"type": {"const": "queryDateWindow"}}, "required": ["type"]},
          "then": {"required": ["parameters", "formats", "maxAgeDays"]}
        },
        {
          "if": {"properties": {"type": {"const": "queryNumericBounds"}}, "required": ["type"]},
          "then": {
            "required": ["parameters"],
            "anyOf": [{"required": ["min"]}, {"required": ["max"]}]
          }
        },
        {
          "if": {"properties": {"type": {"const": "requestTimeWindow"}}, "required": ["type"]},
          "then": {
            "required": ["timezone"],
            "anyOf": [
              {"required": ["notBefore"]},
              {"required": ["notAfter"]},
              {"required": ["weekdays"]},
              {"required": ["dailyWindows"]}
            ]
          }
        },
        {
          "if": {
            "properties": {"type": {"enum": ["jsonBody", "formBody"]}},
            "required": ["type"]
          },
          "then": {"required": ["allowedFields"]}
        },
        {
          "if": {"properties": {"type": {"const": "responseDateWindow"}}, "required": ["type"]},
          "then": {"required": ["phase", "dateFields", "formats", "maxAgeDays"]}
        }
      ]
    }
  },
  "properties": {
    "apiVersion": {"const": "serverware.policy/v1"},
    "kind": {"const": "PolicyBundle"},
    "metadata": {
      "type": "object",
      "required": ["id", "sequence", "rollbackEpoch"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "rollbackEpoch": {"type": "integer", "minimum": 1},
        "validFrom": false,
        "signingKeyId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature": {"type": "string"}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "failMode", "unknownHosts", "unknownPaths", "validationFailure"],
      "properties": {
        "action": {"const": "deny"},
        "failMode": {"const": "closed"},
        "unknownHosts": {"const": "block"},
        "unknownPaths": {"const": "block"},
        "validationFailure": {"const": "block"}
      }
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "anyOf": [
          {"required": ["sourceCidrs"]},
          {"required": ["requiredHeaders"]},
          {"required": ["proxyAuthorization"]}
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sourceCidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requiredHeaders": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string"}
          },
          "proxyAuthorization": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["scheme", "tokenSha256"],
                "additionalProperties": false,
                "properties": {
                  "scheme": {"enum": ["Bearer"]},
                  "tokenId": {"type": "string", "minLength": 1},
                  "tokenSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "sourceCidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "expiresAtEpochMs": {"type": "integer", "minimum": 1}
                }
              }
            ]
          }
        }
      }
    },
    "credentials": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["id", "injection"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"required": ["providerSubject"]},
            "then": {
              "required": ["provider"],
              "properties": {
                "provider": {"type": "string", "minLength": 1, "not": {"const": "generic"}}
              }
            }
          }
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string"},
          "providerSubject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          },
          "scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "injection": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["bearer", "basic", "header", "query", "cookie"]},
              "header": {"type": "string", "minLength": 1, "maxLength": 128},
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              "prefix": {"type": "string", "maxLength": 128},
              "username": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["id", "principals", "match", "adapter"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "principals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "match": {
            "type": "object",
            "required": ["scheme", "host", "port", "methods", "paths"],
            "additionalProperties": false,
            "properties": {
              "scheme": {"enum": ["https"]},
              "host": {"type": "string", "minLength": 1},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}
            }
          },
          "credentialRef": {"type": "string"},
          "adapter": {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["generic.rest", "gmail.v1", "x.v2", "npm.registry"]},
              "config": {"type": "object"}
            }
          },
          "constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/credentialConstraint"}
          },
          "jit": {
            "type": "object",
            "required": ["required", "mode", "ttlSeconds", "maxUses", "consumeOn", "binding", "approvers"],
            "additionalProperties": false,
            "properties": {
              "required": {"type": "boolean"},
              "mode": {"const": "perOperation"},
              "ttlSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
              "maxUses": {"type": "integer", "minimum": 1},
              "consumeOn": {"const": "forwardStart"},
              "binding": {
                "type": "object",
                "required": ["type", "fields"],
                "additionalProperties": false,
                "properties": {
                  "type": {"enum": ["requestDigest", "operationDigest"]},
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "principal",
                        "routeId",
                        "credentialRef",
                        "credentialVersion",
                        "policyHash",
                        "method",
                        "authority",
                        "path",
                        "query",
                        "selectedHeaders",
                        "bodySha256",
                        "packageName",
                        "packageVersion",
                        "tarballIntegrity",
                        "operation"
                      ]
                    }
                  }
                }
              },
              "approvers": {
                "type": "object",
                "required": ["quorum", "users", "authn"],
                "additionalProperties": false,
                "properties": {
                  "quorum": {"const": 1},
                  "users": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "authn": {
                    "type": "object",
                    "required": ["webauthnRequired", "userVerification", "allowedAuthenticatorClasses", "requireHardwareAttestation"],
                    "additionalProperties": false,
                    "properties": {
                      "webauthnRequired": {"type": "boolean"},
                      "userVerification": {"enum": ["required", "preferred", "discouraged"]},
                      "allowedAuthenticatorClasses": {
                        "type": "array",
                        "items": {"enum": ["yubikey", "hardware", "platform", "dev", "unknown"]}
                      },
                      "requireHardwareAttestation": {"type": "boolean"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
