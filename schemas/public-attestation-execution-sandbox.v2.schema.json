        "executableSha256": {
          "$ref": "#/$defs/sha256"
        },
        "executionSource": {
          "const": "sealed-memfd"
        },
        "format": {
          "const": "elf"
        },
        "architecture": {
          "enum": [
            "aarch64",
            "x86_64"
          ]
