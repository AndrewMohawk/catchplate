          "maxItems": 0
        },
        "bounding": {
          "type": "array",
          "maxItems": 0
        },
        "effective": {
          "type": "array",
          "maxItems": 0
        },
        "inheritable": {
          "type": "array",
          "maxItems": 0
        },
        "permitted": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "userNamespace"
