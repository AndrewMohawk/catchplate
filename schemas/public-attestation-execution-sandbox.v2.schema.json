            },
            "profileSha256": {
              "$ref": "#/$defs/sha256"
            },
            "embeddedInStaticProducer": {
              "const": true
            },
            "allowedSyscalls": {
              "const": [
                "brk",
                "clock_gettime",
                "close",
                "exit",
                "exit_group",
                "fstat",
                "futex",
                "getpid",
                "getrandom",
                "gettid",
                "lseek",
                "read",
                "rt_sigreturn",
                "write"
              ]
            }
          }
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execFlags",
            "execSyscall",
            "executableFd",
            "externalEnforcementPrerequisite",
            "method",
            "requiredSeccompFilterCount"
          ],
          "properties": {
            "method": {
              "const": "measured-static-entrypoint-additive-filter"
            },
            "execSyscall": {
              "const": "execveat"
            },
            "executableFd": {
              "const": 126
            },
            "execFlags": {
              "const": [
                "AT_EMPTY_PATH"
              ]
            },
            "requiredSeccompFilterCount": {
              "const": 2
            },
            "externalEnforcementPrerequisite": {
              "description": "Hard production prerequisite. Current source fails production closed until a measured static producer entry stub installs the exact runtime filter before application code, every measured static service peer has its signed post-exec filter identity externally attested, the measured static launcher brokers every service frame, and the supervisor supplies the required read-only cgroup view.",
              "const": "measured-static-entry-stubs-plus-launcher-frame-broker-plus-read-only-cgroupns-v1"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "architecture": {
                "const": "x86_64"
              }
            },
            "required": [
              "architecture"
            ]
          },
          "then": {
            "properties": {
              "auditArchitecture": {
                "const": 3221225534
              },
              "kernelAbi": {
                "properties": {
                  "syscallTableId": {
                    "const": "linux-uapi-x86_64-serverware-v1"
                  },
                  "syscallTableSha256": {
                    "const": "sha256:2e3b41282fd357204e77d43bf1b9cd9fcf7bfc271c32513bb813052d099e8e0b"
                  }
                }
              },
              "bootstrapProfile": {
                "properties": {
                  "profileId": {
                    "const": "serverware-producer-bootstrap-x86_64-v1"
                  }
                }
              },
              "runtimeProfile": {
                "properties": {
                  "profileId": {
                    "const": "serverware-producer-runtime-x86_64-v1"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "auditArchitecture": {
                "const": 3221225655
              },
              "kernelAbi": {
                "properties": {
                  "syscallTableId": {
                    "const": "linux-uapi-aarch64-serverware-v1"
                  },
                  "syscallTableSha256": {
                    "const": "sha256:2111fcbddd04d564b6d478b442b7cd543bf1075b13ce4eef7f9d42677070f21f"
                  }
                }
              },
              "bootstrapProfile": {
                "properties": {
                  "profileId": {
                    "const": "serverware-producer-bootstrap-aarch64-v1"
                  }
                }
              },
              "runtimeProfile": {
                "properties": {
                  "profileId": {
                    "const": "serverware-producer-runtime-aarch64-v1"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cgroup": {
      "type": "object",
