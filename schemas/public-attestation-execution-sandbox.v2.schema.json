    "rootFilesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindMounts",
        "emptyTmpfs",
        "maxBytes",
        "nodev",
        "noexec",
        "nosuid",
        "path",
        "readOnlyAfterSetup",
