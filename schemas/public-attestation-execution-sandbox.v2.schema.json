                "properties": {
                  "major": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048575
                  },
                  "minor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048575
                  },
                  "rbps": {
                    "$ref": "#/$defs/u64Positive"
                  },
                  "wbps": {
                    "$ref": "#/$defs/u64Positive"
                  },
                  "riops": {
                    "$ref": "#/$defs/u64Positive"
                  },
                  "wiops": {
                    "$ref": "#/$defs/u64Positive"
                  }
                }
              }
            }
          }
        },
        "disposable": {
          "const": true
        },
        "killMode": {
          "const": "pid-namespace-init-plus-cgroup.kill"
