    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "command",
        "executionSource",
        "executableSha256",
        "format",
        "postExecEnforcement",
        "requireSealed",
        "sourceFdRole",
        "static"
