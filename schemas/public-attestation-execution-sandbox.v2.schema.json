          "properties": {
            "entryStubSha256": {
              "$ref": "#/$defs/sha256"
            },
            "mechanism": {
              "const": "measured-static-entry-stub-additive-seccomp"
            },
            "entryStubMeasured": {
              "const": true
            },
            "requiredBeforeApplicationCode": {
              "const": true
            },
            "runtimeProfileSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "command": {
          "$ref": "#/$defs/producerCommand"
        }
      }
    },
    "fdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closeAllOthers",
        "immutableConfig",
        "namedProducerFds",
        "stderr",
        "stdin",
        "stdout"
      ],
      "properties": {
        "stdin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "access",
            "maxBytes",
            "requireSealed",
            "source",
            "targetFd"
