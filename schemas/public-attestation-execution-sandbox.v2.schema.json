{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/public-attestation-execution-sandbox.v2.schema.json",
  "title": "Serverware public attestation execution sandbox v2",
  "description": "A measured-process and retained-FD containment contract. The ordinary host kernel and host root are trusted; this is not hostile-host or whole-codebase proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "capabilities",
    "cgroup",
    "executionMode",
    "executable",
    "fdPolicy",
    "identity",
    "monitoring",
    "namespaces",
    "network",
    "noNewPrivileges",
    "process",
    "productionClaim",
    "rootFilesystem",
    "seccomp",
    "trustBoundary"
  ],
  "properties": {
    "apiVersion": {
      "const": "serverware.publicAttestationExecutionSandbox/v2"
    },
    "executionMode": {
      "enum": [
        "fixture-non-production",
        "production"
      ]
    },
    "productionClaim": {
      "type": "boolean"
    },
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "hostKernelTrusted",
        "hostRootTrusted",
        "hostileHostProof",
        "launcherStaticElfRequired"
      ],
      "properties": {
        "claim": {
          "const": "measured-process-and-retained-fd-containment-v2"
        },
        "hostKernelTrusted": {
          "const": true
        },
        "hostRootTrusted": {
          "const": true
        },
        "hostileHostProof": {
          "const": false
        },
