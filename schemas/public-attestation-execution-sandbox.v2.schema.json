          ],
          "properties": {
            "endianness": {
              "const": "little"
            },
            "syscallTableId": {
              "enum": [
                "linux-uapi-aarch64-serverware-v1",
                "linux-uapi-x86_64-serverware-v1"
              ]
            },
            "syscallTableSha256": {
              "$ref": "#/$defs/sha256"
            },
            "wordBits": {
              "const": 64
            }
          }
        },
        "bootstrapProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedSyscalls",
            "instructionCount",
