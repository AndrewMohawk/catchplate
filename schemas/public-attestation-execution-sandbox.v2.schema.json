            "memoryOomGroup": {
              "const": true
            },
            "cpuMaxQuotaMicros": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 10000000
            },
            "cpuMaxPeriodMicros": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 1000000
            },
            "cpuWeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
