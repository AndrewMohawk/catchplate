            "profileFdRole": {
              "const": "seccompProfile"
            },
            "profileId": {
              "enum": [
                "serverware-producer-bootstrap-aarch64-v1",
                "serverware-producer-bootstrap-x86_64-v1"
              ]
            },
            "profileSha256": {
              "$ref": "#/$defs/sha256"
            },
            "instructionCount": {
              "const": 37
            },
            "allowedSyscalls": {
              "const": [
                "brk",
                "clock_gettime",
                "close",
                "execveat",
                "exit",
                "exit_group",
                "fstat",
                "futex",
                "getpid",
                "getrandom",
                "gettid",
                "lseek",
                "read",
                "rt_sigreturn",
                "seccomp",
                "write"
              ]
            }
          }
        },
        "runtimeProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedSyscalls",
            "embeddedInStaticProducer",
            "profileId",
            "profileSha256"
          ],
          "properties": {
            "profileId": {
              "enum": [
                "serverware-producer-runtime-aarch64-v1",
                "serverware-producer-runtime-x86_64-v1"
