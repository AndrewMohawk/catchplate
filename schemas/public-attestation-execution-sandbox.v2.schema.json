        "maxBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1073741824
        },
        "readOnlyAfterSetup": {
          "const": true
        },
        "nodev": {
          "const": true
        },
        "noexec": {
          "const": true
        },
        "nosuid": {
          "const": true
        },
        "bindMounts": {
          "const": []
        }
      }
    },
    "seccomp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "auditArchitecture",
        "bootstrapProfile",
