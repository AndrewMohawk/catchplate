  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "const": "production"
          }
        },
        "required": [
          "executionMode"
        ]
      },
      "then": {
        "properties": {
          "productionClaim": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "executionMode": {
            "const": "fixture-non-production"
          },
          "productionClaim": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$"
    },
    "cgroupPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096,
      "pattern": "^/sys/fs/cgroup/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$"
    },
    "cgroupMembershipPath": {
      "type": "string",
