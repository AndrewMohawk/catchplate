          "properties": {
            "source": {
              "const": "launcher-stdin"
            },
            "targetFd": {
              "const": 0
            },
            "access": {
              "const": "read-only"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "requireSealed": {
              "const": true
            }
          }
        },
        "stdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "access",
            "source",
            "targetFd"
          ],
          "properties": {
            "source": {
              "const": "launcher-stdout"
            },
            "targetFd": {
              "const": 1
            },
            "access": {
              "const": "write-only"
            }
          }
        },
        "stderr": {
          "const": "closed"
        },
        "immutableConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "access",
            "binding",
            "maxBytes",
            "requireSealed",
            "sourceFdRole",
            "targetFd"
          ],
          "properties": {
            "sourceFdRole": {
              "const": "immutableConfig"
            },
            "targetFd": {
              "type": "integer",
              "minimum": 3,
              "maximum": 63
            },
            "access": {
              "const": "read-only"
            },
            "binding": {
              "$ref": "#/$defs/immutableConfigBinding"
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "requireSealed": {
              "const": true
            }
          }
        },
        "namedProducerFds": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/sealedFileFd"
              },
              {
                "$ref": "#/$defs/sealedReleaseBoundFileFd"
              },
              {
                "$ref": "#/$defs/sealedMeasurementCopyFd"
              },
              {
                "$ref": "#/$defs/sealedEphemeralSecretFd"
              },
              {
                "$ref": "#/$defs/unixServiceFd"
              }
            ]
          }
        },
        "closeAllOthers": {
          "const": true
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandDeadlineMilliseconds",
        "killAndReapTimeoutMilliseconds",
        "limitMutationWatch",
        "membershipPollMilliseconds",
        "startupTimeoutMilliseconds"
      ],
      "properties": {
        "commandDeadlineMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "startupTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "membershipPollMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "killAndReapTimeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "limitMutationWatch": {
          "const": "inotify-fail-on-write-attrib-delete-move"
