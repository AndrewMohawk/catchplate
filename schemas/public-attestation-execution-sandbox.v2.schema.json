        "kernelAbi",
        "runtimeProfile",
        "transition",
        "unknownSyscallAction"
      ],
      "properties": {
        "contract": {
          "const": "serverware.closedSeccompProfile/v1"
        },
        "format": {
          "const": "linux-cbpf-sock-filter-le-v1"
        },
        "architecture": {
          "enum": [
            "aarch64",
            "x86_64"
          ]
        },
        "auditArchitecture": {
          "type": "integer",
          "enum": [
            3221225534,
            3221225655
          ]
        },
        "defaultAction": {
          "const": "kill-process"
        },
        "unknownSyscallAction": {
          "const": "kill-process"
