{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/public-attestation-producer-descriptor.v2.schema.json",
  "title": "Catchplate public attestation producer descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "concurrencyLimit",
    "executablePath",
    "executableSha256",
    "immutableConfigPath",
    "maxInputBytes",
    "maxOutputBytes",
    "nonceService",
    "nonceStoreIdentitySha256",
    "nonceStoreKeySpkiSha256",
    "producerRequestSchemaSha256",
    "sandboxResources",
    "sandboxDescriptorPath",
    "sandboxDescriptorSha256",
    "sandboxLauncherPath",
    "sandboxLauncherSha256",
    "timeoutMilliseconds",
    "trustRootsSha256",
    "verifierStateService",
    "witnessStoreIdentitySha256",
    "witnessStoreKeySpkiSha256"
  ],
  "properties": {
    "apiVersion": {
      "const": "catchplate.publicAttestationProducerDescriptor/v2"
    },
    "concurrencyLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "executablePath": {"$ref": "#/$defs/absolutePath"},
    "executableSha256": {"$ref": "#/$defs/sha256"},
    "immutableConfigPath": {"$ref": "#/$defs/absolutePath"},
    "maxInputBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 262144
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 4194304
    },
    "nonceService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "expectedPeerCgroupPath",
        "expectedPeerExecutableSha256",
        "expectedPeerGid",
        "expectedPeerUid",
        "maxResponseBytes",
        "requestRole",
        "responseRole",
        "socketType",
        "timeoutMilliseconds"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.attestationNonceConsumeOnceRequest/v3"
        },
        "expectedPeerCgroupPath": {"$ref": "#/$defs/absolutePath"},
        "expectedPeerExecutableSha256": {"$ref": "#/$defs/sha256"},
        "expectedPeerGid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expectedPeerUid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 1048576
        },
        "requestRole": {"$ref": "#/$defs/identifier"},
        "responseRole": {"$ref": "#/$defs/identifier"},
        "socketType": {
          "const": "AF_UNIX/SOCK_SEQPACKET"
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        }
      }
    },
    "nonceStoreIdentitySha256": {"$ref": "#/$defs/sha256"},
    "nonceStoreKeySpkiSha256": {"$ref": "#/$defs/sha256"},
    "producerRequestSchemaSha256": {"$ref": "#/$defs/sha256"},
    "sandboxResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountSources",
        "measurementCopies",
        "producerStreams",
        "rootPath",
        "sealedFiles",
        "seccompProfilePath"
      ],
      "properties": {
        "mountSources": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": {"$ref": "#/$defs/absolutePath"},
              "role": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        "measurementCopies": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["measurementOf", "role"],
            "properties": {
              "measurementOf": {
                "enum": [
                  "producerExecutable",
                  "sandboxDescriptor"
                ]
              },
              "role": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        "producerStreams": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role"],
            "properties": {
              "role": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        "sealedFiles": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": {"$ref": "#/$defs/absolutePath"},
              "role": {"$ref": "#/$defs/identifier"}
            }
          }
        },
        "rootPath": {"$ref": "#/$defs/absolutePath"},
        "seccompProfilePath": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "sandboxDescriptorPath": {"$ref": "#/$defs/absolutePath"},
    "sandboxDescriptorSha256": {"$ref": "#/$defs/sha256"},
    "sandboxLauncherPath": {"$ref": "#/$defs/absolutePath"},
    "sandboxLauncherSha256": {"$ref": "#/$defs/sha256"},
    "timeoutMilliseconds": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "trustRootsSha256": {"$ref": "#/$defs/sha256"},
    "verifierStateService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abortPath",
        "apiVersion",
        "attachNonceStatusPath",
        "caFdRole",
        "clientCertificateFdRole",
        "clientCertificateSpkiSha256",
        "clientKeyFdRole",
        "commitPath",
        "concurrencyLimit",
        "endpoint",
        "issueChallengePath",
        "markConsumptionPath",
        "maxResponseBytes",
        "preparePath",
        "readPath",
        "recoverPath",
        "recoverChallengePath",
        "recoveryLookupPath",
        "serverLeafSpkiSha256",
        "serviceConfigurationSha256",
        "timeoutMilliseconds"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.attestationVerifierStateClient/v2"
        },
        "abortPath": {"const": "/v1/state/abort"},
        "attachNonceStatusPath": {
          "const": "/v1/state/attach-nonce-status"
        },
        "caFdRole": {"const": "verifierStateCa"},
        "clientCertificateFdRole": {
          "const": "verifierStateClientCertificate"
        },
        "clientCertificateSpkiSha256": {"$ref": "#/$defs/sha256"},
        "clientKeyFdRole": {"const": "verifierStateClientKey"},
        "commitPath": {"const": "/v1/state/commit"},
        "concurrencyLimit": {"const": 1},
        "endpoint": {
          "type": "string",
          "pattern": "^https://(?:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "maxLength": 512
        },
        "issueChallengePath": {
          "const": "/v1/state/issue-challenge"
        },
        "markConsumptionPath": {
          "const": "/v1/state/mark-consumption"
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "preparePath": {"const": "/v1/state/prepare"},
        "readPath": {"const": "/v1/state/read"},
        "recoverPath": {"const": "/v1/state/recover"},
        "recoverChallengePath": {
          "const": "/v1/state/recover-challenge"
        },
        "recoveryLookupPath": {
          "const": "/v1/state/recovery-lookup"
        },
        "serverLeafSpkiSha256": {"$ref": "#/$defs/sha256"},
        "serviceConfigurationSha256": {"$ref": "#/$defs/sha256"},
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        }
      }
    },
    "witnessStoreIdentitySha256": {"$ref": "#/$defs/sha256"},
    "witnessStoreKeySpkiSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$",
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:@+-]{0,127}$"
    }
  }
}
