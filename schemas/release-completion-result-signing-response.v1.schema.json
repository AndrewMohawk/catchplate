{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/release-completion-result-signing-response.v1.schema.json",
  "title": "Catchplate Release Completion Result Signing Response v1",
  "$comment": "Closed, language-neutral external-signer response for final-v1. Structural validation does not verify the Ed25519 signature, bind the response to the exact deterministic request, establish caller-pinned provider/key/SPKI/role-registry trust, or authorize an action. The native verifier must perform those checks before producing the non-actionable final result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "operation",
    "status",
    "requestSha256",
    "idempotencyKey",
    "provider",
    "signingKeyId",
    "signingKeySpkiSha256",
    "globalRoleRegistrySha256",
    "resultSha256",
    "signingBytesSha256",
    "signature"
  ],
  "properties": {
    "apiVersion": {
      "const": "catchplate.releaseCompletionResultSigningResponse/v1"
    },
    "kind": {
      "const": "ReleaseCompletionResultSigningResponse"
    },
    "operation": {
      "const": "sign-release-completion-result"
    },
    "status": {
      "const": "signed"
    },
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "idempotencyKey": {"$ref": "#/$defs/sha256"},
    "provider": {"$ref": "#/$defs/identifier"},
    "signingKeyId": {"$ref": "#/$defs/sha256"},
    "signingKeySpkiSha256": {"$ref": "#/$defs/sha256"},
    "globalRoleRegistrySha256": {"$ref": "#/$defs/sha256"},
    "resultSha256": {"$ref": "#/$defs/sha256"},
    "signingBytesSha256": {"$ref": "#/$defs/sha256"},
    "signature": {"$ref": "#/$defs/ed25519Signature"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,255}(?![\\s\\S])"
    },
    "ed25519Signature": {
      "$comment": "Canonical unpadded base64url encoding of exactly 64 Ed25519 signature bytes; the final character enforces zero unused pad bits.",
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{85}[AQgw](?![\\s\\S])"
    }
  }
}
