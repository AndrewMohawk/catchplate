        "status": {"const": "redemption-verified-non-actionable"},
        "actionable": {"const": false},
        "redemptionVerified": {"const": true},
        "commitId": {"$ref": "#/$defs/identifier"},
        "storeId": {"$ref": "#/$defs/identifier"},
        "signingKeyId": {"$ref": "#/$defs/sha256"},
        "stateStoreSigningKeyId": {"$ref": "#/$defs/sha256"},
        "receiptFileSha256": {"$ref": "#/$defs/sha256"},
        "receiptPayloadSha256": {"$ref": "#/$defs/sha256"},
        "priorStateSha256": {"$ref": "#/$defs/sha256"},
        "currentStateSha256": {"$ref": "#/$defs/sha256"},
        "transitionSha256": {"$ref": "#/$defs/sha256"},
        "challengeConsumptionSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadAuthorizationId": {"$ref": "#/$defs/identifier"},
        "currentHeadAuthorizationFileSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadAuthorizationKeyId": {"$ref": "#/$defs/sha256"},
        "currentHeadSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadVerifierNonceSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadReservationId": {"$ref": "#/$defs/identifier"},
        "currentHeadRedemptionId": {"$ref": "#/$defs/identifier"},
        "currentHeadRedemptionReceiptFileSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadRedemptionReceiptIdentitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentHeadRedemptionVerifierNonceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentHeadRedemptionKeyId": {"$ref": "#/$defs/sha256"},
        "currentFinalHeadSha256": {"$ref": "#/$defs/sha256"},
        "currentHeadOneUseSequence": {"$ref": "#/$defs/positiveU64"},
        "verifierStateKeyId": {"$ref": "#/$defs/sha256"},
        "storeAssuranceKeyId": {"$ref": "#/$defs/sha256"},
        "tlsReleaseKeyId": {"$ref": "#/$defs/sha256"},
        "rollbackResistanceBoundary": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "digestMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
      },
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "publicNitroResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "verificationOk",
        "finalCompletionVerified",
        "actionAuthorization",
