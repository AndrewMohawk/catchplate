    "hostReadinessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "provided",
        "completionProofApiVersion",
        "completionProofFileSha256",
        "completionProofCoreSha256",
        "generatedAtUnix",
        "launchAuthorityKeyId",
        "authoritativeForFinalCompletion"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.hostReadinessContext/v1"},
        "provided": {"type": "boolean"},
        "completionProofApiVersion": {
          "type": ["string", "null"],
          "enum": ["serverware.completionProof/v6", null]
        },
        "completionProofFileSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "completionProofCoreSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "generatedAtUnix": {
          "oneOf": [
            {"$ref": "#/$defs/positiveU64"},
