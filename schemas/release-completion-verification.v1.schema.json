            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "authoritativeForFinalCompletion": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"provided": {"const": false}},
            "required": ["provided"]
          },
          "then": {
            "properties": {
              "completionProofApiVersion": {"type": "null"},
              "completionProofFileSha256": {"type": "null"},
              "completionProofCoreSha256": {"type": "null"},
              "generatedAtUnix": {"type": "null"},
              "launchAuthorityKeyId": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "completionProofApiVersion": {
                "const": "serverware.completionProof/v6"
              },
              "completionProofFileSha256": {"$ref": "#/$defs/sha256"},
              "completionProofCoreSha256": {"$ref": "#/$defs/sha256"},
              "generatedAtUnix": {"$ref": "#/$defs/positiveU64"}
