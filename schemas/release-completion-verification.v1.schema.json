{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/release-completion-verification.v1.schema.json",
  "title": "Serverware Release Completion Verification v1",
  "$comment": "Closed, non-actionable final verification output. The embedded public-Nitro result and the complete v1 result core have independent Ed25519 signatures whose providers, keys, SPKI digests, and global role registry must be pinned by the caller. Optional completionProof/v6 input is represented only as non-authoritative trusted-host readiness context. Structural validation does not authenticate signatures, recompute digests, prove TEE execution, establish trust-root provenance, or authorize an action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "verificationOk",
    "finalCompletionVerified",
    "actionAuthorization",
    "okForAction",
    "verificationMode",
    "redemptionVerified",
    "readinessOnly",
    "independentlyAuthenticated",
    "pipeline",
    "canonicalProfile",
    "verifiedAtUnix",
    "publicNitroVerification",
    "aggregateAuthentication",
    "completionIdentity",
    "completionIdentitySha256",
    "nextClientState",
    "stateCommit",
    "hostReadinessContext",
    "hostBootstrapBoundary",
    "globalRoleRegistry",
    "externalPinProvenanceBoundary",
    "externalProvisioningBoundary",
    "resultSha256",
    "authenticity"
  ],
  "properties": {
    "apiVersion": {
      "const": "serverware.releaseCompletionVerification/v1"
    },
    "verificationOk": {"const": true},
    "finalCompletionVerified": {"const": true},
    "actionAuthorization": {"type": "null"},
    "okForAction": {"const": false},
    "verificationMode": {"const": "final"},
    "redemptionVerified": {"const": true},
    "readinessOnly": {"const": false},
    "independentlyAuthenticated": {"const": true},
    "pipeline": {"$ref": "#/$defs/pipeline"},
    "canonicalProfile": {"$ref": "#/$defs/canonicalProfile"},
    "verifiedAtUnix": {"$ref": "#/$defs/positiveU64"},
    "publicNitroVerification": {
      "$ref": "#/$defs/publicNitroVerification"
    },
    "aggregateAuthentication": {
      "$ref": "#/$defs/aggregateAuthentication"
    },
    "completionIdentity": {"$ref": "#/$defs/completionIdentity"},
    "completionIdentitySha256": {"$ref": "#/$defs/sha256"},
    "nextClientState": {"$ref": "#/$defs/clientState"},
    "stateCommit": {"$ref": "#/$defs/stateCommit"},
    "hostReadinessContext": {"$ref": "#/$defs/hostReadinessContext"},
    "hostBootstrapBoundary": {"$ref": "#/$defs/hostBootstrapBoundary"},
    "globalRoleRegistry": {"$ref": "#/$defs/globalRoleRegistry"},
    "externalPinProvenanceBoundary": {
      "const": "The verifier proves equality to supplied pins. It cannot prove that an on-host argument was independently sourced; the client or another out-of-band trust channel must pin the bundle digest and protected-state key IDs."
    },
    "externalProvisioningBoundary": {
      "const": "Actual AWS Nitro EIF construction and PCR policy, AWS KMS CiphertextForRecipient releases, enclave-owned TLS exporter support, independent builders/promoter, off-host monotonic witness storage, CAS/current-head reservation and atomic authorization redemption, and a stateful action gate that re-checks the live final head and consumes the redemption receipt identity while performing the action must still be provisioned. This persisted completion is never an action capability."
    },
    "resultSha256": {"$ref": "#/$defs/sha256"},
    "authenticity": {"$ref": "#/$defs/resultAuthenticity"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "sha384": {
      "type": "string",
      "pattern": "^sha384:[0-9a-f]{96}(?![\\s\\S])"
    },
    "unsignedU64": {
      "$comment": "Unsigned protocol field represented within the canonical signed 64-bit JSON profile.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "positiveU64": {
      "$comment": "Positive protocol field represented within the canonical signed 64-bit JSON profile.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,255}(?![\\s\\S])"
    },
    "publicNitroProvider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\r\\n\\u2028\\u2029]+(?![\\s\\S])"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{85}[AQgw](?![\\s\\S])"
    },
    "pipeline": {
      "const": "manifest-v6-promoted-oci-nitro-eif"
    },
    "canonicalProfile": {
      "const": "serverware.canonicalJson/integer-string-bool-null-array-object-nfc-v1"
    },
    "pcrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PCR0", "PCR1", "PCR2"],
      "properties": {
        "PCR0": {"$ref": "#/$defs/sha384"},
        "PCR1": {"$ref": "#/$defs/sha384"},
        "PCR2": {"$ref": "#/$defs/sha384"}
      }
    },
    "completionCoreDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builderA",
        "builderB",
        "continuity",
        "custody",
        "eif",
        "hardware",
        "promotion",
        "release",
        "response",
        "runtime",
        "source",
        "trust",
        "witness"
      ],
      "properties": {
        "builderA": {"$ref": "#/$defs/sha256"},
        "builderB": {"$ref": "#/$defs/sha256"},
        "continuity": {"$ref": "#/$defs/sha256"},
        "custody": {"$ref": "#/$defs/sha256"},
        "eif": {"$ref": "#/$defs/sha256"},
        "hardware": {"$ref": "#/$defs/sha256"},
        "promotion": {"$ref": "#/$defs/sha256"},
        "release": {"$ref": "#/$defs/sha256"},
        "response": {"$ref": "#/$defs/sha256"},
        "runtime": {"$ref": "#/$defs/sha256"},
        "source": {"$ref": "#/$defs/sha256"},
        "trust": {"$ref": "#/$defs/sha256"},
        "witness": {"$ref": "#/$defs/sha256"}
      }
    },
    "completionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "challengeNonceSha256",
        "coreDigests",
        "pipeline",
        "releaseGeneration",
        "rollbackEpoch"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.finalCompletionIdentity/v3"},
        "challengeNonceSha256": {"$ref": "#/$defs/sha256"},
        "coreDigests": {"$ref": "#/$defs/completionCoreDigests"},
        "pipeline": {"$ref": "#/$defs/pipeline"},
        "releaseGeneration": {"$ref": "#/$defs/unsignedU64"},
        "rollbackEpoch": {"$ref": "#/$defs/unsignedU64"}
      }
    },
    "publicResultRoles": {
