        "sourceGitInventory",
        "sourceUntrackedApproval",
        "stateCommit",
        "stateStore",
        "storeAssurance",
        "tlsRelease",
        "verifierState",
        "witness",
        "witnessStore"
      ],
      "properties": {
        "builderA": {"$ref": "#/$defs/sha256"},
        "builderB": {"$ref": "#/$defs/sha256"},
        "buildWatchdog": {"$ref": "#/$defs/sha256"},
        "clientState": {"$ref": "#/$defs/sha256"},
        "clientStateCheckpoint": {"$ref": "#/$defs/sha256"},
        "currentHeadAuthorization": {"$ref": "#/$defs/sha256"},
        "currentHeadRedemption": {"$ref": "#/$defs/sha256"},
        "keyCustody": {"$ref": "#/$defs/sha256"},
        "kmsAudit": {"$ref": "#/$defs/sha256"},
        "manifestV6EifBuilder": {"$ref": "#/$defs/sha256"},
        "nitroAttestationVerifier": {"$ref": "#/$defs/sha256"},
        "promotion": {"$ref": "#/$defs/sha256"},
        "publicNitroResult": {"$ref": "#/$defs/sha256"},
        "sourceGitInventory": {"$ref": "#/$defs/sha256"},
        "sourceUntrackedApproval": {"$ref": "#/$defs/sha256"},
        "stateCommit": {"$ref": "#/$defs/sha256"},
        "stateStore": {"$ref": "#/$defs/sha256"},
        "storeAssurance": {"$ref": "#/$defs/sha256"},
        "tlsRelease": {"$ref": "#/$defs/sha256"},
        "verifierState": {"$ref": "#/$defs/sha256"},
        "witness": {"$ref": "#/$defs/sha256"},
        "witnessStore": {"$ref": "#/$defs/sha256"}
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointSha256",
        "challengeConsumptionSha256",
        "leafIndex",
        "releaseGeneration",
        "rollbackEpoch",
        "sequence",
        "treeSize",
        "rootHash",
        "witnessKeyId",
        "witnessStoreKeyId",
        "witnessStoreIdentitySha256",
        "witnessStoreAssuranceSha256"
      ],
      "properties": {
        "checkpointSha256": {"$ref": "#/$defs/sha256"},
        "challengeConsumptionSha256": {"$ref": "#/$defs/sha256"},
        "leafIndex": {"$ref": "#/$defs/unsignedU64"},
        "releaseGeneration": {"$ref": "#/$defs/unsignedU64"},
        "rollbackEpoch": {"$ref": "#/$defs/unsignedU64"},
        "sequence": {"$ref": "#/$defs/unsignedU64"},
        "treeSize": {"$ref": "#/$defs/unsignedU64"},
        "rootHash": {"$ref": "#/$defs/sha256"},
        "witnessKeyId": {"$ref": "#/$defs/sha256"},
        "witnessStoreKeyId": {"$ref": "#/$defs/sha256"},
        "witnessStoreIdentitySha256": {"$ref": "#/$defs/sha256"},
        "witnessStoreAssuranceSha256": {"$ref": "#/$defs/sha256"}
