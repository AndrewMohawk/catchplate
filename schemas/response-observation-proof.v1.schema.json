        "kind": {"const": "ServerwareVendorTeeVerification"},
        "statement": {"$ref": "#/$defs/productionVerifierStatement"},
        "signature": {"$ref": "#/$defs/ed25519SignatureText"}
      }
    },
    "vendorTee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "provider", "quote_sha256", "quote", "trusted_verifier"],
      "properties": {
        "platform": {"$ref": "#/$defs/identifier"},
        "provider": {"$ref": "#/$defs/identifier"},
        "quote_sha256": {"$ref": "#/$defs/sha256"},
