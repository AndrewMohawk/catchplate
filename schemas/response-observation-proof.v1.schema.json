        "trusted_verifier": {
          "oneOf": [
            {"$ref": "#/$defs/developmentTrustedVerifier"},
            {"$ref": "#/$defs/productionTrustedVerifier"}
          ]
        }
      }
    },
    "runtimeProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "server_statement",
        "server_statement_sha256",
        "server_signature",
        "vendor_tee"
      ],
      "properties": {
        "apiVersion": {"const": "serverware.responseObservationRuntimeProof/v1"},
        "kind": {"const": "ServerwareResponseObservationRuntimeProof"},
        "server_statement": {"$ref": "#/$defs/statement"},
        "server_statement_sha256": {"$ref": "#/$defs/sha256"},
        "server_signature": {"$ref": "#/$defs/ed25519Signature"},
        "vendor_tee": {"$ref": "#/$defs/vendorTee"}
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "public_key_pem",
        "signature",
        "capture_digest"
      ],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/sha256"},
