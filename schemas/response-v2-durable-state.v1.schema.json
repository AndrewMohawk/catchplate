          "$ref": "#/$defs/nullableIdentifier"
        },
        "recoveryArtifactSha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "terminalArtifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "response-v2-nested-authority-artifact.v1.schema.json"
          },
          "allOf": [
            {
              "contains": {
                "$ref": "response-v2-nested-authority-artifact.v1.schema.json#/$defs/stateCasArtifact"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "body": {
                    "$ref": "response-v2-nested-authority-artifact.v1.schema.json#/$defs/bindCleanupObservationArtifact"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "terminalArtifactsRootSha256": {
          "$ref": "#/$defs/sha256",
          "$comment": "SHA-256 over RFC 8785 JCS of terminalArtifacts in artifactClass order. The terminal record is immutable and later observations append a successor settlement linked by predecessorSettlementSha256."
        },
        "appendOnly": {
          "const": true
        },
        "replacementProhibited": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recoveryArtifactId": {
                "type": "null"
              }
            },
            "required": [
              "recoveryArtifactId"
            ]
          },
          "then": {
            "properties": {
              "recoveryArtifactSha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "recoveryArtifactSha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "settlementKind": {
                "const": "EXPIRED_OPERATION_RECONCILIATION"
              }
            },
            "required": [
              "settlementKind"
            ]
          },
          "then": {
            "properties": {
              "terminalArtifacts": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "$ref": "response-v2-nested-authority-artifact.v1.schema.json#/$defs/bindRecoveryArtifact"
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        }
      ]
    },
