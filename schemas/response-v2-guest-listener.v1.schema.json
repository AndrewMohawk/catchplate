{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.invalid/schemas/response-v2-guest-listener.v1.schema.json",
  "title": "Guest-local response-v2 listener and descriptor handoff",
  "$comment": "Structural data only. Root preparation verifies the independent signed router delivery before creating only a fresh fixed path and a bound, non-listening socket. Handoff metadata is not authority. Final activation requires the actual retained delivery owner, verified generation, exact descriptor/path originals, final router identity and unchanged original startup deadline. No launcher, inspector, TEE readiness or cleanup is supplied by this schema.",
  "oneOf": [{"$ref": "#/$defs/profile"}, {"$ref": "#/$defs/handoff"}, {"$ref": "#/$defs/nativeClient"}],
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion"],
      "properties": {"apiVersion": {"const": "catchplate.responseV2.guestListener/v1"}},
      "description": "Explicit guestListener in signed cold custody configuration or native response client v2. Omission preserves the host profile; explicit null is refused. Fixed path /run/catchplate-response-v2-guest/transaction.sock, expectedClientUid and expectedSocketGid both 65534, signed router UID distinct and nonzero. Fresh root:65534 directory mode 0711 is socket-only; the routerUID:65534 socket is mode 0660."
    },
    "uint": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "inode", "mode", "uid", "gid"],
      "properties": {"device": {"$ref": "#/$defs/uint"}, "inode": {"$ref": "#/$defs/uint"}, "mode": {"$ref": "#/$defs/u32"}, "uid": {"$ref": "#/$defs/u32"}, "gid": {"$ref": "#/$defs/u32"}},
      "description": "Exact fstat/lstat originals, not caller-supplied permission. Socket filesystem identity and kernel socket descriptor identity are distinct and both retained."
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["configurationSha256", "deliverySha256", "generationId", "generation", "bootId", "issuedAtBoottimeNs", "deadlineBoottimeNs", "routerUid", "routerGid"],
      "properties": {
        "configurationSha256": {"$ref": "response-v2-guest-credential-delivery.v1.schema.json#/$defs/sha256"},
        "deliverySha256": {"$ref": "response-v2-guest-credential-delivery.v1.schema.json#/$defs/sha256"},
        "generationId": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "bootId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "issuedAtBoottimeNs": {"$ref": "response-v2-guest-credential-delivery.v1.schema.json#/$defs/ns"},
        "deadlineBoottimeNs": {"$ref": "response-v2-guest-credential-delivery.v1.schema.json#/$defs/ns"},
        "routerUid": {"type": "integer", "minimum": 1, "maximum": 4294967295, "not": {"const": 65534}},
        "routerGid": {"const": 65519}
      },
      "description": "Exact equality to the separately admitted router delivery and signed topology is mandatory. Canonical positive u64 decimal times, original <=600-second window; no handoff-supplied renewal."
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "binding", "directory", "socketPath", "socketFd"],
      "properties": {
        "apiVersion": {"const": "catchplate.responseV2.guestListenerHandoff/v1"},
        "binding": {"$ref": "#/$defs/binding"}, "directory": {"$ref": "#/$defs/identity"},
        "socketPath": {"$ref": "#/$defs/identity"}, "socketFd": {"$ref": "#/$defs/identity"}
      },
      "description": "Existing canonical compact sorted UTF-8 JSON, no LF, 1..16384 bytes in an actual memfd with exactly WRITE/GROW/SHRINK/SEAL seals. An unsigned handoff is only consistency data from the genuine privileged launcher; the receiver independently admits signed originals."
    },
    "nativeClient": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "guestListener", "socketPath", "expectedUid", "startupTimeoutMs", "signerKeySha256", "roleIdentityRootSha256", "proofPinsRootSha256", "teeVerifier", "transparencyTrustPin", "roleKeys", "generationId", "expectedSourceCommitSha256", "expectedSourceTreeSha256", "minimumRevocationEpoch"],
      "properties": {
        "apiVersion": {"const": "catchplate.nativeResponseObservationV2Config/v2"},
        "guestListener": {"$ref": "#/$defs/profile"},
        "socketPath": {"const": "/run/catchplate-response-v2-guest/transaction.sock"},
        "expectedUid": {"type": "integer", "minimum": 1, "maximum": 4294967295, "not": {"const": 65534}},
        "startupTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 30000},
        "signerKeySha256": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"},
        "roleIdentityRootSha256": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"},
        "proofPinsRootSha256": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"},
        "teeVerifier": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/teeVerifier"},
        "transparencyTrustPin": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/transparency"},
        "roleKeys": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/roleKey"}},
        "generationId": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/text"},
        "expectedSourceCommitSha256": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"},
        "expectedSourceTreeSha256": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"},
        "expectedProviderGeneration": {"anyOf": [{"$ref": "native-startup-configuration.v4.schema.json#/$defs/uint"}, {"type": "null"}]},
        "expectedTrustRootSha256": {"anyOf": [{"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"}, {"type": "null"}]},
        "expectedTrustCheckpointSha256": {"anyOf": [{"$ref": "native-startup-configuration.v4.schema.json#/$defs/sha"}, {"type": "null"}]},
        "minimumRevocationEpoch": {"$ref": "native-startup-configuration.v4.schema.json#/$defs/uint"}
      },
      "description": "Source-selected only by the actual cold Pending encrypted-service-token source (outer native startup v6 at this checkpoint), never environment/host or nested v1 fallback. The actual final UID/GID 65534 client has no supplementary groups and checks fixed directory/socket ownership plus actual nonzero router SO_PEERCRED UID/GID before its unchanged signed hello/TEE admission."
    }
  }
}
