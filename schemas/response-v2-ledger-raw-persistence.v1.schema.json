{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://catchplate.invalid/schemas/response-v2-ledger-raw-persistence.v1.schema.json",
  "title":"Selected private ledger raw-response persistence",
  "oneOf":[{"$ref":"#/$defs/configuration"},{"$ref":"response-v2-target-dispatch.v1.schema.json#/$defs/capturePersist"},{"$ref":"#/$defs/result"}],
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "identifier":{"type":"string","minLength":1,"maxLength":128},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "configuration":{"type":"object","additionalProperties":false,"required":["apiVersion"],"properties":{
      "apiVersion":{"const":"catchplate.responseV2.ledgerRawPersistence/v1"}
    }},
    "receiptBody":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","configurationSha256","ledgerServiceId","ledgerKeyId","objectId","objectKind","contentSha256","contentLength","mediaType"],
      "properties":{
        "apiVersion":{"const":"catchplate.responseV2.rawStorageReceipt/v1"},
        "generationId":{"$ref":"#/$defs/identifier"},"generation":{"$ref":"#/$defs/positive"},
        "configurationSha256":{"$ref":"#/$defs/sha256"},"ledgerServiceId":{"$ref":"#/$defs/identifier"},
        "ledgerKeyId":{"$ref":"#/$defs/sha256"},"objectId":{"type":"string","pattern":"^obj:[0-9a-f]{64}$"},
        "objectKind":{"const":"raw-response"},"contentSha256":{"$ref":"#/$defs/sha256"},
        "contentLength":{"type":"integer","minimum":1,"maximum":34603008},"mediaType":{"const":"http11-response"}
      }
    },
    "storageReceipt":{"type":"object","additionalProperties":false,
      "required":["body","publicKeyBase64","signature"],"properties":{
        "body":{"$ref":"#/$defs/receiptBody"},
        "publicKeyBase64":{"type":"string","minLength":44,"maxLength":44,"pattern":"^[A-Za-z0-9+/]{43}=$"},
        "signature":{"type":"string","minLength":88,"maxLength":88,"pattern":"^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "object":{"type":"object","additionalProperties":false,
      "required":["objectType","objectSha256","byteLength","retrievalId","persistenceReceiptSha256"],"properties":{
        "objectType":{"const":"UPSTREAM_RESPONSE"},"objectSha256":{"$ref":"#/$defs/sha256"},
        "byteLength":{"type":"integer","minimum":1,"maximum":34603008},
        "retrievalId":{"type":"string","pattern":"^obj:[0-9a-f]{64}$"},
        "persistenceReceiptSha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "stateRequest":{"type":"object","additionalProperties":false,
      "required":["apiVersion","requestId","operationId","attemptId","stableResumeId","attemptRevision","fencingToken","deadlineBoottimeNs","frame"],
      "properties":{
        "apiVersion":{"const":"catchplate.responseObservationV2StateAuthority/v1"},
        "requestId":{"type":"string","pattern":"^capture:[0-9a-f]{64}$"},
        "operationId":{"type":"string","pattern":"^persist:[0-9a-f]{64}$"},
        "attemptId":{"$ref":"#/$defs/identifier"},"stableResumeId":{"$ref":"#/$defs/sha256"},
        "attemptRevision":{"$ref":"#/$defs/positive"},"fencingToken":{"$ref":"#/$defs/positive"},
        "deadlineBoottimeNs":{"$ref":"#/$defs/positive"},
        "frame":{"$ref":"response-v2-state-authority-rpc.v1.schema.json#/$defs/requestFrame"}
      }
    },
    "stateResult":{"type":"object","additionalProperties":false,
      "required":["receipt","responseDataResult","exactObject"],"properties":{
        "receipt":{"allOf":[{"$ref":"response-v2-target-dispatch.v1.schema.json#/$defs/stateReceipt"},{"properties":{"disposition":{"const":"APPLIED"},"authoritativeState":{"const":"DISPATCHING"}}}]},
        "responseDataResult":{"type":"null"},"exactObject":{"type":"null"}
      }
    },
    "result":{"type":"object","additionalProperties":false,
      "required":["apiVersion","captureSha256","object","storageReceipt","artifactCommit","stateRequest","stateResult","postState"],
      "properties":{
        "apiVersion":{"const":"catchplate.responseV2.rawPersistenceResult/v1"},
        "captureSha256":{"$ref":"#/$defs/sha256"},"object":{"$ref":"#/$defs/object"},
        "storageReceipt":{"$ref":"#/$defs/storageReceipt"},
        "artifactCommit":{"$ref":"response-v2-nested-authority-artifact.v1.schema.json"},
        "stateRequest":{"$ref":"#/$defs/stateRequest"},"stateResult":{"$ref":"#/$defs/stateResult"},
        "postState":{"allOf":[{"$ref":"response-v2-target-dispatch.v1.schema.json#/$defs/postState"},{"properties":{"authoritativeState":{"const":"DISPATCHING"},"proofMaterial":{"type":"null"}}}]}
      }
    }
  },
  "$comment":"Cold ledgerRawPersistence is separate from independently assigned targetDispatch, requires genuine guest delivery plus ledgerExactRead, and rejects explicit null. Closed metadata originals are <=262144 canonical bytes. One sealed raw HTTP/1.1 descriptor, length1..34603008, must be admitted through actual native capture/permit/DispatchBegin verification; no JSON, locator, receipt or readiness grants permission. Receipt signature covers canonical body under catchplate.responseV2.rawStorageReceipt/v1 followed by NUL. Its deterministic content scope includes the actual full cold configuration SHA; actual assigned persistence key and canonical padded base64 must match. Claim generation/attempt/fence precedes CAS writes; existing claim or partial/mismatching CAS refuses without repair. Blob and exact receipt become durable before attempt-scoped ArtifactCommit and protected ObjectCommitRaw. State result binds the SHA of the entire genuine signed frame, not just frame.request. Full expected frame content, receipt scope and successor revision are checked. Result is returned only after named-original readback and durable local result; no plaintext, new effect, retry, archival or release authority is conveyed."
}
