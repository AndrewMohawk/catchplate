{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.invalid/schemas/response-v2-signed-checkpoint.v1.schema.json",
  "title": "Serverware Response v2 Signed Transparency Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "schemaVersion",
    "generationId",
    "checkpointId",
    "treeSize",
    "rootSha256",
    "predecessorCheckpointSha256",
    "issuedAtEpochMillis",
    "signerRoleId",
    "authentication"
  ],
  "properties": {
    "apiVersion": {
      "const": "serverware.responseV2.signedCheckpoint/v1"
    },
    "kind": {
      "const": "ServerwareResponseV2SignedCheckpoint"
    },
    "schemaVersion": {
      "const": "1"
    },
    "generationId": {
      "$ref": "#/$defs/identifier"
    },
    "checkpointId": {
      "$ref": "#/$defs/identifier"
    },
    "treeSize": {
      "$ref": "#/$defs/positiveSafeUint"
    },
    "rootSha256": {
      "$ref": "#/$defs/sha256",
      "$comment": "This proves the append-only transparency tree root only. It does not prove generation readiness, service topology, reconciliation completion, hardware-backed execution, or TEE identity; those require their separately signed artifacts."
    },
    "predecessorCheckpointSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuedAtEpochMillis": {
      "$ref": "#/$defs/safeUint"
    },
    "signerRoleId": {
      "$ref": "#/$defs/identifier"
    },
    "authentication": {
      "$ref": "#/$defs/authentication",
      "$comment": "The verifier MUST resolve this key through the pinned provider generation. A valid checkpoint signature is not a substitute for the seven service readiness signatures or router topology attestation."
    }
  },
  "$defs": {
    "safeUint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeUint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signedPayloadSha256",
        "signatureBase64url"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "signedPayloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "signatureBase64url": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
