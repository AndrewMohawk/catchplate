{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.invalid/schemas/response-v2-target-dispatch.v1.schema.json",
  "title":"Independently assigned native gate execution and retained capture",
  "oneOf":[{"$ref":"#/$defs/configuration"},{"$ref":"#/$defs/begin"},{"$ref":"#/$defs/permit"},{"$ref":"#/$defs/capturePersist"},{"$ref":"#/$defs/completed"}],
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "identifier":{"type":"string","minLength":1,"maxLength":256},
    "positive":{"type":"integer","minimum":1,"maximum":18446744073709551615},
    "signature":{"type":"string","pattern":"^[A-Za-z0-9+/]{86}==$"},
    "publicKey":{"type":"string","pattern":"^[A-Za-z0-9+/]{43}=$"},
    "configuration":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","assignment","trustRoots","validFromEpochMs","validUntilEpochMs"],"properties":{
        "apiVersion":{"const":"serverware.responseV2.targetDispatchAssignment/v1"},
        "generationId":{"$ref":"#/$defs/identifier"},"generation":{"type":"integer","minimum":1,"maximum":9223372036854775807},
        "assignment":{"$ref":"#/$defs/assignment"},"trustRoots":{"$ref":"#/$defs/roots"},
        "validFromEpochMs":{"$ref":"#/$defs/positive"},"validUntilEpochMs":{"type":"integer","minimum":1,"maximum":9223372036854}
      }
    },
    "assignment":{"type":"object","additionalProperties":false,
      "required":["purpose","kernelBootId","bootId","keyId","controlPlaneResponseSigningKeyId","releaseRecordSha256","policyHash","configurationSha256","caCertificateSha256","caPublicKeySpkiSha256","expectedBinaryDigest","expectedPcrs","expectedEif","expectedModuleId","maxAgeSeconds","futureSkewSeconds"],"properties":{
        "purpose":{"const":"native-gate-target-dispatch-capture-v1"},
        "kernelBootId":{"type":"string","format":"uuid"},"bootId":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
        "keyId":{"$ref":"#/$defs/sha256"},"controlPlaneResponseSigningKeyId":{"$ref":"#/$defs/sha256"},
        "releaseRecordSha256":{"$ref":"#/$defs/sha256"},"policyHash":{"$ref":"#/$defs/sha256"},"configurationSha256":{"$ref":"#/$defs/sha256"},
        "caCertificateSha256":{"$ref":"#/$defs/sha256"},"caPublicKeySpkiSha256":{"$ref":"#/$defs/sha256"},"expectedBinaryDigest":{"$ref":"#/$defs/sha256"},
        "expectedPcrs":{"type":"object","minProperties":3,"maxProperties":32,"required":["PCR0","PCR1","PCR2"],
          "propertyNames":{"pattern":"^PCR(?:[0-9]|[12][0-9]|3[01])$"},"additionalProperties":{"type":"string","pattern":"^sha384:[0-9a-f]{96}$"}},
        "expectedEif":{"type":"string","pattern":"^sha384:(?!0{96}$)[0-9a-f]{96}$"},"expectedModuleId":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[ -~]+$"},
        "maxAgeSeconds":{"type":"integer","minimum":1,"maximum":300},"futureSkewSeconds":{"type":"integer","minimum":0,"maximum":30}
      }
    },
    "roots":{"type":"object","additionalProperties":false,
      "required":["apiVersion","awsNitroRootCertificatesPem","awsNitroCrlsDerBase64url","nitroCertificateProfile"],"properties":{
        "apiVersion":{"const":"serverware.nativeResponseAttestationTrustRoots/v1"},
        "awsNitroRootCertificatesPem":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":65536}},
        "awsNitroCrlsDerBase64url":{"type":"array","maxItems":0},
        "nitroCertificateProfile":{"type":"object","additionalProperties":false,"required":["profileId","allowedLeafExtendedKeyUsageOids"],"properties":{
          "profileId":{"const":"aws-nitro-attestation-pki-native-v1"},"allowedLeafExtendedKeyUsageOids":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","maxLength":128,"pattern":"^[0-9]+(?:\\.[0-9]+)+$"}}
        }}
      }
    },
    "transaction":{"type":"object","additionalProperties":false,
      "required":["principalId","connectionIdentitySha256","clientRequestSha256","decisionRequestSha256","routeId","routeSemanticsSha256","policySha256","credentialBindingSha256","upstreamResponseSha256","tlsSessionSha256","enrollmentSessionId","observationSessionId"],"properties":{
        "principalId":{"$ref":"#/$defs/identifier"},"connectionIdentitySha256":{"$ref":"#/$defs/sha256"},"clientRequestSha256":{"$ref":"#/$defs/sha256"},"decisionRequestSha256":{"$ref":"#/$defs/sha256"},
        "routeId":{"$ref":"#/$defs/identifier"},"routeSemanticsSha256":{"$ref":"#/$defs/sha256"},"policySha256":{"$ref":"#/$defs/sha256"},"credentialBindingSha256":{"$ref":"#/$defs/sha256"},
        "upstreamResponseSha256":{"type":"null"},"tlsSessionSha256":{"$ref":"#/$defs/sha256"},"enrollmentSessionId":{"type":["string","null"]},"observationSessionId":{"$ref":"#/$defs/identifier"}
      }
    },
    "binding":{"type":"object","additionalProperties":false,
      "required":["requestId","custodyBootId","clientIdentitySha256","transaction","attemptId","predecessorLifecycleState","predecessorStateSha256","attemptRevision","fencingToken","monotonicDeadline","deadlineAtEpochMs"],"properties":{
        "requestId":{"$ref":"#/$defs/identifier"},"custodyBootId":{"$ref":"#/$defs/identifier"},"clientIdentitySha256":{"$ref":"#/$defs/sha256"},"transaction":{"$ref":"#/$defs/transaction"},
        "attemptId":{"$ref":"#/$defs/identifier"},"predecessorLifecycleState":{"const":"STAGED"},"predecessorStateSha256":{"$ref":"#/$defs/sha256"},"attemptRevision":{"$ref":"#/$defs/positive"},"fencingToken":{"$ref":"#/$defs/positive"},
        "monotonicDeadline":{"type":"object","additionalProperties":false,"required":["apiVersion","custodyBootId","clockId","absoluteBoottimeNs"],"properties":{
          "apiVersion":{"const":"serverware.responseObservationMonotonicDeadline/v1"},"custodyBootId":{"$ref":"#/$defs/identifier"},"clockId":{"const":"CLOCK_BOOTTIME"},"absoluteBoottimeNs":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}
        }},"deadlineAtEpochMs":{"$ref":"#/$defs/positive"}
      }
    },
    "original":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","stableResumeId","binding","sessionSha256","gateKeyId","stagedRequest","target","requestSha256"],"properties":{
        "apiVersion":{"const":"serverware.responseV2.targetDispatchOriginal/v1"},"generationId":{"$ref":"#/$defs/identifier"},"generation":{"$ref":"#/$defs/positive"},"stableResumeId":{"$ref":"#/$defs/sha256"},
        "binding":{"$ref":"#/$defs/binding"},"sessionSha256":{"$ref":"#/$defs/sha256"},"gateKeyId":{"$ref":"#/$defs/sha256"},
        "stagedRequest":{"allOf":[{"$ref":"response-v2-state-authority-rpc.v1.schema.json#/$defs/rawObjectReference"},{"properties":{"objectKind":{"const":"staged-request"},"mediaType":{"const":"http11-request"}}}]},
        "target":{"type":"object","additionalProperties":false,"required":["scheme","host","port","address"],"properties":{
          "scheme":{"const":"https"},"host":{"type":"string","minLength":1,"maxLength":253},"port":{"type":"integer","minimum":1,"maximum":65535},"address":{"type":"string","minLength":1,"maxLength":45}
        }},"requestSha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "descriptor":{"type":"object","additionalProperties":false,
      "required":["objectId","mediaType","fdIndex","byteLength","sha256","requiredSeals"],"properties":{
        "objectId":{"type":"string","pattern":"^obj:[0-9a-f]{64}$"},"mediaType":{"const":"HTTP11_RESPONSE"},"fdIndex":{"const":0},"byteLength":{"type":"integer","minimum":1,"maximum":34603008},"sha256":{"$ref":"#/$defs/sha256"},"requiredSeals":{"const":"IMMUTABLE_V1"}
      }
    },
    "tls":{"type":"object","additionalProperties":false,"required":["serverName","port","peerChainSha256","protocol","cipherSuite","exporterSha256"],"properties":{
      "serverName":{"type":"string","minLength":1,"maxLength":253},"port":{"type":"integer","minimum":1,"maximum":65535},"peerChainSha256":{"$ref":"#/$defs/sha256"},"protocol":{"enum":["TLSv1_2","TLSv1_3"]},"cipherSuite":{"type":"string","minLength":1,"maxLength":128},"exporterSha256":{"$ref":"#/$defs/sha256"}
    }},
    "statement":{"type":"object","additionalProperties":false,
      "required":["apiVersion","phase","original","permitSha256","rawResponse","tls","bootId","keyId","controlPlaneResponseSigningKeyId","issuedAtEpochNs","expiresAtEpochNs"],"properties":{
        "apiVersion":{"const":"serverware.nativeTargetDispatchStatement/v1"},"phase":{"enum":["prepare","capture"]},"original":{"$ref":"#/$defs/original"},
        "permitSha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},"rawResponse":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/descriptor"}]},"tls":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/tls"}]},
        "bootId":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"keyId":{"$ref":"#/$defs/sha256"},"controlPlaneResponseSigningKeyId":{"$ref":"#/$defs/sha256"},"issuedAtEpochNs":{"$ref":"#/$defs/positive"},"expiresAtEpochNs":{"$ref":"#/$defs/positive"}
      },"allOf":[{"if":{"properties":{"phase":{"const":"prepare"}}},"then":{"properties":{"permitSha256":{"type":"null"},"rawResponse":{"type":"null"},"tls":{"type":"null"}}},"else":{"properties":{"permitSha256":{"$ref":"#/$defs/sha256"},"rawResponse":{"$ref":"#/$defs/descriptor"},"tls":{"$ref":"#/$defs/tls"}}}}]
    },
    "envelope":{"type":"object","additionalProperties":false,"required":["statement","signature","nativeKeyEvidence"],"properties":{
      "statement":{"$ref":"#/$defs/statement"},"signature":{"type":"string","pattern":"^ed25519:[A-Za-z0-9_-]{86}$"},
      "nativeKeyEvidence":{"type":"object","additionalProperties":false,"required":["apiVersion","attestationDocumentB64","responseProofPublicKey"],"properties":{
        "apiVersion":{"const":"serverware.nativeResponseProofKeyEvidence/v1"},"attestationDocumentB64":{"type":"string","minLength":1,"maxLength":16384,"pattern":"^[A-Za-z0-9_-]+$"},"responseProofPublicKey":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"}
      }}
    }},
    "authorityScope":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","serviceRole","serviceId","logicalRole","roleIdentityRootSha256","keyId","keyMaterialSha256","operation","operationId","attemptId","attemptRevision","fencingToken","executableSha256","configurationSha256","allowedOperations","operationBindingSha256"],"properties":{
        "apiVersion":{"const":"serverware.responseObservationV2ProviderAuthorityScope/v2"},"generationId":{"$ref":"#/$defs/identifier"},"generation":{"$ref":"#/$defs/positive"},"serviceRole":{"const":"state-authority"},"serviceId":{"$ref":"#/$defs/identifier"},"logicalRole":{"const":"linearizable-store"},
        "roleIdentityRootSha256":{"$ref":"#/$defs/sha256"},"keyId":{"$ref":"#/$defs/sha256"},"keyMaterialSha256":{"$ref":"#/$defs/sha256"},"operation":{"const":"STATE_CAS"},"operationId":{"$ref":"#/$defs/identifier"},"attemptId":{"$ref":"#/$defs/identifier"},"attemptRevision":{"$ref":"#/$defs/positive"},"fencingToken":{"$ref":"#/$defs/positive"},
        "executableSha256":{"$ref":"#/$defs/sha256"},"configurationSha256":{"$ref":"#/$defs/sha256"},"allowedOperations":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string"}},"operationBindingSha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "stateReceipt":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","operation","requestId","operationId","attemptId","stableResumeId","authorityScope","exactRequestSha256","exactResultSha256","disposition","authoritativeRevision","authoritativeState","fencingToken","signerLogicalRole","signerKeyId","signature"],"properties":{
        "apiVersion":{"const":"serverware.responseObservationV2StateMutationReceipt/v1"},"generationId":{"$ref":"#/$defs/identifier"},"generation":{"$ref":"#/$defs/positive"},"operation":{"const":"STATE_CAS"},"requestId":{"$ref":"#/$defs/identifier"},"operationId":{"$ref":"#/$defs/identifier"},"attemptId":{"$ref":"#/$defs/identifier"},"stableResumeId":{"$ref":"#/$defs/sha256"},
        "authorityScope":{"$ref":"#/$defs/authorityScope"},"exactRequestSha256":{"$ref":"#/$defs/sha256"},"exactResultSha256":{"$ref":"#/$defs/sha256"},"disposition":{"const":"APPLIED"},"authoritativeRevision":{"$ref":"#/$defs/positive"},"authoritativeState":{"enum":["DISPATCHING","OBSERVED"]},"fencingToken":{"$ref":"#/$defs/positive"},"signerLogicalRole":{"const":"linearizable-store"},"signerKeyId":{"$ref":"#/$defs/sha256"},"signature":{"$ref":"#/$defs/signature"}
      }
    },
    "postState":{"type":"object","additionalProperties":false,
      "required":["apiVersion","generationId","generation","operation","requestId","operationId","attemptId","attemptRevision","authoritativeState","authoritativeStateSha256","stableResumeId","fencingToken","ownerProcessId","ownerPid","ownerStartTimeTicks","ownerCgroupId","deadlineBootId","deadlineBootMillis","proofMaterial","observationSha256","authorityScope","signerLogicalRole","signerKeyId","signature"],"properties":{
        "apiVersion":{"const":"serverware.responseObservationV2AttemptStateObservation/v1"},"generationId":{"$ref":"#/$defs/identifier"},"generation":{"$ref":"#/$defs/positive"},"operation":{"const":"STATE_CAS"},"requestId":{"$ref":"#/$defs/identifier"},"operationId":{"$ref":"#/$defs/identifier"},"attemptId":{"$ref":"#/$defs/identifier"},"attemptRevision":{"$ref":"#/$defs/positive"},
        "authoritativeState":{"enum":["DISPATCHING","OBSERVED"]},"authoritativeStateSha256":{"$ref":"#/$defs/sha256"},"stableResumeId":{"$ref":"#/$defs/sha256"},"fencingToken":{"$ref":"#/$defs/positive"},"ownerProcessId":{"$ref":"#/$defs/identifier"},"ownerPid":{"type":"integer","minimum":1,"maximum":4294967295},"ownerStartTimeTicks":{"$ref":"#/$defs/positive"},"ownerCgroupId":{"$ref":"#/$defs/identifier"},"deadlineBootId":{"$ref":"#/$defs/identifier"},"deadlineBootMillis":{"$ref":"#/$defs/positive"},
        "proofMaterial":{"type":"null"},"observationSha256":{"$ref":"#/$defs/sha256"},"authorityScope":{"$ref":"#/$defs/authorityScope"},"signerLogicalRole":{"const":"linearizable-store"},"signerKeyId":{"$ref":"#/$defs/sha256"},"signature":{"$ref":"#/$defs/signature"}
      }
    },
    "permit":{"type":"object","additionalProperties":false,
      "required":["apiVersion","original","credentialUse","dispatchRequest","dispatchReceipt","postState","publicKeyBase64","signature"],"properties":{
        "apiVersion":{"const":"serverware.responseV2.targetDispatchPermit/v1"},"original":{"$ref":"#/$defs/original"},"credentialUse":{"$ref":"response-v2-nested-authority-artifact.v1.schema.json#/$defs/credentialUseArtifact"},
        "dispatchRequest":{"$ref":"response-v2-state-authority-rpc.v1.schema.json#/$defs/requestFrame"},"dispatchReceipt":{"$ref":"#/$defs/stateReceipt"},"postState":{"$ref":"#/$defs/postState"},"publicKeyBase64":{"$ref":"#/$defs/publicKey"},"signature":{"$ref":"#/$defs/signature"}
      }
    },
    "begin":{"type":"object","additionalProperties":false,"required":["apiVersion","original","gateEvidence"],"properties":{
      "apiVersion":{"const":"serverware.responseV2.targetDispatchBegin/v1"},"original":{"$ref":"#/$defs/original"},"gateEvidence":{"$ref":"#/$defs/envelope"}
    }},
    "capturePersist":{"type":"object","additionalProperties":false,
      "required":["apiVersion","requestId","operationId","stableResumeId","permit","capture","rawResponse"],"properties":{
        "apiVersion":{"const":"serverware.responseV2.capturePersist/v1"},"requestId":{"type":"string","pattern":"^capture:[0-9a-f]{64}$"},"operationId":{"type":"string","pattern":"^persist:[0-9a-f]{64}$"},"stableResumeId":{"$ref":"#/$defs/sha256"},"permit":{"$ref":"#/$defs/permit"},"capture":{"$ref":"#/$defs/envelope"},"rawResponse":{"$ref":"#/$defs/descriptor"}
      }
    },
    "completed":{"type":"object","additionalProperties":false,
      "required":["apiVersion","captureSha256","object","outcomeRequest","outcomeReceipt","postState","targetEffect"],"properties":{
        "apiVersion":{"const":"serverware.responseV2.targetCaptureCommitted/v1"},"captureSha256":{"$ref":"#/$defs/sha256"},"object":{"$ref":"response-v2-ledger-raw-persistence.v1.schema.json#/$defs/object"},
        "outcomeRequest":{"$ref":"response-v2-state-authority-rpc.v1.schema.json#/$defs/requestFrame"},"outcomeReceipt":{"$ref":"#/$defs/stateReceipt"},"postState":{"$ref":"#/$defs/postState"},"targetEffect":{"$ref":"response-v2-nested-authority-artifact.v1.schema.json#/$defs/targetEffectArtifact"}
      }
    }
  },
  "$comment":"Data-only schema; no value creates a signer, session, dispatch permission or capture owner. Actual retained signed guest configuration separately assigns targetDispatch and ledgerRawPersistence. Byte bounds, canonical encodings, nonzero keys, exact full-frame hashes, cross-field equality, actual current same-boot deadlines, native role4 NSM verification and every live original remain mandatory source checks. The staged object is credential-free and distinct from the final injected request hash. Permit signatures retain the existing role canonical UTF8 recipe with their fixed domain+NUL; native statements use canonical ASCII, and nested/state signatures keep their original recipes. No provider contact retry, timeout-as-proof, router key, stale currentness, raw parent bytes or ambient trust is admitted. Public Reserve/Authorize/Stage producers remain a separate required integration."
}
