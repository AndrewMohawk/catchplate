{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.dev/schemas/setup-native-ca-installation.v1.schema.json",
  "title": "Authenticated trusted-host-local Setup CA readback, not completed Setup",
  "oneOf": [{"$ref": "#/$defs/optionsRequest"}, {"$ref": "#/$defs/prepareRequest"}, {"$ref": "#/$defs/completeRequest"}, {"$ref": "#/$defs/lookupRequest"}],
  "$defs": {
    "digest": {"$ref": "setup-native-enrollment.v1.schema.json#/$defs/digest"},
    "uuid": {"$ref": "setup-native-enrollment.v1.schema.json#/$defs/uuid"},
    "epoch": {"$ref": "setup-native-enrollment.v1.schema.json#/$defs/epoch"},
    "grant": {"type": "object", "additionalProperties": false, "required": ["base64Url", "byteCount", "bytesDigest"],
      "properties": {"base64Url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 43691},
        "byteCount": {"type": "integer", "minimum": 1, "maximum": 32768}, "bytesDigest": {"$ref": "#/$defs/digest"}}},
    "requestBase": {"type": "object", "required": ["apiVersion", "sessionId"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCaInstallationRequest/v1"}, "sessionId": {"$ref": "#/$defs/uuid"}}},
    "optionsRequest": {"allOf": [{"$ref": "#/$defs/requestBase"}, {"type": "object", "required": ["installationAuthorization", "hostKeyId"],
      "properties": {"installationAuthorization": {"$ref": "#/$defs/grant"}, "hostKeyId": {"$ref": "#/$defs/digest"}}}], "unevaluatedProperties": false},
    "prepareRequest": {"allOf": [{"$ref": "#/$defs/requestBase"}, {"type": "object", "required": ["installationAuthorization", "hostKeyId", "assertion"],
      "properties": {"installationAuthorization": {"$ref": "#/$defs/grant"}, "hostKeyId": {"$ref": "#/$defs/digest"},
        "assertion": {"type": "object", "description": "Existing exact policy_authority hardware assertion; at most 16384 original bytes."}}}], "unevaluatedProperties": false},
    "completeRequest": {"allOf": [{"$ref": "#/$defs/requestBase"}, {"type": "object", "required": ["observationOriginal"],
      "properties": {"observationOriginal": {"$ref": "#/$defs/observationOriginal"}}}], "unevaluatedProperties": false},
    "lookupRequest": {"allOf": [{"$ref": "#/$defs/requestBase"}], "unevaluatedProperties": false},
    "preparedOriginal": {"type": "string", "minLength": 2, "maxLength": 8192, "description": "Exact canonical ASCII prepared12; preserve integer epochs and original bytes."},
    "observationOriginal": {"type": "string", "minLength": 2, "maxLength": 32768, "description": "Exact canonical ASCII observation envelope3; full payload signatures are independently verified, not browser verdicts."},
    "prepared": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "attemptId", "sessionId", "enrollmentSha256", "intentSha256", "certificateSha256", "associationSha256", "installationAuthorizationSha256", "hostKeyId", "nonceSha256", "issuedAtEpochNs", "expiresAtEpochNs"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCaInstallationPrepared/v1"}, "attemptId": {"$ref": "#/$defs/uuid"}, "sessionId": {"$ref": "#/$defs/uuid"},
        "enrollmentSha256": {"$ref": "#/$defs/digest"}, "intentSha256": {"$ref": "#/$defs/digest"}, "certificateSha256": {"$ref": "#/$defs/digest"},
        "associationSha256": {"$ref": "#/$defs/digest"}, "installationAuthorizationSha256": {"$ref": "#/$defs/digest"}, "hostKeyId": {"$ref": "#/$defs/digest"},
        "nonceSha256": {"$ref": "#/$defs/digest"}, "issuedAtEpochNs": {"$ref": "#/$defs/epoch"}, "expiresAtEpochNs": {"$ref": "#/$defs/epoch"}}},
    "destinationIdentity": {"type": "object", "additionalProperties": false,
      "required": ["device", "inode", "mode", "uid", "gid", "size", "mtimeSeconds", "mtimeNanos", "ctimeSeconds", "ctimeNanos"],
      "properties": {"device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "mode": {"const": 420},
        "uid": {"type": "integer", "minimum": 0, "maximum": 4294967294}, "gid": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "size": {"type": "integer", "minimum": 1, "maximum": 65536}, "mtimeSeconds": {"type": "integer"}, "ctimeSeconds": {"type": "integer"},
        "mtimeNanos": {"type": "integer", "minimum": 0, "maximum": 999999999}, "ctimeNanos": {"type": "integer", "minimum": 0, "maximum": 999999999}}},
    "observationPayload": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "purpose", "trustMode", "preparedSha256", "enrollmentSha256", "certificateSha256", "associationSha256", "installationAuthorizationSha256", "nativeSetupSha256", "targetRequestSha256", "runtimeCaCertificateSha256", "hostId", "machineIdSha256", "bootId", "namespaceDevice", "namespaceInode", "destinationPath", "destinationIdentity", "operationSha256", "reservationSha256", "observedBeforeEpochNs", "observedAfterEpochNs", "hostSigningKeyId", "workloadSpkiSha256"],
      "properties": {"apiVersion": {"const": "catchplate.nativeSetupCaInstallObservation/v1"}, "purpose": {"const": "setup-ca-installation-readback"}, "trustMode": {"const": "trusted-host-local"},
        "preparedSha256": {"$ref": "#/$defs/digest"}, "enrollmentSha256": {"$ref": "#/$defs/digest"}, "certificateSha256": {"$ref": "#/$defs/digest"},
        "associationSha256": {"$ref": "#/$defs/digest"}, "installationAuthorizationSha256": {"$ref": "#/$defs/digest"}, "nativeSetupSha256": {"$ref": "#/$defs/digest"},
        "targetRequestSha256": {"$ref": "#/$defs/digest"}, "runtimeCaCertificateSha256": {"$ref": "#/$defs/digest"}, "hostId": {"type": "string", "minLength": 1, "maxLength": 128},
        "machineIdSha256": {"$ref": "#/$defs/digest"}, "bootId": {"$ref": "#/$defs/uuid"}, "namespaceDevice": {"type": "integer", "minimum": 1}, "namespaceInode": {"type": "integer", "minimum": 1},
        "destinationPath": {"type": "string", "pattern": "^/", "maxLength": 4096}, "destinationIdentity": {"$ref": "#/$defs/destinationIdentity"},
        "operationSha256": {"$ref": "#/$defs/digest"}, "reservationSha256": {"$ref": "#/$defs/digest"}, "observedBeforeEpochNs": {"$ref": "#/$defs/epoch"},
        "observedAfterEpochNs": {"$ref": "#/$defs/epoch"}, "hostSigningKeyId": {"$ref": "#/$defs/digest"}, "workloadSpkiSha256": {"$ref": "#/$defs/digest"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["payload", "signature", "workloadSignature"],
      "properties": {"payload": {"$ref": "#/$defs/observationPayload"}, "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"},
        "workloadSignature": {"type": "string", "pattern": "^ecdsa-p256-sha256:[A-Za-z0-9_-]+$", "maxLength": 125}},
      "description": "Host Ed25519 domain catchplate.nativeSetupCaInstallObservation/v1 plus NUL plus full canonical ASCII payload; target P256/SHA256 canonical-DER signature uses domain catchplate.nativeSetupCaInstallPossession/v1 plus NUL plus the same full payload. No digest-only signature or generic signed success DTO."},
    "authorityPolicy": {"type": "object", "additionalProperties": false, "required": ["schema", "installationRootPublicKeyPem", "hosts", "credentialPolicy"],
      "properties": {"schema": {"const": "catchplate.setupNativeCaInstallationAuthorityPolicy/v1"}, "installationRootPublicKeyPem": {"type": "string", "minLength": 1, "maxLength": 16384},
        "credentialPolicy": {"type": "object"}, "hosts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false,
          "required": ["hostId", "machineIdSha256", "keyId", "publicKeyBase64url"], "properties": {"hostId": {"type": "string", "minLength": 1, "maxLength": 128},
            "machineIdSha256": {"$ref": "#/$defs/digest"}, "keyId": {"$ref": "#/$defs/digest"}, "publicKeyBase64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}}}}}},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["preparedOriginal", "preparedSha256", "enrollmentOriginal", "enrollmentSha256", "installationAuthorization"],
      "properties": {"preparedOriginal": {"$ref": "#/$defs/preparedOriginal"}, "preparedSha256": {"$ref": "#/$defs/digest"},
        "enrollmentOriginal": {"type": "string", "minLength": 2, "maxLength": 1500000}, "enrollmentSha256": {"$ref": "#/$defs/digest"}, "installationAuthorization": {"$ref": "#/$defs/grant"}}},
    "installation": {"type": "object", "additionalProperties": false, "required": ["revision", "phase", "preparedSha256", "enrollmentSha256", "observationSha256", "prepareRequestDigest", "completeRequestDigest"],
      "properties": {"revision": {"enum": [0, 1]}, "phase": {"enum": ["installation_unknown", "ca_readback_authenticated"]}, "preparedSha256": {"$ref": "#/$defs/digest"},
        "enrollmentSha256": {"$ref": "#/$defs/digest"}, "observationSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "prepareRequestDigest": {"$ref": "#/$defs/digest"}, "completeRequestDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}}},
    "responseFlags": {"type": "object", "required": ["apiVersion", "status", "automaticRetryAllowed", "nativeHostVerified", "enrollmentComplete", "proxyReady"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCaInstallationResponse/v1"}, "status": {"type": "string"}, "automaticRetryAllowed": {"const": false},
        "nativeHostVerified": {"const": false}, "enrollmentComplete": {"const": false}, "proxyReady": {"const": false}}},
    "optionsResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["options"], "properties": {"status": {"const": "fresh-assertion-required"},
      "options": {"type": "object", "additionalProperties": false, "required": ["publicKey", "catchplate"], "properties": {"publicKey": {"type": "object"}, "catchplate": {"type": "object", "additionalProperties": false,
        "required": ["schema", "operation", "operationId", "challengeId", "credentialRecordId"], "properties": {"schema": {"const": "catchplate.setupNativeCaInstallationOptions/v1"},
          "operation": {"const": "setup.native-ca.prepare"}, "operationId": {"$ref": "#/$defs/digest"}, "challengeId": {"$ref": "#/$defs/digest"}, "credentialRecordId": {"$ref": "#/$defs/uuid"}}}}}}}], "unevaluatedProperties": false},
    "prepareResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["preparedOriginal", "preparedSha256", "enrollmentOriginal", "enrollmentSha256", "installationAuthorization"],
      "properties": {"status": {"const": "installation-outcome-unknown"}, "preparedOriginal": {"$ref": "#/$defs/preparedOriginal"}, "preparedSha256": {"$ref": "#/$defs/digest"},
        "enrollmentOriginal": {"type": "string", "maxLength": 1500000}, "enrollmentSha256": {"$ref": "#/$defs/digest"}, "installationAuthorization": {"$ref": "#/$defs/grant"}}}], "unevaluatedProperties": false},
    "completeResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["installation"],
      "properties": {"status": {"const": "ca-readback-authenticated"}, "installation": {"$ref": "#/$defs/installation"}}}], "unevaluatedProperties": false},
    "lookupResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["installation", "observationOriginal", "bundle"],
      "properties": {"status": {"const": "observation"}, "installation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/installation"}]},
        "observationOriginal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/observationOriginal"}]}, "bundle": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bundle"}]}}}], "unevaluatedProperties": false},
    "error": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"properties": {"status": {"enum": ["refused", "installation-outcome-unknown"]}}}], "unevaluatedProperties": false}
  }
}
