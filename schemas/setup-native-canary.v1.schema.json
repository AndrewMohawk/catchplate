{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.example/schemas/setup-native-canary.v1.schema.json",
  "title": "Protected native canary to Setup association only",
  "description": "No external contact, action authority, measured-host assurance, proxy readiness or final Setup receipt. Original completed effects remain historical; current policy and roots are rechecked by the actual protected transaction.",
  "oneOf": [{"$ref": "#/$defs/sessionRequest"}, {"$ref": "#/$defs/optionsRequest"}, {"$ref": "#/$defs/recordRequest"}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid", "minLength": 36, "maxLength": 36},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "ascii": {"type": "string", "pattern": "^[\\u0000-\\u007f]+$"},
    "argumentsOriginal": {"allOf": [{"$ref": "#/$defs/ascii"}], "minLength": 2, "maxLength": 16384,
      "description": "Exact canonical ASCII arguments selected by draft; unchanged through options and one record attempt."},
    "sessionRequest": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "sessionId"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCanaryRequest/v1"}, "sessionId": {"$ref": "#/$defs/uuid"}}},
    "optionsRequest": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "argumentsOriginal"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCanaryRequest/v1"}, "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"}}},
    "recordRequest": {"type": "object", "additionalProperties": false, "required": ["apiVersion", "argumentsOriginal", "assertion"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCanaryRequest/v1"}, "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"},
        "assertion": {"type": "object", "description": "Existing exact WebAuthn get assertion, bounded to 16 KiB by the actual owner and independently verified."}}},
    "credentialPolicy": {"type": "object", "additionalProperties": false,
      "required": ["rpId", "origins", "allowedAuthenticatorClasses", "hardwareRequired", "requireUserPresence", "requireUserVerification", "maxAssertionAgeSeconds"],
      "properties": {"rpId": {"type": "string", "minLength": 1, "maxLength": 253},
        "origins": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "allowedAuthenticatorClasses": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["hardware", "yubikey"]}},
        "hardwareRequired": {"const": true}, "requireUserPresence": {"const": true}, "requireUserVerification": {"const": true},
        "maxAssertionAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 120}}},
    "arguments": {"type": "object", "additionalProperties": false,
      "required": ["actor_id", "control_plane_configuration_digest", "credential_policy", "request"],
      "properties": {"actor_id": {"type": "string", "pattern": "^oidc:", "maxLength": 1024},
        "control_plane_configuration_digest": {"$ref": "#/$defs/digest"}, "credential_policy": {"$ref": "#/$defs/credentialPolicy"},
        "request": {"$ref": "#/$defs/request"}}},
    "request": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "sessionId", "setupSha256", "continuationSha256", "enrollmentSha256", "installationSha256", "canaryId",
        "finalizationSha256", "publicationSha256", "policyHash", "activationPolicySha256", "credentialId", "credentialVersion",
        "enrollmentApprovalId", "nativeApprovalId", "auditIds", "issuedAtEpochNs", "expiresAtEpochNs"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCanaryAssociation/v1"}, "sessionId": {"$ref": "#/$defs/uuid"},
        "setupSha256": {"$ref": "#/$defs/digest"}, "continuationSha256": {"$ref": "#/$defs/digest"},
        "enrollmentSha256": {"$ref": "#/$defs/digest"}, "installationSha256": {"$ref": "#/$defs/digest"},
        "canaryId": {"type": "string", "minLength": 1, "maxLength": 256}, "finalizationSha256": {"$ref": "#/$defs/digest"},
        "publicationSha256": {"$ref": "#/$defs/digest"}, "policyHash": {"$ref": "#/$defs/digest"},
        "activationPolicySha256": {"$ref": "#/$defs/digest"}, "credentialId": {"$ref": "#/$defs/uuid"}, "credentialVersion": {"const": 1},
        "enrollmentApprovalId": {"$ref": "#/$defs/uuid"}, "nativeApprovalId": {"$ref": "#/$defs/uuid"},
        "auditIds": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}},
        "issuedAtEpochNs": {"$ref": "#/$defs/epoch"}, "expiresAtEpochNs": {"$ref": "#/$defs/epoch"}},
      "description": "Server-selected exact originals and sorted audit selectors. Kernel rederives every selector. Metadata operation interval at most 30 seconds and within original Setup expiry; no historical effect window is extended."},
    "review": {"type": "object", "additionalProperties": false,
      "required": ["sessionId", "canaryId", "policyHash", "credentialId", "credentialVersion", "enrollmentSha256", "installationSha256", "finalizationSha256", "publicationSha256", "expiresAtEpochNs"],
      "properties": {"sessionId": {"$ref": "#/$defs/uuid"}, "canaryId": {"type": "string", "minLength": 1, "maxLength": 256},
        "policyHash": {"$ref": "#/$defs/digest"}, "credentialId": {"$ref": "#/$defs/uuid"}, "credentialVersion": {"const": 1},
        "enrollmentSha256": {"$ref": "#/$defs/digest"}, "installationSha256": {"$ref": "#/$defs/digest"},
        "finalizationSha256": {"$ref": "#/$defs/digest"}, "publicationSha256": {"$ref": "#/$defs/digest"}, "expiresAtEpochNs": {"$ref": "#/$defs/epoch"}}},
    "association": {"type": "object", "additionalProperties": false,
      "required": ["revision", "phase", "canaryId", "policyHash", "finalizationSha256", "publicationSha256", "requestDigest", "associatedAtEpochNs"],
      "properties": {"revision": {"const": 0}, "phase": {"const": "canary_publication_associated"},
        "canaryId": {"type": "string", "minLength": 1, "maxLength": 256}, "policyHash": {"$ref": "#/$defs/digest"},
        "finalizationSha256": {"$ref": "#/$defs/digest"}, "publicationSha256": {"$ref": "#/$defs/digest"},
        "requestDigest": {"$ref": "#/$defs/digest"}, "associatedAtEpochNs": {"$ref": "#/$defs/epoch"}}},
    "options": {"type": "object", "additionalProperties": false, "required": ["publicKey", "catchplate"],
      "properties": {"publicKey": {"type": "object", "additionalProperties": false,
          "required": ["challenge", "rpId", "allowCredentials", "timeout", "userVerification"],
          "properties": {"challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "rpId": {"type": "string", "maxLength": 253},
            "allowCredentials": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false,
              "required": ["type", "id"], "properties": {"type": {"const": "public-key"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}}},
            "timeout": {"const": 30000}, "userVerification": {"const": "required"}}},
        "catchplate": {"type": "object", "additionalProperties": false,
          "required": ["schema", "operation", "operationId", "challengeId", "credentialRecordId", "payloadDigest"],
          "properties": {"schema": {"const": "catchplate.setupNativeCanaryOptions/v1"}, "operation": {"const": "setup.native-canary.record"},
            "operationId": {"$ref": "#/$defs/digest"}, "challengeId": {"$ref": "#/$defs/digest"},
            "credentialRecordId": {"$ref": "#/$defs/uuid"}, "payloadDigest": {"$ref": "#/$defs/digest"}}}}},
    "responseFlags": {"type": "object", "required": ["apiVersion", "status", "okForAction", "automaticRetryAllowed", "nativeHostVerified", "enrollmentComplete", "proxyReady"],
      "properties": {"apiVersion": {"const": "catchplate.setupNativeCanaryResponse/v1"}, "status": {"type": "string"},
        "okForAction": {"const": false}, "automaticRetryAllowed": {"const": false}, "nativeHostVerified": {"const": false},
        "enrollmentComplete": {"const": false}, "proxyReady": {"const": false}}},
    "draftResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["argumentsOriginal", "argumentsSha256", "review"],
      "properties": {"status": {"const": "draft"}, "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"},
        "argumentsSha256": {"$ref": "#/$defs/digest"}, "review": {"$ref": "#/$defs/review"}}}], "unevaluatedProperties": false},
    "optionsResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["options"],
      "properties": {"status": {"const": "fresh-assertion-required"}, "options": {"$ref": "#/$defs/options"}}}], "unevaluatedProperties": false},
    "recordResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["association"],
      "properties": {"status": {"const": "canary-publication-associated"}, "association": {"$ref": "#/$defs/association"}}}], "unevaluatedProperties": false},
    "lookupResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["association", "associationOriginal"],
      "properties": {"status": {"const": "observation"}, "association": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/association"}]},
        "associationOriginal": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/ascii"}], "minLength": 2, "maxLength": 32768}]}}}], "unevaluatedProperties": false},
    "error": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"properties": {"status": {"enum": ["refused", "association-outcome-unknown"]}}}], "unevaluatedProperties": false},
    "response": {"oneOf": [{"$ref": "#/$defs/draftResponse"}, {"$ref": "#/$defs/optionsResponse"}, {"$ref": "#/$defs/recordResponse"},
      {"$ref": "#/$defs/lookupResponse"}, {"$ref": "#/$defs/error"}]}
    ,
    "rotatedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sessionId",
        "setupSha256",
        "continuationSha256",
        "enrollmentSha256",
        "installationSha256",
        "canaryId",
        "finalizationSha256",
        "publicationSha256",
        "policyHash",
        "activationPolicySha256",
        "credentialId",
        "credentialVersion",
        "enrollmentApprovalId",
        "nativeApprovalId",
        "auditIds",
        "issuedAtEpochNs",
        "expiresAtEpochNs",
        "rotationAuditId"
      ],
      "properties": {
        "apiVersion": {
          "const": "catchplate.setupNativeCanaryAssociation/v2"
        },
        "sessionId": {
          "$ref": "#/$defs/uuid"
        },
        "setupSha256": {
          "$ref": "#/$defs/digest"
        },
        "continuationSha256": {
          "$ref": "#/$defs/digest"
        },
        "enrollmentSha256": {
          "$ref": "#/$defs/digest"
        },
        "installationSha256": {
          "$ref": "#/$defs/digest"
        },
        "canaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "finalizationSha256": {
          "$ref": "#/$defs/digest"
        },
        "publicationSha256": {
          "$ref": "#/$defs/digest"
        },
        "policyHash": {
          "$ref": "#/$defs/digest"
        },
        "activationPolicySha256": {
          "$ref": "#/$defs/digest"
        },
        "credentialId": {
          "$ref": "#/$defs/uuid"
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "enrollmentApprovalId": {
          "$ref": "#/$defs/uuid"
        },
        "nativeApprovalId": {
          "$ref": "#/$defs/uuid"
        },
        "auditIds": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "issuedAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "rotationAuditId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "description": "Server-selected exact originals and sorted audit selectors. Kernel rederives every selector. Metadata operation interval at most 30 seconds and within original Setup expiry; no historical effect window is extended."
    },
    "rotatedArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "control_plane_configuration_digest",
        "credential_policy",
        "request"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^oidc:",
          "maxLength": 1024
        },
        "control_plane_configuration_digest": {
          "$ref": "#/$defs/digest"
        },
        "credential_policy": {
          "$ref": "#/$defs/credentialPolicy"
        },
        "request": {
          "$ref": "#/$defs/rotatedRequest"
        }
      }
    },
    "rotatedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "canaryId",
        "policyHash",
        "credentialId",
        "credentialVersion",
        "enrollmentSha256",
        "installationSha256",
        "finalizationSha256",
        "publicationSha256",
        "expiresAtEpochNs"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/uuid"
        },
        "canaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policyHash": {
          "$ref": "#/$defs/digest"
        },
        "credentialId": {
          "$ref": "#/$defs/uuid"
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "enrollmentSha256": {
          "$ref": "#/$defs/digest"
        },
        "installationSha256": {
          "$ref": "#/$defs/digest"
        },
        "finalizationSha256": {
          "$ref": "#/$defs/digest"
        },
        "publicationSha256": {
          "$ref": "#/$defs/digest"
        },
        "expiresAtEpochNs": {
          "$ref": "#/$defs/epoch"
        }
      }
    },
    "rotatedDraftResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/responseFlags"
        },
        {
          "type": "object",
          "required": [
            "argumentsOriginal",
            "argumentsSha256",
            "review"
          ],
          "properties": {
            "status": {
              "const": "draft"
            },
            "argumentsOriginal": {
              "$ref": "#/$defs/argumentsOriginal"
            },
            "argumentsSha256": {
              "$ref": "#/$defs/digest"
            },
            "review": {
              "$ref": "#/$defs/rotatedReview"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "requestAny": {
      "oneOf": [
        {
          "$ref": "#/$defs/request"
        },
        {
          "$ref": "#/$defs/rotatedRequest"
        }
      ]
    },
    "responseAny": {
      "anyOf": [
        {
          "$ref": "#/$defs/response"
        },
        {
          "$ref": "#/$defs/rotatedDraftResponse"
        }
      ]
    }
  }
}
