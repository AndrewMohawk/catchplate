{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.dev/schemas/setup-native-enrollment.v1.schema.json",
  "title": "Protected native Setup certificate issuance; not installed trust or completed Setup",
  "oneOf": [
    {"$ref": "#/$defs/draftRequest"}, {"$ref": "#/$defs/optionsRequest"},
    {"$ref": "#/$defs/effectRequest"}, {"$ref": "#/$defs/lookupRequest"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid", "minLength": 36, "maxLength": 36},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 699051},
    "intentOriginal": {"type": "string", "minLength": 2, "maxLength": 1200000,
      "description": "Exact canonical ASCII intent17 original; do not parse and reserialize its integer epochs."},
    "file": {"type": "object", "additionalProperties": false,
      "required": ["base64Url", "byteCount", "bytesDigest"],
      "properties": {"base64Url": {"$ref": "#/$defs/base64url"},
        "byteCount": {"type": "integer", "minimum": 2, "maximum": 524288}, "bytesDigest": {"$ref": "#/$defs/digest"}}},
    "draftRequest": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "sessionId", "authorization", "packet", "request"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentRequest/v1"},
        "sessionId": {"$ref": "#/$defs/uuid"}, "authorization": {"$ref": "#/$defs/file"},
        "packet": {"$ref": "#/$defs/file"}, "request": {"$ref": "#/$defs/file"}}},
    "optionsRequest": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "intentOriginal", "phase", "approvalId"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentRequest/v1"},
        "intentOriginal": {"$ref": "#/$defs/intentOriginal"}, "phase": {"enum": ["request", "decide", "issue"]},
        "approvalId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]}},
      "allOf": [{"if": {"properties": {"phase": {"const": "request"}}},
        "then": {"properties": {"approvalId": {"type": "null"}}},
        "else": {"properties": {"approvalId": {"$ref": "#/$defs/uuid"}}}}]},
    "effectRequest": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "intentOriginal", "approvalId", "assertion"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentRequest/v1"},
        "intentOriginal": {"$ref": "#/$defs/intentOriginal"},
        "approvalId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]},
        "assertion": {"type": "object", "description": "Original fresh policy_authority WebAuthn assertion, bounded to 16 KiB; actual existing assertion verifier defines its cryptographic grammar."}}},
    "lookupRequest": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "sessionId"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentRequest/v1"}, "sessionId": {"$ref": "#/$defs/uuid"}}},
    "intent": {"type": "object", "additionalProperties": false,
      "required": ["apiVersion", "sessionId", "ownerId", "setupSha256", "continuationSha256", "assignmentSha256", "policyHash",
        "routePolicyDigest", "principalId", "credentialId", "credentialVersion", "issuerBootstrap", "authorization", "packet", "request", "issuedAtEpochNs", "expiresAtEpochNs"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentIntent/v1"}, "sessionId": {"$ref": "#/$defs/uuid"},
        "ownerId": {"type": "string", "pattern": "^oidc:", "maxLength": 1024}, "setupSha256": {"$ref": "#/$defs/digest"},
        "continuationSha256": {"$ref": "#/$defs/digest"}, "assignmentSha256": {"$ref": "#/$defs/digest"},
        "policyHash": {"$ref": "#/$defs/digest"}, "routePolicyDigest": {"$ref": "#/$defs/digest"},
        "principalId": {"type": "string", "minLength": 1, "maxLength": 1024}, "credentialId": {"$ref": "#/$defs/uuid"},
        "credentialVersion": {"const": 1}, "issuerBootstrap": {"$ref": "#/$defs/base64url"},
        "authorization": {"$ref": "#/$defs/base64url"}, "packet": {"$ref": "#/$defs/base64url"}, "request": {"$ref": "#/$defs/base64url"},
        "issuedAtEpochNs": {"$ref": "#/$defs/epoch"}, "expiresAtEpochNs": {"$ref": "#/$defs/epoch"}},
      "description": "The full original independently verified native grant bounds the unchanged <=300 second intent. IssuerBootstrap is the actual cold caller original. No uploaded verified DTO is accepted."},
    "authorityPolicy": {"type": "object", "additionalProperties": false,
      "required": ["schema", "issuerRootPublicKeyPem", "issuerBootstrapSha256", "credentialPolicy"],
      "properties": {"schema": {"const": "serverware.setupNativeEnrollmentAuthorityPolicy/v1"},
        "issuerRootPublicKeyPem": {"type": "string", "minLength": 1, "maxLength": 16384},
        "issuerBootstrapSha256": {"$ref": "#/$defs/digest"}, "credentialPolicy": {"type": "object"}},
      "description": "Independently signed authority configuration purpose field setupNativeEnrollmentPolicy; exact existing hardware credential policy, issuer root distinct from CP authority root. Both verifier and planner reverify original issuer grants and certificate."},
    "enrollment": {"type": "object", "additionalProperties": false,
      "required": ["revision", "phase", "intentSha256", "assignmentSha256", "certificateSha256", "approvalId", "prepareRequestDigest", "completeRequestDigest"],
      "properties": {"revision": {"enum": [0, 1]}, "phase": {"enum": ["issuance_unknown", "certificate_issued"]},
        "intentSha256": {"$ref": "#/$defs/digest"}, "assignmentSha256": {"$ref": "#/$defs/digest"},
        "certificateSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "approvalId": {"$ref": "#/$defs/uuid"},
        "prepareRequestDigest": {"$ref": "#/$defs/digest"}, "completeRequestDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}}},
    "association": {"type": "object", "additionalProperties": false,
      "required": ["schema", "authorizationDigest", "requestDigest", "issuerCertificateDigest", "certificateSha256", "serialNumber"],
      "properties": {"schema": {"const": "serverware.workloadIdentityIssuerResponse/v1"},
        "authorizationDigest": {"$ref": "#/$defs/digest"}, "requestDigest": {"$ref": "#/$defs/digest"},
        "issuerCertificateDigest": {"$ref": "#/$defs/digest"}, "certificateSha256": {"$ref": "#/$defs/digest"},
        "serialNumber": {"type": "string", "pattern": "^[1-9a-f][0-9a-f]{0,39}$"}}},
    "responseFlags": {"type": "object",
      "required": ["apiVersion", "status", "automaticRetryAllowed", "caInstalled", "enrollmentComplete", "proxyReady"],
      "properties": {"apiVersion": {"const": "serverware.setupNativeEnrollmentResponse/v1"}, "status": {"type": "string"},
        "automaticRetryAllowed": {"const": false}, "caInstalled": {"const": false}, "enrollmentComplete": {"const": false}, "proxyReady": {"const": false}}},
    "draftResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["intentOriginal", "intentSha256"],
      "properties": {"status": {"const": "draft"}, "intentOriginal": {"$ref": "#/$defs/intentOriginal"}, "intentSha256": {"$ref": "#/$defs/digest"}}}], "unevaluatedProperties": false},
    "optionsResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["options", "phase", "approvalId", "intentSha256"],
      "properties": {"status": {"const": "fresh-assertion-required"}, "options": {"type": "object", "required": ["publicKey", "serverware"], "additionalProperties": false,
        "properties": {"publicKey": {"type": "object"}, "serverware": {"type": "object", "additionalProperties": false,
          "required": ["schema", "operation", "operationId", "challengeId", "credentialRecordId", "intentSha256"],
          "properties": {"schema": {"const": "serverware.setupNativeEnrollmentOptions/v1"},
            "operation": {"enum": ["setup.native-enrollment.request", "setup.native-enrollment.decide", "setup.native-enrollment.prepare"]},
            "operationId": {"$ref": "#/$defs/digest"}, "challengeId": {"$ref": "#/$defs/digest"}, "credentialRecordId": {"$ref": "#/$defs/uuid"}, "intentSha256": {"$ref": "#/$defs/digest"}}}}},
        "phase": {"enum": ["request", "decide", "issue"]}, "approvalId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]}, "intentSha256": {"$ref": "#/$defs/digest"}}}], "unevaluatedProperties": false},
    "approvalResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["approvalId", "intentSha256"],
      "properties": {"status": {"enum": ["approval-required", "approved"]}, "approvalId": {"$ref": "#/$defs/uuid"}, "intentSha256": {"$ref": "#/$defs/digest"}}}], "unevaluatedProperties": false},
    "certificateResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["enrollment", "certificate", "association"],
      "properties": {"status": {"const": "certificate-issued"}, "enrollment": {"$ref": "#/$defs/enrollment"}, "certificate": {"$ref": "#/$defs/file"}, "association": {"$ref": "#/$defs/association"}}}], "unevaluatedProperties": false},
    "lookupResponse": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"type": "object", "required": ["enrollment", "certificate", "association"],
      "properties": {"status": {"const": "observation"}, "enrollment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/enrollment"}]},
        "certificate": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}, "association": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/association"}]}}}], "unevaluatedProperties": false},
    "error": {"allOf": [{"$ref": "#/$defs/responseFlags"}, {"properties": {"status": {"enum": ["refused", "issuance-outcome-unknown"]}}}], "unevaluatedProperties": false}
    ,
    "rotatedIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sessionId",
        "ownerId",
        "setupSha256",
        "continuationSha256",
        "assignmentSha256",
        "policyHash",
        "routePolicyDigest",
        "principalId",
        "credentialId",
        "credentialVersion",
        "issuerBootstrap",
        "authorization",
        "packet",
        "request",
        "issuedAtEpochNs",
        "expiresAtEpochNs",
        "continuationOriginal"
      ],
      "properties": {
        "apiVersion": {
          "const": "serverware.setupNativeEnrollmentIntent/v2"
        },
        "sessionId": {
          "$ref": "#/$defs/uuid"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^oidc:",
          "maxLength": 1024
        },
        "setupSha256": {
          "$ref": "#/$defs/digest"
        },
        "continuationSha256": {
          "$ref": "#/$defs/digest"
        },
        "assignmentSha256": {
          "$ref": "#/$defs/digest"
        },
        "policyHash": {
          "$ref": "#/$defs/digest"
        },
        "routePolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "credentialId": {
          "$ref": "#/$defs/uuid"
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "issuerBootstrap": {
          "$ref": "#/$defs/base64url"
        },
        "authorization": {
          "$ref": "#/$defs/base64url"
        },
        "packet": {
          "$ref": "#/$defs/base64url"
        },
        "request": {
          "$ref": "#/$defs/base64url"
        },
        "issuedAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "expiresAtEpochNs": {
          "$ref": "#/$defs/epoch"
        },
        "continuationOriginal": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2170880,
          "pattern": "^[\\x00-\\x7f]+$"
        }
      },
      "description": "Exact v2 intent with the literal rotated static continuation; historical provenance never renews authority or expiry."
    },
    "intentAny": {
      "oneOf": [
        {
          "$ref": "#/$defs/intent"
        },
        {
          "$ref": "#/$defs/rotatedIntent"
        }
      ]
    }
  }
}
