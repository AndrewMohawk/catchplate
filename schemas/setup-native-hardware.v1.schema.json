{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://serverware.dev/schemas/setup-native-hardware.v1.schema.json",
  "title":"Purpose-fixed native Setup hardware and independently verified proxy originals",
  "$ref":"#/$defs/httpRequest",
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id":{"type":"string","format":"uuid","maxLength":36},
    "original":{"type":"string","minLength":2,"maxLength":4194304,"pattern":"^[\\x00-\\x7f]+$"},
    "epoch":{"type":"integer","minimum":1,"maximum":9223372036854775807},
    "authority":{"type":"object","additionalProperties":false,"required":["provider","publicKeyPem"],
      "properties":{"provider":{"type":"string","minLength":1,"maxLength":128},"publicKeyPem":{"type":"string","minLength":1,"maxLength":16384}}},
    "authorityPolicy":{"type":"object","additionalProperties":false,
      "required":["schema","credentialPolicy","hardwareVerifier","proxyVerifier","finalAuthority","maximumAttemptNanos"],
      "properties":{"schema":{"const":"serverware.setupNativeHardwareAuthorityPolicy/v1"},"credentialPolicy":{"type":"object"},
        "hardwareVerifier":{"$ref":"#/$defs/authority"},"proxyVerifier":{"$ref":"#/$defs/authority"},"finalAuthority":{"$ref":"#/$defs/authority"},
        "maximumAttemptNanos":{"type":"integer","minimum":1000000000,"maximum":300000000000}}},
    "attempt":{"type":"object","additionalProperties":false,
      "required":["apiVersion","attemptId","sessionId","ownerId","associationSha256","runtimeSha256","enrollmentSha256","installationSha256",
        "scopeSha256","nonce","policyHash","principalId","routeId","credentialId","credentialVersion","issuedAtEpochNs","expiresAtEpochNs"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareAttempt/v1"},"attemptId":{"$ref":"#/$defs/id"},
        "sessionId":{"$ref":"#/$defs/id"},"ownerId":{"type":"string","pattern":"^oidc:","maxLength":1024},
        "associationSha256":{"$ref":"#/$defs/digest"},"runtimeSha256":{"$ref":"#/$defs/digest"},"enrollmentSha256":{"$ref":"#/$defs/digest"},
        "installationSha256":{"$ref":"#/$defs/digest"},"scopeSha256":{"$ref":"#/$defs/digest"},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
        "policyHash":{"$ref":"#/$defs/digest"},"principalId":{"type":"string","minLength":1,"maxLength":1024},
        "routeId":{"type":"string","minLength":1,"maxLength":1024},"credentialId":{"$ref":"#/$defs/id"},"credentialVersion":{"const":1},
        "issuedAtEpochNs":{"$ref":"#/$defs/epoch"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"}}},
    "statement":{"type":"object","additionalProperties":false,
      "required":["apiVersion","attempt","policyOriginalSha256","routePolicyDigest","bootId","keyId","controlPlaneResponseSigningKeyId","dataPlaneBinarySha256","observedAtEpochNs"],
      "properties":{"apiVersion":{"const":"serverware.nativeSetupHardwareStatement/v1"},"attempt":{"$ref":"#/$defs/attempt"},
        "policyOriginalSha256":{"$ref":"#/$defs/digest"},"routePolicyDigest":{"$ref":"#/$defs/digest"},"bootId":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
        "keyId":{"$ref":"#/$defs/digest"},"controlPlaneResponseSigningKeyId":{"$ref":"#/$defs/digest"},
        "dataPlaneBinarySha256":{"$ref":"#/$defs/digest"},"observedAtEpochNs":{"$ref":"#/$defs/epoch"}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["statement","signature","nativeKeyEvidence"],
      "properties":{"statement":{"$ref":"#/$defs/statement"},"signature":{"type":"string","pattern":"^ed25519:[A-Za-z0-9_-]{86}$"},
        "nativeKeyEvidence":{"type":"object","additionalProperties":false,"required":["apiVersion","attestationDocumentB64","responseProofPublicKey"],
          "properties":{"apiVersion":{"const":"serverware.nativeResponseProofKeyEvidence/v1"},
            "attestationDocumentB64":{"type":"string","minLength":1,"maxLength":16384,"pattern":"^[A-Za-z0-9_-]+$"},
            "responseProofPublicKey":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"}}}}},
    "receipt":{"type":"object","additionalProperties":false,"required":["payload","signature"],
      "properties":{"signature":{"type":"string","pattern":"^ed25519:[A-Za-z0-9_-]{86}$"},"payload":{"$ref":"#/$defs/receiptPayload"}}},
    "receiptPayload":{"type":"object","additionalProperties":false,
      "required":["apiVersion","purpose","resultScope","attemptSha256","evidenceSha256","runtimeSha256","enrollmentSha256","installationSha256",
        "scopeSha256","quoteSha256","releaseRecordSha256","policyHash","verifierKeyId","verifierProvider","issuedAtEpochNs","expiresAtEpochNs","measuredHost","finalSetup","proxyReady"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeIndependentVerification/v1"},"purpose":{"enum":["hardware-verifier","proxy-verifier"]},
        "resultScope":{"const":"enclave-hardware-and-proxy-only"},"attemptSha256":{"$ref":"#/$defs/digest"},"evidenceSha256":{"$ref":"#/$defs/digest"},
        "runtimeSha256":{"$ref":"#/$defs/digest"},"enrollmentSha256":{"$ref":"#/$defs/digest"},"installationSha256":{"$ref":"#/$defs/digest"},
        "scopeSha256":{"$ref":"#/$defs/digest"},"quoteSha256":{"$ref":"#/$defs/digest"},"releaseRecordSha256":{"$ref":"#/$defs/digest"},
        "policyHash":{"$ref":"#/$defs/digest"},"verifierKeyId":{"$ref":"#/$defs/digest"},"verifierProvider":{"type":"string","minLength":1,"maxLength":128},
        "issuedAtEpochNs":{"$ref":"#/$defs/epoch"},"expiresAtEpochNs":{"$ref":"#/$defs/epoch"},"measuredHost":{"const":false},"finalSetup":{"const":false},"proxyReady":{"const":false}}},
    "bundle":{"type":"object","additionalProperties":false,"required":["inputsOriginal","attemptOriginal","evidenceOriginal","verifierRequestOriginal"],
      "properties":{"inputsOriginal":{"$ref":"#/$defs/original"},"attemptOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":8192}]},
        "evidenceOriginal":{"anyOf":[{"type":"null"},{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":65536}]}]},
        "verifierRequestOriginal":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/original"}]}}},
    "result":{"type":"object","additionalProperties":false,
      "required":["apiVersion","resultScope","hostAssociationTrust","measuredHost","finalSetup","proxyReady","okForAction","attemptSha256","evidenceSha256","hardwareReceiptSha256","proxyReceiptSha256"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareResult/v1"},"resultScope":{"const":"enclave-hardware-and-proxy-only"},
        "hostAssociationTrust":{"const":"trusted-host-local"},"measuredHost":{"const":false},"finalSetup":{"const":false},"proxyReady":{"const":false},"okForAction":{"const":false},
        "attemptSha256":{"$ref":"#/$defs/digest"},"evidenceSha256":{"$ref":"#/$defs/digest"},"hardwareReceiptSha256":{"$ref":"#/$defs/digest"},"proxyReceiptSha256":{"$ref":"#/$defs/digest"}}},
    "public":{"type":"object","additionalProperties":false,"required":["revision","phase","attemptSha256","prepareRequestDigest","completeRequestDigest"],
      "properties":{"revision":{"enum":[0,1]},"phase":{"enum":["hardware_outcome_unknown","hardware_proxy_verified"]},"attemptSha256":{"$ref":"#/$defs/digest"},
        "prepareRequestDigest":{"$ref":"#/$defs/digest"},"completeRequestDigest":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]}},
      "oneOf":[{"properties":{"revision":{"const":0},"phase":{"const":"hardware_outcome_unknown"},"completeRequestDigest":{"type":"null"}}},
        {"properties":{"revision":{"const":1},"phase":{"const":"hardware_proxy_verified"},"completeRequestDigest":{"$ref":"#/$defs/digest"}}}]},
    "response":{"type":"object","additionalProperties":false,
      "required":["apiVersion","status","okForAction","automaticRetryAllowed","measuredHost","enrollmentComplete","proxyReady","hostAssociationTrust"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareResponse/v1"},"status":{"type":"string"},"okForAction":{"const":false},
        "automaticRetryAllowed":{"const":false},"measuredHost":{"const":false},"enrollmentComplete":{"const":false},"proxyReady":{"const":false},
        "hostAssociationTrust":{"const":"trusted-host-local"},"options":{"type":"object","additionalProperties":false,"required":["publicKey","serverware"],
          "properties":{"publicKey":{"type":"object"},"serverware":{"type":"object","additionalProperties":false,
            "required":["schema","operation","operationId","challengeId","credentialRecordId","payloadDigest"],
            "properties":{"schema":{"const":"serverware.setupNativeHardwareOptions/v1"},"operation":{"const":"setup.native-hardware.prepare"},
              "operationId":{"$ref":"#/$defs/digest"},"challengeId":{"$ref":"#/$defs/digest"},"credentialRecordId":{"$ref":"#/$defs/id"},"payloadDigest":{"$ref":"#/$defs/digest"}}}}},
        "hardware":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/public"}]},"bundle":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/bundle"}]},
        "resultOriginal":{"anyOf":[{"type":"null"},{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":8192}]}]}},
      "oneOf":[
        {"properties":{"status":{"const":"fresh-assertion-required"}},"required":["options"],"not":{"anyOf":[{"required":["hardware"]},{"required":["bundle"]},{"required":["resultOriginal"]}]}},
        {"properties":{"status":{"const":"independent-verification-required"},"hardware":{"$ref":"#/$defs/public"},"bundle":{"$ref":"#/$defs/bundle"}},"required":["hardware","bundle"],"not":{"anyOf":[{"required":["options"]},{"required":["resultOriginal"]}]}},
        {"properties":{"status":{"const":"hardware-proxy-verified"},"hardware":{"$ref":"#/$defs/public"},"resultOriginal":{"$ref":"#/$defs/original"}},"required":["hardware","resultOriginal"],"not":{"anyOf":[{"required":["options"]},{"required":["bundle"]}]}},
        {"properties":{"status":{"const":"observation"}},"required":["hardware","bundle","resultOriginal"],"not":{"required":["options"]}},
        {"properties":{"status":{"enum":["refused","hardware-outcome-unknown"]}},"not":{"anyOf":[{"required":["options"]},{"required":["hardware"]},{"required":["bundle"]},{"required":["resultOriginal"]}]}}
      ]},
    "verifierConfiguration":{"type":"object","additionalProperties":false,
      "required":["apiVersion","role","uid","gid","operation","authorityRootPublicKeyPem","authorityConfigurationOriginal","authorityConfigurationSha256","controlPlaneConfigurationDigest"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeIndependentVerifierConfiguration/v1"},"role":{"enum":["hardware-verifier","proxy-verifier"]},
        "uid":{"type":"integer","minimum":1,"maximum":4294967294},"gid":{"type":"integer","minimum":1,"maximum":4294967294},
        "authorityRootPublicKeyPem":{"type":"string","minLength":1,"maxLength":16384},"authorityConfigurationOriginal":{"$ref":"#/$defs/original"},
        "authorityConfigurationSha256":{"$ref":"#/$defs/digest"},"controlPlaneConfigurationDigest":{"$ref":"#/$defs/digest"},
        "operation":{"type":"object","additionalProperties":false,"required":["bootIdBase64url","timeNamespaceDevice","timeNamespaceInode","issuedAtBoottimeNs","deadlineBoottimeNs"],
          "properties":{"bootIdBase64url":{"type":"string","pattern":"^[A-Za-z0-9_-]{22}$"},"timeNamespaceDevice":{"type":"integer","minimum":1,"maximum":18446744073709551615},
            "timeNamespaceInode":{"type":"integer","minimum":1,"maximum":18446744073709551615},"issuedAtBoottimeNs":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
            "deadlineBoottimeNs":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"}}}}},
    "httpRequest":{"oneOf":[{"$ref":"#/$defs/readRequest"},{"$ref":"#/$defs/prepareRequest"},{"$ref":"#/$defs/completeRequest"}]},
    "readRequest":{"type":"object","additionalProperties":false,"required":["apiVersion","sessionId"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareRequest/v1"},"sessionId":{"$ref":"#/$defs/id"}}},
    "prepareRequest":{"type":"object","additionalProperties":false,"required":["apiVersion","sessionId","assertion"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareRequest/v1"},"sessionId":{"$ref":"#/$defs/id"},"assertion":{"type":"object"}}},
    "completeRequest":{"type":"object","additionalProperties":false,"required":["apiVersion","sessionId","evidenceOriginal","hardwareReceiptOriginal","proxyReceiptOriginal"],
      "properties":{"apiVersion":{"const":"serverware.setupNativeHardwareRequest/v1"},"sessionId":{"$ref":"#/$defs/id"},
        "evidenceOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":65536}]},
        "hardwareReceiptOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":16384}]},
        "proxyReceiptOriginal":{"allOf":[{"$ref":"#/$defs/original"},{"maxLength":16384}]}}}
  }
}
