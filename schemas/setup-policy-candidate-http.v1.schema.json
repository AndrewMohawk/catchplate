{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverware.dev/schemas/setup-policy-candidate-http.v1.schema.json",
  "title": "Protected Setup association, publication and separate control-plane/native observations",
  "description": "Exact originals remain strings, preserving nanosecond integers. Neither a draft nor a stored continuation is policy loading, Setup completion, retry permission or proxy readiness. Complete requests <=4227072 bytes and responses <=5242880 bytes; individual limits never enlarge those bounds.",
  "anyOf": [{"$ref": "#/$defs/draftRequest"}, {"$ref": "#/$defs/draftResponse"}, {"$ref": "#/$defs/optionsRequest"},
    {"$ref": "#/$defs/optionsResponse"}, {"$ref": "#/$defs/bindRequest"}, {"$ref": "#/$defs/bindResponse"},
    {"$ref": "#/$defs/lookupRequest"}, {"$ref": "#/$defs/observation"}, {"$ref": "#/$defs/authorityPolicy"},
    {"$ref": "#/$defs/materializationRequest"}, {"$ref": "#/$defs/materializationDraft"}, {"$ref": "#/$defs/installedObservation"},
    {"$ref": "#/$defs/nativeObservation"}],
  "$defs": {
    "materializationRequest": {
      "description": "POST /materialize-draft, /installed or /native-installed; exact three fields and <=4096 raw bytes. Actual Setup owner with credential_owner, Setup revision3 and continuation0 required. Draft additionally requires literal policy_publisher. Native observation does not perform enrollment, hot reload or a filesystem effect.",
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "sessionId", "expectedRevision"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyMaterializationRequest/v1"},
        "sessionId": {"$ref": "#/$defs/uuid"}, "expectedRevision": {"const": 3}}
    },
    "materializationDraft": {
      "description": "Data-only exact strings, not permission. Whole escaped response <=5242880 bytes. Use the SAME request for separate policy-file request(428), distinct publisher approval and requester consume; no automatic replay or new publication ID after uncertainty.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "okForAction", "automaticRetryAllowed", "continuationOriginal", "requestOriginal", "bindingOriginal"],
      "properties": {
        "apiVersion": {"const": "serverware.setupPolicyMaterializationDraft/v1"},
        "okForAction": {"const": false}, "automaticRetryAllowed": {"const": false},
        "continuationOriginal": {"$ref": "#/$defs/continuationOriginal"},
        "requestOriginal": {"type": "string", "minLength": 2, "maxLength": 1400000,
          "contentMediaType": "application/json", "contentSchema": {"$ref": "#/$defs/materializationBody"},
          "description": "Exact canonical ASCII materialize body without mfa; strings/integers are never normalized via floating point."},
        "bindingOriginal": {"type": "string", "minLength": 2, "maxLength": 8192,
          "contentMediaType": "application/json", "contentSchema": {"$ref": "#/$defs/materializationBinding"},
          "description": "Exact existing policy-file materialize binding. payloadDigest is SHA256 of these unchanged ASCII bytes."}
      }
    },
    "materializationBody": {
      "type": "object", "additionalProperties": false,
      "required": ["publicationId", "policyOriginalBase64url", "artifactEnvelopeSha256", "expectedFileSha256", "reason"],
      "properties": {
        "publicationId": {"$ref": "control-plane-policy-file-publication.v1.schema.json#/$defs/id"},
        "policyOriginalBase64url": {"type": "string", "minLength": 1, "maxLength": 1398102, "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Canonical unpadded base64url; decoded original <=1048576 bytes, from actual protected completed generation."},
        "artifactEnvelopeSha256": {"$ref": "#/$defs/digest"}, "expectedFileSha256": {"$ref": "#/$defs/digest"},
        "reason": {"const": null}
      }
    },
    "materializationBinding": {
      "allOf": [{"$ref": "control-plane-policy-file-publication.v1.schema.json#/$defs/materializeBinding"},
        {"properties": {"reason": {"const": null}, "expectedFileSha256": {"$ref": "#/$defs/digest"}}}]
    },
    "installedObservation": {
      "description": "Read-only original from the actual control-plane loader and settled publication owners. Not native gate proof, proxy readiness, action authorization, retry permission or Setup completion.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "okForAction", "automaticRetryAllowed", "nativeGateVerified", "observationOriginal"],
      "properties": {
        "apiVersion": {"const": "serverware.setupPolicyInstalledObservation/v1"},
        "okForAction": {"const": false}, "automaticRetryAllowed": {"const": false}, "nativeGateVerified": {"const": false},
        "observationOriginal": {"type": "string", "minLength": 2, "maxLength": 131072,
          "description": "Exact canonical ASCII setupLoadedPolicyObservation/v1 from LoadedPublication; scope control-plane-loaded-policy-only, all action/retry/native-gate flags false. Nested original preserves file identity, assignment, journal, approval, audit and exact epoch integers."}
      }
    },
    "nativeObservation": {
      "description": "POST /native-installed response, <=524288 bytes including escaping. The real backend verifies native evidence; this read-only wrapper grants no action, enrollment, policy reload, retry or proxy readiness. Old installedObservation remains control-plane-only.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "okForAction", "automaticRetryAllowed", "proxyReady", "setupSessionId", "observationOriginal"],
      "properties": {
        "apiVersion": {"const": "serverware.setupNativePolicyObservation/v1"},
        "okForAction": {"const": false}, "automaticRetryAllowed": {"const": false}, "proxyReady": {"const": false},
        "setupSessionId": {"$ref": "#/$defs/uuid"},
        "observationOriginal": {"type": "string", "minLength": 2, "maxLength": 262144,
          "contentMediaType": "application/json", "contentSchema": {"$ref": "#/$defs/nativeLoadedObservation"},
          "description": "Unchanged canonical ASCII original; preserve every integer and nested original. This is not a transferable permission or browser-verifiable completion receipt."}
      }
    },
    "nativeLoadedObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "scope", "okForAction", "automaticRetryAllowed", "nativeLoadedPolicyVerified", "proxyReady",
        "continuationSha256", "currentCredentialStateSha256", "requestOriginal", "evidenceOriginal"],
      "properties": {
        "apiVersion": {"const": "serverware.setupNativeLoadedPolicyObservation/v1"},
        "scope": {"const": "native-loaded-policy-only"}, "okForAction": {"const": false},
        "automaticRetryAllowed": {"const": false}, "nativeLoadedPolicyVerified": {"const": true}, "proxyReady": {"const": false},
        "continuationSha256": {"$ref": "#/$defs/digest"}, "currentCredentialStateSha256": {"$ref": "#/$defs/digest"},
        "requestOriginal": {"type": "string", "minLength": 2, "maxLength": 4096,
          "description": "Exact canonical original request retaining its fresh native nonce, context, policy/principal/route/credential and original bounded interval."},
        "evidenceOriginal": {"type": "string", "minLength": 2, "maxLength": 131072,
          "description": "Exact native signed and quoted evidence independently admitted by the backend. This schema is a wire description, not signature, quote or live-owner verification."}
      }
    },
    "authorityPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "controlPlaneConfigurationDigest", "credentialPolicy", "operationMaxSeconds", "maximumArgumentBytes"],
      "properties": {
        "schema": {"const": "serverware.setupPolicyContinuationAuthorityPolicy/v1"},
        "controlPlaneConfigurationDigest": {"$ref": "#/$defs/digest"},
        "credentialPolicy": {"$ref": "control-plane-publication-approval.v1.schema.json#/$defs/credentialPolicy"},
        "operationMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "maximumArgumentBytes": {"const": 2097152}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "argumentsOriginal": {"type": "string", "minLength": 2, "maxLength": 2097152},
    "continuationOriginal": {"type": "string", "minLength": 2, "maxLength": 2170880},
    "draftRequest": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "sessionId", "expectedRevision", "generationRequestId"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateRequest/v1"}, "sessionId": {"$ref": "#/$defs/uuid"},
        "expectedRevision": {"const": 3}, "generationRequestId": {"$ref": "#/$defs/uuid"}}
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["principalId", "routeId", "credentialId", "credentialVersion", "policyHash", "routePolicyDigest", "assignmentDigest", "sessionId", "setupRevision", "continuationRevision", "ownerId", "generationRequestId", "generationPublicationDigest", "candidateId", "canaryId", "expiresAtEpochNs"],
      "properties": {
        "principalId": {"$ref": "#/$defs/id"}, "routeId": {"$ref": "#/$defs/id"}, "credentialId": {"$ref": "#/$defs/uuid"},
        "credentialVersion": {"const": 1}, "policyHash": {"$ref": "#/$defs/digest"}, "routePolicyDigest": {"$ref": "#/$defs/digest"},
        "assignmentDigest": {"$ref": "#/$defs/digest"}, "sessionId": {"$ref": "#/$defs/uuid"}, "setupRevision": {"const": 3},
        "continuationRevision": {"const": 0}, "ownerId": {"type": "string", "pattern": "^oidc:", "maxLength": 1024},
        "generationRequestId": {"$ref": "#/$defs/uuid"}, "generationPublicationDigest": {"$ref": "#/$defs/digest"},
        "candidateId": {"$ref": "#/$defs/id"}, "canaryId": {"$ref": "#/$defs/id"},
        "expiresAtEpochNs": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    },
    "draftResponse": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "okForAction", "argumentsOriginal", "review"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateRequest/v1"}, "okForAction": {"const": false},
        "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"}, "review": {"$ref": "#/$defs/review"}}
    },
    "optionsRequest": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "argumentsOriginal"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateOptions/v1"}, "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"}}
    },
    "optionsResponse": {
      "type": "object", "additionalProperties": false, "required": ["publicKey", "serverware"],
      "properties": {
        "publicKey": {"$ref": "policy-candidate-generation-intake.v1.schema.json#/$defs/optionsResponse/properties/publicKey"},
        "serverware": {
          "type": "object", "additionalProperties": false, "required": ["schema", "operation", "operationId", "challengeId", "credentialRecordId", "payloadDigest", "expiresAt"],
          "properties": {"schema": {"const": "serverware.setupPolicyCandidateOptions/v1"}, "operation": {"const": "setup.policy.bind-candidate"},
            "operationId": {"$ref": "#/$defs/digest"}, "challengeId": {"$ref": "#/$defs/digest"}, "credentialRecordId": {"$ref": "#/$defs/id"},
            "payloadDigest": {"$ref": "#/$defs/digest"}, "expiresAt": {"type": "string", "minLength": 1, "maxLength": 128}}
        }
      }
    },
    "bindRequest": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "argumentsOriginal", "mfa"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateOptions/v1"}, "argumentsOriginal": {"$ref": "#/$defs/argumentsOriginal"},
        "mfa": {"type": "object", "additionalProperties": false, "required": ["setupPolicyProfile", "assertion"],
          "properties": {"setupPolicyProfile": {"const": "serverware.setupPolicyCandidateOptions/v1"},
            "assertion": {"$ref": "control-plane-publication-approval.v1.schema.json#/$defs/assertion"}}}}
    },
    "bindResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "operation", "requestDigest", "auditEventDigest", "idempotentReplay", "continuationOriginal"],
      "properties": {"ok": {"const": true}, "operation": {"const": "setup.policy.bind-candidate"},
        "requestDigest": {"$ref": "#/$defs/digest"}, "auditEventDigest": {"$ref": "#/$defs/digest"},
        "idempotentReplay": {"const": false}, "continuationOriginal": {"$ref": "#/$defs/continuationOriginal"}}
    },
    "lookupRequest": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "sessionId"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateRequest/v1"}, "sessionId": {"$ref": "#/$defs/uuid"}}
    },
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "okForAction", "automaticRetryAllowed", "continuationOriginal"],
      "properties": {"apiVersion": {"const": "serverware.setupPolicyCandidateObservation/v1"}, "okForAction": {"const": false},
        "automaticRetryAllowed": {"const": false}, "continuationOriginal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/continuationOriginal"}]}}
    }
  }
}
