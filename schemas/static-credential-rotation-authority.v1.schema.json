{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.dev/schemas/static-credential-rotation-authority.v1.schema.json",
  "title": "Separately selected native static N+1 rotation authority",
  "description": "A rotation grant is distinct from create permission. Execution also requires exact authenticated predecessor provenance and row/head CAS, a consumed admitted drain barrier, fresh rotation-specific native and hardware proof, and any selected distinct-person approval. Currentness policy v5 must be independently selected in the enclosing configuration.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "credentialPolicy", "operationMaxSeconds", "maximumArgumentBytes", "maximumSecretBytes", "twoPersonRequired", "nativeSecretKekId", "intentMaxSeconds", "nativeCustodyPurpose"],
  "properties": {
    "schema": {"const": "catchplate.staticCredentialRotationAuthorityPolicy/v1"},
    "credentialPolicy": {"$ref": "setup-native-canary.v1.schema.json#/$defs/credentialPolicy"},
    "operationMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "maximumArgumentBytes": {"const": 2097152},
    "maximumSecretBytes": {"const": 1048576},
    "twoPersonRequired": {"type": "boolean"},
    "nativeSecretKekId": {"type": "string", "pattern": "^attested-memory-kek:[0-9a-f]{24}$"},
    "intentMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "nativeCustodyPurpose": {"const": "catchplate.nativeStaticCredentialRotationStatement/v1"}
  }
}
