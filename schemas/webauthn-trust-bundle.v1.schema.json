{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchplate.local/schemas/webauthn-trust-bundle.v1.schema.json",
  "title": "Catchplate WebAuthn Trust Bundle v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "roots"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "catchplate.webauthnTrust/v1"},
    "kind": {"const": "WebAuthnTrustBundle"},
    "metadata": {
      "type": "object",
      "required": ["id", "sequence", "rollbackEpoch", "validFrom", "signingKeyId", "signature"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "rollbackEpoch": {"type": "integer", "minimum": 1},
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "signingKeyId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]+$"}
      }
    },
    "roots": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "authenticatorClass", "certificatePem"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "authenticatorClass": {"enum": ["yubikey", "hardware", "platform"]},
          "aaguids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "certificatePem": {"type": "string", "minLength": 1},
          "certificateSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
