{
  "schema": "catchplate.orderedFormQueryVectors/v1",
  "mode": "orderedFormV1",
  "adapter": "gmail.read.v1",
  "limits": {"raw_bytes": 8192, "segments": 64, "pairs": 64, "repeated_values": 32},
  "cases": [
    {"id": "absent", "raw_query": null, "operation": "gmail.messages.list", "pairs": []},
    {"id": "explicit-empty", "raw_query": "", "operation": "gmail.messages.list", "pairs": []},
    {"id": "empty-segments", "raw_query": "&&", "operation": "gmail.messages.list", "pairs": []},
    {"id": "bare-q", "raw_query": "q", "operation": "gmail.messages.list", "pairs": [["q", ""]]},
    {"id": "empty-q", "raw_query": "q=", "operation": "gmail.messages.list", "pairs": [["q", ""]]},
    {"id": "empty-q-segments", "raw_query": "&&q=&&", "operation": "gmail.messages.list", "pairs": [["q", ""]]},
    {"id": "unsorted", "raw_query": "q=report&maxResults=10&alt=json", "operation": "gmail.messages.list", "pairs": [["q", "report"], ["maxResults", "10"], ["alt", "json"]]},
    {"id": "repeat-labels", "raw_query": "labelIds=INBOX&q=report&labelIds=STARRED", "operation": "gmail.messages.list", "pairs": [["labelIds", "INBOX"], ["q", "report"], ["labelIds", "STARRED"]]},
    {"id": "reverse-labels", "raw_query": "labelIds=STARRED&q=report&labelIds=INBOX", "operation": "gmail.messages.list", "pairs": [["labelIds", "STARRED"], ["q", "report"], ["labelIds", "INBOX"]]},
    {"id": "repeat-same-label", "raw_query": "labelIds=INBOX&labelIds=INBOX", "operation": "gmail.messages.list", "pairs": [["labelIds", "INBOX"], ["labelIds", "INBOX"]]},
    {"id": "repeat-headers", "raw_query": "metadataHeaders=Subject&format=metadata&metadataHeaders=From", "operation": "gmail.message.get", "pairs": [["metadataHeaders", "Subject"], ["format", "metadata"], ["metadataHeaders", "From"]]},
    {"id": "plus-space", "raw_query": "q=hello+world", "operation": "gmail.messages.list", "pairs": [["q", "hello world"]]},
    {"id": "escaped-space", "raw_query": "q=hello%20world", "operation": "gmail.messages.list", "pairs": [["q", "hello world"]]},
    {"id": "literal-plus-upper", "raw_query": "q=hello%2Bworld", "operation": "gmail.messages.list", "pairs": [["q", "hello+world"]]},
    {"id": "literal-plus-lower", "raw_query": "q=hello%2bworld", "operation": "gmail.messages.list", "pairs": [["q", "hello+world"]]},
    {"id": "unreserved", "raw_query": "q=hello", "operation": "gmail.messages.list", "pairs": [["q", "hello"]]},
    {"id": "escaped-unreserved", "raw_query": "%71=%68ello", "operation": "gmail.messages.list", "pairs": [["q", "hello"]]},
    {"id": "first-equals", "raw_query": "q=a=b=c", "operation": "gmail.messages.list", "pairs": [["q", "a=b=c"]]},
    {"id": "escaped-equals", "raw_query": "q=a%3Db%3Dc", "operation": "gmail.messages.list", "pairs": [["q", "a=b=c"]]},
    {"id": "token-padding", "raw_query": "pageToken=abc==", "operation": "gmail.messages.list", "pairs": [["pageToken", "abc=="]]},
    {"id": "search-punctuation", "raw_query": "q=from:alice@example.com+after:2026/10/01", "operation": "gmail.messages.list", "pairs": [["q", "from:alice@example.com after:2026/10/01"]]},
    {"id": "semicolon-data", "raw_query": "q=before;after", "operation": "gmail.messages.list", "pairs": [["q", "before;after"]]},
    {"id": "escaped-semicolon", "raw_query": "q=before%3Bafter", "operation": "gmail.messages.list", "pairs": [["q", "before;after"]]},
    {"id": "query-punctuation", "raw_query": "q=!$'()*,;:@/?=~_-.", "operation": "gmail.messages.list", "pairs": [["q", "!$'()*,;:@/?=~_-."]]},
    {"id": "escaped-separators", "raw_query": "q=a%26labelIds%3DINBOX%23tail", "operation": "gmail.messages.list", "pairs": [["q", "a&labelIds=INBOX#tail"]]},
    {"id": "decode-once", "raw_query": "q=%2526%253D%252B%255C", "operation": "gmail.messages.list", "pairs": [["q", "%26%3D%2B%5C"]]},
    {"id": "unicode-utf8", "raw_query": "q=caf%C3%A9+%F0%9F%93%A7", "operation": "gmail.messages.list", "pairs": [["q", "café 📧"]]},
    {"id": "encoded-repeat-name", "raw_query": "%6cabelIds=INBOX&labelIds=STARRED", "operation": "gmail.messages.list", "pairs": [["labelIds", "INBOX"], ["labelIds", "STARRED"]]},
    {"id": "syntax-only-unknown", "raw_query": "custom=a&custom=b", "operation": null, "pairs": [["custom", "a"], ["custom", "b"]]},
    {"id": "duplicate-q", "raw_query": "q=a&q=b", "operation": "gmail.messages.list", "error": "query_duplicate_singleton"},
    {"id": "duplicate-same-q", "raw_query": "q=a&q=a", "operation": "gmail.messages.list", "error": "query_duplicate_singleton"},
    {"id": "encoded-duplicate-q", "raw_query": "q=a&%71=b", "operation": "gmail.messages.list", "error": "query_duplicate_singleton"},
    {"id": "duplicate-bare-q", "raw_query": "q&q=", "operation": "gmail.messages.list", "error": "query_duplicate_singleton"},
    {"id": "duplicate-format", "raw_query": "format=full&format=metadata", "operation": "gmail.message.get", "error": "query_duplicate_singleton"},
    {"id": "labels-wrong-operation", "raw_query": "labelIds=INBOX", "operation": "gmail.message.get", "error": "query_name_denied"},
    {"id": "headers-wrong-operation", "raw_query": "metadataHeaders=Subject", "operation": "gmail.messages.list", "error": "query_name_denied"},
    {"id": "q-wrong-operation", "raw_query": "q=report", "operation": "gmail.message.get", "error": "query_name_denied"},
    {"id": "unknown-key", "raw_query": "access_token=fixture", "operation": "gmail.messages.list", "error": "query_name_denied"},
    {"id": "unsupported-operation", "raw_query": null, "operation": "gmail.threads.list", "error": "query_operation_unsupported"},
    {"id": "empty-name", "raw_query": "=value", "operation": "gmail.messages.list", "error": "query_empty_name"},
    {"id": "empty-name-after-separator", "raw_query": "q=ok&&=bad", "operation": "gmail.messages.list", "error": "query_empty_name"},
    {"id": "bad-percent", "raw_query": "q=%", "operation": "gmail.messages.list", "error": "query_invalid_escape"},
    {"id": "short-percent", "raw_query": "q=%2", "operation": "gmail.messages.list", "error": "query_invalid_escape"},
    {"id": "nonhex-percent", "raw_query": "q=%GG", "operation": "gmail.messages.list", "error": "query_invalid_escape"},
    {"id": "invalid-utf8", "raw_query": "q=%FF", "operation": "gmail.messages.list", "error": "query_invalid_utf8"},
    {"id": "overlong-utf8", "raw_query": "q=%C0%AF", "operation": "gmail.messages.list", "error": "query_invalid_utf8"},
    {"id": "surrogate-utf8", "raw_query": "q=%ED%A0%80", "operation": "gmail.messages.list", "error": "query_invalid_utf8"},
    {"id": "raw-unicode", "raw_query": "q=café", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "raw-space", "raw_query": "q=hello world", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "raw-fragment", "raw_query": "q=hello#world", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "raw-backslash", "raw_query": "q=a\\b", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "raw-bracket", "raw_query": "q=[a]", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "raw-newline", "raw_query": "q=a\nb", "operation": "gmail.messages.list", "error": "query_invalid_wire"},
    {"id": "decoded-backslash", "raw_query": "q=%5c", "operation": "gmail.messages.list", "error": "query_forbidden_character"},
    {"id": "decoded-nul", "raw_query": "q=%00", "operation": "gmail.messages.list", "error": "query_forbidden_character"},
    {"id": "decoded-tab", "raw_query": "q=%09", "operation": "gmail.messages.list", "error": "query_forbidden_character"},
    {"id": "decoded-del", "raw_query": "q=%7F", "operation": "gmail.messages.list", "error": "query_forbidden_character"},
    {"id": "decoded-c1", "raw_query": "q=%C2%85", "operation": "gmail.messages.list", "error": "query_forbidden_character"}
  ],
  "same_pairs_distinct_wire": [
    ["absent", "explicit-empty", "empty-segments"],
    ["bare-q", "empty-q", "empty-q-segments"],
    ["plus-space", "escaped-space"],
    ["literal-plus-upper", "literal-plus-lower"],
    ["unreserved", "escaped-unreserved"],
    ["first-equals", "escaped-equals"],
    ["semicolon-data", "escaped-semicolon"]
  ]
}
