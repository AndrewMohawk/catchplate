#include <tunables/global>

profile catchplate-docker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  network inet6 stream,
  network unix stream,

  deny capability *,
  deny mount,
  deny ptrace,

  signal,
  unix,

  file,
  deny /boot/** rwklx,
  deny /dev/mem rwklx,
  deny /dev/kmem rwklx,
  deny /dev/port rwklx,
  deny /etc/shadow rwklx,
  deny /proc/acpi/** rwklx,
  deny /proc/kcore rwklx,
  deny /proc/keys rwklx,
  deny /proc/sys/** rwklx,
  deny /proc/sysrq-trigger rwklx,
  deny /sys/** wklx,
}
